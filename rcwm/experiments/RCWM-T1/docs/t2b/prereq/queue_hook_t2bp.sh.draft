# DRAFT queue hook for the T2b prerequisite representation screen (docs/t2b/prereq/DESIGN.md). NOT INSTALLED.
# Installing it (cp to scripts/queue_hooks/70_t2bp.sh) is an operator decision logged in DECISIONS.md: master_chain.sh
# globs scripts/queue_hooks/*.sh ONCE when it enters that loop, so a new hook needs a FRESH chain, launched only after the
# live chain has finished or been stopped at a safe point (R14 one-waiter rule; PREREG-3 must keep its slot). The runner
# also refuses (exit 3, not persisted) while another RCWM job holds or waits for the GPU lease.
# Idempotent: every line checks its own output. The run step takes the shared lease itself (rcwmt.runtime.gpu_lease,
# label rcwm-t1:t2b-prereq: alternation, thermal flag, holder check, 4.5 h cap with D-22 pairing) and holds a one-runner
# lock (runs/t2bp/s0/.run.lock). Exit codes of scripts/t2bp_run.py: 0 complete; 3 deterministic stop - NEVER retried
# (persisted as runs/t2bp/s0/STOPPED.json when it concerns the run); 5 deferred by the turn cap (the second call waits for
# the next turn and resumes); anything else is a crash (the lease is released) - one retry.
if [ -f data/t2bp_dev.SOURCE.json ] && [ ! -f runs/t2bp/s0/STOPPED.json ]; then
  if [ ! -f runs/t2bp/s0/DONE.json ]; then
    step scripts/t2bp_run.py
    t2bp_rc=$?
    if [ "$t2bp_rc" -ne 3 ] && [ ! -f runs/t2bp/s0/DONE.json ] && [ ! -f runs/t2bp/s0/STOPPED.json ]; then
      step scripts/t2bp_run.py                          # resumes from the recorded stages; never re-runs a finished one
    fi
  fi
  # CPU, once, create-only: scorer self-test BEFORE any output is read, validation, the pre-stated screen rule
  if [ -f runs/t2bp/s0/DONE.json ] && [ ! -f runs/t2bp/s0/analysis/T2BP_SCREEN.json ]; then
    step scripts/t2bp_analysis.py
  fi
fi
