# DRAFT queue hook for PREREG-5 (the sealed confirmation of T2b-ledger; PREREG_5_DRAFT.md section 7). NOT INSTALLED. Its
# sha256 is recorded in the freeze, and scripts/t2bl_confirm_run.py refuses to run (exit 3, not persisted) if any
# installed scripts/queue_hooks/*prereg5*.sh is not this file byte for byte. Install only AFTER the freeze (which needs
# the dev gate's PROCEED and BWM's co-sign), by the RCWM-T1 operator on the user's go-ahead, logged in DECISIONS.md:
#   cp docs/t2b/ledger/queue_hook_prereg5.sh.draft scripts/queue_hooks/90_prereg5.sh   (then compare the two sha256 values)
# WHEN IT RUNS. master_chain.sh expands its hook glob ONCE, when execution enters that loop: a new hook runs only in a FRESH
# chain started when no chain process is alive. One RCWM waiter at a time (R14): the steps below are sequential, and each
# runner refuses (exit 3, not persisted) while another RCWM job holds or waits for the GPU lease.
# IDEMPOTENT: every line checks its own output.
# Parts (a) and (b): scripts/t2bl_confirm_run.py, lease rcwm-t1:prereg5 (stages A0, M1, P1-P4 on the GPU; C1 on the CPU at
#   the start of the call after the one that recorded A0). Exit codes: 0 complete; 3 deterministic stop - NEVER retried
#   (persisted as runs/prereg5/STOPPED.json with its verdict-eligible parts); 5 deferred by the 4.5 h cap or C1 pending:
#   SLEEP 60 s FIRST (so BWM's yield loop sees the release; agreed with BWM), then call again; anything else is a crash -
#   exactly one retry. At most six calls per chain pass (the runner's own start rule gives 2 turns at the observed rate, 3
#   at the planning rate, 4 at the planning-rate ceiling and 5 at 2.5 generations/s; docs/t2b/ledger/P5_GEN_PLAN.json);
#   any remaining stage resumes in the next chain pass.
# Part (c), only after the GPU job is terminal and verdict-eligible: mint ONE sealed 5c confirmation draw at run time
#   (t2bl_confirm_run.py --ret-mint -> runs/prereg5/RET_DRAW.json; never re-minted), run the frozen retention suite with
#   T2b-ledger seed 0 as the extra Titan-Sparse adapter (lease rcwm-t1:retention; rc 5: sleep 60 s, then call again; at
#   most three calls), its registered analysis once, then bind the result (or the persisted stop) to PREREG-5
#   (t2bl_confirm_run.py --ret-record -> runs/prereg5/RETENTION.json).
# The registered analysis (CPU, once, create-only) runs when the GPU job ended complete or verdict-eligible AND part (c) is
#   bound; if part (c) can never be bound, the operator runs `python -B scripts/t2bl_confirm_analysis.py` by hand (part (c)
#   is then rendered 'not evaluable') and logs it in DECISIONS.md.
if [ -f PREREG_5_FREEZE.json ]; then
  p5_calls=0
  p5_crashes=0
  while [ "$p5_calls" -lt 6 ] && [ ! -f runs/prereg5/DONE.json ] && [ ! -f runs/prereg5/STOPPED.json ]; do
    step scripts/t2bl_confirm_run.py
    p5_rc=$?
    p5_calls=$((p5_calls + 1))
    if [ "$p5_rc" -eq 0 ] || [ "$p5_rc" -eq 3 ]; then
      break
    elif [ "$p5_rc" -eq 5 ]; then
      sleep 60
    else
      p5_crashes=$((p5_crashes + 1))
      [ "$p5_crashes" -ge 2 ] && break
    fi
  done
  if [ -f runs/prereg5/DONE.json ] || grep -qs '"verdict_eligible": true' runs/prereg5/STOPPED.json; then
    if [ ! -f runs/prereg5/RET_DRAW.json ]; then
      step scripts/t2bl_confirm_run.py --ret-mint
    fi
    if [ -f runs/prereg5/RET_DRAW.json ] && [ ! -f runs/prereg5/RETENTION.json ]; then
      p5_ret_id=$(grep -o '"draw_id": "[^"]*"' runs/prereg5/RET_DRAW.json | head -n 1 | cut -d'"' -f4)
      p5_ret_dir="runs/retention/$p5_ret_id"
      p5_rcalls=0
      while [ -n "$p5_ret_id" ] && [ "$p5_rcalls" -lt 3 ] && [ ! -f "$p5_ret_dir/DONE.json" ] && [ ! -f "$p5_ret_dir/STOPPED.json" ]; do
        step scripts/ret_run.py --mode confirm --draw "docs/retention/draws/$p5_ret_id.jsonl" \
          --extra-adapter "t2bl_s0=runs/t2bl/dev/s0/train/adapter"
        p5_ret_rc=$?
        p5_rcalls=$((p5_rcalls + 1))
        if [ "$p5_ret_rc" -eq 0 ] || [ "$p5_ret_rc" -eq 3 ]; then
          break
        elif [ "$p5_ret_rc" -eq 5 ]; then
          sleep 60
        fi
      done
      if [ -n "$p5_ret_id" ] && [ -f "$p5_ret_dir/DONE.json" ] && [ ! -f "$p5_ret_dir/analysis/RET_RESULTS.json" ]; then
        step scripts/ret_analysis.py analyze --run "$p5_ret_dir"
      fi
      if [ -n "$p5_ret_id" ] && { [ -f "$p5_ret_dir/analysis/RET_RESULTS.json" ] || [ -f "$p5_ret_dir/STOPPED.json" ]; }; then
        step scripts/t2bl_confirm_run.py --ret-record
      fi
    fi
    if [ -f runs/prereg5/RETENTION.json ] && [ ! -f runs/prereg5/analysis/PREREG_5_RESULTS.json ]; then
      step scripts/t2bl_confirm_analysis.py
    fi
  fi
fi
