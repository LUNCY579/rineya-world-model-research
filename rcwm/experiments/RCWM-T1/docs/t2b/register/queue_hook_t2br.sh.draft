# DRAFT queue hook for the T2b-register screen (docs/t2b/register/DESIGN.md; roadmap item 3, joint item 5b). NOT
# INSTALLED. Its sha256 is a frozen input of the screen (scripts/t2br_run.py --freeze). Install only after the freeze, as
# an operator decision logged in DECISIONS.md: cp docs/t2b/register/queue_hook_t2br.sh.draft scripts/queue_hooks/80_t2br.sh
# (name order after PREREG-3's 60 and the prerequisite screen's 70; the roadmap's turn order is PREREG-3, item 2, item 3).
# master_chain.sh globs scripts/queue_hooks/*.sh ONCE when it enters that loop, so a new hook needs a FRESH chain,
# launched only after the live chain has finished or been stopped at a safe point (R14 one-waiter rule). The runner also
# refuses (exit 3, not persisted) while another RCWM job holds or waits for the GPU lease.
# Decision point 1: if PREREG-3's verdict is TRIGGER, build the surface-diversity rendering BEFORE the freeze
# (python -B scripts/t2br_make_data.py --surface-diversity on) and pass --train-variant sd on both run lines below (its
# outputs then go to runs/t2b_register/s0_sd; point the DONE / STOPPED / --run-dir paths there too).
# Idempotent: every line checks its own output. The run step takes the shared lease itself (rcwmt.runtime.gpu_lease,
# label rcwm-t1:t2b-register: alternation, thermal flag, holder check, 4.5 h cap with D-22 pairing) and holds a
# one-runner lock (runs/t2b_register/s0/.run.lock). Exit codes of scripts/t2br_run.py: 0 complete; 3 deterministic stop -
# NEVER retried (persisted as runs/t2b_register/s0/STOPPED.json when it concerns the run); 5 deferred by the turn cap
# (the second call waits for the next turn and resumes); anything else is a crash (the lease is released) - one retry.
if [ -f docs/t2b/register/SCREEN_FREEZE.json ] && [ ! -f runs/t2b_register/s0/STOPPED.json ]; then
  if [ ! -f runs/t2b_register/s0/DONE.json ]; then
    step scripts/t2br_run.py --seed 0
    t2br_rc=$?
    if [ "$t2br_rc" -ne 3 ] && [ ! -f runs/t2b_register/s0/DONE.json ] && [ ! -f runs/t2b_register/s0/STOPPED.json ]; then
      step scripts/t2br_run.py --seed 0                 # resumes from the recorded stages; never re-runs a finished one
    fi
  fi
  # CPU, once, create-only: freeze + provenance verified, outputs validated, the pre-stated rule applied, report rendered
  if [ -f runs/t2b_register/s0/DONE.json ] && [ ! -f runs/t2b_register/analysis/T2BR_RESULTS_s0.json ]; then
    step scripts/t2br_analysis.py --run-dir runs/t2b_register/s0
  fi
fi
