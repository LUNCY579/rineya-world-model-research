{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWM decision prediction",
  "type": "object",
  "required": [
    "parent_id",
    "candidate_set_id",
    "model_id",
    "goal_id",
    "scores",
    "selected_index",
    "observed_utility",
    "costs"
  ],
  "properties": {
    "parent_id": {
      "type": "string"
    },
    "candidate_set_id": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "goal_id": {
      "type": "string"
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1
    },
    "selected_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "observed_utility": {
      "type": [
        "number",
        "null"
      ]
    },
    "costs": {
      "type": "object"
    },
    "fallback_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "support": {
      "type": "array",
      "items": {
        "type": "number"
      }
    }
  },
  "additionalProperties": false
}
