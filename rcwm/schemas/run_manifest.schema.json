{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWM run manifest",
  "type": "object",
  "required": [
    "run_id",
    "experiment_id",
    "scope",
    "status",
    "seed",
    "code_revision",
    "checkpoint_sha256",
    "data_manifest_sha256",
    "hardware",
    "software",
    "artifacts",
    "claims"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "synthetic_mechanics",
        "native_capture",
        "native_training",
        "evaluation"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "blocked",
        "running",
        "completed",
        "failed"
      ]
    },
    "seed": {
      "type": "integer"
    },
    "code_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "checkpoint_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_manifest_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "hardware": {
      "type": "object"
    },
    "software": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
