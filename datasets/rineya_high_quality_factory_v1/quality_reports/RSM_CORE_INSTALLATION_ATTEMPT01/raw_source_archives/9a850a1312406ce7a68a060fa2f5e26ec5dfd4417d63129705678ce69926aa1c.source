onstraints":[{"kind":"equal","positions":[0,1]},{"kind":"count","max":3,"min":1,"value":"ash"}],"kind":"constraint_repair","min_distance":1,"slots":3},"skill_tags":["finite_synthetic_proxy","constraint_repair","equal_count_repair"],"source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"structured","track_id":"RDP-001","verified_target":{"diverse_selection":["c6457","c7590"],"feasible_count":3,"repairs":[{"candidate_id":"c7590","edit_distance":0,"original_valid":true,"repaired":["ash","ash","ash"]},{"candidate_id":"c3074","edit_distance":1,"original_valid":false,"repaired":["birch","birch","ash"]},{"candidate_id":"c6457","edit_distance":0,"original_valid":true,"repaired":["birch","birch","ash"]},{"candidate_id":"c7751","edit_distance":1,"original_valid":false,"repaired":["ash","ash","ash"]}]}}
