ming distance from every previously accepted repaired assignment is at least min_distance. With no accepted candidates this condition is vacuous; min_distance=0 permits duplicate repairs. Return exactly `{feasible_count:integer,repairs:[{candidate_id,original_valid:boolean,edit_distance:integer_or_null,repaired:assignment_or_null}],diverse_selection:[candidate_ids_in_greedy_acceptance_order]}`. Diversity is this declared greedy rule, not global maximum packing. This task does not claim a trained diffusion sampler.\nTask JSON:\n{\"min_distance\":2,\"candidates\":[{\"assignment\":[\"birch\",\"birch\",\"birch\"],\"candidate_id\":\"c3772\"},{\"assignment\":[\"ash\",\"birch\",\"ash\"],\"candidate_id\":\"c2710\"},{\"assignment\":[\"birch\",\"birch\",\"birch\"],\"candidate_id\":\"c3120\"},{\"assignment\":[\"ash\",\"ash\",\"ash\"],\"candidate_id\":\"c4543\"}],\"constraints\":[{\"positions\":[0,1],\"kind\":\"different\"},{\"values\":[\"ash\"],\"position\":0,\"kind\":\"allowed\"}],\"slots\":3,\"alphabet\":[\"ash\",\"birch\"],\"kind\":\"constraint_repair\"}","renderer":"reverse","review_receipt_ids":["expert-RDP-001-extended-pilot-v2-p0002-base-reverse-15636a733662","adv-extended-pilot-v2-3f929d48864d6fbc956f","adj-extended-pilot-v2-9a2b98817ace3cb12ac4"],"review_status":"ACCEPTED","reviewed_candidate_hash":"15636a733662b4f55babd60a35381b7e6350b42e0e4c743c7d0fc3b52aa0a59c","sample_id":"RDP-001-extended-pilot-v2-p0002-base-reverse","scope_limitation":"Finite exhaustive minimum Hamming repair and declared greedy diversity; no diffusion model or globally optimal packing claim.","semantic_family_id":"RDP-001-extended-pilot-v2-p0002","semantic_parent_id":"RDP-001-extended-pilot-v2-p0002","semantic_task":{"alphabet":["ash","birch"],"candidates":[{"assignment":["birch","birch","birch"],"candidate_id":"c3772"},{"assignment":["ash","birch","ash"],"candidate_id":"c2710"},{"assignment":["birch","birch","birch"],"candidate_id":"c3120"},{"assignment":["ash","ash","ash"],"candidate_id":"c4543"}],"constraints":[{"kind":"different","positions":[0,1]},{"kind":"allowed","position":0,"values":["ash"]}],"kind":"constraint_repair","min_distance":2,"slots":3},"skill_tags":["finite_synthetic_proxy","constraint_repair","different_allowed_repair"],"source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"structured","track_id":"RDP-001","verified_target":{"diverse_selection":["c2710"],"feasible_count":2,"repairs":[{"candidate_id":"c3772","edit_distance":1,"original_valid":false,"repaired":["ash","birch","birch"]},{"candidate_id":"c2710","edit_distance":0,"original_valid":true,"repaired":["ash","birch","ash"]},{"candidate_id":"c3120","edit_distance":1,"original_valid":false,"repaired":["ash","birch","birch"]},{"candidate_id":"c4543","edit_distance":1,"original_valid":false,"repaired":["ash","birch","ash"]}]}}
