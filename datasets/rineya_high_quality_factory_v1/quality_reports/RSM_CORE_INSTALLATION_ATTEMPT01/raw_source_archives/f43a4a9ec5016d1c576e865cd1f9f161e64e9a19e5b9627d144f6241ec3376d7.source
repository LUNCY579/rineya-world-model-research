scenario1\",\"facts\":{\"hue\":true,\"portal\":\"open\",\"sigil\":\"known\"}},{\"world_id\":\"scenario2\",\"facts\":{\"hue\":\"blue\",\"portal\":\"closed\",\"sigil\":\"unknown\"}},{\"world_id\":\"scenario3\",\"facts\":{\"hue\":null,\"portal\":\"open\",\"sigil\":\"unknown\"}},{\"world_id\":\"scenario4\",\"facts\":{\"hue\":1,\"portal\":\"closed\",\"sigil\":\"known\"}},{\"world_id\":\"scenario5\",\"facts\":{\"hue\":true,\"portal\":\"open\",\"sigil\":\"unknown\"}}],\"observations\":[{\"fact\":\"portal\",\"equals\":\"open\"}],\"queries\":[{\"query_id\":\"q0\",\"fact\":\"hue\"},{\"query_id\":\"q1\",\"fact\":\"portal\"},{\"query_id\":\"q2\",\"fact\":\"sigil\"}]}","target":{"belief_sizes":[3],"queries":[{"can_reduce_uncertainty":true,"counts":[{"count":1,"value":null},{"count":2,"value":true}],"distinct_values":2,"entailed":false,"guaranteed":null,"query_id":"q0"},{"can_reduce_uncertainty":false,"counts":[{"count":3,"value":"open"}],"distinct_values":1,"entailed":true,"guaranteed":"open","query_id":"q1"},{"can_reduce_uncertainty":true,"counts":[{"count":1,"value":"known"},{"count":2,"value":"unknown"}],"distinct_values":2,"entailed":false,"guaranteed":null,"query_id":"q2"}],"surviving_worlds":["scenario1","scenario3","scenario5"]}}
