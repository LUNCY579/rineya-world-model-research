vations\":[{\"equals\":1,\"fact\":\"hue\"},{\"equals\":true,\"fact\":\"hue\"}],\"worlds\":[{\"facts\":{\"sigil\":\"unknown\",\"portal\":\"closed\",\"hue\":1},\"world_id\":\"scenario0\"},{\"facts\":{\"sigil\":\"known\",\"portal\":\"open\",\"hue\":true},\"world_id\":\"scenario1\"},{\"facts\":{\"sigil\":\"unknown\",\"portal\":\"closed\",\"hue\":\"blue\"},\"world_id\":\"scenario2\"},{\"facts\":{\"sigil\":\"unknown\",\"portal\":\"open\",\"hue\":null},\"world_id\":\"scenario3\"},{\"facts\":{\"sigil\":\"known\",\"portal\":\"closed\",\"hue\":1},\"world_id\":\"scenario4\"},{\"facts\":{\"sigil\":\"unknown\",\"portal\":\"open\",\"hue\":true},\"world_id\":\"scenario5\"}],\"kind\":\"belief\"}","target":{"belief_sizes":[2,0],"queries":[{"can_reduce_uncertainty":false,"counts":[],"distinct_values":0,"entailed":false,"guaranteed":null,"query_id":"q0"},{"can_reduce_uncertainty":false,"counts":[],"distinct_values":0,"entailed":false,"guaranteed":null,"query_id":"q1"},{"can_reduce_uncertainty":false,"counts":[],"distinct_values":0,"entailed":false,"guaranteed":null,"query_id":"q2"}],"surviving_worlds":[]}}
