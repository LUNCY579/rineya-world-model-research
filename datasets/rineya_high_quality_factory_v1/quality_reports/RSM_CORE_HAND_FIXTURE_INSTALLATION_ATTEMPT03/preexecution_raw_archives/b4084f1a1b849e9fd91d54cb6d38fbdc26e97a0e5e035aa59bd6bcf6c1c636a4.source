{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "input",
    "candidate",
    "labels"
  ],
  "properties": {
    "input": {
      "type": "string"
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "plan",
        "claimed_after"
      ],
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claimed_after": {
          "type": "object",
          "required": [
            "node",
            "fuel"
          ],
          "properties": {
            "node": {
              "type": "string"
            },
            "fuel": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "labels": {
      "type": "object",
      "required": [
        "candidate_id",
        "valid",
        "claim_correct",
        "reaches_goal",
        "remaining_moves",
        "progress",
        "usefulness",
        "first_error",
        "repair_plan"
      ],
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "valid": {
          "type": "boolean"
        },
        "claim_correct": {
          "type": "boolean"
        },
        "reaches_goal": {
          "type": "boolean"
        },
        "remaining_moves": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "progress": {
          "type": [
            "integer",
            "null"
          ]
        },
        "usefulness": {
          "type": "integer",
          "enum": [
            -1,
            0,
            1,
            2
          ]
        },
        "first_error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "const": "claim"
            }
          ]
        },
        "repair_plan": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
