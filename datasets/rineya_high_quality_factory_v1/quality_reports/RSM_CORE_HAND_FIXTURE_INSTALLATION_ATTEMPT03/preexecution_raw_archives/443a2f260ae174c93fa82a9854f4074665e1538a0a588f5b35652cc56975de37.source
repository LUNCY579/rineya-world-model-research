:\"skills\",\"state\":{\"x\":4,\"y\":3},\"procedures\":{\"bump\":[{\"op\":\"add\",\"register\":\"x\",\"value\":4}],\"fold\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":1},{\"op\":\"swap\"}],\"gate\":[{\"op\":\"if\",\"test\":{\"register\":\"x\",\"cmp\":\"ge\",\"value\":0},\"then\":[{\"op\":\"call\",\"name\":\"bump\"}],\"else\":[{\"op\":\"add\",\"register\":\"y\",\"value\":-4}]}]},\"main\":[{\"op\":\"call\",\"name\":\"gate\"},{\"op\":\"call\",\"name\":\"gate\"},{\"op\":\"call\",\"name\":\"bump\"}]}","renderer":"forward","review_receipt_ids":["expert-RSM-001-extended-pilot-v2-p0011-base-forward-5915e6081a5d","adv-extended-pilot-v2-2b9b19d44987b253bf16","adj-extended-pilot-v2-2a76703d5301bfa97adb"],"review_status":"ACCEPTED","reviewed_candidate_hash":"5915e6081a5dc3a05c14226e066773e5a1ef8d1983539e696ddd1aea9edc469c","sample_id":"RSM-001-extended-pilot-v2-p0011-base-forward","scope_limitation":"Finite supplied procedure execution; no learned hierarchy or skill acquisition claim.","semantic_family_id":"RSM-001-extended-pilot-v2-p0011","semantic_parent_id":"RSM-001-extended-pilot-v2-p0011","semantic_task":{"kind":"skills","main":[{"name":"gate","op":"call"},{"name":"gate","op":"call"},{"name":"bump","op":"call"}],"procedures":{"bump":[{"op":"add","register":"x","value":4}],"fold":[{"op":"scale","register":"y","value":1},{"op":"swap"}],"gate":[{"else":[{"op":"add","register":"y","value":-4}],"op":"if","test":{"cmp":"ge","register":"x","value":0},"then":[{"name":"bump","op":"call"}]}]},"state":{"x":4,"y":3}},"skill_tags":["finite_synthetic_proxy","skills","repeated_conditional"],"source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"structured","track_id":"RSM-001","verified_target":{"after":{"x":16,"y":3},"call_order":["gate","bump","gate","bump","bump"],"conditions":[true,true],"executed_primitives":3}}
