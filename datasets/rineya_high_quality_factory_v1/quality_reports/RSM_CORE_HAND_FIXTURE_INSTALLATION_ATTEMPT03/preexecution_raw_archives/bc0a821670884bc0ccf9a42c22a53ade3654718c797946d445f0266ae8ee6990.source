{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.2.0","oracle_version":"independent-1.0.0","record_hash":"d6494d8788b80ae1b9ee9b9c425be7a029d2c211c7187530dd78e65d0b4698f8","rendered_input":"Graph contract: kind=graph. nodes contains distinct strings. edges contains [from,to,cost] triples with positive integer fuel costs and at most one edge per ordered pair. start and goal are nodes; fuel is a nonnegative integer. plan is an ordered list of destination node names. Every edge is directed. Start at {node:start,fuel:fuel}. An action is legal exactly when an edge from the current node to its destination exists and its cost is at most the remaining fuel. A legal move changes node to its destination and subtracts the edge cost. At the first illegal action, include that action's {legal:false,after:unchanged_state} step, stop immediately, and do not evaluate subsequent actions. An empty plan is valid. valid means every proposed action was legal. reaches_goal is true exactly when the whole plan is valid and its terminal node is goal, including an initially satisfied goal with an empty plan. shortest_plan is a fresh plan from the INITIAL state that reaches goal within initial fuel, minimizes the number of moves, and breaks ties by the lexicographic order of the entire destination-name sequence. It is [] for an initially satisfied goal and null if no feasible plan exists. Fuel cost is a feasibility constraint, not the optimization objective. Return exactly a JSON object with steps:[{legal:boolean,after:{node:string,fuel:integer}}], after:{node:string,fuel:integer}, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"graph\",\"nodes\":[\"Obsidian\",\"Nacre\",\"Tundra\",\"Vesper\",\"Quasar\",\"Sirocco\",\"Umber\"],\"edges\":[[\"Obsidian\",\"Nacre\",1],[\"Nacre\",\"Tundra\",2],[\"Tundra\",\"Vesper\",4],[\"Vesper\",\"Quasar\",4],[\"Quasar\",\"Sirocco\",1],[\"Sirocco\",\"Umber\",3]],\"start\":\"Obsidian\",\"goal\":\"Umber\",\"fuel\":15,\"plan\":[\"Nacre\"]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-pilot-v3-p0028-base-forward-510ed2ceccdc","adv-pilot-v3-6e45be91ca6ce2e4a094","adj-pilot-v3-f3fc6294a3afec3e4dd5"],"review_status":"ACCEPTED","reviewed_candidate_hash":"510ed2ceccdc0be921c8f48d8fd6c6ff13130a3b23f2dbb16eface3f8630cd73","sample_id":"RGM-001-pilot-v3-p0028-base-forward","semantic_family_id":"RGM-001-pilot-v3-p0028","semantic_parent_id":"RGM-001-pilot-v3-p0028","semantic_task":{"edges":[["Obsidian","Nacre",1],["Nacre","Tundra",2],["Tundra","Vesper",4],["Vesper","Quasar",4],["Quasar","Sirocco",1],["Sirocco","Umber",3]],"fuel":15,"goal":"Umber","kind":"graph","nodes":["Obsidian","Nacre","Tundra","Vesper","Quasar","Sirocco","Umber"],"plan":["Nacre"],"start":"Obsidian"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","partial_chain","graph","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0028","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":14,"node":"Nacre"},"reaches_goal":false,"shortest_plan":["Nacre","Tundra","Vesper","Quasar","Sirocco","Umber"],"steps":[{"after":{"fuel":14,"node":"Nacre"},"legal":true}],"valid":true}}
