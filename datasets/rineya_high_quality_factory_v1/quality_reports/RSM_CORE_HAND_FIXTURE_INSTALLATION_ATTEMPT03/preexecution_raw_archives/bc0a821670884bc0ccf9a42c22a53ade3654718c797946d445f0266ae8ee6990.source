lt\",\"to\":\"dahlia\"},{\"block\":\"birch\",\"to\":\"cobalt\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-pilot-v3-p0017-base-forward-112d9c38444f","adv-pilot-v3-9feb4a1f135c42b3c823","adj-pilot-v3-29a2ce367712e22f1ebc"],"review_status":"ACCEPTED","reviewed_candidate_hash":"112d9c38444f8e31f77adc80552de70ab2f9d16b5e9962c47f5717a4348b757a","sample_id":"RGM-001-pilot-v3-p0017-base-forward","semantic_family_id":"RGM-001-pilot-v3-p0017","semantic_parent_id":"RGM-001-pilot-v3-p0017","semantic_task":{"goal_on":{"birch":"cobalt","cobalt":"dahlia"},"kind":"blocks","on":{"birch":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"plan":[{"block":"cobalt","to":"dahlia"},{"block":"birch","to":"cobalt"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","assemble_stack","blocks","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0017","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"birch":"cobalt","cobalt":"dahlia","dahlia":"TABLE"},"reaches_goal":true,"shortest_plan":[{"block":"cobalt","to":"dahlia"},{"block":"birch","to":"cobalt"}],"steps":[{"after":{"birch":"TABLE","cobalt":"dahlia","dahlia":"TABLE"},"legal":true},{"after":{"birch":"cobalt","cobalt":"dahlia","dahlia":"TABLE"},"legal":true}],"valid":true}}
{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.2.0","oracle_version":"independent-1.0.0","record_hash":"e6948ba5a40a3820e292658008aa3d0252052dfd528ca1713c4799010538bfd7","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"plan\":[{\"to\":\"dahlia\",\"block\":\"cobalt\"},{\"to\":\"cobalt\",\"block\":\"birch\"}],\"goal_on\":{\"birch\":\"cobalt\",\"cobalt\":\"dahlia\"},\"on\":{\"birch\":\"TABLE\