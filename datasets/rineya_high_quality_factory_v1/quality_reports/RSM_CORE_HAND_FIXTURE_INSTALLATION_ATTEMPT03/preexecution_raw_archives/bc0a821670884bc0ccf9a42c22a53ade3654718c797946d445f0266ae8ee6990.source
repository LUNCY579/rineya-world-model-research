reverse-8aa976be4b13","adv-pilot-v3-03909fa9b41edbb7a983","adj-pilot-v3-f1b04f9f9724e0446337"],"review_status":"ACCEPTED","reviewed_candidate_hash":"8aa976be4b133da378e8c3cc2829d670d6bb5d2c589e80353684df3084958a3f","sample_id":"RGM-001-pilot-v3-p0013-base-reverse","semantic_family_id":"RGM-001-pilot-v3-p0013","semantic_parent_id":"RGM-001-pilot-v3-p0013","semantic_task":{"edges":[["Fjord","Beryl",2],["Beryl","Ember",4]],"fuel":6,"goal":"Ember","kind":"graph","nodes":["Fjord","Beryl","Ember"],"plan":["Beryl"],"start":"Fjord"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","partial_chain","graph","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0013","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":2,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":4,"node":"Beryl"},"reaches_goal":false,"shortest_plan":["Beryl","Ember"],"steps":[{"after":{"fuel":4,"node":"Beryl"},"legal":true}],"valid":true}}
{"challenge_axes":[],"difficulty":2,"generation_seed":20261009,"generator_version":"1.2.0","oracle_version":"independent-1.0.0","record_hash":"16d86a369b45c7242020ab87bb1601677358d65ad1570512efe8f2c7b5fe787a","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"cobalt\":\"TABLE\",\"amber\":\"cobalt\",\"birch\":\"amber\",\"dahlia\":\"birch\"},\"goal_on\":{\"dahlia\":\"birch\"},\"plan\":[{\"block\":\"dahlia\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-pilot-v3-p0014-base-forward-28ff6e6372f5","adv-pilot-v3-6b372c4327c69687abbf","adj-pilot-v3-9647ebd97855b55ea143"],"review_status":"ACCEPTED","reviewed_candidate_hash":"28ff6e6372f56e1d81bf039b0fb023189f6557493d8c6c3865002bbf65fd29fd","sample_id":"RGM-001-pilot-v3-p0014-base-forward","semantic_family_id":"RGM-001-pilot-v3-p0014","semantic_parent_id":"RGM-001-pilot-v3-p0014","semantic_task":{"goal_on":{"dahlia":"birch"},"kind":"blocks","on":{"amber":"cobalt","birch":"amber","cobalt":"TABLE","dahlia":"birch"},"plan":[{"block":"dahlia","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","initial_partial_goal","blocks","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0014","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":2,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"cobalt","birch":"amber","cobalt":"TABLE","dahlia":"TABLE"},"reaches_goal":false,"shortest_plan":[],"steps":[{"after":{"amber":"cobalt","birch":"amber","cobalt":"TABLE","dahlia":"TABLE"},"legal":true}],"valid":true}}
