","review_receipt_ids":["expert-RGM-001-pilot-v3-p0021-base-reverse-4030250bce5b","adv-pilot-v3-880e38c7c93fbc67896a","adj-pilot-v3-5b66a0f214e50fd8465d"],"review_status":"ACCEPTED","reviewed_candidate_hash":"4030250bce5b7c8e10ef66337c57cb9abe2fdb75b653709c5ea326fadc4c3180","sample_id":"RGM-001-pilot-v3-p0021-base-reverse","semantic_family_id":"RGM-001-pilot-v3-p0021","semantic_parent_id":"RGM-001-pilot-v3-p0021","semantic_task":{"edges":[["Ember","Aster",4],["Aster","Beryl",2],["Beryl","Dune",2]],"fuel":8,"goal":"Dune","kind":"graph","nodes":["Ember","Aster","Beryl","Dune"],"plan":["Ember","Aster","Beryl","Dune"],"start":"Ember"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","missing_edge_stop","graph","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0021","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":8,"node":"Ember"},"reaches_goal":false,"shortest_plan":["Aster","Beryl","Dune"],"steps":[{"after":{"fuel":8,"node":"Ember"},"legal":false}],"valid":false}}
{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.2.0","oracle_version":"independent-1.0.0","record_hash":"2b39d29f4be786628cd3c3fa2869b79dad952fec60fb7cb0eb5ee627eab34822","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"amber\":\"TABLE\",\"cobalt\":\"amber\",\"birch\":\"TABLE\"},\"goal_on\":{\"amber\":\"birch\"},\"plan\":[{\"block\":\"amber\",\"to\":\"birch\"},{\"block\":\"cobalt\",\"to\":\"TABLE\"},{\"block\":\"amber\",\"to\":\"birch\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-pilot-v3-p0022-base-forward-ef46cad591d1","adv-pilot-v3-946978583c9aee7f9a4a","adj-pilot-v3-c65cd2c5134db27baf38"],"review_status":"ACCEPTED","reviewed_candidate_hash":"ef46cad591d123d98fa9c71f20b9d8338ff8485523015df1d21b833d45fd1d6b","sample_id":"RGM-001-pilot-v3-p0022-base-forward","semantic_family_id":"RGM-001-pilot-v3-p0022","semantic_parent_id":"RGM-001-pilot-v3-p0022","semantic_task":{"goal_on":{"amber":"birch"},"kind":"blocks","on":{"amber":"TABLE","birch":"TABLE","cobalt":"amber"},"plan":[{"block":"amber","to":"birch"},{"block":"cobalt","to":"TABLE"},{"block":"amber","to":"birch"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","blocked_source","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0022","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"TABLE","birch":"TABLE","cobalt":"amber"},"reaches_goal":false,"shortest_plan":[{"block":"cobalt","to":"TABLE"},{"block":"amber","to":"birch"}],"steps":[{"after":{"amber":"TABLE","birch":"TABLE","cobalt":"amber"},"legal":false}],"valid":false}}
