{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.2.0","oracle_version":"independent-1.0.0","record_hash":"4ac7d6d05fb1a30146b4e9297e35bd2b3d44d8ebefced37a710ce9ed9d0dbcf5","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"cobalt\":\"TABLE\",\"dahlia\":\"cobalt\",\"amber\":\"dahlia\",\"birch\":\"amber\"},\"goal_on\":{\"cobalt\":\"birch\"},\"plan\":[{\"block\":\"birch\",\"to\":\"TABLE\"},{\"block\":\"birch\",\"to\":\"TABLE\"},{\"block\":\"amber\",\"to\":\"TABLE\"},{\"block\":\"dahlia\",\"to\":\"TABLE\"},{\"block\":\"cobalt\",\"to\":\"birch\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-pilot-v3-p0024-base-forward-bc2f4f089a45","adv-pilot-v3-3b00bf718a974eb13ecd","adj-pilot-v3-c02d4ce3131a0269d2b4"],"review_status":"ACCEPTED","reviewed_candidate_hash":"bc2f4f089a4503f4513116314622d45adeeddba3b8f9c867a8bac56998cabc5f","sample_id":"RGM-001-pilot-v3-p0024-base-forward","semantic_family_id":"RGM-001-pilot-v3-p0024","semantic_parent_id":"RGM-001-pilot-v3-p0024","semantic_task":{"goal_on":{"cobalt":"birch"},"kind":"blocks","on":{"amber":"dahlia","birch":"amber","cobalt":"TABLE","dahlia":"cobalt"},"plan":[{"block":"birch","to":"TABLE"},{"block":"birch","to":"TABLE"},{"block":"amber","to":"TABLE"},{"block":"dahlia","to":"TABLE"},{"block":"cobalt","to":"birch"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","clear_partial_goal","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0024","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"dahlia","birch":"TABLE","cobalt":"TABLE","dahlia":"cobalt"},"reaches_goal":false,"shortest_plan":[{"block":"birch","to":"TABLE"},{"block":"amber","to":"TABLE"},{"block":"dahlia","to":"TABLE"},{"block":"cobalt","to":"birch"}],"steps":[{"after":{"amber":"dahlia","birch":"TABLE","cobalt":"TABLE","dahlia":"cobalt"},"legal":true},{"after":{"amber":"dahlia","birch":"TABLE","cobalt":"TABLE","dahlia":"cobalt"},"legal":false}],"valid":false}}
