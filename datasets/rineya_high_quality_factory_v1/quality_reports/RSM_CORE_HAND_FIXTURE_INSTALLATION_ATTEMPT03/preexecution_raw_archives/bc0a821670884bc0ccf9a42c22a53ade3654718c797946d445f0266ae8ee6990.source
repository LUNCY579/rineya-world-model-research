{"challenge_axes":[],"difficulty":3,"generation_seed":20261009,"generator_version":"1.2.0","oracle_version":"independent-1.0.0","record_hash":"4959f7b71191492a8cac023442fc7287f0741f592d004cc2bc352668b61e6ade","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"cobalt\":\"TABLE\",\"birch\":\"TABLE\",\"dahlia\":\"TABLE\"},\"goal_on\":{\"cobalt\":\"birch\"},\"plan\":[{\"block\":\"dahlia\",\"to\":\"cobalt\"},{\"block\":\"dahlia\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-pilot-v3-p0012-base-forward-0556d9f487b9","adv-pilot-v3-e7e62ee49c0ce665902f","adj-pilot-v3-ac6e3776c1f95602f235"],"review_status":"ACCEPTED","reviewed_candidate_hash":"0556d9f487b9cb5858273cf8ca6cecd3baa40ed2d99389423856607e0456c69c","sample_id":"RGM-001-pilot-v3-p0012-base-forward","semantic_family_id":"RGM-001-pilot-v3-p0012","semantic_parent_id":"RGM-001-pilot-v3-p0012","semantic_task":{"goal_on":{"cobalt":"birch"},"kind":"blocks","on":{"birch":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"plan":[{"block":"dahlia","to":"cobalt"},{"block":"dahlia","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","legal_non_goal_detour","blocks","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0012","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"birch":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"cobalt","to":"birch"}],"steps":[{"after":{"birch":"TABLE","cobalt":"TABLE","dahlia":"cobalt"},"legal":true},{"after":{"birch":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"legal":true}],"valid":true}}
