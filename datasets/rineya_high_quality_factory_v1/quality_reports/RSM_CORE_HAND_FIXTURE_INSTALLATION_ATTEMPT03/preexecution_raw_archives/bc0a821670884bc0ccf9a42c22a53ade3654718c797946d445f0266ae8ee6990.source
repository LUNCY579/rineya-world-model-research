\"Dune\",\"Fjord\"],\"kind\":\"graph\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-pilot-v3-p0003-base-reverse-7419b5ea13b2","adv-pilot-v3-9da74563ef496b3ff0a9","adj-pilot-v3-90a4af6a7571f8ce7450"],"review_status":"ACCEPTED","reviewed_candidate_hash":"7419b5ea13b2cb2f4c6711edec89d415b03dc4f161ad7cdb685122fb8673ab48","sample_id":"RGM-001-pilot-v3-p0003-base-reverse","semantic_family_id":"RGM-001-pilot-v3-p0003","semantic_parent_id":"RGM-001-pilot-v3-p0003","semantic_task":{"edges":[["Cedar","Beryl",2],["Beryl","Ember",2],["Ember","Dune",3],["Dune","Fjord",4],["Cedar","Fjord",11]],"fuel":10,"goal":"Fjord","kind":"graph","nodes":["Cedar","Beryl","Ember","Dune","Fjord"],"plan":["Beryl","Ember","Dune","Fjord"],"start":"Cedar"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","unreachable_goal","graph","invalid_plan","unreachable"],"source_family_key":"RGM-001-seed20261009-p0003","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":3,"node":"Dune"},"reaches_goal":false,"shortest_plan":null,"steps":[{"after":{"fuel":8,"node":"Beryl"},"legal":true},{"after":{"fuel":6,"node":"Ember"},"legal":true},{"after":{"fuel":3,"node":"Dune"},"legal":true},{"after":{"fuel":3,"node":"Dune"},"legal":false}],"valid":false}}
{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.2.0","oracle_version":"independent-1.0.0","record_hash":"9d5deb585a5f22fa7182312cd5cf3c00003fea9cff14b1c6293196541aca596e","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"amber\":\"TABLE\",\"birch\":\"amber\",\"dahlia\":\"birch\",\"cobalt\":\"dahlia\"},\"goal_on\":{\"cobalt\":\"TABLE\",\"amber\":\"birch\",\"birch\":\"dahlia\",\"dahlia\":\"cobalt\"},\"plan\":[{\"block\":\"cobalt\",\"to\":\"TABLE\"},{\"block\":\"dahlia\",\"to\":\"cobalt\"},{\"block\":\"birch\",\"to\":\"dahlia\"},{\"block\":\"amber\",\"to\":\"birch\"},{\"block\":\"amber\",\"to\":\"birch\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-pilot-v3-p0004-base-forward-be2191613563","adv-pilot-v3-90b95ebafc9aa79e96d1","adj-pilot-v3-293f559f65a52dc00f49"],"review_status":"ACCEPTED","reviewed_candidate_hash":"be2191613563d421ea2a2bfa427311c7ad50306cef51a6b99c0908c468f1c031","sample_id":"RGM-001-pilot-v3-p0004-base-forward","semantic_family_id":"RGM-001-pilot-v3-p0004","semantic_parent_id":"RGM-001-pilot-v3-p0004","semantic_task":{"goal_on":{"amber":"birch","birch":"dahlia","cobalt":"TABLE","dahlia":"cobalt"},"kind":"blocks","on":{"amber":"TABLE","birch":"amber","cobalt":"dahlia","dahlia":"birch"},"plan":[{"block":"cobalt","to":"TABLE"},{"block":"dahlia","to":"cobalt"},{"block":"birch","to":"dahlia"},{"block":"amber","to":"birch"},{"block":"amber","to":"birch"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","reverse_stack_and_invalid_tail","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0004","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"birch","birch":"dahlia","cobalt":"TABLE","dahlia":"cobalt"},"reaches_goal":false,"shortest_plan":[{"block":"cobalt","to":"TABLE"},{"block":"dahlia","to":"cobalt"},{"block":"birch","to":"dahlia"},{"block":"amber","to":"birch"}],"steps":[{"after":{"amber":"TABLE","birch":"amber","cobalt":"TABLE","dahlia":"birch"},"legal":true},{"after":{"amber":"TABLE","birch":"amber","cobalt":"TABLE","dahlia":"cobalt"},"legal":true},{"after":{"amber":"TABLE","birch":"dahlia","cobalt":"TABLE","dahlia":"cobalt"},"legal"