sidian\",\"Umber\",3],[\"Umber\",\"Zephyr\",2],[\"Zephyr\",\"Nacre\",3],[\"Vesper\",\"Quasar\",1]],\"nodes\":[\"Quasar\",\"Vesper\",\"Sirocco\",\"Obsidian\",\"Umber\",\"Zephyr\",\"Nacre\"],\"kind\":\"graph\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-pilot-v3-p0008-matched-reverse-ea218db40b47","adv-pilot-v3-0f15cd4648eb9d8e261f","adj-pilot-v3-e4dea7e2524559f5a076"],"review_status":"ACCEPTED","reviewed_candidate_hash":"ea218db40b4716bd8502e006a185c17bf8a0854f1d7b10cff78a494093289457","sample_id":"RGM-001-pilot-v3-p0008-matched-reverse","semantic_family_id":"RGM-001-pilot-v3-p0008","semantic_parent_id":"RGM-001-pilot-v3-p0008","semantic_task":{"edges":[["Quasar","Vesper",3],["Vesper","Sirocco",2],["Sirocco","Obsidian",3],["Obsidian","Umber",3],["Umber","Zephyr",2],["Zephyr","Nacre",3],["Vesper","Quasar",1]],"fuel":20,"goal":"Nacre","kind":"graph","nodes":["Quasar","Vesper","Sirocco","Obsidian","Umber","Zephyr","Nacre"],"plan":["Vesper","Sirocco","Obsidian","Umber","Zephyr","Nacre"],"start":"Quasar"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","valid_detour","graph","matched_goal_outcome","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0008","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":4,"node":"Nacre"},"reaches_goal":true,"shortest_plan":["Vesper","Sirocco","Obsidian","Umber","Zephyr","Nacre"],"steps":[{"after":{"fuel":17,"node":"Vesper"},"legal":true},{"after":{"fuel":15,"node":"Sirocco"},"legal":true},{"after":{"fuel":12,"node":"Obsidian"},"legal":true},{"after":{"fuel":9,"node":"Umber"},"legal":true},{"after":{"fuel":7,"node":"Zephyr"},"legal":true},{"after":{"fuel":4,"node":"Nacre"},"legal":true}],"valid":true}}
{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.2.0","oracle_version":"independent-1.0.0","record_hash":"010de94fc7437ff4e3f5cddbd6ab10cdbce526791263e7da5ec0c0e3cce1657d","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"ruby\":\"TABLE\",\"quartz\":\"ruby\",\"pearl\":\"quartz\",\"sapphire\":\"pearl\",\"onyx\":\"sapphire\"},\"goal_on\":{\"ruby\":\"onyx\"},\"plan\":[{\"block\":\"onyx\",\"to\":\"TABLE\"},{\"block\":\"onyx\",\"to\":\"TABLE\"},{\"block\":\"sapphire\",\"to\":\"TABLE\"},{\"block\":\"pearl\",\"to\":\"TABLE\"},{\"block\":\"quartz\",\"to\":\"TABLE\"},{\"block\":\"ruby\",\"to\":\"onyx\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-pilot-v3-p0009-base-forward-9772b20244be","adv-pilot-v3-652f8fcaadc210a08c84","adj-pilot-v3-f0b3321e23a5156f0ec8"],"review_status":"ACCEPTED","reviewed_candidate_hash":"9772b20244beda7a742fc3ed68dd5babf2ee0889a170882f9a8929dbbc14227a","sample_id":"RGM-001-pilot-v3-p0009-base-forward","semantic_family_id":"RGM-001-pilot-v3-p0009","semantic_parent_id":"RGM-001-pilot-v3-p0009","semantic_task":{"goal_on":{"ruby":"onyx"},"kind":"blocks","on":{"onyx":"sapphire","pearl":"quartz","quartz":"ruby","ruby":"TABLE","sapphire":"pearl"},"plan":[{"block":"onyx","to":"TABLE"},{"block":"onyx","to":"TABLE"},{"block":"sapphire","to":"TABLE"},{"block":"pearl","to":"TABLE"},{"block":"quartz","to":"TABLE"},{"block":"ruby","to":"onyx"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","clear_partial_goal","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0009","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"onyx":"TABLE","pearl":"quartz","quartz":"ruby","ruby":"TABLE","sapphire":"pearl"},"reaches_goal":false,"shortest_plan":[{"block":"onyx","to":"TABLE"},{"block":"sapphire","to":"TABLE"},{"block":"pearl","to":"TABLE"},{"block":"quartz","to":"TABLE"},{"block":"ruby","to":"onyx"}],"steps":[{"after":{"onyx":"TABLE","pearl":"quartz","quartz":"ruby","ruby":"TABLE","sapphire":"pearl"},"legal":true},{"after":{"onyx":"TABLE","pearl":"quartz","quartz":"ruby","ruby":"TABLE","sapphire":"pearl"},"legal":false}],"valid":false}}
