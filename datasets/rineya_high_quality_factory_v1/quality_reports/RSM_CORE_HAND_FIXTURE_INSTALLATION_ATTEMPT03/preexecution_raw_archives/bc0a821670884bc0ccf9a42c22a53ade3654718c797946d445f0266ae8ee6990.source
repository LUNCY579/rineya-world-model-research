t-v3-p0006-base-reverse-d639164a82c1","adv-pilot-v3-6a705be54ff2a097cdd7","adj-pilot-v3-409e4ee3f05c6105063b"],"review_status":"ACCEPTED","reviewed_candidate_hash":"d639164a82c1f56f17f54a54ac7c32744191bb799b9a9f9980b5a2baf59c6fb3","sample_id":"RGM-001-pilot-v3-p0006-base-reverse","semantic_family_id":"RGM-001-pilot-v3-p0006","semantic_parent_id":"RGM-001-pilot-v3-p0006","semantic_task":{"edges":[["Dune","Cedar",2],["Cedar","Ember",4]],"fuel":6,"goal":"Ember","kind":"graph","nodes":["Dune","Cedar","Ember"],"plan":["Dune","Cedar","Ember"],"start":"Dune"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","missing_edge_stop","graph","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0006","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":6,"node":"Dune"},"reaches_goal":false,"shortest_plan":["Cedar","Ember"],"steps":[{"after":{"fuel":6,"node":"Dune"},"legal":false}],"valid":false}}
{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.2.0","oracle_version":"independent-1.0.0","record_hash":"771a8741a56bcf9e20a84da83af6a4be46aa0494676580aa9d9240799fd69884","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"dahlia\":\"TABLE\",\"amber\":\"dahlia\",\"cobalt\":\"TABLE\"},\"goal_on\":{\"dahlia\":\"cobalt\"},\"plan\":[{\"block\":\"dahlia\",\"to\":\"cobalt\"},{\"block\":\"amber\",\"to\":\"TABLE\"},{\"block\":\"dahlia\",\"to\":\"cobalt\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-pilot-v3-p0007-base-forward-e8c47dd7560e","adv-pilot-v3-80cc2c478f17c44d11fe","adj-pilot-v3-35b92f1eb795f009d153"],"review_status":"ACCEPTED","reviewed_candidate_hash":"e8c47dd7560e69a4fa733c727ae7b51f2aa536698dfe9b2cf04a1c311bcf9119","sample_id":"RGM-001-pilot-v3-p0007-base-forward","semantic_family_id":"RGM-001-pilot-v3-p0007","semantic_parent_id":"RGM-001-pilot-v3-p0007","semantic_task":{"goal_on":{"dahlia":"cobalt"},"kind":"blocks","on":{"amber":"dahlia","cobalt":"TABLE","dahlia":"TABLE"},"plan":[{"block":"dahlia","to":"cobalt"},{"block":"amber","to":"TABLE"},{"block":"dahlia","to":"cobalt"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","blocked_source","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0007","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"dahlia","cobalt":"TABLE","dahlia":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"amber","to":"TABLE"},{"block":"dahlia","to":"cobalt"}],"steps":[{"after":{"amber":"dahlia","cobalt":"TABLE","dahlia":"TABLE"},"legal":false}],"valid":false}}
