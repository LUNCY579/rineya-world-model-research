er":"reverse","review_receipt_ids":["expert-RGM-001-pilot-v3-p0001-base-reverse-8a380c218f42","adv-pilot-v3-f3b74c821234fc8b4d82","adj-pilot-v3-bebcc2052baa8f3ab71c"],"review_status":"ACCEPTED","reviewed_candidate_hash":"8a380c218f42ca82485892c38802597b1c9b0ec8efb6e3ed7a2c5cf2c9e199b4","sample_id":"RGM-001-pilot-v3-p0001-base-reverse","semantic_family_id":"RGM-001-pilot-v3-p0001","semantic_parent_id":"RGM-001-pilot-v3-p0001","semantic_task":{"edges":[["Aster","Beryl",4],["Beryl","Ember",1],["Ember","Dune",1],["Aster","Dune",7]],"fuel":6,"goal":"Dune","kind":"graph","nodes":["Aster","Beryl","Ember","Dune"],"plan":["Dune","Beryl","Dune"],"start":"Aster"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","fuel_constrained_route","graph","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0001","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":6,"node":"Aster"},"reaches_goal":false,"shortest_plan":["Beryl","Ember","Dune"],"steps":[{"after":{"fuel":6,"node":"Aster"},"legal":false}],"valid":false}}
{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.2.0","oracle_version":"independent-1.0.0","record_hash":"e5929589b93fcaba47226c97f8dc6713ca8496b7dc139538a769bbb058e49e76","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"cobalt\":\"TABLE\",\"dahlia\":\"TABLE\",\"amber\":\"TABLE\"},\"goal_on\":{\"dahlia\":\"cobalt\",\"amber\":\"dahlia\"},\"plan\":[{\"block\":\"dahlia\",\"to\":\"cobalt\"},{\"block\":\"amber\",\"to\":\"dahlia\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-pilot-v3-p0002-base-forward-8dbad16822e3","adv-pilot-v3-3a235de15a3dd37bd8dc","adj-pilot-v3-9e2d662ce240c03b8a0b"],"review_status":"ACCEPTED","reviewed_candidate_hash":"8dbad16822e3cf690153dcf0c2236001290b6d7eb462d7b06f2a87989a845035","sample_id":"RGM-001-pilot-v3-p0002-base-forward","semantic_family_id":"RGM-001-pilot-v3-p0002","semantic_parent_id":"RGM-001-pilot-v3-p0002","semantic_task":{"goal_on":{"amber":"dahlia","dahlia":"cobalt"},"kind":"blocks","on":{"amber":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"plan":[{"block":"dahlia","to":"cobalt"},{"block":"amber","to":"dahlia"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","assemble_stack","blocks","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0002","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"dahlia","cobalt":"TABLE","dahlia":"cobalt"},"reaches_goal":true,"shortest_plan":[{"block":"dahlia","to":"cobalt"},{"block":"amber","to":"dahlia"}],"steps":[{"after":{"amber":"TABLE","cobalt":"TABLE","dahlia":"cobalt"},"legal":true},{"after":{"amber":"dahlia","cobalt":"TABLE","dahlia":"cobalt"},"legal":true}],"valid":true}}
