t_ids":["expert-RGM-001-expansion-v3-p0166-base-reverse-7cab125ea031","adv-tags-7af611c17dd8c8bbf6357f57","adj-expansion-v3-63107a6fe35aab1d306e"],"review_status":"ACCEPTED","reviewed_candidate_hash":"7cab125ea031609a711fc0f71d1a61c316d72c0db843a9a75ebea81bf932b7eb","sample_id":"RGM-001-expansion-v3-p0166-base-reverse","semantic_family_id":"RGM-001-expansion-v3-p0166","semantic_parent_id":"RGM-001-expansion-v3-p0166","semantic_task":{"edges":[["Beryl","Ember",4],["Ember","Fjord",1],["Beryl","Fjord",6]],"fuel":5,"goal":"Fjord","kind":"graph","nodes":["Beryl","Ember","Fjord"],"plan":["Fjord","Ember","Fjord"],"start":"Beryl"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0166","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":5,"node":"Beryl"},"reaches_goal":false,"shortest_plan":["Ember","Fjord"],"steps":[{"after":{"fuel":5,"node":"Beryl"},"legal":false}],"valid":false}}
{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"a99d0de62387d7809b730cb14d133c8d0bac7ef79385e75b22c2cbe0bf48fbe5","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"dahlia\":\"TABLE\",\"cobalt\":\"dahlia\",\"birch\":\"TABLE\"},\"goal_on\":{\"cobalt\":\"TABLE\",\"dahlia\":\"TABLE\",\"birch\":\"dahlia\"},\"plan\":[{\"block\":\"cobalt\",\"to\":\"TABLE\"},{\"block\":\"birch\",\"to\":\"dahlia\"},{\"block\":\"birch\",\"to\":\"dahlia\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0167-base-forward-425e4903840a","adv-tags-5cc12bb7a965e5970dd4b435","adj-expansion-v3-ae49e79c748796e12646"],"review_status":"ACCEPTED","reviewed_candidate_hash":"425e4903840af9432799882999839361f63b753c1193f496e1c1ca483e36093d","sample_id":"RGM-001-expansion-v3-p0167-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0167","semantic_parent_id":"RGM-001-expansion-v3-p0167","semantic_task":{"goal_on":{"birch":"dahlia","cobalt":"TABLE","dahlia":"TABLE"},"kind":"blocks","on":{"birch":"TABLE","cobalt":"dahlia","dahlia":"TABLE"},"plan":[{"block":"cobalt","to":"TABLE"},{"block":"birch","to":"dahlia"},{"block":"birch","to":"dahlia"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0167","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"birch":"dahlia","cobalt":"TABLE","dahlia":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"cobalt","to":"TABLE"},{"block":"birch","to":"dahlia"}],"steps":[{"after":{"birch":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"legal":true},{"after":{"birch":"dahlia","cobalt":"TABLE","dahlia":"TABLE"},"legal":true},{"after":{"birch":"dahlia","cobalt":"TABLE","dahlia":"TABLE"},"legal":false}],"valid":false}}
