{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"91be90e4f85995e51b73b97d5a71edb3bebe73743ca1410c4ec3a3bd680f5346","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"amber\":\"TABLE\",\"dahlia\":\"amber\",\"birch\":\"TABLE\"},\"goal_on\":{\"dahlia\":\"TABLE\",\"birch\":\"dahlia\",\"amber\":\"TABLE\"},\"plan\":[{\"block\":\"dahlia\",\"to\":\"TABLE\"},{\"block\":\"birch\",\"to\":\"dahlia\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0052-base-forward-505ac06621fa","adv-tags-f1bac4ae3098d680709ed1e8","adj-expansion-v3-9976fc5c3a7349014f00"],"review_status":"ACCEPTED","reviewed_candidate_hash":"505ac06621fac366a591f96818409f03138b1d276c329fd8e4d595ebe239dea6","sample_id":"RGM-001-expansion-v3-p0052-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0052","semantic_parent_id":"RGM-001-expansion-v3-p0052","semantic_task":{"goal_on":{"amber":"TABLE","birch":"dahlia","dahlia":"TABLE"},"kind":"blocks","on":{"amber":"TABLE","birch":"TABLE","dahlia":"amber"},"plan":[{"block":"dahlia","to":"TABLE"},{"block":"birch","to":"dahlia"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0052","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"TABLE","birch":"dahlia","dahlia":"TABLE"},"reaches_goal":true,"shortest_plan":[{"block":"dahlia","to":"TABLE"},{"block":"birch","to":"dahlia"}],"steps":[{"after":{"amber":"TABLE","birch":"TABLE","dahlia":"TABLE"},"legal":true},{"after":{"amber":"TABLE","birch":"dahlia","dahlia":"TABLE"},"legal":true}],"valid":true}}
