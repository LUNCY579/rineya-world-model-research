Quasar\",2],[\"Sirocco\",\"Zephyr\",3],[\"Nacre\",\"Vesper\",3],[\"Nacre\",\"Umber\",4]],\"nodes\":[\"Vesper\",\"Tundra\",\"Sirocco\",\"Umber\",\"Nacre\",\"Zephyr\",\"Quasar\"],\"kind\":\"graph\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0148-base-reverse-2be4cf581f47","adv-tags-473e4f4786b2ff9586859d67","adj-expansion-v3-0d3d6a0f88146efdb754"],"review_status":"ACCEPTED","reviewed_candidate_hash":"2be4cf581f47821f5880d12b7205ef39159b5e29e281626851198ad56fb9c9a0","sample_id":"RGM-001-expansion-v3-p0148-base-reverse","semantic_family_id":"RGM-001-expansion-v3-p0148","semantic_parent_id":"RGM-001-expansion-v3-p0148","semantic_task":{"edges":[["Vesper","Tundra",2],["Tundra","Sirocco",2],["Sirocco","Umber",3],["Umber","Nacre",2],["Nacre","Zephyr",3],["Zephyr","Quasar",2],["Sirocco","Zephyr",3],["Nacre","Vesper",3],["Nacre","Umber",4]],"fuel":14,"goal":"Quasar","kind":"graph","nodes":["Vesper","Tundra","Sirocco","Umber","Nacre","Zephyr","Quasar"],"plan":["Tundra"],"start":"Vesper"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0148","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":12,"node":"Tundra"},"reaches_goal":false,"shortest_plan":["Tundra","Sirocco","Zephyr","Quasar"],"steps":[{"after":{"fuel":12,"node":"Tundra"},"legal":true}],"valid":true}}
