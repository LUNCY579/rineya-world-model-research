{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"08a4a50ee7678b4e3d6ac6e6b879dd18e76b4d670df71901d78598868c409dce","rendered_input":"Graph contract: kind=graph. nodes contains distinct strings. edges contains [from,to,cost] triples with positive integer fuel costs and at most one edge per ordered pair. start and goal are nodes; fuel is a nonnegative integer. plan is an ordered list of destination node names. Every edge is directed. Start at {node:start,fuel:fuel}. An action is legal exactly when an edge from the current node to its destination exists and its cost is at most the remaining fuel. A legal move changes node to its destination and subtracts the edge cost. At the first illegal action, include that action's {legal:false,after:unchanged_state} step, stop immediately, and do not evaluate subsequent actions. An empty plan is valid. valid means every proposed action was legal. reaches_goal is true exactly when the whole plan is valid and its terminal node is goal, including an initially satisfied goal with an empty plan. shortest_plan is a fresh plan from the INITIAL state that reaches goal within initial fuel, minimizes the number of moves, and breaks ties by the lexicographic order of the entire destination-name sequence. It is [] for an initially satisfied goal and null if no feasible plan exists. Fuel cost is a feasibility constraint, not the optimization objective. Return exactly a JSON object with steps:[{legal:boolean,after:{node:string,fuel:integer}}], after:{node:string,fuel:integer}, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"graph\",\"nodes\":[\"Dune\",\"Fjord\",\"Ember\"],\"edges\":[[\"Dune\",\"Fjord\",4],[\"Fjord\",\"Ember\",2],[\"Fjord\",\"Dune\",1],[\"Dune\",\"Ember\",4]],\"start\":\"Dune\",\"goal\":\"Ember\",\"fuel\":6,\"plan\":[\"Fjord\",\"Dune\",\"Fjord\",\"Dune\",\"Fjord\",\"Dune\",\"Fjord\",\"Dune\",\"Fjord\",\"Dune\",\"Fjord\",\"Dune\",\"Fjord\",\"Dune\",\"Ember\"]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0080-base-forward-4c8f381a9c98","adv-tags-0dbb4eee04cbe00555777b3a","adj-expansion-v3-70c79108e2c8447f1c8b"],"review_status":"ACCEPTED","reviewed_candidate_hash":"4c8f381a9c9809fe1e20c51a17f3e4dedda40353cbcb5eed044a9eab07fb1e5d","sample_id":"RGM-001-expansion-v3-p0080-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0080","semantic_parent_id":"RGM-001-expansion-v3-p0080","semantic_task":{"edges":[["Dune","Fjord",4],["Fjord","Ember",2],["Fjord","Dune",1],["Dune","Ember",4]],"fuel":6,"goal":"Ember","kind":"graph","nodes":["Dune","Fjord","Ember"],"plan":["Fjord","Dune","Fjord","Dune","Fjord","Dune","Fjord","Dune","Fjord","Dune","Fjord","Dune","Fjord","Dune","Ember"],"start":"Dune"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0080","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":1,"node":"Dune"},"reaches_goal":false,"shortest_plan":["Ember"],"steps":[{"after":{"fuel":2,"node":"Fjord"},"legal":true},{"after":{"fuel":1,"node":"Dune"},"legal":true},{"after":{"fuel":1,"node":"Dune"},"legal":false}],"valid":false}}
