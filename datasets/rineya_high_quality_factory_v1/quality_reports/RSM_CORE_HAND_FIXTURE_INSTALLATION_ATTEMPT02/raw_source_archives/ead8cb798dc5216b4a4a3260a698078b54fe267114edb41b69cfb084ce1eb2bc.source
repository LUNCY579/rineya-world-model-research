{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"b163100a256200c8d0d8eed501ac58aedaaa80bc1e6f7cb4ef15bb526267b491","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"ruby\":\"TABLE\",\"sapphire\":\"ruby\",\"quartz\":\"TABLE\",\"onyx\":\"TABLE\",\"pearl\":\"onyx\"},\"goal_on\":{\"quartz\":\"sapphire\",\"onyx\":\"ruby\",\"pearl\":\"quartz\",\"sapphire\":\"TABLE\"},\"plan\":[{\"block\":\"sapphire\",\"to\":\"TABLE\"},{\"block\":\"quartz\",\"to\":\"sapphire\"},{\"block\":\"pearl\",\"to\":\"quartz\"},{\"block\":\"onyx\",\"to\":\"ruby\"},{\"block\":\"onyx\",\"to\":\"ruby\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0159-base-forward-32c84e455f51","adv-tags-40af3dd2969bae65fb9bccfc","adj-expansion-v3-15f8753b63a6a5a9142a"],"review_status":"ACCEPTED","reviewed_candidate_hash":"32c84e455f51fea44a7c9fd32801a1d0cafdae08f76f49a7a2a1579ba7e4d790","sample_id":"RGM-001-expansion-v3-p0159-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0159","semantic_parent_id":"RGM-001-expansion-v3-p0159","semantic_task":{"goal_on":{"onyx":"ruby","pearl":"quartz","quartz":"sapphire","sapphire":"TABLE"},"kind":"blocks","on":{"onyx":"TABLE","pearl":"onyx","quartz":"TABLE","ruby":"TABLE","sapphire":"ruby"},"plan":[{"block":"sapphire","to":"TABLE"},{"block":"quartz","to":"sapphire"},{"block":"pearl","to":"quartz"},{"block":"onyx","to":"ruby"},{"block":"onyx","to":"ruby"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0159","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"onyx":"ruby","pearl":"quartz","quartz":"sapphire","ruby":"TABLE","sapphire":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"sapphire","to":"TABLE"},{"block":"quartz","to":"sapphire"},{"block":"pearl","to":"quartz"},{"block":"onyx","to":"ruby"}],"steps":[{"after":{"onyx":"TABLE","pearl":"onyx","quartz":"TABLE","ruby":"TABLE","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"TABLE","pearl":"onyx","quartz":"sapphire","ruby":"TABLE","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"TABLE","pearl":"quartz","quartz":"sapphire","ruby":"TABLE","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"ruby","pearl":"quartz","quartz":"sapphire","ruby":"TABLE","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"ruby","pearl":"quartz","quartz":"sapphire","ruby":"TABLE","sapphire":"TABLE"},"legal":false}],"valid":false}}
