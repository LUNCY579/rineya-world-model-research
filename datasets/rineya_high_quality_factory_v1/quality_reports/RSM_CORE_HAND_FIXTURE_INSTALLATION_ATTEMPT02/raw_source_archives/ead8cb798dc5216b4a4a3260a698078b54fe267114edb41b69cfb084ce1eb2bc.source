{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"d62e74629360afa273393795abd4049229c501ef9912d89d8bb945b9f9bde25d","rendered_input":"Graph contract: kind=graph. nodes contains distinct strings. edges contains [from,to,cost] triples with positive integer fuel costs and at most one edge per ordered pair. start and goal are nodes; fuel is a nonnegative integer. plan is an ordered list of destination node names. Every edge is directed. Start at {node:start,fuel:fuel}. An action is legal exactly when an edge from the current node to its destination exists and its cost is at most the remaining fuel. A legal move changes node to its destination and subtracts the edge cost. At the first illegal action, include that action's {legal:false,after:unchanged_state} step, stop immediately, and do not evaluate subsequent actions. An empty plan is valid. valid means every proposed action was legal. reaches_goal is true exactly when the whole plan is valid and its terminal node is goal, including an initially satisfied goal with an empty plan. shortest_plan is a fresh plan from the INITIAL state that reaches goal within initial fuel, minimizes the number of moves, and breaks ties by the lexicographic order of the entire destination-name sequence. It is [] for an initially satisfied goal and null if no feasible plan exists. Fuel cost is a feasibility constraint, not the optimization objective. Return exactly a JSON object with steps:[{legal:boolean,after:{node:string,fuel:integer}}], after:{node:string,fuel:integer}, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"plan\":[\"Obsidian\",\"Nacre\",\"Sirocco\"],\"fuel\":19,\"goal\":\"Sirocco\",\"start\":\"Vesper\",\"edges\":[[\"Vesper\",\"Obsidian\",4],[\"Obsidian\",\"Tundra\",1],[\"Tundra\",\"Umber\",4],[\"Umber\",\"Zephyr\",1],[\"Zephyr\",\"Quasar\",1],[\"Quasar\",\"Nacre\",1],[\"Nacre\",\"Sirocco\",3],[\"Obsidian\",\"Vesper\",1],[\"Obsidian\",\"Nacre\",5],[\"Tundra\",\"Vesper\",4],[\"Zephyr\",\"Tundra\",4],[\"Zephyr\",\"Umber\",3],[\"Quasar\",\"Umber\",1],[\"Sirocco\",\"Nacre\",5]],\"nodes\":[\"Vesper\",\"Obsidian\",\"Tundra\",\"Umber\",\"Zephyr\",\"Quasar\",\"Nacre\",\"Sirocco\"],\"kind\":\"graph\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0038-matched-reverse-e8b5b5186169","adv-tags-9e3781bf0d9ff71adc14454a","adj-expansion-v3-4177b217100b8f3ded91"],"review_status":"ACCEPTED","reviewed_candidate_hash":"e8b5b5186169f83e527443717014079e3bae9f94d9227a11ef6485dc6d353208","sample_id":"RGM-001-expansion-v3-p0038-matched-reverse","semantic_family_id":"RGM-001-expansion-v3-p0038","semantic_parent_id":"RGM-001-expansion-v3-p0038","semantic_task":{"edges":[["Vesper","Obsidian",4],["Obsidian","Tundra",1],["Tundra","Umber",4],["Umber","Zephyr",1],["Zephyr","Quasar",1],["Quasar","Nacre",1],["Nacre","Sirocco",3],["Obsidian","Vesper",1],["Obsidian","Nacre",5],["Tundra","Vesper",4],["Zephyr","Tundra",4],["Zephyr","Umber",3],["Quasar","Umber",1],["Sirocco","Nacre",5]],"fuel":19,"goal":"Sirocco","kind":"graph","nodes":["Vesper","Obsidian","Tundra","Umber","Zephyr","Quasar","Nacre","Sirocco"],"plan":["Obsidian","Nacre","Sirocco"],"start":"Vesper"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","matched_goal_outcome","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0038","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":7,"node":"Sirocco"},"reaches_goal":true,"shortest_plan":["Obsidian","Nacre","Sirocco"],"steps":[{"after":{"fuel":15,"node":"Obsidian"},"legal":true},{"after":{"fuel":10,"node":"Nacre"},"legal":true},{"after":{"fuel":7,"node":"Sirocco"},"legal":true}],"valid":true}}
{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"e33a04b0bb5c56ae9451ae7ace075e3877cf41327cf54136b5d72281f532fdfa","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"onyx\":\"TABLE\",\"sapphire\":\"onyx\",\"pearl\":\"sapphire\",\"ruby\":\"pearl\",\"quartz\":\"TABLE\"},\"goal_on\":{\"sapphire\":\"TABLE\",\"pearl\":\"TABLE\",\"quartz\":\"ruby\",\"ruby\":\"TABLE\"},\"plan\":[{\"block\":\"ruby\",\"to\":\"TABLE\"},{\"block\":\"pearl\",\"to\":\"TABLE\"},{\"block\":\"quartz\",\"to\":\"ruby\"},{\"block\":\"sapphire\",\"to\":\"TABLE\"},{\"block\":\"onyx\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0039-base-forward-5fd947e534b0","adv-tags-2fef9b0d56260d8906fee051","adj-expansion-v3-5624cd19efdbaa675536"],"review_status":"ACCEPTED","reviewed_candidate_hash":"5fd947e534b072300e3e90a0693bac08df9fb0cd0bfc89ff9cd1d984ec7cca2d","sample_id":"RGM-001-expansion-v3-p0039-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0039","semantic_parent_id":"RGM-001-expansion-v3-p0039","semantic_task":{"goal_on":{"pearl":"TABLE","quartz":"ruby","ruby":"TABLE","sapphire":"TABLE"},"kind":"blocks","on":{"onyx":"TABLE","pearl":"sapphire","quartz":"TABLE","ruby":"pearl","sapphire":"onyx"},"plan":[{"block":"ruby","to":"TABLE"},{"block":"pearl","to":"TABLE"},{"block":"quartz","to":"ruby"},{"block":"sapphire","to":"TABLE"},{"block":"onyx","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0039","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"ruby","ruby":"TABLE","sapphire":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"ruby","to":"TABLE"},{"block":"pearl","to":"TABLE"},{"block":"quartz","to":"ruby"},{"block":"sapphire","to":"TABLE"}],"steps":[{"after":{"onyx":"TABLE","pearl":"sapphire","quartz":"TABLE","ruby":"TABLE","sapphire":"onyx"},"legal":true},{"after":{"onyx":"TABLE","pearl":"TABLE","quartz"