{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"541ebdb8453d215503db4c5aaebb21155a833f56dd726949b29a9d4cfaf47f4b","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"cobalt\":\"TABLE\",\"birch\":\"cobalt\",\"dahlia\":\"birch\"},\"goal_on\":{\"birch\":\"TABLE\",\"cobalt\":\"birch\",\"dahlia\":\"cobalt\"},\"plan\":[{\"block\":\"birch\",\"to\":\"cobalt\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0122-base-forward-b85dd714a9d3","adv-tags-b9028697625b810d455dd64e","adj-expansion-v3-9eac4b09f9618a2c618f"],"review_status":"ACCEPTED","reviewed_candidate_hash":"b85dd714a9d37e7e34bf2221bdf80f092e35c67d8d0cd549312ff6ff64885b89","sample_id":"RGM-001-expansion-v3-p0122-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0122","semantic_parent_id":"RGM-001-expansion-v3-p0122","semantic_task":{"goal_on":{"birch":"TABLE","cobalt":"birch","dahlia":"cobalt"},"kind":"blocks","on":{"birch":"cobalt","cobalt":"TABLE","dahlia":"birch"},"plan":[{"block":"birch","to":"cobalt"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","block_goal_composition","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0122","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"birch":"cobalt","cobalt":"TABLE","dahlia":"birch"},"reaches_goal":false,"shortest_plan":[{"block":"dahlia","to":"TABLE"},{"block":"birch","to":"TABLE"},{"block":"cobalt","to":"birch"},{"block":"dahlia","to":"cobalt"}],"steps":[{"after":{"birch":"cobalt","cobalt":"TABLE","dahlia":"birch"},"legal":false}],"valid":false}}
