ar\",\"Ember\",3],[\"Beryl\",\"Dune\",4],[\"Aster\",\"Beryl\",4]],\"start\":\"Beryl\",\"goal\":\"Ember\",\"fuel\":16,\"plan\":[\"Cedar\",\"Ember\"]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0165-base-forward-9c81b7ee7038","adv-tags-b6a88d2d3516795d5373555d","adj-expansion-v3-c483e51552e3c127a3e5"],"review_status":"ACCEPTED","reviewed_candidate_hash":"9c81b7ee70389444c13cba70a1d5ed260a38a9f95c64582824c6ec6bcfba4de9","sample_id":"RGM-001-expansion-v3-p0165-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0165","semantic_parent_id":"RGM-001-expansion-v3-p0165","semantic_task":{"edges":[["Beryl","Aster",2],["Aster","Cedar",1],["Cedar","Dune",1],["Dune","Fjord",3],["Fjord","Ember",2],["Aster","Ember",2],["Beryl","Cedar",1],["Cedar","Ember",3],["Beryl","Dune",4],["Aster","Beryl",4]],"fuel":16,"goal":"Ember","kind":"graph","nodes":["Beryl","Aster","Cedar","Dune","Fjord","Ember"],"plan":["Cedar","Ember"],"start":"Beryl"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0165","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":12,"node":"Ember"},"reaches_goal":true,"shortest_plan":["Aster","Ember"],"steps":[{"after":{"fuel":15,"node":"Cedar"},"legal":true},{"after":{"fuel":12,"node":"Ember"},"legal":true}],"valid":true}}
