{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"0df61a7be877c3f7e74a04de7c4c2668a343aec389e629729eea4a0196fb22e0","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"plan\":[{\"to\":\"pearl\",\"block\":\"ruby\"},{\"to\":\"ruby\",\"block\":\"quartz\"},{\"to\":\"quartz\",\"block\":\"sapphire\"}],\"goal_on\":{\"onyx\":\"TABLE\",\"sapphire\":\"quartz\",\"quartz\":\"ruby\",\"ruby\":\"pearl\",\"pearl\":\"TABLE\"},\"on\":{\"sapphire\":\"TABLE\",\"pearl\":\"TABLE\",\"ruby\":\"TABLE\",\"quartz\":\"TABLE\",\"onyx\":\"TABLE\"},\"kind\":\"blocks\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0149-matched-reverse-a0f9ab319a32","adv-tags-7fa817665295f3201588f4b2","adj-expansion-v3-770d3420eaba82c6ce8c"],"review_status":"ACCEPTED","reviewed_candidate_hash":"a0f9ab319a3210494559dec4d624f2b6fb2d0e6095477f88b025077a99a153df","sample_id":"RGM-001-expansion-v3-p0149-matched-reverse","semantic_family_id":"RGM-001-expansion-v3-p0149","semantic_parent_id":"RGM-001-expansion-v3-p0149","semantic_task":{"goal_on":{"onyx":"TABLE","pearl":"TABLE","quartz":"ruby","ruby":"pearl","sapphire":"quartz"},"kind":"blocks","on":{"onyx":"TABLE","pearl":"TABLE","quartz":"TABLE","ruby":"TABLE","sapphire":"TABLE"},"plan":[{"block":"ruby","to":"pearl"},{"block":"quartz","to":"ruby"},{"block":"sapphire","to":"quartz"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","matched_goal_outcome","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0149","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"ruby","ruby":"pearl","sapphire":"quartz"},"reaches_goal":true,"shortest_plan":[{"block":"ruby","to":"pearl"},{"block":"quartz","to":"ruby"},{"block":"sapphire","to":"quartz"}],"steps":[{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"TABLE","ruby":"pearl","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"ruby","ruby":"pearl","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"ruby","ruby":"pearl","sapphire":"quartz"},"legal":true}],"valid":true}}
{"challenge_axes":[],"difficulty":3,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"63870fb867ac41b21d513d006e27fa4da2a879f7915bed1d50ac507f40e41a88","rendered_input":"Graph contract: kind=graph. nodes contains distinct strings. edges contains [from,to,cost] triples with positive integer fuel costs and at most one edge per ordered pair. start and goal are nodes; fuel is a nonnegative integer. plan is an ordered list of destination node names. Every edge is directed. Start at {node:start,fuel:fuel}. An action is legal exactly when an edge from the current node to its destination exists and its cost is at most the remaining fuel. A legal move changes node to its destination and subtracts the edge cost. At the first illegal action, include that action's {legal:false,after:unchanged_state} step, stop immediately, and do not evaluate subsequent actions. An empty plan is valid. valid means every proposed action was legal. reaches_goal is true exactly when the whole plan is valid and its terminal node is goal, including an initially satisfied goal with an empty plan. shortest_plan is a fresh plan from the INITIAL state that reaches goal within initial fuel, minimizes the number of moves, and breaks ties by the lexicographic order of the entire destination-name sequence. It is [] for an initially satisfied goal and null if no feasible plan exists. Fuel cost is a feasibility constraint, not the optimization objective. Return exactly a JSON object with steps:[{legal:boolean,after:{node:string,fuel:integer}}], after:{node:string,fuel:integer}, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"graph\",\"nodes\":[\"Dune\",\"Ember\",\"Cedar\",\"Aster\",\"Fjord\"],\"edges\":[[\"Dune\",\"Ember\",2],[\"Ember\",\"Cedar\",2],[\"Cedar\",\"Aster\",3],[\"Aster\",\"Fjord\",3],[\"Ember\",\"Fjord\",2],[\"Dune\",\"Cedar\",1],[\"Cedar\",\"Fjord\",2],[\"Ember\",\"Aster\",1],[\"Cedar\",\"Dune\",2],[\"Cedar\",\"Ember\",6],[\"Aster\",\"Dune\",1],[\"Fjord\",\"Aster\",2]],\"start\":\"Dune\",\"goal\":\"Fjord\",\"fuel\":19,\"plan\":[\"Ember\",\"Fjord\"]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0150-base-forward-1de319ade031","adv-tags-4e7c51199c7b69f366d602a2","adj-expansion-v3-40e15a2ef646905caf6d"],"review_status":"ACCEPTED","reviewed_candidate_hash":"1de319ade031907f08edc3e9fc1c0caec2377748f1fb955ff094320b5d3bae5c","sample_id":"RGM-001-expansion-v3-p0150-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0150","semantic_parent_id":"RGM-001-expansion-v3-p0150","semantic_task":{"edges":[["Dune","Ember",2],["Ember","Cedar",2],["Cedar","Aster",3],["Aster","Fjord",3],["Ember","Fjord",2],["Dune","Cedar",1],["Cedar","Fjord",2],["Ember","Aster",1],["Cedar","Dune",2],["Cedar","Ember",6],["Aster","Dune",1],["Fjord","Aster",2]],"fuel":19,"goal":"Fjord","kind":"graph","nodes":["Dune","Ember","Cedar","Aster","Fjord"],"plan":["Ember","Fjord"],"start":"Dune"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0150","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":15,"node":"Fjord"},"reaches_goal":true,"shortest_plan":["Cedar","Fjord"],"steps":[{"after":{"fuel":17,"node":"Ember"},"legal":true},{"after":{"fuel":15,"node":"Fjord"},"legal":true}],"valid":true}}
