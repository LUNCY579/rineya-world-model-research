r\"],\"kind\":\"graph\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0156-base-reverse-378bb3ca8577","adv-tags-e47df8cfcc5e46a4b45dec1c","adj-expansion-v3-2113056b428578f2ff4e"],"review_status":"ACCEPTED","reviewed_candidate_hash":"378bb3ca85779b9ab9680512267b8ee90f7158ff4d867a4b7d835811fe87dc1b","sample_id":"RGM-001-expansion-v3-p0156-base-reverse","semantic_family_id":"RGM-001-expansion-v3-p0156","semantic_parent_id":"RGM-001-expansion-v3-p0156","semantic_task":{"edges":[["Fjord","Dune",4],["Dune","Aster",4],["Aster","Cedar",4],["Cedar","Ember",3]],"fuel":15,"goal":"Ember","kind":"graph","nodes":["Fjord","Dune","Aster","Cedar","Ember"],"plan":["Fjord","Dune","Aster","Cedar","Ember"],"start":"Fjord"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","single_successor_resource_graph","graph","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0156","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":15,"node":"Fjord"},"reaches_goal":false,"shortest_plan":["Dune","Aster","Cedar","Ember"],"steps":[{"after":{"fuel":15,"node":"Fjord"},"legal":false}],"valid":false}}
{"challenge_axes":[],"difficulty":2,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"0834b9d598be56424002addf19869c47a60374a335a9d36a439c71de10466257","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"cobalt\":\"TABLE\",\"amber\":\"TABLE\",\"birch\":\"amber\"},\"goal_on\":{\"amber\":\"TABLE\",\"birch\":\"TABLE\",\"cobalt\":\"birch\"},\"plan\":[{\"block\":\"birch\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0157-base-forward-4528f4f57fc3","adv-tags-9eaa0e083c6034ac276c6332","adj-expansion-v3-f548543612ae1de96d42"],"review_status":"ACCEPTED","reviewed_candidate_hash":"4528f4f57fc3f4c5f0a6496868b45690bf8cab5a4e184a07a7e4bac36414b05e","sample_id":"RGM-001-expansion-v3-p0157-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0157","semantic_parent_id":"RGM-001-expansion-v3-p0157","semantic_task":{"goal_on":{"amber":"TABLE","birch":"TABLE","cobalt":"birch"},"kind":"blocks","on":{"amber":"TABLE","birch":"amber","cobalt":"TABLE"},"plan":[{"block":"birch","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0157","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":2,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"TABLE","birch":"TABLE","cobalt":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"birch","to":"TABLE"},{"block":"cobalt","to":"birch"}],"steps":[{"after":{"amber":"TABLE","birch":"TABLE","cobalt":"TABLE"},"legal":true}],"valid":true}}
