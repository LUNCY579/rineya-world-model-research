":"TABLE","ruby":"TABLE","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"TABLE","ruby":"TABLE","sapphire":"ruby"},"legal":true},{"after":{"onyx":"sapphire","pearl":"TABLE","quartz":"TABLE","ruby":"TABLE","sapphire":"ruby"},"legal":true},{"after":{"onyx":"sapphire","pearl":"TABLE","quartz":"onyx","ruby":"TABLE","sapphire":"ruby"},"legal":true},{"after":{"onyx":"sapphire","pearl":"quartz","quartz":"onyx","ruby":"TABLE","sapphire":"ruby"},"legal":true}],"valid":true}}
{"challenge_axes":[],"difficulty":3,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"1b110fdc9b52fd4ca857890e68b039fb72fc532d359a1631384812efbdba1672","rendered_input":"Graph contract: kind=graph. nodes contains distinct strings. edges contains [from,to,cost] triples with positive integer fuel costs and at most one edge per ordered pair. start and goal are nodes; fuel is a nonnegative integer. plan is an ordered list of destination node names. Every edge is directed. Start at {node:start,fuel:fuel}. An action is legal exactly when an edge from the current node to its destination exists and its cost is at most the remaining fuel. A legal move changes node to its destination and subtracts the edge cost. At the first illegal action, include that action's {legal:false,after:unchanged_state} step, stop immediately, and do not evaluate subsequent actions. An empty plan is valid. valid means every proposed action was legal. reaches_goal is true exactly when the whole plan is valid and its terminal node is goal, including an initially satisfied goal with an empty plan. shortest_plan is a fresh plan from the INITIAL state that reaches goal within initial fuel, minimizes the number of moves, and breaks ties by the lexicographic order of the entire destination-name sequence. It is [] for an initially satisfied goal and null if no feasible plan exists. Fuel cost is a feasibility constraint, not the optimization objective. Return exactly a JSON object with steps:[{legal:boolean,after:{node:string,fuel:integer}}], after:{node:string,fuel:integer}, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"graph\",\"nodes\":[\"Beryl\",\"Fjord\",\"Cedar\",\"Aster\",\"Ember\"],\"edges\":[[\"Beryl\",\"Fjord\",3],[\"Fjord\",\"Cedar\",4],[\"Cedar\",\"Aster\",2],[\"Aster\",\"Ember\",1],[\"Fjord\",\"Ember\",1],[\"Beryl\",\"Cedar\",3],[\"Cedar\",\"Ember\",3],[\"Aster\",\"Beryl\",3]],\"start\":\"Beryl\",\"goal\":\"Ember\",\"fuel\":17,\"plan\":[\"Fjord\",\"Ember\"]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0090-base-forward-f02857a47060","adv-tags-a1e4eb14fe463fabaae453bc","adj-expansion-v3-5ce33b90e4764d626a02"],"review_status":"ACCEPTED","reviewed_candidate_hash":"f02857a4706094d42f83a7cf7cb22be0f2ae8645de007f2bebd73a724e5cb18c","sample_id":"RGM-001-expansion-v3-p0090-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0090","semantic_parent_id":"RGM-001-expansion-v3-p0090","semantic_task":{"edges":[["Beryl","Fjord",3],["Fjord","Cedar",4],["Cedar","Aster",2],["Aster","Ember",1],["Fjord","Ember",1],["Beryl","Cedar",3],["Cedar","Ember",3],["Aster","Beryl",3]],"fuel":17,"goal":"Ember","kind":"graph","nodes":["Beryl","Fjord","Cedar","Aster","Ember"],"plan":["Fjord","Ember"],"start":"Beryl"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0090","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":13,"node":"Ember"},"reaches_goal":true,"shortest_plan":["Cedar","Ember"],"steps":[{"after":{"fuel":14,"node":"Fjord"},"legal":true},{"after":{"fuel":13,"node":"Ember"},"legal":true}],"valid":true}}
{"challenge_axes":[],"difficulty":3,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"8041b135203de5aef1aabc0e9ab210b5fe3327554ec773fdfabf85c31e6794d2","rendered_input":"Graph contract: kind=graph. nodes contains distinct strings. edges contains [from,to,cost] triples with positive integer fuel costs and at most one edge per ordered pair. start and goal are nodes; fuel is a nonnegative integer. plan is an ordered list of destination node names. Every edge is directed. Start at {node:start,fuel:fuel}. An action is legal exactly when an edge from the current node to its destination exists and its cost is at most the remaining fuel. A legal move changes node to its destination and subtracts the edge cost. At the first illegal action, include that action's {legal:false,after:unchanged_state} step, stop immediately, and do not evaluate subsequent actions. An empty plan is valid. valid means every proposed action was legal. reaches_goal is true exactly when the whole plan is valid and its terminal node is goal, including an initially satisfied goal with an empty plan. shortest_plan is a fresh plan from the INITIAL state that reaches goal within initial fuel, minimizes the number of moves, and breaks ties by the lexicographic order of the entire destination-name sequence. It is [] for an initially satisfied goal and null if no feasible plan exists. Fuel cost is a feasibility constraint, not the optimization objective. Return exactly a JSON object with steps:[{legal:boolean,after:{node:string,fuel:integer}}], after:{node:string,fuel:integer}, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"plan\":[\"Fjord\",\"Ember\"],\"fuel\":17,\"goal\":\"Ember\",\"start\":\"Beryl\",\"edges\":[[\"Beryl\",\"Fjord\",3],[\"Fjord\",\"Cedar\",4],[\"Cedar\",\"Aster\",2],[\"Aster\",\"Ember\",1],[\"Fjord\",\"Ember\",1],[\"Beryl\",\"Cedar\",3],[\"Cedar\",\"Ember\",3],[\"Aster\",\