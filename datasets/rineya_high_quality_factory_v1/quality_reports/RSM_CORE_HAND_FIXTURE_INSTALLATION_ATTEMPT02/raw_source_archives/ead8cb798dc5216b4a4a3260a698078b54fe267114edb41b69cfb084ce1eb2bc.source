{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"2d867c662ea20a77c66167093a07bcc2dfc4deb815b015b21eb51cb39ad85e12","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"sapphire\":\"TABLE\",\"pearl\":\"TABLE\",\"quartz\":\"TABLE\",\"onyx\":\"quartz\",\"ruby\":\"onyx\"},\"goal_on\":{\"quartz\":\"TABLE\",\"ruby\":\"TABLE\",\"pearl\":\"ruby\",\"onyx\":\"pearl\",\"sapphire\":\"onyx\"},\"plan\":[{\"block\":\"ruby\",\"to\":\"TABLE\"},{\"block\":\"pearl\",\"to\":\"ruby\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0169-base-forward-e12efe72456c","adv-tags-196a1170f9c6bf24bc5553eb","adj-expansion-v3-f3c4bdda7c01639b2ede"],"review_status":"ACCEPTED","reviewed_candidate_hash":"e12efe72456c544cf66ade029da21f64073b5e9d41c6c3cbc96dc2b27066d525","sample_id":"RGM-001-expansion-v3-p0169-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0169","semantic_parent_id":"RGM-001-expansion-v3-p0169","semantic_task":{"goal_on":{"onyx":"pearl","pearl":"ruby","quartz":"TABLE","ruby":"TABLE","sapphire":"onyx"},"kind":"blocks","on":{"onyx":"quartz","pearl":"TABLE","quartz":"TABLE","ruby":"onyx","sapphire":"TABLE"},"plan":[{"block":"ruby","to":"TABLE"},{"block":"pearl","to":"ruby"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0169","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"onyx":"quartz","pearl":"ruby","quartz":"TABLE","ruby":"TABLE","sapphire":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"ruby","to":"TABLE"},{"block":"pearl","to":"ruby"},{"block":"onyx","to":"pearl"},{"block":"sapphire","to":"onyx"}],"steps":[{"after":{"onyx":"quartz","pearl":"TABLE","quartz":"TABLE","ruby":"TABLE","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"quartz","pearl":"ruby","quartz":"TABLE","ruby":"TABLE","sapphire":"TABLE"},"legal":true}],"valid":true}}
{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"2a7ca34f8e9890cef71f795de8af11cef0b6bb4d370f6a7ef7e16d2d39f6441c","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"plan\":[{\"to\":\"TABLE\",\"block\":\"ruby\"},{\"to\":\"ruby\",\"block\":\"pearl\"}],\"goal_on\":{\"sapphire\":\"onyx\",\"onyx\"