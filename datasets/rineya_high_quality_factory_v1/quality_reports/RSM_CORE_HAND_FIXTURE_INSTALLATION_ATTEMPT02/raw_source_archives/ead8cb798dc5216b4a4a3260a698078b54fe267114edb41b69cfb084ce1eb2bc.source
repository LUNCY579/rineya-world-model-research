{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"813cb54185cf9f01c31e0a73864871a078da66f45dc0b32a4683d2223aad7de9","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"birch\":\"TABLE\",\"dahlia\":\"birch\",\"amber\":\"dahlia\"},\"goal_on\":{\"amber\":\"dahlia\",\"dahlia\":\"TABLE\"},\"plan\":[{\"block\":\"amber\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0057-base-forward-537066eeaf31","adv-tags-0fb71473b7353c926c5eb130","adj-expansion-v3-adac0211b17e56053292"],"review_status":"ACCEPTED","reviewed_candidate_hash":"537066eeaf315ee5cdfb578780c035de794ffc74c69c0738a8dcbb67a24c4027","sample_id":"RGM-001-expansion-v3-p0057-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0057","semantic_parent_id":"RGM-001-expansion-v3-p0057","semantic_task":{"goal_on":{"amber":"dahlia","dahlia":"TABLE"},"kind":"blocks","on":{"amber":"dahlia","birch":"TABLE","dahlia":"birch"},"plan":[{"block":"amber","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","block_goal_composition","blocks","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0057","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"TABLE","birch":"TABLE","dahlia":"birch"},"reaches_goal":false,"shortest_plan":[{"block":"amber","to":"TABLE"},{"block":"dahlia","to":"TABLE"},{"block":"amber","to":"dahlia"}],"steps":[{"after":{"amber":"TABLE","birch":"TABLE","dahlia":"birch"},"legal":true}],"valid":true}}
