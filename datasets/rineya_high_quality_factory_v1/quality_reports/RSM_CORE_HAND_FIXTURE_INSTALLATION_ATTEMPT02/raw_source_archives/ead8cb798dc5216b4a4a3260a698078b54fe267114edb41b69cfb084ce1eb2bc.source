{"challenge_axes":[],"difficulty":2,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"3179df5a3f23b577e13b8e689359a7c5a42ef9577824d59ab90535713c29f30a","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"dahlia\":\"TABLE\",\"birch\":\"dahlia\",\"amber\":\"TABLE\"},\"goal_on\":{\"amber\":\"TABLE\",\"birch\":\"amber\",\"dahlia\":\"TABLE\"},\"plan\":[{\"block\":\"birch\",\"to\":\"amber\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0137-base-forward-42a3f774dba3","adv-tags-da34ee5a1bf1d8db5b1b4868","adj-expansion-v3-bd6e0b24fcc20a62f7ab"],"review_status":"ACCEPTED","reviewed_candidate_hash":"42a3f774dba3b871ed01d9410e684fc2cfd87e3495da61bbd5d0921c9818ab83","sample_id":"RGM-001-expansion-v3-p0137-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0137","semantic_parent_id":"RGM-001-expansion-v3-p0137","semantic_task":{"goal_on":{"amber":"TABLE","birch":"amber","dahlia":"TABLE"},"kind":"blocks","on":{"amber":"TABLE","birch":"dahlia","dahlia":"TABLE"},"plan":[{"block":"birch","to":"amber"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0137","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":2,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"TABLE","birch":"amber","dahlia":"TABLE"},"reaches_goal":true,"shortest_plan":[{"block":"birch","to":"amber"}],"steps":[{"after":{"amber":"TABLE","birch":"amber","dahlia":"TABLE"},"legal":true}],"valid":true}}
