s":["expert-RGM-001-expansion-v3-p0046-base-reverse-c10458441a38","adv-tags-692fb1e14b39abbb404d6b22","adj-expansion-v3-b7b842b04f4e3da3787f"],"review_status":"ACCEPTED","reviewed_candidate_hash":"c10458441a389cf29ff5132a21cb8ec489c48530163740dbb7ce150be99583c7","sample_id":"RGM-001-expansion-v3-p0046-base-reverse","semantic_family_id":"RGM-001-expansion-v3-p0046","semantic_parent_id":"RGM-001-expansion-v3-p0046","semantic_task":{"edges":[["Dune","Fjord",3],["Fjord","Cedar",1],["Dune","Cedar",5]],"fuel":4,"goal":"Cedar","kind":"graph","nodes":["Dune","Fjord","Cedar"],"plan":["Cedar","Fjord","Cedar"],"start":"Dune"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0046","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":4,"node":"Dune"},"reaches_goal":false,"shortest_plan":["Fjord","Cedar"],"steps":[{"after":{"fuel":4,"node":"Dune"},"legal":false}],"valid":false}}
{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"ab962bf24ef922cbdecedd05d044dcc9a8599eb0462b2b47c913c33dd2aa0d2d","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"amber\":\"TABLE\",\"cobalt\":\"TABLE\",\"birch\":\"cobalt\"},\"goal_on\":{\"amber\":\"TABLE\",\"birch\":\"amber\",\"cobalt\":\"birch\"},\"plan\":[{\"block\":\"birch\",\"to\":\"amber\"},{\"block\":\"cobalt\",\"to\":\"birch\"},{\"block\":\"amber\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0047-base-forward-1948cdfef9f4","adv-tags-4da4a96e0dc4b875600ae45b","adj-expansion-v3-18d5917582f997e17b52"],"review_status":"ACCEPTED","reviewed_candidate_hash":"1948cdfef9f4a92dedd47c493ba9dfad1944d04c9a7a5f3a30fff5dfe15fec72","sample_id":"RGM-001-expansion-v3-p0047-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0047","semantic_parent_id":"RGM-001-expansion-v3-p0047","semantic_task":{"goal_on":{"amber":"TABLE","birch":"amber","cobalt":"birch"},"kind":"blocks","on":{"amber":"TABLE","birch":"cobalt","cobalt":"TABLE"},"plan":[{"block":"birch","to":"amber"},{"block":"cobalt","to":"birch"},{"block":"amber","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0047","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"TABLE","birch":"amber","cobalt":"birch"},"reaches_goal":false,"shortest_plan":[{"block":"birch","to":"amber"},{"block":"cobalt","to":"birch"}],"steps":[{"after":{"amber":"TABLE","birch":"amber","cobalt":"TABLE"},"legal":true},{"after":{"amber":"TABLE","birch":"amber","cobalt":"birch"},"legal":true},{"after":{"amber":"TABLE","birch":"amber","cobalt":"birch"},"legal":false}],"valid":false}}
