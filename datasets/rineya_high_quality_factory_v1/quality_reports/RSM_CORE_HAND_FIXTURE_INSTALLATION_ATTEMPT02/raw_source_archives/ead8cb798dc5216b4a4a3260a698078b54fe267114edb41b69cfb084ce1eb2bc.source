\"Zephyr\",2],[\"Umber\",\"Zephyr\",11],[\"Umber\",\"Obsidian\",6],[\"Vesper\",\"Zephyr\",4],[\"Zephyr\",\"Tundra\",4]],\"nodes\":[\"Umber\",\"Tundra\",\"Obsidian\",\"Quasar\",\"Vesper\",\"Nacre\",\"Zephyr\"],\"kind\":\"graph\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0108-matched-reverse-067c099d1aca","adv-tags-ab48fc2bf3797e19bf1bc6ae","adj-expansion-v3-fd301a96da1bb3b353b4"],"review_status":"ACCEPTED","reviewed_candidate_hash":"067c099d1acae1f0b53bbf96d0b8d801aa157b6f866d2e3023095a2bbf8d37fe","sample_id":"RGM-001-expansion-v3-p0108-matched-reverse","semantic_family_id":"RGM-001-expansion-v3-p0108","semantic_parent_id":"RGM-001-expansion-v3-p0108","semantic_task":{"edges":[["Umber","Tundra",2],["Tundra","Obsidian",3],["Obsidian","Quasar",1],["Quasar","Vesper",2],["Vesper","Nacre",1],["Nacre","Zephyr",2],["Umber","Zephyr",11],["Umber","Obsidian",6],["Vesper","Zephyr",4],["Zephyr","Tundra",4]],"fuel":37,"goal":"Zephyr","kind":"graph","nodes":["Umber","Tundra","Obsidian","Quasar","Vesper","Nacre","Zephyr"],"plan":["Zephyr"],"start":"Umber"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","matched_goal_outcome","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0108","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":26,"node":"Zephyr"},"reaches_goal":true,"shortest_plan":["Zephyr"],"steps":[{"after":{"fuel":26,"node":"Zephyr"},"legal":true}],"valid":true}}
{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"ca2f4386ac6c66c870fed0890239ed2b953817414eabafb672449cb8e883d1a7","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"ruby\":\"TABLE\",\"quartz\":\"ruby\",\"onyx\":\"quartz\",\"sapphire\":\"TABLE\",\"pearl\":\"sapphire\"},\"goal_on\":{\"quartz\":\"TABLE\",\"pearl\":\"TABLE\",\"sapphire\":\"TABLE\",\"ruby\":\"sapphire\",\"onyx\":\"ruby\"},\"plan\":[{\"block\":\"onyx\",\"to\":\"TABLE\"},{\"block\":\"pearl\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0109-base-forward-51ed91bc17e6","adv-tags-c85d9f95066cf51a954cc1f5","adj-expansion-v3-b18918c24ed299e0b79b"],"review_status":"ACCEPTED","reviewed_candidate_hash":"51ed91bc17e632c436e18e0462a30657a743a7cabdfa6d437569928e7d5da803","sample_id":"RGM-001-expansion-v3-p0109-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0109","semantic_parent_id":"RGM-001-expansion-v3-p0109","semantic_task":{"goal_on":{"onyx":"ruby","pearl":"TABLE","quartz":"TABLE","ruby":"sapphire","sapphire":"TABLE"},"kind":"blocks","on":{"onyx":"quartz","pearl":"sapphire","quartz":"ruby","ruby":"TABLE","sapphire":"TABLE"},"plan":[{"block":"onyx","to":"TABLE"},{"block":"pearl","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0109","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"ruby","ruby":"TABLE","sapphire":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"onyx","to":"TABLE"},{"block":"pearl","to":"TABLE"},{"block":"quartz","to":"TABLE"},{"block":"ruby","to":"sapphire"},{"block":"onyx","to":"ruby"}],"steps":[{"after":{"onyx":"TABLE","pearl":"sapphire","quartz":"ruby","ruby":"TABLE","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"ruby","ruby":"TABLE","sapphire":"TABLE"},"legal":true}],"valid":true}}
