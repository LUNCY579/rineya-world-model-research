{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":2,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"65b83418653d03c2dfe9eb46feef936391a2aeb0dda011707f153d2dfc237028","rendered_input":"Graph contract: kind=graph. nodes contains distinct strings. edges contains [from,to,cost] triples with positive integer fuel costs and at most one edge per ordered pair. start and goal are nodes; fuel is a nonnegative integer. plan is an ordered list of destination node names. Every edge is directed. Start at {node:start,fuel:fuel}. An action is legal exactly when an edge from the current node to its destination exists and its cost is at most the remaining fuel. A legal move changes node to its destination and subtracts the edge cost. At the first illegal action, include that action's {legal:false,after:unchanged_state} step, stop immediately, and do not evaluate subsequent actions. An empty plan is valid. valid means every proposed action was legal. reaches_goal is true exactly when the whole plan is valid and its terminal node is goal, including an initially satisfied goal with an empty plan. shortest_plan is a fresh plan from the INITIAL state that reaches goal within initial fuel, minimizes the number of moves, and breaks ties by the lexicographic order of the entire destination-name sequence. It is [] for an initially satisfied goal and null if no feasible plan exists. Fuel cost is a feasibility constraint, not the optimization objective. Return exactly a JSON object with steps:[{legal:boolean,after:{node:string,fuel:integer}}], after:{node:string,fuel:integer}, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"graph\",\"nodes\":[\"Quasar\",\"Obsidian\",\"Nacre\",\"Sirocco\",\"Vesper\",\"Zephyr\",\"Umber\"],\"edges\":[[\"Quasar\",\"Obsidian\",3],[\"Obsidian\",\"Nacre\",1],[\"Nacre\",\"Sirocco\",2],[\"Sirocco\",\"Vesper\",3],[\"Vesper\",\"Zephyr\",1],[\"Zephyr\",\"Umber\",4],[\"Quasar\",\"Umber\",3],[\"Nacre\",\"Quasar\",4],[\"Nacre\",\"Vesper\",3],[\"Nacre\",\"Umber\",3],[\"Umber\",\"Vesper\",3]],\"start\":\"Quasar\",\"goal\":\"Umber\",\"fuel\":14,\"plan\":[\"Obsidian\"]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0088-base-forward-59f774003316","adv-tags-c4bbf47b0e7dfe860ad4e040","adj-expansion-v3-1321a1bb3f9e6e493e33"],"review_status":"ACCEPTED","reviewed_candidate_hash":"59f774003316084231b2948fbd25d6615b381c0e4618ede95adfea75e9863d98","sample_id":"RGM-001-expansion-v3-p0088-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0088","semantic_parent_id":"RGM-001-expansion-v3-p0088","semantic_task":{"edges":[["Quasar","Obsidian",3],["Obsidian","Nacre",1],["Nacre","Sirocco",2],["Sirocco","Vesper",3],["Vesper","Zephyr",1],["Zephyr","Umber",4],["Quasar","Umber",3],["Nacre","Quasar",4],["Nacre","Vesper",3],["Nacre","Umber",3],["Umber","Vesper",3]],"fuel":14,"goal":"Umber","kind":"graph","nodes":["Quasar","Obsidian","Nacre","Sirocco","Vesper","Zephyr","Umber"],"plan":["Obsidian"],"start":"Quasar"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0088","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":2,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":11,"node":"Obsidian"},"reaches_goal":false,"shortest_plan":["Umber"],"steps":[{"after":{"fuel":11,"node":"Obsidian"},"legal":true}],"valid":true}}
