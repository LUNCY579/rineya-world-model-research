_receipt_ids":["expert-RGM-001-expansion-v3-p0101-base-reverse-085becde8414","adv-tags-c7be44632be5396061e20296","adj-expansion-v3-00339355ae8c101e7d10"],"review_status":"ACCEPTED","reviewed_candidate_hash":"085becde8414b7b040825dd9a16081c9d32a6fb8860b9ea1f69b40d67b98d8c9","sample_id":"RGM-001-expansion-v3-p0101-base-reverse","semantic_family_id":"RGM-001-expansion-v3-p0101","semantic_parent_id":"RGM-001-expansion-v3-p0101","semantic_task":{"edges":[["Dune","Fjord",2],["Fjord","Cedar",3],["Cedar","Beryl",2]],"fuel":7,"goal":"Beryl","kind":"graph","nodes":["Dune","Fjord","Cedar","Beryl"],"plan":["Fjord","Cedar","Beryl"],"start":"Dune"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","single_successor_resource_graph","graph","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0101","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":0,"node":"Beryl"},"reaches_goal":true,"shortest_plan":["Fjord","Cedar","Beryl"],"steps":[{"after":{"fuel":5,"node":"Fjord"},"legal":true},{"after":{"fuel":2,"node":"Cedar"},"legal":true},{"after":{"fuel":0,"node":"Beryl"},"legal":true}],"valid":true}}
{"challenge_axes":[],"difficulty":2,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"cff4d6c8ca2f1ed7518300d28d527a154799d04b64a173a37635218a813598aa","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"birch\":\"TABLE\",\"dahlia\":\"birch\",\"cobalt\":\"dahlia\"},\"goal_on\":{\"cobalt\":\"TABLE\",\"dahlia\":\"TABLE\"},\"plan\":[{\"block\":\"birch\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0102-base-forward-2417599f913a","adv-tags-ddd7f03f0eccef10952998c5","adj-expansion-v3-0d13661be1a47760ce29"],"review_status":"ACCEPTED","reviewed_candidate_hash":"2417599f913a33132756cd735537b9d32602c327a29afe118d23cd6768c39f39","sample_id":"RGM-001-expansion-v3-p0102-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0102","semantic_parent_id":"RGM-001-expansion-v3-p0102","semantic_task":{"goal_on":{"cobalt":"TABLE","dahlia":"TABLE"},"kind":"blocks","on":{"birch":"TABLE","cobalt":"dahlia","dahlia":"birch"},"plan":[{"block":"birch","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_explicit_goal_table_roots","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0102","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":2,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"birch":"TABLE","cobalt":"dahlia","dahlia":"birch"},"reaches_goal":false,"shortest_plan":[{"block":"cobalt","to":"TABLE"},{"block":"dahlia","to":"TABLE"}],"steps":[{"after":{"birch":"TABLE","cobalt":"dahlia","dahlia":"birch"},"legal":false}],"valid":false}}
