":["expert-RGM-001-expansion-v3-p0126-base-reverse-933d3a2a1782","adv-tags-f508760f1117b036de183638","adj-expansion-v3-32569f82ea45a6cebab1"],"review_status":"ACCEPTED","reviewed_candidate_hash":"933d3a2a1782ba01e2aee9b4af0cc5de8e90d7e7d53cd8e05695c82be04dd933","sample_id":"RGM-001-expansion-v3-p0126-base-reverse","semantic_family_id":"RGM-001-expansion-v3-p0126","semantic_parent_id":"RGM-001-expansion-v3-p0126","semantic_task":{"edges":[["Aster","Ember",4],["Ember","Dune",4],["Dune","Aster",6]],"fuel":8,"goal":"Dune","kind":"graph","nodes":["Aster","Ember","Dune"],"plan":["Aster","Ember","Dune"],"start":"Aster"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","single_successor_resource_graph","graph","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0126","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":8,"node":"Aster"},"reaches_goal":false,"shortest_plan":["Ember","Dune"],"steps":[{"after":{"fuel":8,"node":"Aster"},"legal":false}],"valid":false}}
{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"524c05545ad73f5e5aebc25110f99cd57bc4a3351f5f78577a8fc0de5c73ccf0","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"cobalt\":\"TABLE\",\"amber\":\"cobalt\",\"dahlia\":\"amber\"},\"goal_on\":{\"cobalt\":\"TABLE\",\"amber\":\"TABLE\",\"dahlia\":\"amber\"},\"plan\