",\"cobalt\":\"birch\",\"birch\":\"TABLE\",\"amber\":\"TABLE\"},\"kind\":\"blocks\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0074-base-reverse-0de650e10b03","adv-tags-484d4f081ab5d1b319b4f42e","adj-expansion-v3-f3e540cce4a62b71928c"],"review_status":"ACCEPTED","reviewed_candidate_hash":"0de650e10b03d331d826065c765e0dba5cb664966eae9bda9f6c4c7867333d4c","sample_id":"RGM-001-expansion-v3-p0074-base-reverse","semantic_family_id":"RGM-001-expansion-v3-p0074","semantic_parent_id":"RGM-001-expansion-v3-p0074","semantic_task":{"goal_on":{"amber":"dahlia","birch":"amber","cobalt":"birch","dahlia":"TABLE"},"kind":"blocks","on":{"amber":"TABLE","birch":"TABLE","cobalt":"birch","dahlia":"cobalt"},"plan":[{"block":"amber","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0074","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"TABLE","birch":"TABLE","cobalt":"birch","dahlia":"cobalt"},"reaches_goal":false,"shortest_plan":[{"block":"dahlia","to":"TABLE"},{"block":"amber","to":"dahlia"},{"block":"cobalt","to":"TABLE"},{"block":"birch","to":"amber"},{"block":"cobalt","to":"birch"}],"steps":[{"after":{"amber":"TABLE","birch":"TABLE","cobalt":"birch","dahlia":"cobalt"},"legal":false}],"valid":false}}
{"challenge_axes":[],"difficulty":3,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"be85630edc127bcd7c655e42ec7664227c8b0f9a12c1a9c99c0b4a63b7f4ad0f","rendered_input":"Graph contract: kind=graph. nodes contains distinct strings. edges contains [from,to,cost] triples with positive integer fuel costs and at most one edge per ordered pair. start and goal are nodes; fuel is a nonnegative integer. plan is an ordered list of destination node names. Every edge is directed. Start at {node:start,fuel:fuel}. An action is legal exactly when an edge from the current node to its destination exists and its cost is at most the remaining fuel. A legal move changes node to its destination and subtracts the edge cost. At the first illegal action, include that action's {legal:false,after:unchanged_state} step, stop immediately, and do not evaluate subsequent actions. An empty plan is valid. valid means every proposed action was legal. reaches_goal is true exactly when the whole plan is valid and its terminal node is goal, including an initially satisfied goal with an empty plan. shortest_plan is a fresh plan from the INITIAL state that reaches goal within initial fuel, minimizes the number of moves, and breaks ties by the lexicographic order of the entire destination-name sequence. It is [] for an initially satisfied goal and null if no feasible plan exists. Fuel cost is a feasibility constraint, not the optimization objective. Return exactly a JSON object with steps:[{legal:boolean,after:{node:string,fuel:integer}}], after:{node:string,fuel:integer}, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"graph\",\"nodes\":[\"Aster\",\"Fjord\",\"Beryl\",\"Cedar\"],\"edges\":[[\"Aster\",\"Fjord\",1],[\"Fjord\",\"Beryl\",4],[\"Beryl\",\"Cedar\",2],[\"Fjord\",\"Cedar\",2],[\"Aster\",\"Beryl\",2],[\"Cedar\",\"Aster\",1]],\"start\":\"Aster\",\"goal\":\"Cedar\",\"fuel\":18,\"plan\":[\"Fjord\",\"Cedar\"]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0075-base-forward-0138b76a3302","adv-tags-d4f91b53eaa5d85e17891187","adj-expansion-v3-6054d8d372a6195233e4"],"review_status":"ACCEPTED","reviewed_candidate_hash":"0138b76a3302fa950e1d6a4e5d631f7525e18907484bffac847df2daa0bcfafe","sample_id":"RGM-001-expansion-v3-p0075-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0075","semantic_parent_id":"RGM-001-expansion-v3-p0075","semantic_task":{"edges":[["Aster","Fjord",1],["Fjord","Beryl",4],["Beryl","Cedar",2],["Fjord","Cedar",2],["Aster","Beryl",2],["Cedar","Aster",1]],"fuel":18,"goal":"Cedar","kind":"graph","nodes":["Aster","Fjord","Beryl","Cedar"],"plan":["Fjord","Cedar"],"start":"Aster"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0075","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":15,"node":"Cedar"},"reaches_goal":true,"shortest_plan":["Beryl","Cedar"],"steps":[{"after":{"fuel":17,"node":"Fjord"},"legal":true},{"after":{"fuel":15,"node":"Cedar"},"legal":true}],"valid":true}}
