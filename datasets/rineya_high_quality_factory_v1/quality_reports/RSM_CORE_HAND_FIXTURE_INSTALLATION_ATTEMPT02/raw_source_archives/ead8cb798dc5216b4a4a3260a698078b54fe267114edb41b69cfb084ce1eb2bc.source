{"challenge_axes":[],"difficulty":1,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"421efcae869f83e4e421134846842efcd0cfe56d060c5ee0ce78d61f021a38ab","rendered_input":"Graph contract: kind=graph. nodes contains distinct strings. edges contains [from,to,cost] triples with positive integer fuel costs and at most one edge per ordered pair. start and goal are nodes; fuel is a nonnegative integer. plan is an ordered list of destination node names. Every edge is directed. Start at {node:start,fuel:fuel}. An action is legal exactly when an edge from the current node to its destination exists and its cost is at most the remaining fuel. A legal move changes node to its destination and subtracts the edge cost. At the first illegal action, include that action's {legal:false,after:unchanged_state} step, stop immediately, and do not evaluate subsequent actions. An empty plan is valid. valid means every proposed action was legal. reaches_goal is true exactly when the whole plan is valid and its terminal node is goal, including an initially satisfied goal with an empty plan. shortest_plan is a fresh plan from the INITIAL state that reaches goal within initial fuel, minimizes the number of moves, and breaks ties by the lexicographic order of the entire destination-name sequence. It is [] for an initially satisfied goal and null if no feasible plan exists. Fuel cost is a feasibility constraint, not the optimization objective. Return exactly a JSON object with steps:[{legal:boolean,after:{node:string,fuel:integer}}], after:{node:string,fuel:integer}, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"graph\",\"nodes\":[\"Fjord\",\"Aster\",\"Cedar\",\"Beryl\",\"Dune\"],\"edges\":[[\"Fjord\",\"Aster\",3],[\"Aster\",\"Cedar\",3],[\"Cedar\",\"Beryl\",4],[\"Beryl\",\"Dune\",2],[\"Fjord\",\"Cedar\",4],[\"Fjord\",\"Dune\",4],[\"Aster\",\"Beryl\",5],[\"Cedar\",\"Fjord\",6],[\"Beryl\",\"Fjord\",4],[\"Dune\",\"Fjord\",1]],\"start\":\"Fjord\",\"goal\":\"Fjord\",\"fuel\":12,\"plan\":[]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0070-base-forward-098940b62fbe","adv-tags-a29dd6aa650d082e328d5365","adj-expansion-v3-9969d5861645c1895973"],"review_status":"ACCEPTED","reviewed_candidate_hash":"098940b62fbe9846b01f455378edd439c1bb723896d48ea6128d24a9cd676f61","sample_id":"RGM-001-expansion-v3-p0070-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0070","semantic_parent_id":"RGM-001-expansion-v3-p0070","semantic_task":{"edges":[["Fjord","Aster",3],["Aster","Cedar",3],["Cedar","Beryl",4],["Beryl","Dune",2],["Fjord","Cedar",4],["Fjord","Dune",4],["Aster","Beryl",5],["Cedar","Fjord",6],["Beryl","Fjord",4],["Dune","Fjord",1]],"fuel":12,"goal":"Fjord","kind":"graph","nodes":["Fjord","Aster","Cedar","Beryl","Dune"],"plan":[],"start":"Fjord"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0070","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":1,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":12,"node":"Fjord"},"reaches_goal":true,"shortest_plan":[],"steps":[],"valid":true}}
