ster\",\"Beryl\",3]],\"nodes\":[\"Cedar\",\"Dune\",\"Beryl\",\"Ember\",\"Fjord\",\"Aster\"],\"kind\":\"graph\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0091-base-reverse-b4861e5e997a","adv-tags-2d0bb0cdb3addce8785db5d2","adj-expansion-v3-cc5c7ffe1647578de08f"],"review_status":"ACCEPTED","reviewed_candidate_hash":"b4861e5e997acf519e5091fad5bf389f31881692e7fdb4a3e40bff239eccd4f8","sample_id":"RGM-001-expansion-v3-p0091-base-reverse","semantic_family_id":"RGM-001-expansion-v3-p0091","semantic_parent_id":"RGM-001-expansion-v3-p0091","semantic_task":{"edges":[["Cedar","Dune",3],["Dune","Beryl",1],["Beryl","Ember",4],["Ember","Fjord",1],["Fjord","Aster",4],["Cedar","Aster",14],["Ember","Cedar",6],["Aster","Beryl",3]],"fuel":13,"goal":"Aster","kind":"graph","nodes":["Cedar","Dune","Beryl","Ember","Fjord","Aster"],"plan":["Aster","Dune","Aster"],"start":"Cedar"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0091","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":13,"node":"Cedar"},"reaches_goal":false,"shortest_plan":["Dune","Beryl","Ember","Fjord","Aster"],"steps":[{"after":{"fuel":13,"node":"Cedar"},"legal":false}],"valid":false}}
{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"0446a02c0e17458edd7b7a1f02024104f443ce1c4bc257d5058272c92cbce90d","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"birch\":\"TABLE\",\"amber\":\"TABLE\",\"dahlia\":\"amber\"},\"goal_on\":{\"birch\":\"TABLE\",\"amber\":\"birch\",\"dahlia\":\"amber\"},\"plan\":[{\"block\":\"dahlia\",\"to\":\"TABLE\"},{\"block\":\"amber\",\"to\":\"birch\"},{\"block\":\"dahlia\",\"to\":\"amber\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0092-base-forward-d89cf8c6b5da","adv-tags-ea9d42f83a24e982558b61fe","adj-expansion-v3-8c48e017f79eb5859abf"],"review_status":"ACCEPTED","reviewed_candidate_hash":"d89cf8c6b5dac09bed7dbae748f7ece2198fecc7c10e0221bdf8f88f435e7d4e","sample_id":"RGM-001-expansion-v3-p0092-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0092","semantic_parent_id":"RGM-001-expansion-v3-p0092","semantic_task":{"goal_on":{"amber":"birch","birch":"TABLE","dahlia":"amber"},"kind":"blocks","on":{"amber":"TABLE","birch":"TABLE","dahlia":"amber"},"plan":[{"block":"dahlia","to":"TABLE"},{"block":"amber","to":"birch"},{"block":"dahlia","to":"amber"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0092","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"birch","birch":"TABLE","dahlia":"amber"},"reaches_goal":true,"shortest_plan":[{"block":"dahlia","to":"TABLE"},{"block":"amber","to":"birch"},{"block":"dahlia","to":"amber"}],"steps":[{"after":{"amber":"TABLE","birch":"TABLE","dahlia":"TABLE"},"legal":true},{"after":{"amber":"birch","birch":"TABLE","dahlia":"TABLE"},"legal":true},{"after":{"amber":"birch","birch":"TABLE","dahlia":"amber"},"legal":true}],"valid":true}}
