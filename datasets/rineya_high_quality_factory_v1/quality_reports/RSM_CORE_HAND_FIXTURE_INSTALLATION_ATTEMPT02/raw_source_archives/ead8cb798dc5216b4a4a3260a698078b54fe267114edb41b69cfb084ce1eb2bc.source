\"Beryl\",\"Fjord\",2],[\"Fjord\",\"Dune\",6]],\"nodes\":[\"Cedar\",\"Aster\",\"Beryl\",\"Dune\",\"Fjord\"],\"kind\":\"graph\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0043-base-reverse-b4ea7c97fca3","adv-tags-cb5ad27857634d6a6f0b7809","adj-expansion-v3-3d93b0dcdf996aa865fb"],"review_status":"ACCEPTED","reviewed_candidate_hash":"b4ea7c97fca3a8863ec98696af6a9cde5eaf26c96369ebb0db15128d95eff3ca","sample_id":"RGM-001-expansion-v3-p0043-base-reverse","semantic_family_id":"RGM-001-expansion-v3-p0043","semantic_parent_id":"RGM-001-expansion-v3-p0043","semantic_task":{"edges":[["Cedar","Aster",4],["Aster","Beryl",1],["Beryl","Dune",2],["Dune","Fjord",3],["Aster","Dune",2],["Aster","Fjord",5],["Beryl","Cedar",2],["Beryl","Aster",2],["Beryl","Fjord",2],["Fjord","Dune",6]],"fuel":10,"goal":"Fjord","kind":"graph","nodes":["Cedar","Aster","Beryl","Dune","Fjord"],"plan":["Aster"],"start":"Cedar"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0043","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":2,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":6,"node":"Aster"},"reaches_goal":false,"shortest_plan":["Aster","Fjord"],"steps":[{"after":{"fuel":6,"node":"Aster"},"legal":true}],"valid":true}}
{"challenge_axes":[],"difficulty":2,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"9e66025431dbccb179580c7baa84d57cc6659429165af99b59645c48da760237","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"dahlia\":\"TABLE\",\"birch\":\"TABLE\",\"amber\":\"birch\",\"cobalt\":\"amber\"},\"goal_on\":{\"dahlia\":\"TABLE\",\"cobalt\":\"TABLE\",\"birch\":\"TABLE\",\"amber\":\"birch\"},\"plan\":[{\"block\":\"cobalt\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0044-base-forward-19a6be80db1a","adv-tags-f2054a528367467cd3987303","adj-expansion-v3-decc9f8ca7b469f38627"],"review_status":"ACCEPTED","reviewed_candidate_hash":"19a6be80db1a50bd30ea84b8bc360ae18d19ecfb77d5ea92bd3cce8eb4fe3895","sample_id":"RGM-001-expansion-v3-p0044-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0044","semantic_parent_id":"RGM-001-expansion-v3-p0044","semantic_task":{"goal_on":{"amber":"birch","birch":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"kind":"blocks","on":{"amber":"birch","birch":"TABLE","cobalt":"amber","dahlia":"TABLE"},"plan":[{"block":"cobalt","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0044","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":2,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"birch","birch":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"reaches_goal":true,"shortest_plan":[{"block":"cobalt","to":"TABLE"}],"steps":[{"after":{"amber":"birch","birch":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"legal":true}],"valid":true}}
