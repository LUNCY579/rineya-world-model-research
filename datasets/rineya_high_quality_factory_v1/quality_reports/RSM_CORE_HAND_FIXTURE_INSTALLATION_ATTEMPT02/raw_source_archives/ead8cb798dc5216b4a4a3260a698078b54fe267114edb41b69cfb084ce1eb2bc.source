cks\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0032-base-reverse-1b318931db4b","adv-tags-f4a76901cac78cb233a8f4e4","adj-expansion-v3-7e3264e5f7dd4253d908"],"review_status":"ACCEPTED","reviewed_candidate_hash":"1b318931db4bf668c63142141fc9f3a40bd2fa7f516187ed11c971099dc11bac","sample_id":"RGM-001-expansion-v3-p0032-base-reverse","semantic_family_id":"RGM-001-expansion-v3-p0032","semantic_parent_id":"RGM-001-expansion-v3-p0032","semantic_task":{"goal_on":{"birch":"TABLE","cobalt":"dahlia","dahlia":"TABLE"},"kind":"blocks","on":{"birch":"TABLE","cobalt":"dahlia","dahlia":"TABLE"},"plan":[]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0032","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":1,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"birch":"TABLE","cobalt":"dahlia","dahlia":"TABLE"},"reaches_goal":true,"shortest_plan":[],"steps":[],"valid":true}}
