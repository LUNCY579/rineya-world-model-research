,{\"to\":\"pearl\",\"block\":\"sapphire\"},{\"to\":\"sapphire\",\"block\":\"ruby\"}],\"goal_on\":{\"ruby\":\"sapphire\",\"quartz\":\"TABLE\",\"onyx\":\"TABLE\",\"sapphire\":\"pearl\"},\"on\":{\"sapphire\":\"pearl\",\"pearl\":\"quartz\",\"quartz\":\"ruby\",\"ruby\":\"TABLE\",\"onyx\":\"TABLE\"},\"kind\":\"blocks\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0129-matched-reverse-e930f87bca3a","adv-tags-1ca362a694489bb8bff8606a","adj-expansion-v3-81250830d4d031fd7c34"],"review_status":"ACCEPTED","reviewed_candidate_hash":"e930f87bca3a9d871922e9855b5b8a43cc396076e6445c1195f3cce01568d31a","sample_id":"RGM-001-expansion-v3-p0129-matched-reverse","semantic_family_id":"RGM-001-expansion-v3-p0129","semantic_parent_id":"RGM-001-expansion-v3-p0129","semantic_task":{"goal_on":{"onyx":"TABLE","quartz":"TABLE","ruby":"sapphire","sapphire":"pearl"},"kind":"blocks","on":{"onyx":"TABLE","pearl":"quartz","quartz":"ruby","ruby":"TABLE","sapphire":"pearl"},"plan":[{"block":"sapphire","to":"TABLE"},{"block":"pearl","to":"TABLE"},{"block":"quartz","to":"TABLE"},{"block":"sapphire","to":"pearl"},{"block":"ruby","to":"sapphire"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","matched_goal_outcome","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0129","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"TABLE","ruby":"sapphire","sapphire":"pearl"},"reaches_goal":true,"shortest_plan":[{"block":"sapphire","to":"TABLE"},{"block":"pearl","to":"TABLE"},{"block":"quartz","to":"TABLE"},{"block":"sapphire","to":"pearl"},{"block":"ruby","to":"sapphire"}],"steps":[{"after":{"onyx":"TABLE","pearl":"quartz","quartz":"ruby","ruby":"TABLE","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"ruby","ruby":"TABLE","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"TABLE","ruby":"TABLE","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"TABLE","ruby":"TABLE","sapphire":"pearl"},"legal":true},{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"TABLE","ruby":"sapphire","sapphire":"pearl"},"legal":true}],"valid":true}}
{"challenge_axes":[],"difficulty":1,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"da46e9d8da6f667c38d1da687079a2a428b8380cfa46c8b0840ecafd0f4fa431","rendered_input":"Graph contract: kind=graph. nodes contains distinct strings. edges contains [from,to,cost] triples with positive integer fuel costs and at most one edge per ordered pair. start and goal are nodes; fuel is a nonnegative integer. plan is an ordered list of destination node names. Every edge is directed. Start at {node:start,fuel:fuel}. An action is legal exactly when an edge from the current node to its destination exists and its cost is at most the remaining fuel. A legal move changes node to its destination and subtracts the edge cost. At the first illegal action, include that action's {legal:false,after:unchanged_state} step, stop immediately, and do not evaluate subsequent actions. An empty plan is valid. valid means every proposed action was legal. reaches_goal is true exactly when the whole plan is valid and its terminal node is goal, including an initially satisfied goal with an empty plan. shortest_plan is a fresh plan from the INITIAL state that reaches goal within initial fuel, minimizes the number of moves, and breaks ties by the lexicographic order of the entire destination-name sequence. It is [] for an initially satisfied goal and null if no feasible plan exists. Fuel cost is a feasibility constraint, not the optimization objective. Return exactly a JSON object with steps:[{legal:boolean,after:{node:string,fuel:integer}}], after:{node:string,fuel:integer}, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"graph\",\"nodes\":[\"Cedar\",\"Beryl\",\"Ember\",\"Aster\",\"Dune\"],\"edges\":[[\"Cedar\",\"Beryl\",2],[\"Beryl\",\"Ember\",3],[\"Ember\",\"Aster\",3],[\"Aster\",\"Dune\",2],[\"Cedar\",\"Dune\",3],[\"Dune\",\"Aster\",2]],\"start\":\"Cedar\",\"goal\":\"Cedar\",\