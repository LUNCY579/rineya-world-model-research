"review_receipt_ids":["expert-RGM-001-expansion-v3-p0053-base-reverse-cf6b2b687cc8","adv-tags-3aad6964e91ec53111de644a","adj-expansion-v3-4bb8dbc55d4b294adac6"],"review_status":"ACCEPTED","reviewed_candidate_hash":"cf6b2b687cc8f79b98c2c87c7794a20e24e9b9210bd0469fabbb6d39d7db68a6","sample_id":"RGM-001-expansion-v3-p0053-base-reverse","semantic_family_id":"RGM-001-expansion-v3-p0053","semantic_parent_id":"RGM-001-expansion-v3-p0053","semantic_task":{"edges":[["Cedar","Beryl",1],["Beryl","Ember",3],["Beryl","Cedar",1],["Ember","Beryl",2]],"fuel":8,"goal":"Ember","kind":"graph","nodes":["Cedar","Beryl","Ember"],"plan":["Beryl","Cedar"],"start":"Cedar"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0053","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":6,"node":"Cedar"},"reaches_goal":false,"shortest_plan":["Beryl","Ember"],"steps":[{"after":{"fuel":7,"node":"Beryl"},"legal":true},{"after":{"fuel":6,"node":"Cedar"},"legal":true}],"valid":true}}
{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"c5b427a41acd9b918d6091d93cd9c8ced996c4f04c7bec57276484203f459266","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"dahlia\":\"TABLE\",\"birch\":\"dahlia\",\"amber\":\"birch\",\"cobalt\":\"amber\"},\"goal_on\":{\"birch\":\"TABLE\",\"amber\":\"TABLE\",\"dahlia\":\"TABLE\"},\"plan\":[{\"block\":\"amber\",\"to\":\"birch\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0054-base-forward-eedefee862a2","adv-tags-ee7522c936e864fb5edeb19d","adj-expansion-v3-c0860bac55cd1874fcef"],"review_status":"ACCEPTED","reviewed_candidate_hash":"eedefee862a2569df01da735a6941403367bb7560f827703fe64dd4155ccac81","sample_id":"RGM-001-expansion-v3-p0054-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0054","semantic_parent_id":"RGM-001-expansion-v3-p0054","semantic_task":{"goal_on":{"amber":"TABLE","birch":"TABLE","dahlia":"TABLE"},"kind":"blocks","on":{"amber":"birch","birch":"dahlia","cobalt":"amber","dahlia":"TABLE"},"plan":[{"block":"amber","to":"birch"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_explicit_goal_table_roots","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0054","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"birch","birch":"dahlia","cobalt":"amber","dahlia":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"cobalt","to":"TABLE"},{"block":"amber","to":"TABLE"},{"block":"birch","to":"TABLE"}],"steps":[{"after":{"amber":"birch","birch":"dahlia","cobalt":"amber","dahlia":"TABLE"},"legal":false}],"valid":false}}
