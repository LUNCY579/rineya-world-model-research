,[\"Tundra\",\"Quasar\",2],[\"Umber\",\"Quasar\",15],[\"Umber\",\"Tundra\",5],[\"Nacre\",\"Tundra\",6],[\"Nacre\",\"Quasar\",2],[\"Vesper\",\"Nacre\",3],[\"Vesper\",\"Quasar\",5],[\"Sirocco\",\"Quasar\",5],[\"Tundra\",\"Sirocco\",5]],\"nodes\":[\"Umber\",\"Obsidian\",\"Nacre\",\"Vesper\",\"Sirocco\",\"Tundra\",\"Quasar\"],\"kind\":\"graph\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0048-matched-reverse-c05ea12ba195","adv-tags-b575dc54055d9594c5601def","adj-expansion-v3-b06468455776436b08d3"],"review_status":"ACCEPTED","reviewed_candidate_hash":"c05ea12ba19586200aa0ac5bd3efbc5c603abe688109ece40a8760127895ed6d","sample_id":"RGM-001-expansion-v3-p0048-matched-reverse","semantic_family_id":"RGM-001-expansion-v3-p0048","semantic_parent_id":"RGM-001-expansion-v3-p0048","semantic_task":{"edges":[["Umber","Obsidian",3],["Obsidian","Nacre",1],["Nacre","Vesper",4],["Vesper","Sirocco",1],["Sirocco","Tundra",4],["Tundra","Quasar",2],["Umber","Quasar",15],["Umber","Tundra",5],["Nacre","Tundra",6],["Nacre","Quasar",2],["Vesper","Nacre",3],["Vesper","Quasar",5],["Sirocco","Quasar",5],["Tundra","Sirocco",5]],"fuel":14,"goal":"Quasar","kind":"graph","nodes":["Umber","Obsidian","Nacre","Vesper","Sirocco","Tundra","Quasar"],"plan":["Tundra","Quasar"],"start":"Umber"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","matched_goal_outcome","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0048","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":7,"node":"Quasar"},"reaches_goal":true,"shortest_plan":["Tundra","Quasar"],"steps":[{"after":{"fuel":9,"node":"Tundra"},"legal":true},{"after":{"fuel":7,"node":"Quasar"},"legal":true}],"valid":true}}
{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"48a4634fc490f1cfa6c9b3e874f82ec82d5c50884289820f58dd4b8ee594fe5d","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"onyx\":\"TABLE\",\"sapphire\":\"onyx\",\"ruby\":\"TABLE\",\"quartz\":\"ruby\",\"pearl\":\"TABLE\"},\"goal_on\":{\"sapphire\":\"TABLE\",\"pearl\":\"sapphire\",\"ruby\":\"TABLE\",\"onyx\":\"TABLE\",\"quartz\":\"onyx\"},\"plan\":[{\"block\":\"sapphire\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0049-base-forward-9632c12a51c1","adv-tags-2acd76386976cc87418ba508","adj-expansion-v3-ba3f3596fb74109f99e7"],"review_status":"ACCEPTED","reviewed_candidate_hash":"9632c12a51c156d937a1ecb6fd67b16ae0e508797cd5614bfcb83afba093c943","sample_id":"RGM-001-expansion-v3-p0049-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0049","semantic_parent_id":"RGM-001-expansion-v3-p0049","semantic_task":{"goal_on":{"onyx":"TABLE","pearl":"sapphire","quartz":"onyx","ruby":"TABLE","sapphire":"TABLE"},"kind":"blocks","on":{"onyx":"TABLE","pearl":"TABLE","quartz":"ruby","ruby":"TABLE","sapphire":"onyx"},"plan":[{"block":"sapphire","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0049","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"ruby","ruby":"TABLE","sapphire":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"sapphire","to":"TABLE"},{"block":"pearl","to":"sapphire"},{"block":"quartz","to":"onyx"}],"steps":[{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"ruby","ruby":"TABLE","sapphire":"TABLE"},"legal":true}],"valid":true}}
