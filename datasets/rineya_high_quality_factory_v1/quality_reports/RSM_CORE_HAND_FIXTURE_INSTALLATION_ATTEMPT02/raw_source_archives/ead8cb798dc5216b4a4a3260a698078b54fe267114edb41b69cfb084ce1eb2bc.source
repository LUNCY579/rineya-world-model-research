{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"125b36f1158721a3c2fcf9078c096a427da5887f688608692f56879d1ac78c67","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"birch\":\"TABLE\",\"amber\":\"birch\",\"cobalt\":\"amber\",\"dahlia\":\"cobalt\"},\"goal_on\":{\"cobalt\":\"TABLE\",\"amber\":\"TABLE\",\"dahlia\":\"amber\",\"birch\":\"dahlia\"},\"plan\":[{\"block\":\"dahlia\",\"to\":\"TABLE\"},{\"block\":\"cobalt\",\"to\":\"TABLE\"},{\"block\":\"amber\",\"to\":\"TABLE\"},{\"block\":\"dahlia\",\"to\":\"amber\"},{\"block\":\"birch\",\"to\":\"dahlia\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0104-base-forward-2ea6c407e2bd","adv-tags-c40bb069b6ae96825e3ca4b1","adj-expansion-v3-c3af510efad4b110557a"],"review_status":"ACCEPTED","reviewed_candidate_hash":"2ea6c407e2bdf8a24ae082c4451fc158c9793478a228dc8ef3662a3ef524ad2f","sample_id":"RGM-001-expansion-v3-p0104-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0104","semantic_parent_id":"RGM-001-expansion-v3-p0104","semantic_task":{"goal_on":{"amber":"TABLE","birch":"dahlia","cobalt":"TABLE","dahlia":"amber"},"kind":"blocks","on":{"amber":"birch","birch":"TABLE","cobalt":"amber","dahlia":"cobalt"},"plan":[{"block":"dahlia","to":"TABLE"},{"block":"cobalt","to":"TABLE"},{"block":"amber","to":"TABLE"},{"block":"dahlia","to":"amber"},{"block":"birch","to":"dahlia"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_explicit_goal_table_roots","blocks","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0104","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"TABLE","birch":"dahlia","cobalt":"TABLE","dahlia":"amber"},"reaches_goal":true,"shortest_plan":[{"block":"dahlia","to":"TABLE"},{"block":"cobalt","to":"TABLE"},{"block":"amber","to":"TABLE"},{"block":"dahlia","to":"amber"},{"block":"birch","to":"dahlia"}],"steps":[{"after":{"amber":"birch","birch":"TABLE","cobalt":"amber","dahlia":"TABLE"},"legal":true},{"after":{"amber":"birch","birch":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"legal":true},{"after":{"amber":