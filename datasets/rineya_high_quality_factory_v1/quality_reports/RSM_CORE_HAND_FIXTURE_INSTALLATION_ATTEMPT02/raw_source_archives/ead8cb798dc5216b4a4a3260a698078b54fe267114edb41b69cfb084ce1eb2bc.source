xpert-RGM-001-expansion-v3-p0033-base-reverse-40fa07711e2d","adv-tags-aa48ad9dea6e8fe01767ebca","adj-expansion-v3-d4275f2de4c67cc73ac5"],"review_status":"ACCEPTED","reviewed_candidate_hash":"40fa07711e2dd21f919e29ce8c89e52daed59790835390d01a734fba782e9600","sample_id":"RGM-001-expansion-v3-p0033-base-reverse","semantic_family_id":"RGM-001-expansion-v3-p0033","semantic_parent_id":"RGM-001-expansion-v3-p0033","semantic_task":{"edges":[["Beryl","Ember",4],["Ember","Fjord",4],["Beryl","Fjord",8]],"fuel":7,"goal":"Fjord","kind":"graph","nodes":["Beryl","Ember","Fjord"],"plan":["Ember","Fjord"],"start":"Beryl"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","invalid_plan","unreachable"],"source_family_key":"RGM-001-seed20261009-p0033","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":3,"node":"Ember"},"reaches_goal":false,"shortest_plan":null,"steps":[{"after":{"fuel":3,"node":"Ember"},"legal":true},{"after":{"fuel":3,"node":"Ember"},"legal":false}],"valid":false}}
{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"0289851ff9283854d400470871b43360339e5152033db7216535eb349f834665","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"amber\":\"TABLE\",\"dahlia\":\"amber\",\"birch\":\"dahlia\",\"cobalt\":\"birch\"},\"goal_on\":{\"birch\":\"TABLE\",\"amber\":\"birch\",\"dahlia\":\"amber\",\"cobalt\":\"dahlia\"},\"plan\":[{\"block\":\"amber\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0034-base-forward-15f1699b1db7","adv-tags-9075ea74c50fbf14eaad827e","adj-expansion-v3-fc0ed940d187e161365c"],"review_status":"ACCEPTED","reviewed_candidate_hash":"15f1699b1db76df8434fcabe76f2ddc801bb216eea37e00dc9b748c91a9b4b59","sample_id":"RGM-001-expansion-v3-p0034-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0034","semantic_parent_id":"RGM-001-expansion-v3-p0034","semantic_task":{"goal_on":{"amber":"birch","birch":"TABLE","cobalt":"dahlia","dahlia":"amber"},"kind":"blocks","on":{"amber":"TABLE","birch":"dahlia","cobalt":"birch","dahlia":"amber"},"plan":[{"block":"amber","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","block_goal_composition","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0034","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"TABLE","birch":"dahlia","cobalt":"birch","dahlia":"amber"},"reaches_goal":false,"shortest_plan":[{"block":"cobalt","to":"TABLE"},{"block":"birch","to":"TABLE"},{"block":"dahlia","to":"TABLE"},{"block":"amber","to":"birch"},{"block":"dahlia","to":"amber"},{"block":"cobalt","to":"dahlia"}],"steps":[{"after":{"amber":"TABLE","birch":"dahlia","cobalt":"birch","dahlia":"amber"},"legal":false}],"valid":false}}
