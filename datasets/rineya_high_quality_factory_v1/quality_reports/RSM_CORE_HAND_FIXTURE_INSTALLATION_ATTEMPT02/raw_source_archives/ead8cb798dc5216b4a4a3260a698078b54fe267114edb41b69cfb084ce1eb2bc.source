ryl\",\"goal\":\"Dune\",\"fuel\":16,\"plan\":[\"Dune\",\"Ember\",\"Dune\"]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0136-base-forward-79cbdc5c2e60","adv-tags-1eb9ad548298fd7371641ab9","adj-expansion-v3-b1500af4bb98673ace1a"],"review_status":"ACCEPTED","reviewed_candidate_hash":"79cbdc5c2e606ad2ae71e652a12fa0e75a3504ba4950815b3468b23811b52772","sample_id":"RGM-001-expansion-v3-p0136-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0136","semantic_parent_id":"RGM-001-expansion-v3-p0136","semantic_task":{"edges":[["Beryl","Ember",4],["Ember","Aster",4],["Aster","Fjord",4],["Fjord","Dune",4],["Beryl","Dune",17],["Beryl","Fjord",2],["Fjord","Ember",2]],"fuel":16,"goal":"Dune","kind":"graph","nodes":["Beryl","Ember","Aster","Fjord","Dune"],"plan":["Dune","Ember","Dune"],"start":"Beryl"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0136","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":16,"node":"Beryl"},"reaches_goal":false,"shortest_plan":["Fjord","Dune"],"steps":[{"after":{"fuel":16,"node":"Beryl"},"legal":false}],"valid":false}}
