nderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0113-base-reverse-576aca267924","adv-tags-d2d2afc92fdb20737f08edd2","adj-expansion-v3-8c642fd3a11683a27a1e"],"review_status":"ACCEPTED","reviewed_candidate_hash":"576aca267924709dfb57e9292bfffefc9a7d6db55ad4a7a02f03a168a4619386","sample_id":"RGM-001-expansion-v3-p0113-base-reverse","semantic_family_id":"RGM-001-expansion-v3-p0113","semantic_parent_id":"RGM-001-expansion-v3-p0113","semantic_task":{"edges":[["Ember","Dune",3],["Dune","Beryl",2],["Dune","Ember",1],["Ember","Beryl",3],["Beryl","Dune",5]],"fuel":9,"goal":"Beryl","kind":"graph","nodes":["Ember","Dune","Beryl"],"plan":["Dune","Ember"],"start":"Ember"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0113","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":5,"node":"Ember"},"reaches_goal":false,"shortest_plan":["Beryl"],"steps":[{"after":{"fuel":6,"node":"Dune"},"legal":true},{"after":{"fuel":5,"node":"Ember"},"legal":true}],"valid":true}}
{"challenge_axes":[],"difficulty":2,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"f4b60355f19fae65bb5c27ee444d8f4fd420c6c42e2e5771dfb65b4e2b4b59e5","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"dahlia\":\"TABLE\",\"birch\":\"TABLE\",\"cobalt\":\"birch\",\"amber\":\"TABLE\"},\"goal_on\":{\"birch\":\"amber\",\"dahlia\":\"TABLE\",\"amber\":\"TABLE\"},\"plan\":[{\"block\":\"amber\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0114-base-forward-401e0845ebc9","adv-tags-97f5ae6ace4607f8187fc641","adj-expansion-v3-6ce2b2e3f0bb6de975bb"],"review_status":"ACCEPTED","reviewed_candidate_hash":"401e0845ebc993c78d9e24d60f11c2745f2f803b956aa20a1d5bd3f627ec7fe4","sample_id":"RGM-001-expansion-v3-p0114-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0114","semantic_parent_id":"RGM-001-expansion-v3-p0114","semantic_task":{"goal_on":{"amber":"TABLE","birch":"amber","dahlia":"TABLE"},"kind":"blocks","on":{"amber":"TABLE","birch":"TABLE","cobalt":"birch","dahlia":"TABLE"},"plan":[{"block":"amber","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0114","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":2,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"TABLE","birch":"TABLE","cobalt":"birch","dahlia":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"cobalt","to":"TABLE"},{"block":"birch","to":"amber"}],"steps":[{"after":{"amber":"TABLE","birch":"TABLE","cobalt":"birch","dahlia":"TABLE"},"legal":false}],"valid":false}}
