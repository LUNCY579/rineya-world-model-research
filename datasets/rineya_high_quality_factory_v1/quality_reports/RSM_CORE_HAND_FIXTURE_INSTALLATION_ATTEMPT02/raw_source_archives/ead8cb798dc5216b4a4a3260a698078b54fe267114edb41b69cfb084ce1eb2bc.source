{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"08a7c350b00648cc9696bbd510dcfedcf027bbf90ed975694bf35d22cc932ad5","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"dahlia\":\"TABLE\",\"birch\":\"dahlia\",\"amber\":\"birch\"},\"goal_on\":{\"amber\":\"dahlia\",\"dahlia\":\"TABLE\"},\"plan\":[{\"block\":\"amber\",\"to\":\"birch\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0042-base-forward-77e7a8ce6f92","adv-tags-ac279d21a001f87a5efeaacc","adj-expansion-v3-bfd9ffe232022526e7d2"],"review_status":"ACCEPTED","reviewed_candidate_hash":"77e7a8ce6f9207745358cd89c35758a2c23e2900e0c50831e8454b70480e955d","sample_id":"RGM-001-expansion-v3-p0042-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0042","semantic_parent_id":"RGM-001-expansion-v3-p0042","semantic_task":{"goal_on":{"amber":"dahlia","dahlia":"TABLE"},"kind":"blocks","on":{"amber":"birch","birch":"dahlia","dahlia":"TABLE"},"plan":[{"block":"amber","to":"birch"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","block_goal_composition","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0042","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"birch","birch":"dahlia","dahlia":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"amber","to":"TABLE"},{"block":"birch","to":"TABLE"},{"block":"amber","to":"dahlia"}],"steps":[{"after":{"amber":"birch","birch":"dahlia","dahlia":"TABLE"},"legal":false}],"valid":false}}
