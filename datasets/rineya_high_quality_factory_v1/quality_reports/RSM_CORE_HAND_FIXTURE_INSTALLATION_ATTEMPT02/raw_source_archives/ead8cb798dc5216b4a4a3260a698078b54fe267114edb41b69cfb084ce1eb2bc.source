{"challenge_axes":[],"difficulty":2,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"9ab74aa3e66b241cc5f2f8d38261066207c88cbba90eee3c91934068cff71133","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"cobalt\":\"TABLE\",\"birch\":\"TABLE\",\"amber\":\"birch\"},\"goal_on\":{\"cobalt\":\"birch\",\"amber\":\"TABLE\"},\"plan\":[{\"block\":\"amber\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0117-base-forward-2922220e4f73","adv-tags-75030c08c55d5a588cc50031","adj-expansion-v3-7e63afeb6aa9cb91296a"],"review_status":"ACCEPTED","reviewed_candidate_hash":"2922220e4f73435440db3090bb24c82fcd30bb1390315ac0435b45065a51f0b2","sample_id":"RGM-001-expansion-v3-p0117-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0117","semantic_parent_id":"RGM-001-expansion-v3-p0117","semantic_task":{"goal_on":{"amber":"TABLE","cobalt":"birch"},"kind":"blocks","on":{"amber":"birch","birch":"TABLE","cobalt":"TABLE"},"plan":[{"block":"amber","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0117","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":2,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"TABLE","birch":"TABLE","cobalt":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"amber","to":"TABLE"},{"block":"cobalt","to":"birch"}],"steps":[{"after":{"amber":"TABLE","birch":"TABLE","cobalt":"TABLE"},"legal":true}],"valid":true}}
