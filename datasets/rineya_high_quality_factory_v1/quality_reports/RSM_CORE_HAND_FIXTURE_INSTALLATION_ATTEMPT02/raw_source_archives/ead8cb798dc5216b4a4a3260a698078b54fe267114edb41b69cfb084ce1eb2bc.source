{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"a52e597bbf46cd7c296ccd44cebae51417fce4bc64f17d54e731baad2800b648","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"dahlia\":\"TABLE\",\"amber\":\"dahlia\",\"cobalt\":\"amber\"},\"goal_on\":{\"amber\":\"TABLE\",\"cobalt\":\"TABLE\"},\"plan\":[{\"block\":\"cobalt\",\"to\":\"TABLE\"},{\"block\":\"amber\",\"to\":\"TABLE\"},{\"block\":\"amber\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0147-base-forward-46d25c6fae7b","adv-tags-9a34887ebca79b99e2e61d9a","adj-expansion-v3-add9a09583fae0f208a4"],"review_status":"ACCEPTED","reviewed_candidate_hash":"46d25c6fae7b5511446417aea8869fa188635c1480e1b3bd101ecb3e0de59f07","sample_id":"RGM-001-expansion-v3-p0147-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0147","semantic_parent_id":"RGM-001-expansion-v3-p0147","semantic_task":{"goal_on":{"amber":"TABLE","cobalt":"TABLE"},"kind":"blocks","on":{"amber":"dahlia","cobalt":"amber","dahlia":"TABLE"},"plan":[{"block":"cobalt","to":"TABLE"},{"block":"amber","to":"TABLE"},{"block":"amber","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_explicit_goal_table_roots","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0147","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"cobalt","to":"TABLE"},{"block":"amber","to":"TABLE"}],"steps":[{"after":{"amber":"dahlia","cobalt":"TABLE","dahlia":"TABLE"},"legal":true},{"after":{"amber":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"legal":true},{"after":{"amber":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"legal":false}],"valid":false}}
