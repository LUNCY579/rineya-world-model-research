,\"Aster\",6],[\"Cedar\",\"Ember\",6],[\"Aster\",\"Beryl\",3],[\"Ember\",\"Fjord\",6]],\"nodes\":[\"Beryl\",\"Dune\",\"Cedar\",\"Fjord\",\"Aster\",\"Ember\"],\"kind\":\"graph\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0071-base-reverse-00eb3d835507","adv-tags-2d3a253be83981c3c3f10a84","adj-expansion-v3-0e8ad59b14fbc7254ca5"],"review_status":"ACCEPTED","reviewed_candidate_hash":"00eb3d835507144638c084e8bc82d42ec822c677ee6317cc56aa820f2fbbba82","sample_id":"RGM-001-expansion-v3-p0071-base-reverse","semantic_family_id":"RGM-001-expansion-v3-p0071","semantic_parent_id":"RGM-001-expansion-v3-p0071","semantic_task":{"edges":[["Beryl","Dune",4],["Dune","Cedar",4],["Cedar","Fjord",4],["Fjord","Aster",1],["Aster","Ember",3],["Dune","Fjord",2],["Cedar","Aster",6],["Cedar","Ember",6],["Aster","Beryl",3],["Ember","Fjord",6]],"fuel":18,"goal":"Ember","kind":"graph","nodes":["Beryl","Dune","Cedar","Fjord","Aster","Ember"],"plan":["Dune","Cedar","Fjord","Aster","Ember"],"start":"Beryl"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0071","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":2,"node":"Ember"},"reaches_goal":true,"shortest_plan":["Dune","Cedar","Ember"],"steps":[{"after":{"fuel":14,"node":"Dune"},"legal":true},{"after":{"fuel":10,"node":"Cedar"},"legal":true},{"after":{"fuel":6,"node":"Fjord"},"legal":true},{"after":{"fuel":5,"node":"Aster"},"legal":true},{"after":{"fuel":2,"node":"Ember"},"legal":true}],"valid":true}}
{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"7f8793025107272794e41874b16f85369570c088961fa136e68603dae96fafd1","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"cobalt\":\"TABLE\",\"amber\":\"cobalt\",\"birch\":\"TABLE\"},\"goal_on\":{\"birch\":\"TABLE\",\"cobalt\":\"birch\"},\"plan\":[{\"block\":\"amber\",\"to\":\"TABLE\"},{\"block\":\"cobalt\",\"to\":\"birch\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0072-base-forward-16a6ad0b111c","adv-tags-87e92318457370938a717cbf","adj-expansion-v3-b5bc736350634e8c63e7"],"review_status":"ACCEPTED","reviewed_candidate_hash":"16a6ad0b111c522122a517f979002d671de199898514d47fe70f966f6ffcc24d","sample_id":"RGM-001-expansion-v3-p0072-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0072","semantic_parent_id":"RGM-001-expansion-v3-p0072","semantic_task":{"goal_on":{"birch":"TABLE","cobalt":"birch"},"kind":"blocks","on":{"amber":"cobalt","birch":"TABLE","cobalt":"TABLE"},"plan":[{"block":"amber","to":"TABLE"},{"block":"cobalt","to":"birch"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0072","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"TABLE","birch":"TABLE","cobalt":"birch"},"reaches_goal":true,"shortest_plan":[{"block":"amber","to":"TABLE"},{"block":"cobalt","to":"birch"}],"steps":[{"after":{"amber":"TABLE","birch":"TABLE","cobalt":"TABLE"},"legal":true},{"after":{"amber":"TABLE","birch":"TABLE","cobalt":"birch"},"legal":true}],"valid":true}}
