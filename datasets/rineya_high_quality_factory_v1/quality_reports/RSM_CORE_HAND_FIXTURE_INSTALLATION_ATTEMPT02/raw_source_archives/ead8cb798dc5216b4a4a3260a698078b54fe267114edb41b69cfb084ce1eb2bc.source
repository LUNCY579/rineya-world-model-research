ne\",\"Ember\",2],[\"Dune\",\"Cedar\",5]],\"start\":\"Fjord\",\"goal\":\"Dune\",\"fuel\":10,\"plan\":[\"Fjord\",\"Ember\",\"Aster\",\"Beryl\",\"Cedar\",\"Dune\"]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0171-base-forward-1cc0d81f00cc","adv-tags-d4a141db00aeb28190062f5c","adj-expansion-v3-26d8e02acc26d144c35b"],"review_status":"ACCEPTED","reviewed_candidate_hash":"1cc0d81f00ccdaf05a55bcceb8b45d8e7b4c388fe187b26a963bb57653fb89c0","sample_id":"RGM-001-expansion-v3-p0171-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0171","semantic_parent_id":"RGM-001-expansion-v3-p0171","semantic_task":{"edges":[["Fjord","Ember",1],["Ember","Aster",3],["Aster","Beryl",3],["Beryl","Cedar",1],["Cedar","Dune",2],["Fjord","Cedar",2],["Ember","Beryl",1],["Dune","Ember",2],["Dune","Cedar",5]],"fuel":10,"goal":"Dune","kind":"graph","nodes":["Fjord","Ember","Aster","Beryl","Cedar","Dune"],"plan":["Fjord","Ember","Aster","Beryl","Cedar","Dune"],"start":"Fjord"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0171","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":10,"node":"Fjord"},"reaches_goal":false,"shortest_plan":["Cedar","Dune"],"steps":[{"after":{"fuel":10,"node":"Fjord"},"legal":false}],"valid":false}}
