{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"88223597b4641259bc9ab20f0eb5b15bb01e7ed6ac8b0fed5199f4d24e9d6483","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"amber\":\"TABLE\",\"birch\":\"TABLE\",\"cobalt\":\"TABLE\",\"dahlia\":\"cobalt\"},\"goal_on\":{\"dahlia\":\"TABLE\",\"cobalt\":\"dahlia\",\"birch\":\"TABLE\",\"amber\":\"birch\"},\"plan\":[{\"block\":\"amber\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0094-base-forward-81d6486d1e3b","adv-tags-5eb57e8504c3d777b79d9d48","adj-expansion-v3-e4f99a0ca21cfd4c3e86"],"review_status":"ACCEPTED","reviewed_candidate_hash":"81d6486d1e3b8c455027825ff3aba04e8a7780e625413122f1e41c897d7f1a27","sample_id":"RGM-001-expansion-v3-p0094-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0094","semantic_parent_id":"RGM-001-expansion-v3-p0094","semantic_task":{"goal_on":{"amber":"birch","birch":"TABLE","cobalt":"dahlia","dahlia":"TABLE"},"kind":"blocks","on":{"amber":"TABLE","birch":"TABLE","cobalt":"TABLE","dahlia":"cobalt"},"plan":[{"block":"amber","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0094","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"amber":"TABLE","birch":"TABLE","cobalt":"TABLE","dahlia":"cobalt"},"reaches_goal":false,"shortest_plan":[{"block":"amber","to":"birch"},{"block":"dahlia","to":"TABLE"},{"block":"cobalt","to":"dahlia"}],"steps":[{"after":{"amber":"TABLE","birch":"TABLE","cobalt":"TABLE","dahlia":"cobalt"},"legal":false}],"valid":false}}
