,\"Umber\",2],[\"Umber\",\"Tundra\",1],[\"Quasar\",\"Vesper\",1],[\"Vesper\",\"Sirocco\",1],[\"Vesper\",\"Nacre\",3],[\"Vesper\",\"Obsidian\",6],[\"Sirocco\",\"Vesper\",3],[\"Obsidian\",\"Nacre\",5],[\"Umber\",\"Quasar\",4],[\"Tundra\",\"Quasar\",6],[\"Tundra\",\"Nacre\",4]],\"nodes\":[\"Vesper\",\"Quasar\",\"Sirocco\",\"Nacre\",\"Obsidian\",\"Umber\",\"Tundra\"],\"kind\":\"graph\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0128-matched-reverse-5678dc38d882","adv-tags-07c19dcbc91af83b344ceb14","adj-expansion-v3-e0aaf59665e212c08892"],"review_status":"ACCEPTED","reviewed_candidate_hash":"5678dc38d882066bd9073e8dc4a5654f23ea2ac1c39f4eeb2d4e3da4d296b056","sample_id":"RGM-001-expansion-v3-p0128-matched-reverse","semantic_family_id":"RGM-001-expansion-v3-p0128","semantic_parent_id":"RGM-001-expansion-v3-p0128","semantic_task":{"edges":[["Vesper","Quasar",4],["Quasar","Sirocco",2],["Sirocco","Nacre",1],["Nacre","Obsidian",2],["Obsidian","Umber",2],["Umber","Tundra",1],["Quasar","Vesper",1],["Vesper","Sirocco",1],["Vesper","Nacre",3],["Vesper","Obsidian",6],["Sirocco","Vesper",3],["Obsidian","Nacre",5],["Umber","Quasar",4],["Tundra","Quasar",6],["Tundra","Nacre",4]],"fuel":16,"goal":"Tundra","kind":"graph","nodes":["Vesper","Quasar","Sirocco","Nacre","Obsidian","Umber","Tundra"],"plan":["Obsidian","Umber","Tundra"],"start":"Vesper"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","matched_goal_outcome","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0128","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":7,"node":"Tundra"},"reaches_goal":true,"shortest_plan":["Obsidian","Umber","Tundra"],"steps":[{"after":{"fuel":10,"node":"Obsidian"},"legal":true