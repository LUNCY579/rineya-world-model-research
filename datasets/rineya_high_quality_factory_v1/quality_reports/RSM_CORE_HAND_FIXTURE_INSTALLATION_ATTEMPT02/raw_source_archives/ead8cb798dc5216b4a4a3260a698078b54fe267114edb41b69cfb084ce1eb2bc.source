{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"812901aa6aa33cbacc66350491a533570d6673cd6edbccc9b8c6b5d78f5e0299","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"cobalt\":\"TABLE\",\"birch\":\"cobalt\",\"dahlia\":\"birch\"},\"goal_on\":{\"cobalt\":\"TABLE\",\"dahlia\":\"cobalt\",\"birch\":\"TABLE\"},\"plan\":[{\"block\":\"dahlia\",\"to\":\"TABLE\"},{\"block\":\"birch\",\"to\":\"TABLE\"},{\"block\":\"dahlia\",\"to\":\"cobalt\"},{\"block\":\"birch\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0067-base-forward-8d6cf60bca8a","adv-tags-fe2d1d03b8eb6992afc981b3","adj-expansion-v3-ff7be4a9c50edb8328a3"],"review_status":"ACCEPTED","reviewed_candidate_hash":"8d6cf60bca8a59b8c1626a119d685347d562a7adff4d7a073999515f2dda67db","sample_id":"RGM-001-expansion-v3-p0067-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0067","semantic_parent_id":"RGM-001-expansion-v3-p0067","semantic_task":{"goal_on":{"birch":"TABLE","cobalt":"TABLE","dahlia":"cobalt"},"kind":"blocks","on":{"birch":"cobalt","cobalt":"TABLE","dahlia":"birch"},"plan":[{"block":"dahlia","to":"TABLE"},{"block":"birch","to":"TABLE"},{"block":"dahlia","to":"cobalt"},{"block":"birch","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_explicit_goal_table_roots","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0067","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"birch":"TABLE","cobalt":"TABLE","dahlia":"cobalt"},"reaches_goal":false,"shortest_plan":[{"block":"dahlia","to":"TABLE"},{"block":"birch","to":"TABLE"},{"block":"dahlia","to":"cobalt"}],"steps":[{"after":{"birch":"cobalt","cobalt":"TABLE","dahlia":"TABLE"},"legal":true},{"after":{"birch":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"legal":true},{"after":{"birch":"TABLE","cobalt":"TABLE","dahlia":"cobalt"},"legal":true},{"after":{"birch":"TABLE","cobalt":"TABLE","dahlia":"cobalt"},"legal":false}],"valid":false}}
