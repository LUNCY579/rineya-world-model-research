{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"fe5d2a25be3a635454ed063416b52735db6e2582696c22d254861ebcbd77624f","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"onyx\":\"TABLE\",\"ruby\":\"TABLE\",\"quartz\":\"ruby\",\"pearl\":\"quartz\",\"sapphire\":\"TABLE\"},\"goal_on\":{\"sapphire\":\"TABLE\",\"pearl\":\"sapphire\",\"quartz\":\"TABLE\",\"ruby\":\"quartz\",\"onyx\":\"TABLE\"},\"plan\":[{\"block\":\"pearl\",\"to\":\"sapphire\"},{\"block\":\"quartz\",\"to\":\"TABLE\"},{\"block\":\"ruby\",\"to\":\"quartz\"},{\"block\":\"onyx\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0139-base-forward-67d442978304","adv-tags-0f7c1e84a53bd6f4a4b43a41","adj-expansion-v3-66d7c37babe727e26cc4"],"review_status":"ACCEPTED","reviewed_candidate_hash":"67d442978304ebc4161875878f4966b4731d993f05e791e70f32deb05744e2b7","sample_id":"RGM-001-expansion-v3-p0139-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0139","semantic_parent_id":"RGM-001-expansion-v3-p0139","semantic_task":{"goal_on":{"onyx":"TABLE","pearl":"sapphire","quartz":"TABLE","ruby":"quartz","sapphire":"TABLE"},"kind":"blocks","on":{"onyx":"TABLE","pearl":"quartz","quartz":"ruby","ruby":"TABLE","sapphire":"TABLE"},"plan":[{"block":"pearl","to":"sapphire"},{"block":"quartz","to":"TABLE"},{"block":"ruby","to":"quartz"},{"block":"onyx","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0139","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"onyx":"TABLE","pearl":"sapphire","quartz":"TABLE","ruby":"quartz","sapphire":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"pearl","to":"sapphire"},{"block":"quartz","to":"TABLE"},{"block":"ruby","to":"quartz"}],"steps":[{"after":{"onyx":"TABLE","pearl":"sapphire","quartz":"ruby","ruby":"TABLE","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"TABLE","pearl":"sapphire","quartz":"TABLE","ruby":"TABLE","sapphire":"TABLE"},"le