{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"5b956f4bb20bd15f1a57488ca9baaeb6d6d891ac3fdf6a1bc22fd45a73c62e0c","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"cobalt\":\"TABLE\",\"dahlia\":\"cobalt\",\"birch\":\"dahlia\"},\"goal_on\":{\"dahlia\":\"TABLE\",\"cobalt\":\"dahlia\",\"birch\":\"TABLE\"},\"plan\":[{\"block\":\"birch\",\"to\":\"TABLE\"},{\"block\":\"dahlia\",\"to\":\"TABLE\"},{\"block\":\"cobalt\",\"to\":\"dahlia\"},{\"block\":\"birch\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0107-base-forward-61e1fe596303","adv-tags-c775ed824f45f4109f98f5c6","adj-expansion-v3-e46bb61fb82326ac53ac"],"review_status":"ACCEPTED","reviewed_candidate_hash":"61e1fe596303daeb5b94a175e0cf74b946f365ec002976e4ab2327ce2b9a10c2","sample_id":"RGM-001-expansion-v3-p0107-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0107","semantic_parent_id":"RGM-001-expansion-v3-p0107","semantic_task":{"goal_on":{"birch":"TABLE","cobalt":"dahlia","dahlia":"TABLE"},"kind":"blocks","on":{"birch":"dahlia","cobalt":"TABLE","dahlia":"cobalt"},"plan":[{"block":"birch","to":"TABLE"},{"block":"dahlia","to":"TABLE"},{"block":"cobalt","to":"dahlia"},{"block":"birch","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_explicit_goal_table_roots","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0107","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"birch":"TABLE","cobalt":"dahlia","dahlia":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"birch","to":"TABLE"},{"block":"dahlia","to":"TABLE"},{"block":"cobalt","to":"dahlia"}],"steps":[{"after":{"birch":"TABLE","cobalt":"TABLE","dahlia":"cobalt"},"legal":true},{"after":{"birch":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"legal":true},{"after":{"birch":"TABLE","cobalt":"dahlia","dahlia":"TABLE"},"legal":true},{"after":{"birch":"TABLE","cobalt":"dahlia","dahlia":"TABLE"},"legal":false}],"valid":false}}
