{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"5522c34de0a75a622ba7059e6d36933fdb3b9bbeeb89787a8ce5d103dbea93b1","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"pearl\":\"TABLE\",\"sapphire\":\"TABLE\",\"onyx\":\"TABLE\",\"quartz\":\"onyx\",\"ruby\":\"quartz\"},\"goal_on\":{\"sapphire\":\"onyx\",\"pearl\":\"ruby\",\"onyx\":\"quartz\",\"ruby\":\"TABLE\"},\"plan\":[{\"block\":\"ruby\",\"to\":\"TABLE\"},{\"block\":\"pearl\",\"to\":\"ruby\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0069-base-forward-df6926ab8fcc","adv-tags-cb9b73b8ab0d2a7ebe97a3c6","adj-expansion-v3-79360d3a789d3e3e5198"],"review_status":"ACCEPTED","reviewed_candidate_hash":"df6926ab8fccb94aa9a66f9ac7750d4bc7b90286c6293ed1a58aafa6e6787c5a","sample_id":"RGM-001-expansion-v3-p0069-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0069","semantic_parent_id":"RGM-001-expansion-v3-p0069","semantic_task":{"goal_on":{"onyx":"quartz","pearl":"ruby","ruby":"TABLE","sapphire":"onyx"},"kind":"blocks","on":{"onyx":"TABLE","pearl":"TABLE","quartz":"onyx","ruby":"quartz","sapphire":"TABLE"},"plan":[{"block":"ruby","to":"TABLE"},{"block":"pearl","to":"ruby"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0069","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"onyx":"TABLE","pearl":"ruby","quartz":"onyx","ruby":"TABLE","sapphire":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"ruby","to":"TABLE"},{"block":"pearl","to":"ruby"},{"block":"quartz","to":"TABLE"},{"block":"onyx","to":"quartz"},{"block":"sapphire","to":"onyx"}],"steps":[{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"onyx","ruby":"TABLE","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"TABLE","pearl":"ruby","quartz":"onyx","ruby":"TABLE","sapphire":"TABLE"},"legal":true}],"valid":true}}
{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"38c8bb2dd925126edf75e55c8bdab5d408c786cc0f4ceb71da52c3757aec3d04","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"plan\":[{\"to\":\"TABLE\",\"block\":\"ruby\"},{\"to\":\"ruby\",\"block\":\"pearl\"}],\"goal_on\":{\"ruby\":\"TABLE\",\"onyx\":\"