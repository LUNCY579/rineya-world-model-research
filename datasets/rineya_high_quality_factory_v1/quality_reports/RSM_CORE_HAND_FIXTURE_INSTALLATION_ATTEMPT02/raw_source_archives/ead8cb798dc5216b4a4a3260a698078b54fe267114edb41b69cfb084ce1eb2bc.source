{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":3,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"54274dfb23d3153c44fe0d3ba50f5c10e144f0e085e24ccf5ec3852cd97cf134","rendered_input":"Graph contract: kind=graph. nodes contains distinct strings. edges contains [from,to,cost] triples with positive integer fuel costs and at most one edge per ordered pair. start and goal are nodes; fuel is a nonnegative integer. plan is an ordered list of destination node names. Every edge is directed. Start at {node:start,fuel:fuel}. An action is legal exactly when an edge from the current node to its destination exists and its cost is at most the remaining fuel. A legal move changes node to its destination and subtracts the edge cost. At the first illegal action, include that action's {legal:false,after:unchanged_state} step, stop immediately, and do not evaluate subsequent actions. An empty plan is valid. valid means every proposed action was legal. reaches_goal is true exactly when the whole plan is valid and its terminal node is goal, including an initially satisfied goal with an empty plan. shortest_plan is a fresh plan from the INITIAL state that reaches goal within initial fuel, minimizes the number of moves, and breaks ties by the lexicographic order of the entire destination-name sequence. It is [] for an initially satisfied goal and null if no feasible plan exists. Fuel cost is a feasibility constraint, not the optimization objective. Return exactly a JSON object with steps:[{legal:boolean,after:{node:string,fuel:integer}}], after:{node:string,fuel:integer}, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"plan\":[\"Sirocco\"],\"fuel\":21,\"goal\":\"Sirocco\",\"start\":\"Nacre\",\"edges\":[[\"Nacre\",\"Vesper\",3],[\"Vesper\",\"Obsidian\",3],[\"Obsidian\",\"Tundra\",1],[\"Tundra\",\"Quasar\",3],[\"Quasar\",\"Umber\",4],[\"Umber\",\"Zephyr\",1],[\"Zephyr\",\"Sirocco\",2],[\"Vesper\",\"Nacre\",1],[\"Nacre\",\"Zephyr\",5],[\"Nacre\",\"Sirocco\",5],[\"Vesper\",\"Sirocco\",4],[\"Obsidian\",\"Sirocco\",2],[\"Tundra\",\"Nacre\",3],[\"Quasar\",\"Sirocco\",1],[\"Umber\",\"Nacre\",6],[\"Umber\",\"Vesper\",3],[\"Umber\",\"Sirocco\",2],[\"Zephyr\",\"Obsidian\",2],[\"Zephyr\",\"Umber\",3],[\"Sirocco\",\"Nacre\",3],[\"Sirocco\",\"Quasar\",5],[\"Sirocco\",\"Zephyr\",2]],\"nodes\":[\"Nacre\",\"Vesper\",\"Obsidian\",\"Tundra\",\"Quasar\",\"Umber\",\"Zephyr\",\"Sirocco\"],\"kind\":\"graph\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0098-matched-reverse-b275809a9106","adv-tags-0a40397f9a7242fea6f8f2ee","adj-expansion-v3-78f06106a7a557d2094f"],"review_status":"ACCEPTED","reviewed_candidate_hash":"b275809a9106f137df50ae921a75bcfed19d257f7a5d9afd31eae283b80a2069","sample_id":"RGM-001-expansion-v3-p0098-matched-reverse","semantic_family_id":"RGM-001-expansion-v3-p0098","semantic_parent_id":"RGM-001-expansion-v3-p0098","semantic_task":{"edges":[["Nacre","Vesper",3],["Vesper","Obsidian",3],["Obsidian","Tundra",1],["Tundra","Quasar",3],["Quasar","Umber",4],["Umber","Zephyr",1],["Zephyr","Sirocco",2],["Vesper","Nacre",1],["Nacre","Zephyr",5],["Nacre","Sirocco",5],["Vesper","Sirocco",4],["Obsidian","Sirocco",2],["Tundra","Nacre",3],["Quasar","Sirocco",1],["Umber","Nacre",6],["Umber","Vesper",3],["Umber","Sirocco",2],["Zephyr","Obsidian",2],["Zephyr","Umber",3],["Sirocco","Nacre",3],["Sirocco","Quasar",5],["Sirocco","Zephyr",2]],"fuel":21,"goal":"Sirocco","kind":"graph","nodes":["Nacre","Vesper","Obsidian","Tundra","Quasar","Umber","Zephyr","Sirocco"],"plan":["Sirocco"],"start":"Nacre"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","matched_goal_outcome","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0098","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":16,"node":"Sirocco"},"reaches_goal":true,"shortest_plan":["Sirocco"],"steps":[{"after":{"fuel":16,"node":"Sirocco"},"legal":true}],"valid":true}}
{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"e6800992ff361e909fb8ad37641ee8a5057b38f55bb76e81e435cc5e143ee80a","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"quartz\":\"TABLE\",\"ruby\":\"TABLE\",\"onyx\":\"TABLE\",\"sapphire\":\"TABLE\",\"pearl\":\"sapphire\"},\"goal_on\":{\"onyx\":\"TABLE\",\"quartz\":\"pearl\",\"pearl\":\"TABLE\",\"ruby\":\"onyx\"},\"plan\":[{\"block\":\"pearl\",\"to\":\"TABLE\"},{\"block\":\"quartz\",\"to\":\"pearl\"},{\"block\":\"ruby\",\"to\":\"onyx\"},{\"block\":\"onyx\",\"to\":\"TABLE\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0099-base-forward-4122ce5c6001","adv-tags-25f3992d58bc9926bf81278f","adj-expansion-v3-5294d49c95e6f1b8b7fe"],"review_status":"ACCEPTED","reviewed_candidate_hash":"4122ce5c6001beb5f5f0d1279090e4afc7dbf4b927a9fa7d6de1e53cd08c9bc5","sample_id":"RGM-001-expansion-v3-p0099-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0099","semantic_parent_id":"RGM-001-expansion-v3-p0099","semantic_task":{"goal_on":{"onyx":"TABLE","pearl":"TABLE","quartz":"pearl","ruby":"onyx"},"kind":"blocks","on":{"onyx":"TABLE","pearl":"sapphire","quartz":"TABLE","ruby":"TABLE","sapphire":"TABLE"},"plan":[{"block":"pearl","to":"TABLE"},{"block":"quartz","to":"pearl"},{"block":"ruby","to":"onyx"},{"block":"onyx","to":"TABLE"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0099","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"pearl","ruby":"onyx","sapphire":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"pearl","to":"TABLE"},{"block":"quartz","to":"pearl"},{"block":"ruby","to":"onyx"}],"steps":[{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"TABLE","ruby":"TABLE","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"pearl","ruby":"TABLE","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"pearl","r