nodes\":[\"Aster\",\"Fjord\",\"Dune\",\"Beryl\",\"Cedar\",\"Ember\"],\"kind\":\"graph\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0031-base-reverse-7644f2ed16d4","adv-tags-bed8ed840e253471d1122361","adj-expansion-v3-2e2714177939e86bcfb3"],"review_status":"ACCEPTED","reviewed_candidate_hash":"7644f2ed16d41ed849f6fb0001aa0b42f6f43b10e06650e1e3d659b836e113da","sample_id":"RGM-001-expansion-v3-p0031-base-reverse","semantic_family_id":"RGM-001-expansion-v3-p0031","semantic_parent_id":"RGM-001-expansion-v3-p0031","semantic_task":{"edges":[["Aster","Fjord",4],["Fjord","Dune",2],["Dune","Beryl",2],["Beryl","Cedar",2],["Cedar","Ember",4],["Aster","Ember",15],["Cedar","Beryl",2]],"fuel":14,"goal":"Ember","kind":"graph","nodes":["Aster","Fjord","Dune","Beryl","Cedar","Ember"],"plan":["Ember","Fjord","Ember"],"start":"Aster"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0031","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":14,"node":"Aster"},"reaches_goal":false,"shortest_plan":["Fjord","Dune","Beryl","Cedar","Ember"],"steps":[{"after":{"fuel":14,"node":"Aster"},"legal":false}],"valid":false}}
{"challenge_axes":[],"difficulty":1,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"9d3d0a59b0a399651a55bec6044e061abf3ffc4610b3868671e4562bb72ae55e","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"dahlia\":\"TABLE\",\"cobalt\":\"dahlia\",\"birch\":\"TABLE\"},\"goal_on\":{\"birch\":\"TABLE\",\"dahlia\":\"TABLE\",\"cobalt\":\"dahlia\"},\"plan\":[]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0032-base-forward-db1dba16e2bd","adv-tags-2b4e3cf97a1800c2d2249afe","adj-expansion-v3-4bb0e7475e8c27e532f4"],"review_status":"ACCEPTED","reviewed_candidate_hash":"db1dba16e2bd27fa646b152a59391015e4ab252f86ec9e5d1796374d68f53cd1","sample_id":"RGM-001-expansion-v3-p0032-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0032","semantic_parent_id":"RGM-001-expansion-v3-p0032","semantic_task":{"goal_on":{"birch":"TABLE","cobalt":"dahlia","dahlia":"TABLE"},"kind":"blocks","on":{"birch":"TABLE","cobalt":"dahlia","dahlia":"TABLE"},"plan":[]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","valid_plan","goal_satisfaction"],"source_family_key":"RGM-001-seed20261009-p0032","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":1,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"birch":"TABLE","cobalt":"dahlia","dahlia":"TABLE"},"reaches_goal":true,"shortest_plan":[],"steps":[],"valid":true}}
