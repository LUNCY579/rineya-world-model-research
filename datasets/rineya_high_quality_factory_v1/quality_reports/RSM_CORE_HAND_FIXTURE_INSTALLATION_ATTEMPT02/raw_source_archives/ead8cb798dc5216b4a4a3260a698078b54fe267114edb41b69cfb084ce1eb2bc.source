{"challenge_axes":[],"difficulty":2,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"10cf5512578304ae0a590e3fea76b6fa000028e5c83fde6208eee4d2459df2e7","rendered_input":"Graph contract: kind=graph. nodes contains distinct strings. edges contains [from,to,cost] triples with positive integer fuel costs and at most one edge per ordered pair. start and goal are nodes; fuel is a nonnegative integer. plan is an ordered list of destination node names. Every edge is directed. Start at {node:start,fuel:fuel}. An action is legal exactly when an edge from the current node to its destination exists and its cost is at most the remaining fuel. A legal move changes node to its destination and subtracts the edge cost. At the first illegal action, include that action's {legal:false,after:unchanged_state} step, stop immediately, and do not evaluate subsequent actions. An empty plan is valid. valid means every proposed action was legal. reaches_goal is true exactly when the whole plan is valid and its terminal node is goal, including an initially satisfied goal with an empty plan. shortest_plan is a fresh plan from the INITIAL state that reaches goal within initial fuel, minimizes the number of moves, and breaks ties by the lexicographic order of the entire destination-name sequence. It is [] for an initially satisfied goal and null if no feasible plan exists. Fuel cost is a feasibility constraint, not the optimization objective. Return exactly a JSON object with steps:[{legal:boolean,after:{node:string,fuel:integer}}], after:{node:string,fuel:integer}, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"graph\",\"nodes\":[\"Cedar\",\"Ember\",\"Aster\"],\"edges\":[[\"Cedar\",\"Ember\",2],[\"Ember\",\"Aster\",2]],\"start\":\"Cedar\",\"goal\":\"Aster\",\"fuel\":4,\"plan\":[\"Ember\"]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0133-base-forward-71495864048d","adv-tags-45a98c087a1cb2353a27df0c","adj-expansion-v3-1d7f28478f00c7c24484"],"review_status":"ACCEPTED","reviewed_candidate_hash":"71495864048de9f766aae312f2fafaee245a1a890833d2e23254ff1b6e96fdfa","sample_id":"RGM-001-expansion-v3-p0133-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0133","semantic_parent_id":"RGM-001-expansion-v3-p0133","semantic_task":{"edges":[["Cedar","Ember",2],["Ember","Aster",2]],"fuel":4,"goal":"Aster","kind":"graph","nodes":["Cedar","Ember","Aster"],"plan":["Ember"],"start":"Cedar"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","single_successor_resource_graph","graph","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0133","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":2,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":2,"node":"Ember"},"reaches_goal":false,"shortest_plan":["Ember","Aster"],"steps":[{"after":{"fuel":2,"node":"Ember"},"legal":true}],"valid":true}}
