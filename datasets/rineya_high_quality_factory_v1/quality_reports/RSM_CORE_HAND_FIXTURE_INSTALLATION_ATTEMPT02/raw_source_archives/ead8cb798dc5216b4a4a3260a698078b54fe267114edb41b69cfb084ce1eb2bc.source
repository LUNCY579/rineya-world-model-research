cre\",\"Zephyr\",3],[\"Zephyr\",\"Quasar\",2],[\"Sirocco\",\"Zephyr\",3],[\"Nacre\",\"Vesper\",3],[\"Nacre\",\"Umber\",4]],\"nodes\":[\"Vesper\",\"Tundra\",\"Sirocco\",\"Umber\",\"Nacre\",\"Zephyr\",\"Quasar\"],\"kind\":\"graph\"}","renderer":"reverse","review_receipt_ids":["expert-RGM-001-expansion-v3-p0148-matched-reverse-eb01ad904422","adv-tags-1b118b806773c60d031c7215","adj-expansion-v3-f791c72069689624aeae"],"review_status":"ACCEPTED","reviewed_candidate_hash":"eb01ad9044220acef17b77c1332272b894365214984c7abe64cea7fbc2dd049c","sample_id":"RGM-001-expansion-v3-p0148-matched-reverse","semantic_family_id":"RGM-001-expansion-v3-p0148","semantic_parent_id":"RGM-001-expansion-v3-p0148","semantic_task":{"edges":[["Vesper","Tundra",2],["Tundra","Sirocco",2],["Sirocco","Umber",3],["Umber","Nacre",2],["Nacre","Zephyr",3],["Zephyr","Quasar",2],["Sirocco","Zephyr",3],["Nacre","Vesper",3],["Nacre","Umber",4]],"fuel":14,"goal":"Quasar","kind":"graph","nodes":["Vesper","Tundra","Sirocco","Umber","Nacre","Zephyr","Quasar"],"plan":["Tundra","Sirocco","Zephyr","Quasar"],"start":"Vesper"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","matched_goal_outcome","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0148","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":5,"node":"Quasar"},"reaches_goal":true,"shortest_plan":["Tundra","Sirocco","Zephyr","Quasar"],"steps":[{"after":{"fuel":12,"node":"Tundra"},"legal":true},{"after":{"fuel":10,"node":"Sirocco"},"legal":true},{"after":{"fuel":7,"node":"Zephyr"},"legal":true},{"after":{"fuel":5,"node":"Quasar"},"legal":true}],"valid":true}}
{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"17246b3148fea5a974d5a07b3e69eacc95a239336dda74742638c0a38e8c09b1","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"onyx\":\"TABLE\",\"quartz\":\"TABLE\",\"ruby\":\"TABLE\",\"pearl\":\"TABLE\",\"sapphire\":\"TABLE\"},\"goal_on\":{\"pearl\":\"TABLE\",\"ruby\":\"pearl\",\"quartz\":\"ruby\",\"sapphire\":\"quartz\",\"onyx\":\"TABLE\"},\"plan\":[{\"block\":\"ruby\",\"to\":\"pearl\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0149-base-forward-8a8b499551d0","adv-tags-3487bbb66cfb1315f7b01c5f","adj-expansion-v3-5765ac9ec42e3d5c9158"],"review_status":"ACCEPTED","reviewed_candidate_hash":"8a8b499551d0b153d72abb332acb26b70dee079665e5a5c6134ccb8f9b1ba2e1","sample_id":"RGM-001-expansion-v3-p0149-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0149","semantic_parent_id":"RGM-001-expansion-v3-p0149","semantic_task":{"goal_on":{"onyx":"TABLE","pearl":"TABLE","quartz":"ruby","ruby":"pearl","sapphire":"quartz"},"kind":"blocks","on":{"onyx":"TABLE","pearl":"TABLE","quartz":"TABLE","ruby":"TABLE","sapphire":"TABLE"},"plan":[{"block":"ruby","to":"pearl"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","valid_plan"],"source_family_key":"RGM-001-seed20261009-p0149","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"TABLE","ruby":"pearl","sapphire":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"ruby","to":"pearl"},{"block":"quartz","to":"ruby"},{"block":"sapphire","to":"quartz"}],"steps":[{"after":{"onyx":"TABLE","pearl":"TABLE","quartz":"TABLE","ruby":"pearl","sapphire":"TABLE"},"legal":true}],"valid":true}}
{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"942433022120a8be1cf28948ccf66fc0c5d7cf3dd79fcd76443a04b4f294d175","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"plan\":[{\"to\":\"pearl\",\"block\":\"ruby\"}],\"goal_on\":{\"onyx\":\"TABLE\",\"sapphire\":\"quartz\",\"quartz\":\"ruby\",\"rub