":["Sirocco","Nacre","Umber","Vesper","Obsidian","Zephyr","Tundra"],"steps":[{"after":{"fuel":13,"node":"Sirocco"},"legal":true},{"after":{"fuel":10,"node":"Nacre"},"legal":true},{"after":{"fuel":9,"node":"Umber"},"legal":true},{"after":{"fuel":7,"node":"Vesper"},"legal":true},{"after":{"fuel":6,"node":"Obsidian"},"legal":true},{"after":{"fuel":2,"node":"Zephyr"},"legal":true},{"after":{"fuel":0,"node":"Tundra"},"legal":true}],"valid":true}}
{"challenge_axes":["heldout_names","larger_graph_or_block_count"],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"917633e0fce76b908a14190e194b0290c28f0a8b4bda4ab48a25c0b205b533d8","rendered_input":"Blocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"blocks\",\"on\":{\"sapphire\":\"TABLE\",\"onyx\":\"TABLE\",\"ruby\":\"onyx\",\"pearl\":\"ruby\",\"quartz\":\"pearl\"},\"goal_on\":{\"pearl\":\"TABLE\",\"sapphire\":\"TABLE\",\"quartz\":\"TABLE\",\"onyx\":\"quartz\",\"ruby\":\"TABLE\"},\"plan\":[{\"block\":\"quartz\",\"to\":\"TABLE\"},{\"block\":\"pearl\",\"to\":\"TABLE\"},{\"block\":\"ruby\",\"to\":\"TABLE\"},{\"block\":\"onyx\",\"to\":\"quartz\"},{\"block\":\"onyx\",\"to\":\"quartz\"}]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0059-base-forward-45f3b2ed27b0","adv-tags-8160336ae8a9d083f070ebdf","adj-expansion-v3-a6ad17a83e5cb3b1f232"],"review_status":"ACCEPTED","reviewed_candidate_hash":"45f3b2ed27b0fa83e32eeea8985e81d1cc8aecb3f8e7889108b4b805c4195038","sample_id":"RGM-001-expansion-v3-p0059-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0059","semantic_parent_id":"RGM-001-expansion-v3-p0059","semantic_task":{"goal_on":{"onyx":"quartz","pearl":"TABLE","quartz":"TABLE","ruby":"TABLE","sapphire":"TABLE"},"kind":"blocks","on":{"onyx":"TABLE","pearl":"ruby","quartz":"pearl","ruby":"onyx","sapphire":"TABLE"},"plan":[{"block":"quartz","to":"TABLE"},{"block":"pearl","to":"TABLE"},{"block":"ruby","to":"TABLE"},{"block":"onyx","to":"quartz"},{"block":"onyx","to":"quartz"}]},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","multiple_initial_table_stacks","blocks","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0059","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"onyx":"quartz","pearl":"TABLE","quartz":"TABLE","ruby":"TABLE","sapphire":"TABLE"},"reaches_goal":false,"shortest_plan":[{"block":"quartz","to":"TABLE"},{"block":"pearl","to":"TABLE"},{"block":"ruby","to":"TABLE"},{"block":"onyx","to":"quartz"}],"steps":[{"after":{"onyx":"TABLE","pearl":"ruby","quartz":"TABLE","ruby":"onyx","sapphire":"TABLE"},"legal":true},{"after":{"onyx":"TABLE",