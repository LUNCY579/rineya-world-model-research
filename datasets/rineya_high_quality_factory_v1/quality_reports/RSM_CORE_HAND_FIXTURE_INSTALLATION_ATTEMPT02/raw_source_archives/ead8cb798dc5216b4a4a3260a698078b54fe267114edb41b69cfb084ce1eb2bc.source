{"challenge_axes":[],"difficulty":4,"generation_seed":20261009,"generator_version":"1.3.2","oracle_version":"independent-1.0.0","record_hash":"e509d4d53596fb8571b3ca03c11b5ea6962bd76b48709c88633ce8628df6b95b","rendered_input":"Graph contract: kind=graph. nodes contains distinct strings. edges contains [from,to,cost] triples with positive integer fuel costs and at most one edge per ordered pair. start and goal are nodes; fuel is a nonnegative integer. plan is an ordered list of destination node names. Every edge is directed. Start at {node:start,fuel:fuel}. An action is legal exactly when an edge from the current node to its destination exists and its cost is at most the remaining fuel. A legal move changes node to its destination and subtracts the edge cost. At the first illegal action, include that action's {legal:false,after:unchanged_state} step, stop immediately, and do not evaluate subsequent actions. An empty plan is valid. valid means every proposed action was legal. reaches_goal is true exactly when the whole plan is valid and its terminal node is goal, including an initially satisfied goal with an empty plan. shortest_plan is a fresh plan from the INITIAL state that reaches goal within initial fuel, minimizes the number of moves, and breaks ties by the lexicographic order of the entire destination-name sequence. It is [] for an initially satisfied goal and null if no feasible plan exists. Fuel cost is a feasibility constraint, not the optimization objective. Return exactly a JSON object with steps:[{legal:boolean,after:{node:string,fuel:integer}}], after:{node:string,fuel:integer}, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\nTask JSON:\n{\"kind\":\"graph\",\"nodes\":[\"Fjord\",\"Aster\",\"Cedar\",\"Dune\",\"Ember\"],\"edges\":[[\"Fjord\",\"Aster\",3],[\"Aster\",\"Cedar\",1],[\"Cedar\",\"Dune\",3],[\"Dune\",\"Ember\",4],[\"Aster\",\"Fjord\",1],[\"Fjord\",\"Dune\",2],[\"Dune\",\"Aster\",6],[\"Ember\",\"Cedar\",4]],\"start\":\"Fjord\",\"goal\":\"Ember\",\"fuel\":11,\"plan\":[\"Aster\",\"Fjord\",\"Aster\",\"Fjord\",\"Aster\",\"Fjord\",\"Aster\",\"Fjord\",\"Aster\",\"Fjord\",\"Aster\",\"Fjord\",\"Aster\",\"Fjord\",\"Aster\",\"Fjord\",\"Aster\",\"Fjord\",\"Aster\",\"Fjord\",\"Aster\",\"Fjord\",\"Aster\",\"Fjord\",\"Ember\"]}","renderer":"forward","review_receipt_ids":["expert-RGM-001-expansion-v3-p0170-base-forward-079f0a363cfc","adv-tags-3d77bf1fef45dd9e30d54ec6","adj-expansion-v3-b52e01dabad4885861f7"],"review_status":"ACCEPTED","reviewed_candidate_hash":"079f0a363cfcb36dce8e9a4c901ea4d05900c992e0c813369229d0d231b8404c","sample_id":"RGM-001-expansion-v3-p0170-base-forward","semantic_family_id":"RGM-001-expansion-v3-p0170","semantic_parent_id":"RGM-001-expansion-v3-p0170","semantic_task":{"edges":[["Fjord","Aster",3],["Aster","Cedar",1],["Cedar","Dune",3],["Dune","Ember",4],["Aster","Fjord",1],["Fjord","Dune",2],["Dune","Aster",6],["Ember","Cedar",4]],"fuel":11,"goal":"Ember","kind":"graph","nodes":["Fjord","Aster","Cedar","Dune","Ember"],"plan":["Aster","Fjord","Aster","Fjord","Aster","Fjord","Aster","Fjord","Aster","Fjord","Aster","Fjord","Aster","Fjord","Aster","Fjord","Aster","Fjord","Aster","Fjord","Aster","Fjord","Aster","Fjord","Ember"],"start":"Fjord"},"skill_tags":["relational_planning","state_transition","preconditions","canonical_shortest_plan","branched_resource_graph","graph","invalid_plan"],"source_family_key":"RGM-001-seed20261009-p0170","source_provenance":{"license":"repository-private-research","origin":"original_synthetic","sealed_evaluation_used":false},"split":"train","structural_difficulty":4,"target_format":"structured","track_id":"RGM-001","verified_target":{"after":{"fuel":0,"node":"Aster"},"reaches_goal":false,"shortest_plan":["Dune","Ember"],"steps":[{"after":{"fuel":8,"node":"Aster"},"legal":true},{"after":{"fuel":7,"node":"Fjord"},"legal":true},{"after":{"fuel":4,"node":"Aster"},"legal":true},{"after":{"fuel":3,"node":"Fjord"},"legal":true},{"