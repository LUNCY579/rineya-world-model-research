est_plan":[{"block":"birch","to":"TABLE"},{"block":"amber","to":"birch"},{"block":"dahlia","to":"amber"}],"steps":[{"after":{"amber":"dahlia","birch":"TABLE","dahlia":"TABLE"},"legal":true},{"after":{"amber":"birch","birch":"TABLE","dahlia":"TABLE"},"legal":true},{"after":{"amber":"birch","birch":"TABLE","dahlia":"amber"},"legal":true}],"valid":true}}
