"Beryl\"],\"kind\":\"graph\"}","target":{"after":{"fuel":2,"node":"Cedar"},"reaches_goal":false,"shortest_plan":["Beryl"],"steps":[{"after":{"fuel":7,"node":"Fjord"},"legal":true},{"after":{"fuel":6,"node":"Cedar"},"legal":true},{"after":{"fuel":3,"node":"Fjord"},"legal":true},{"after":{"fuel":2,"node":"Cedar"},"legal":true},{"after":{"fuel":2,"node":"Cedar"},"legal":false}],"valid":false}}
