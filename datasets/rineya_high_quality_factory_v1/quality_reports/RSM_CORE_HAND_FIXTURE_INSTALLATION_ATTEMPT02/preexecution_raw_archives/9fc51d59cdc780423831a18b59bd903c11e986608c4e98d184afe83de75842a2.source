"cobalt":"TABLE","dahlia":"TABLE"},"reaches_goal":true,"shortest_plan":[{"block":"amber","to":"dahlia"},{"block":"cobalt","to":"TABLE"},{"block":"birch","to":"amber"}],"steps":[{"after":{"amber":"dahlia","birch":"TABLE","cobalt":"birch","dahlia":"TABLE"},"legal":true},{"after":{"amber":"dahlia","birch":"TABLE","cobalt":"TABLE","dahlia":"TABLE"},"legal":true},{"after":{"amber":"dahlia","birch":"amber","cobalt":"TABLE","dahlia":"TABLE"},"legal":true}],"valid":true}}
