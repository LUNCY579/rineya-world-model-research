ode":"Fjord"},"reaches_goal":true,"shortest_plan":["Cedar","Fjord"],"steps":[{"after":{"fuel":17,"node":"Ember"},"legal":true},{"after":{"fuel":15,"node":"Fjord"},"legal":true}],"valid":true}}
