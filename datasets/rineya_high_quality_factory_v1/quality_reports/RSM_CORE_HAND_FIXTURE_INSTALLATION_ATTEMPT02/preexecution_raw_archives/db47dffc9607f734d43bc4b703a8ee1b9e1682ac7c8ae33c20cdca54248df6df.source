event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2},{"bindings":{"c":2},"call_site":{"body_path":[0,"then"],"caller_instance":1,"index":1},"event":"enter","initiation_ok":true,"instance_id":2,"option":"leaf"},{"body_path":[],"event":"effect","index":0,"instance_id":2,"op":"swap","option":"leaf","state":{"x":1,"y":6}},{"body_path":[],"event":"effect","index":1,"instance_id":2,"op":"add","option":"leaf","register":"x","state":{"x":3,"y":6},"value":2},{"event":"return","instance_id":2,"option":"leaf","success_ok":true},{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":3,"y":8},"value":2},{"event":"return","instance_id":0,"option":"root","success_ok":true}],"next_event":null,"previous_effects":0,"status":"completed"}}
{"controlled_context":"R","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 forward","controlled_context":"R","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-191","arbitrary-193"],"renderer":"forward","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-195"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-193","arbitrary-197"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-197","arbitrary-199"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-191","arbitrary-201"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-203"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-205"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-207"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 R","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-193","arbitrary-194"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"891fee6f37b6c9c8018a2f0b1e64af6cfd22e75fa0f26583bf2013538e62ae65","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"kind\":\"option_resume\",\"version\":1,\"initial_state\":{\"x\":2,\"y\":1},\"options\":{\"root\":{\"params\":[\"a\"],\"initiation\":{\"all\":[{\"left\":{\"param\":\"a\"},\"cmp\":\"ge\",\"right\":{\"const\":1}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}},{\"left\":{\"reg\":\"y\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"body\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"a\"}},{\"op\":\"call\",\"option\":\"child\",\"args\":{\"b\":{\"param\":\"a\"}}},{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"a\"}}]},\"child\":{\"params\":[\"b\"],\"initiation\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":4}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}}]},\"body\":[{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"then\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"b\"}},{\"op\":\"call\",\"option\":\"leaf\",\"args\":{\"c\":{\"param\":\"b\"}}}],\"else\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":{\"const\":1}}]}]},\"leaf\":{\"params\":[\"c\"],\"initiation\":{\"all\":[]},\"success\":{\"all\":[]},\"body\":[{\"op\":\"swap\"},{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"c\"}}]}},\"entry\":{\"option\":\"root\",\"args\":{\"a\":{\"reg\":\"x\"}}},\"mode\":\"resume\",\"history\":[{\"event\":\"enter\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"call_site\":null,\"initiation_ok\":true},{\"event\":\"effect\",\"instance_id\":0,\"option\":\"root\",\"body_path\":[],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":4,\"y\":1}},{\"event\":\"enter\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"call_site\":{\"caller_instance\":0,\"body_path\":[],\"index\":1},\"initiation_ok\":true},{\"event\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[],\"index\":0,\"condition\":true},{\"event\":\"effect\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[0,\"then\"],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":6,\"y\":1}}],\"checkpoint\":{\"state\":{\"x\":6,\"y\":1},\"frames\":[{\"frame_kind\":\"option\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"body_path\":[],\"next_index\":2},{\"frame_kind\":\"option\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[],\"next_index\":1},{\"frame_kind\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[0,\"then\"],\"next_index\":1}],\"next_instance_id\":2,\"root_pending\":false,\"phase\":\"running\"},\"event_budget\":48}","renderer":"forward","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-193","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-R","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":1}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"resume","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":3,"phase":"completed","root_pending":false,"state":{"x":3,"y":8}},"error":null,"new_effects":3,"new_events":[{"bindings":{"c":2},"call_site":{"body_path":[0,"then"],"caller_instance":1,"index":1},"event":"enter","initiation_ok":true,"instance_id":2,"option":"leaf"},{"body_path":[],"event":"effect","index":0,"instance_id":2,"op":"swap","option":"leaf","state":{"x":1,"y":6}},{"body_path":[],"event":"effect","index":1,"instance_id":2,"op":"add","option":"leaf","register":"x","state":{"x":3,"y":6},"value":2},{"event":"return","instance_id":2,"option":"leaf","success_ok":true},{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":3,"y":8},"value":2},{"event":"return","instance_id":0,"option":"root","success_ok":true}],"next_event":null,"previous_effects":2,"status":"completed"}}
{"controlled_context":"R","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 reverse","controlled_context":"R","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-192","arbitrary-194"],"renderer":"reverse","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-196"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-194","arbitrary-198"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-198","arbitrary-200"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-192","arbitrary-202"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-204"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-206"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-208"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 R","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-193","arbitrary-194"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"2c11a4e9c16b9457995d8f7b8e05096a78e600fc1515f39a378d4284f7eb0b8d","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"event_budget\":48,\"checkpoint\":{\"phase\":\"running\",\"root_pending\":false,\"next_instance_id\":2,\"frames\":[{\"next_index\":2,\"body_path\":[],\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[0,\"then\"],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"branch\"}],\"state\":{\"y\":1,\"x\":6}},\"history\":[{\"initiation_ok\":true,\"call_site\":null,\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"event\":\"enter\"},{\"state\":{\"y\":1,\"x\":4},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[],\"option\":\"root\",\"instance_id\":0,\"event\":\"effect\"},{\"initiation_ok\":true,\"call_site\":{\"index\":1,\"body_path\":[],\"caller_instance\":0},\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"event\":\"enter\"},{\"condition\":true,\"index\":0,\"body_path\":[],\"option\":\"child\",\"instance_id\":1,\"event\":\"branch\"},{\"state\":{\"y\":1,\"x\":6},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[0,\"then\"],\"option\":\"child\",\"instance_id\":1,\"event\":\"effect\"}],\"mode\":\"resume\",\"entry\":{\"args\":{\"a\":{\"reg\":\"x\"}},\"option\":\"root\"},\"options\":{\"leaf\":{\"body\":[{\"op\":\"swap\"},{\"value\":{\"param\":\"c\"},\"register\":\"x\",\"op\":\"add\"}],\"success\":{\"all\":[]},\"initiation\":{\"all\":[]},\"params\":[\"c\"]},\"child\":{\"body\":[{\"else\":[{\"value\":{\"const\":1},\"register\":\"y\",\"op\":\"scale\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"c\":{\"param\":\"b\"}},\"option\":\"leaf\",\"op\":\"call\"}],\"test\":{\"all\":[{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":4},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"b\"]},\"root\":{\"body\":[{\"value\":{\"param\":\"a\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"b\":{\"param\":\"a\"}},\"option\":\"child\",\"op\":\"call\"},{\"value\":{\"param\":\"a\"},\"register\":\"y\",\"op\":\"add\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"y\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":1},\"cmp\":\"ge\",\"left\":{\"param\":\"a\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"a\"]}},\"initial_state\":{\"y\":1,\"x\":2},\"version\":1,\"kind\":\"option_resume\"}","renderer":"reverse","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-194","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-R","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":1}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"resume","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":3,"phase":"completed","root_pending":false,"state":{"x":3,"y":8}},"error":null,"new_effects":3,"new_events":[{"bindings":{"c":2},"call_site":{"body_path":[0,"then"],"caller_instance":1,"index":1},"event":"enter","initiation_ok":true,"instance_id":2,"option":"leaf"},{"body_path":[],"event":"effect","index":0,"instance_id":2,"op":"swap","option":"leaf","state":{"x":1,"y":6}},{"body_path":[],"event":"effect","index":1,"instance_id":2,"op":"add","option":"leaf","register":"x","state":{"x":3,"y":6},"value":2},{"event":"return","instance_id":2,"option":"leaf","success_ok":true},{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":3,"y":8},"value":2},{"event":"return","instance_id":0,"option":"root","success_ok":true}],"next_event":null,"previous_effects":2,"status":"completed"}}
{"controlled_context":"T","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 forward","controlled_context":"T","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-191","arbitrary-193"],"renderer":"forward","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-195"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-193","arbitrary-197"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-197","arbitrary-199"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-191","arbitrary-201"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-203"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-205"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-207"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 T","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-195","arbitrary-196"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"b2412bde517545815cd23a9b7316114a41c6578a3bb40b6c5d82d3016f65bf6d","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"kind\":\"option_resume\",\"version\":1,\"initial_state\":{\"x\":2,\"y\":1},\"options\":{\"root\":{\"params\":[\"a\"],\"initiation\":{\"all\":[{\"left\":{\"param\":\"a\"},\"cmp\":\"ge\",\"right\":{\"const\":1}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}},{\"left\":{\"reg\":\"y\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"body\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"a\"}},{\"op\":\"call\",\"option\":\"child\",\"args\":{\"b\":{\"param\":\"a\"}}},{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"a\"}}]},\"child\":{\"params\":[\"b\"],\"initiation\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":4}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}}]},\"body\":[{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"then\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"b\"}},{\"op\":\"call\",\"option\":\"leaf\",\"args\":{\"c\":{\"param\":\"b\"}}}],\"else\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":{\"const\":1}}]}]},\"leaf\":{\"params\":[\"c\"],\"initiation\":{\"all\":[]},\"success\":{\"all\":[]},\"body\":[{\"op\":\"swap\"},{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"c\"}}]}},\"entry\":{\"option\":\"root\",\"args\":{\"a\":{\"reg\":\"x\"}}},\"mode\":\"restart\",\"history\":[{\"event\":\"enter\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"call_site\":null,\"initiation_ok\":true},{\"event\":\"effect\",\"instance_id\":0,\"option\":\"root\",\"body_path\":[],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":4,\"y\":1}},{\"event\":\"enter\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"call_site\":{\"caller_instance\":0,\"body_path\":[],\"index\":1},\"initiation_ok\":true},{\"event\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[],\"index\":0,\"condition\":true},{\"event\":\"effect\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[0,\"then\"],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":6,\"y\":1}}],\"checkpoint\":{\"state\":{\"x\":6,\"y\":1},\"frames\":[{\"frame_kind\":\"option\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"body_path\":[],\"next_index\":2},{\"frame_kind\":\"option\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[],\"next_index\":1},{\"frame_kind\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[0,\"then\"],\"next_index\":1}],\"next_instance_id\":2,\"root_pending\":false,\"phase\":\"running\"},\"event_budget\":48}","renderer":"forward","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-195","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-T","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":1}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"restart","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[{"bindings":{"a":6},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"}],"next_instance_id":2,"phase":"initiation_failed","root_pending":false,"state":{"x":12,"y":1}},"error":null,"new_effects":1,"new_events":[{"bindings":{"a":6},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":12,"y":1},"value":6},{"bindings":{"b":6},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":false,"instance_id":1,"option":"child"}],"next_event":null,"previous_effects":2,"status":"initiation_failed"}}
{"controlled_context":"T","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 reverse","controlled_context":"T","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-192","arbitrary-194"],"renderer":"reverse","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-196"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-194","arbitrary-198"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-198","arbitrary-200"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-192","arbitrary-202"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-204"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-206"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-208"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 T","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-195","arbitrary-196"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"1d811ce9b4b696759af6c9e2f946f6780cf4228258e2b3611ce6f241b5ad60a9","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"event_budget\":48,\"checkpoint\":{\"phase\":\"running\",\"root_pending\":false,\"next_instance_id\":2,\"frames\":[{\"next_index\":2,\"body_path\":[],\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[0,\"then\"],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"branch\"}],\"state\":{\"y\":1,\"x\":6}},\"history\":[{\"initiation_ok\":true,\"call_site\":null,\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"event\":\"enter\"},{\"state\":{\"y\":1,\"x\":4},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[],\"option\":\"root\",\"instance_id\":0,\"event\":\"effect\"},{\"initiation_ok\":true,\"call_site\":{\"index\":1,\"body_path\":[],\"caller_instance\":0},\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"event\":\"enter\"},{\"condition\":true,\"index\":0,\"body_path\":[],\"option\":\"child\",\"instance_id\":1,\"event\":\"branch\"},{\"state\":{\"y\":1,\"x\":6},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[0,\"then\"],\"option\":\"child\",\"instance_id\":1,\"event\":\"effect\"}],\"mode\":\"restart\",\"entry\":{\"args\":{\"a\":{\"reg\":\"x\"}},\"option\":\"root\"},\"options\":{\"leaf\":{\"body\":[{\"op\":\"swap\"},{\"value\":{\"param\":\"c\"},\"register\":\"x\",\"op\":\"add\"}],\"success\":{\"all\":[]},\"initiation\":{\"all\":[]},\"params\":[\"c\"]},\"child\":{\"body\":[{\"else\":[{\"value\":{\"const\":1},\"register\":\"y\",\"op\":\"scale\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"c\":{\"param\":\"b\"}},\"option\":\"leaf\",\"op\":\"call\"}],\"test\":{\"all\":[{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":4},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"b\"]},\"root\":{\"body\":[{\"value\":{\"param\":\"a\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"b\":{\"param\":\"a\"}},\"option\":\"child\",\"op\":\"call\"},{\"value\":{\"param\":\"a\"},\"register\":\"y\",\"op\":\"add\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"y\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":1},\"cmp\":\"ge\",\"left\":{\"param\":\"a\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"a\"]}},\"initial_state\":{\"y\":1,\"x\":2},\"version\":1,\"kind\":\"option_resume\"}","renderer":"reverse","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-196","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-T","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":1}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"restart","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[{"bindings":{"a":6},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"}],"next_instance_id":2,"phase":"initiation_failed","root_pending":false,"state":{"x":12,"y":1}},"error":null,"new_effects":1,"new_events":[{"bindings":{"a":6},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":12,"y":1},"value":6},{"bindings":{"b":6},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":false,"instance_id":1,"option":"child"}],"next_event":null,"previous_effects":2,"status":"initiation_failed"}}
{"controlled_context":"P","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 forward","controlled_context":"P","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-191","arbitrary-193"],"renderer":"forward","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-195"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-193","arbitrary-197"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-197","arbitrary-199"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-191","arbitrary-201"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-203"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-205"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-207"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 P","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-197","arbitrary-198"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"ad8b26a088326a04e486e24afeb5831d03ee5ee9aef9dbacb34a5aff555868c5","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"kind\":\"option_resume\",\"version\":1,\"initial_state\":{\"x\":2,\"y\":1},\"options\":{\"root\":{\"params\":[\"a\"],\"initiation\":{\"all\":[{\"left\":{\"param\":\"a\"},\"cmp\":\"ge\",\"right\":{\"const\":1}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}},{\"left\":{\"reg\":\"y\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"body\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"a\"}},{\"op\":\"call\",\"option\":\"child\",\"args\":{\"b\":{\"param\":\"a\"}}},{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"a\"}}]},\"child\":{\"params\":[\"b\"],\"initiation\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":4}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}}]},\"body\":[{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"then\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"b\"}},{\"op\":\"call\",\"option\":\"leaf\",\"args\":{\"c\":{\"param\":\"b\"}}}],\"else\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":{\"const\":1}}]}]},\"leaf\":{\"params\":[\"c\"],\"initiation\":{\"all\":[]},\"success\":{\"all\":[]},\"body\":[{\"op\":\"swap\"},{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"c\"}}]}},\"entry\":{\"option\":\"root\",\"args\":{\"a\":{\"reg\":\"x\"}}},\"mode\":\"resume\",\"history\":[{\"event\":\"enter\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"call_site\":null,\"initiation_ok\":true},{\"event\":\"effect\",\"instance_id\":0,\"option\":\"root\",\"body_path\":[],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":4,\"y\":1}},{\"event\":\"enter\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"call_site\":{\"caller_instance\":0,\"body_path\":[],\"index\":1},\"initiation_ok\":true},{\"event\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[],\"index\":0,\"condition\":true},{\"event\":\"effect\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[0,\"then\"],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":6,\"y\":1}}],\"checkpoint\":{\"state\":{\"x\":6,\"y\":1},\"frames\":[{\"frame_kind\":\"option\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"body_path\":[],\"next_index\":2},{\"frame_kind\":\"option\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[],\"next_index\":1},{\"frame_kind\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[0,\"then\"],\"next_index\":1}],\"next_instance_id\":2,\"root_pending\":false,\"phase\":\"running\"},\"event_budget\":2}","renderer":"forward","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-197","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-P","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":1}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":2,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"resume","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":2,"option":"child"},{"bindings":{"c":2},"body_path":[],"frame_kind":"option","instance_id":2,"next_index":1,"option":"leaf"}],"next_instance_id":3,"phase":"running","root_pending":false,"state":{"x":1,"y":6}},"error":null,"new_effects":1,"new_events":[{"bindings":{"c":2},"call_site":{"body_path":[0,"then"],"caller_instance":1,"index":1},"event":"enter","initiation_ok":true,"instance_id":2,"option":"leaf"},{"body_path":[],"event":"effect","index":0,"instance_id":2,"op":"swap","option":"leaf","state":{"x":1,"y":6}}],"next_event":{"body_path":[],"event":"effect","index":1,"instance_id":2,"op":"add","option":"leaf","register":"x","state":{"x":3,"y":6},"value":2},"previous_effects":2,"status":"paused"}}
{"controlled_context":"P","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 reverse","controlled_context":"P","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-192","arbitrary-194"],"renderer":"reverse","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-196"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-194","arbitrary-198"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-198","arbitrary-200"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-192","arbitrary-202"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-204"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-206"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-208"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 P","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-197","arbitrary-198"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"b6a6a396369d2ff9bf91d1f9bc55f138a1ca027baef4af9d1ae122ea1b91ab36","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"event_budget\":2,\"checkpoint\":{\"phase\":\"running\",\"root_pending\":false,\"next_instance_id\":2,\"frames\":[{\"next_index\":2,\"body_path\":[],\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[0,\"then\"],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"branch\"}],\"state\":{\"y\":1,\"x\":6}},\"history\":[{\"initiation_ok\":true,\"call_site\":null,\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"event\":\"enter\"},{\"state\":{\"y\":1,\"x\":4},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[],\"option\":\"root\",\"instance_id\":0,\"event\":\"effect\"},{\"initiation_ok\":true,\"call_site\":{\"index\":1,\"body_path\":[],\"caller_instance\":0},\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"event\":\"enter\"},{\"condition\":true,\"index\":0,\"body_path\":[],\"option\":\"child\",\"instance_id\":1,\"event\":\"branch\"},{\"state\":{\"y\":1,\"x\":6},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[0,\"then\"],\"option\":\"child\",\"instance_id\":1,\"event\":\"effect\"}],\"mode\":\"resume\",\"entry\":{\"args\":{\"a\":{\"reg\":\"x\"}},\"option\":\"root\"},\"options\":{\"leaf\":{\"body\":[{\"op\":\"swap\"},{\"value\":{\"param\":\"c\"},\"register\":\"x\",\"op\":\"add\"}],\"success\":{\"all\":[]},\"initiation\":{\"all\":[]},\"params\":[\"c\"]},\"child\":{\"body\":[{\"else\":[{\"value\":{\"const\":1},\"register\":\"y\",\"op\":\"scale\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"c\":{\"param\":\"b\"}},\"option\":\"leaf\",\"op\":\"call\"}],\"test\":{\"all\":[{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":4},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"b\"]},\"root\":{\"body\":[{\"value\":{\"param\":\"a\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"b\":{\"param\":\"a\"}},\"option\":\"child\",\"op\":\"call\"},{\"value\":{\"param\":\"a\"},\"register\":\"y\",\"op\":\"add\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"y\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":1},\"cmp\":\"ge\",\"left\":{\"param\":\"a\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"a\"]}},\"initial_state\":{\"y\":1,\"x\":2},\"version\":1,\"kind\":\"option_resume\"}","renderer":"reverse","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-198","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-P","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":1}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":2,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"resume","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":2,"option":"child"},{"bindings":{"c":2},"body_path":[],"frame_kind":"option","instance_id":2,"next_index":1,"option":"leaf"}],"next_instance_id":3,"phase":"running","root_pending":false,"state":{"x":1,"y":6}},"error":null,"new_effects":1,"new_events":[{"bindings":{"c":2},"call_site":{"body_path":[0,"then"],"caller_instance":1,"index":1},"event":"enter","initiation_ok":true,"instance_id":2,"option":"leaf"},{"body_path":[],"event":"effect","index":0,"instance_id":2,"op":"swap","option":"leaf","state":{"x":1,"y":6}}],"next_event":{"body_path":[],"event":"effect","index":1,"instance_id":2,"op":"add","option":"leaf","register":"x","state":{"x":3,"y":6},"value":2},"previous_effects":2,"status":"paused"}}
{"controlled_context":"U","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 forward","controlled_context":"U","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-191","arbitrary-193"],"renderer":"forward","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-195"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-193","arbitrary-197"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-197","arbitrary-199"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-191","arbitrary-201"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-203"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-205"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-207"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 U","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-199","arbitrary-200"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"c36f2094225c75bec844f43c1ab394779af852b7af98673558b03b988574fb3a","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"kind\":\"option_resume\",\"version\":1,\"initial_state\":{\"x\":2,\"y\":1},\"options\":{\"root\":{\"params\":[\"a\"],\"initiation\":{\"all\":[{\"left\":{\"param\":\"a\"},\"cmp\":\"ge\",\"right\":{\"const\":1}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}},{\"left\":{\"reg\":\"y\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"body\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"a\"}},{\"op\":\"call\",\"option\":\"child\",\"args\":{\"b\":{\"param\":\"a\"}}},{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"a\"}}]},\"child\":{\"params\":[\"b\"],\"initiation\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":4}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}}]},\"body\":[{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"then\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"b\"}},{\"op\":\"call\",\"option\":\"leaf\",\"args\":{\"c\":{\"param\":\"b\"}}}],\"else\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":{\"const\":1}}]}]},\"leaf\":{\"params\":[\"c\"],\"initiation\":{\"all\":[]},\"success\":{\"all\":[]},\"body\":[{\"op\":\"swap\"},{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"c\"}}]}},\"entry\":{\"option\":\"root\",\"args\":{\"a\":{\"reg\":\"x\"}}},\"mode\":\"resume\",\"history\":[{\"event\":\"enter\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"call_site\":null,\"initiation_ok\":true},{\"event\":\"effect\",\"instance_id\":0,\"option\":\"root\",\"body_path\":[],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":4,\"y\":1}},{\"event\":\"enter\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"call_site\":{\"caller_instance\":0,\"body_path\":[],\"index\":1},\"initiation_ok\":true},{\"event\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[],\"index\":0,\"condition\":true},{\"event\":\"effect\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[0,\"then\"],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":6,\"y\":1}},{\"event\":\"enter\",\"instance_id\":2,\"option\":\"leaf\",\"bindings\":{\"c\":2},\"call_site\":{\"caller_instance\":1,\"body_path\":[0,\"then\"],\"index\":1},\"initiation_ok\":true},{\"event\":\"effect\",\"instance_id\":2,\"option\":\"leaf\",\"body_path\":[],\"index\":0,\"op\":\"swap\",\"state\":{\"x\":1,\"y\":6}}],\"checkpoint\":{\"state\":{\"x\":1,\"y\":6},\"frames\":[{\"frame_kind\":\"option\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"body_path\":[],\"next_index\":2},{\"frame_kind\":\"option\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[],\"next_index\":1},{\"frame_kind\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[0,\"then\"],\"next_index\":2},{\"frame_kind\":\"option\",\"instance_id\":2,\"option\":\"leaf\",\"bindings\":{\"c\":2},\"body_path\":[],\"next_index\":1}],\"next_instance_id\":3,\"root_pending\":false,\"phase\":\"running\"},\"event_budget\":48}","renderer":"forward","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-199","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-U","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":2,"option":"child"},{"bindings":{"c":2},"body_path":[],"frame_kind":"option","instance_id":2,"next_index":1,"option":"leaf"}],"next_instance_id":3,"phase":"running","root_pending":false,"state":{"x":1,"y":6}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2},{"bindings":{"c":2},"call_site":{"body_path":[0,"then"],"caller_instance":1,"index":1},"event":"enter","initiation_ok":true,"instance_id":2,"option":"leaf"},{"body_path":[],"event":"effect","index":0,"instance_id":2,"op":"swap","option":"leaf","state":{"x":1,"y":6}}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"resume","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":3,"phase":"completed","root_pending":false,"state":{"x":3,"y":8}},"error":null,"new_effects":2,"new_events":[{"body_path":[],"event":"effect","index":1,"instance_id":2,"op":"add","option":"leaf","register":"x","state":{"x":3,"y":6},"value":2},{"event":"return","instance_id":2,"option":"leaf","success_ok":true},{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":3,"y":8},"value":2},{"event":"return","instance_id":0,"option":"root","success_ok":true}],"next_event":null,"previous_effects":3,"status":"completed"}}
{"controlled_context":"U","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 reverse","controlled_context":"U","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-192","arbitrary-194"],"renderer":"reverse","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-196"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-194","arbitrary-198"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-198","arbitrary-200"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-192","arbitrary-202"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-204"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-206"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-208"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 U","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-199","arbitrary-200"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"5cb23ebfc67824c02638d7dfc0e98fc2036c48ac344ef84efb990f617df496b3","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"event_budget\":48,\"checkpoint\":{\"phase\":\"running\",\"root_pending\":false,\"next_instance_id\":3,\"frames\":[{\"next_index\":2,\"body_path\":[],\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"option\"},{\"next_index\":2,\"body_path\":[0,\"then\"],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"branch\"},{\"next_index\":1,\"body_path\":[],\"bindings\":{\"c\":2},\"option\":\"leaf\",\"instance_id\":2,\"frame_kind\":\"option\"}],\"state\":{\"y\":6,\"x\":1}},\"history\":[{\"initiation_ok\":true,\"call_site\":null,\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"event\":\"enter\"},{\"state\":{\"y\":1,\"x\":4},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[],\"option\":\"root\",\"instance_id\":0,\"event\":\"effect\"},{\"initiation_ok\":true,\"call_site\":{\"index\":1,\"body_path\":[],\"caller_instance\":0},\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"event\":\"enter\"},{\"condition\":true,\"index\":0,\"body_path\":[],\"option\":\"child\",\"instance_id\":1,\"event\":\"branch\"},{\"state\":{\"y\":1,\"x\":6},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[0,\"then\"],\"option\":\"child\",\"instance_id\":1,\"event\":\"effect\"},{\"initiation_ok\":true,\"call_site\":{\"index\":1,\"body_path\":[0,\"then\"],\"caller_instance\":1},\"bindings\":{\"c\":2},\"option\":\"leaf\",\"instance_id\":2,\"event\":\"enter\"},{\"state\":{\"y\":6,\"x\":1},\"op\":\"swap\",\"index\":0,\"body_path\":[],\"option\":\"leaf\",\"instance_id\":2,\"event\":\"effect\"}],\"mode\":\"resume\",\"entry\":{\"args\":{\"a\":{\"reg\":\"x\"}},\"option\":\"root\"},\"options\":{\"leaf\":{\"body\":[{\"op\":\"swap\"},{\"value\":{\"param\":\"c\"},\"register\":\"x\",\"op\":\"add\"}],\"success\":{\"all\":[]},\"initiation\":{\"all\":[]},\"params\":[\"c\"]},\"child\":{\"body\":[{\"else\":[{\"value\":{\"const\":1},\"register\":\"y\",\"op\":\"scale\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"c\":{\"param\":\"b\"}},\"option\":\"leaf\",\"op\":\"call\"}],\"test\":{\"all\":[{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":4},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"b\"]},\"root\":{\"body\":[{\"value\":{\"param\":\"a\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"b\":{\"param\":\"a\"}},\"option\":\"child\",\"op\":\"call\"},{\"value\":{\"param\":\"a\"},\"register\":\"y\",\"op\":\"add\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"y\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":1},\"cmp\":\"ge\",\"left\":{\"param\":\"a\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"a\"]}},\"initial_state\":{\"y\":1,\"x\":2},\"version\":1,\"kind\":\"option_resume\"}","renderer":"reverse","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-200","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-U","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":2,"option":"child"},{"bindings":{"c":2},"body_path":[],"frame_kind":"option","instance_id":2,"next_index":1,"option":"leaf"}],"next_instance_id":3,"phase":"running","root_pending":false,"state":{"x":1,"y":6}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2},{"bindings":{"c":2},"call_site":{"body_path":[0,"then"],"caller_instance":1,"index":1},"event":"enter","initiation_ok":true,"instance_id":2,"option":"leaf"},{"body_path":[],"event":"effect","index":0,"instance_id":2,"op":"swap","option":"leaf","state":{"x":1,"y":6}}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"resume","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":3,"phase":"completed","root_pending":false,"state":{"x":3,"y":8}},"error":null,"new_effects":2,"new_events":[{"body_path":[],"event":"effect","index":1,"instance_id":2,"op":"add","option":"leaf","register":"x","state":{"x":3,"y":6},"value":2},{"event":"return","instance_id":2,"option":"leaf","success_ok":true},{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":3,"y":8},"value":2},{"event":"return","instance_id":0,"option":"root","success_ok":true}],"next_event":null,"previous_effects":3,"status":"completed"}}
{"controlled_context":"A","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 forward","controlled_context":"A","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-191","arbitrary-193"],"renderer":"forward","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-195"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-193","arbitrary-197"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-197","arbitrary-199"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-191","arbitrary-201"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-203"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-205"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-207"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 A","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-201","arbitrary-202"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"4759c40a155a1288aa3fddd10949a69334363ade4f78cdb2c39545bdb508b2ca","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"kind\":\"option_resume\",\"version\":1,\"initial_state\":{\"x\":2,\"y\":1},\"options\":{\"root\":{\"params\":[\"a\"],\"initiation\":{\"all\":[{\"left\":{\"param\":\"a\"},\"cmp\":\"ge\",\"right\":{\"const\":1}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}},{\"left\":{\"reg\":\"y\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"body\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"a\"}},{\"op\":\"call\",\"option\":\"child\",\"args\":{\"b\":{\"param\":\"a\"}}},{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"a\"}}]},\"child\":{\"params\":[\"b\"],\"initiation\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":4}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}}]},\"body\":[{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"then\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"b\"}},{\"op\":\"call\",\"option\":\"leaf\",\"args\":{\"c\":{\"param\":\"b\"}}}],\"else\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":{\"const\":1}}]}]},\"leaf\":{\"params\":[\"c\"],\"initiation\":{\"all\":[]},\"success\":{\"all\":[]},\"body\":[{\"op\":\"swap\"},{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"c\"}}]}},\"entry\":{\"option\":\"root\",\"args\":{\"a\":{\"const\":3}}},\"mode\":\"fresh\",\"history\":[],\"checkpoint\":null,\"event_budget\":48}","renderer":"forward","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-201","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-A","semantic_task":{"checkpoint":null,"entry":{"args":{"a":{"const":3}},"option":"root"},"event_budget":48,"history":[],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"fresh","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":3,"phase":"completed","root_pending":false,"state":{"x":4,"y":11}},"error":null,"new_effects":5,"new_events":[{"bindings":{"a":3},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":5,"y":1},"value":3},{"bindings":{"b":3},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":8,"y":1},"value":3},{"bindings":{"c":3},"call_site":{"body_path":[0,"then"],"caller_instance":1,"index":1},"event":"enter","initiation_ok":true,"instance_id":2,"option":"leaf"},{"body_path":[],"event":"effect","index":0,"instance_id":2,"op":"swap","option":"leaf","state":{"x":1,"y":8}},{"body_path":[],"event":"effect","index":1,"instance_id":2,"op":"add","option":"leaf","register":"x","state":{"x":4,"y":8},"value":3},{"event":"return","instance_id":2,"option":"leaf","success_ok":true},{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":4,"y":11},"value":3},{"event":"return","instance_id":0,"option":"root","success_ok":true}],"next_event":null,"previous_effects":0,"status":"completed"}}
{"controlled_context":"A","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 reverse","controlled_context":"A","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-192","arbitrary-194"],"renderer":"reverse","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-196"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-194","arbitrary-198"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-198","arbitrary-200"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-192","arbitrary-202"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-204"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-206"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-208"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 A","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-201","arbitrary-202"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"7bba4a0a30f36712e0d356874fffa1e162de73ffe70cfe697f9f27618e9d8314","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"event_budget\":48,\"checkpoint\":null,\"history\":[],\"mode\":\"fresh\",\"entry\":{\"args\":{\"a\":{\"const\":3}},\"option\":\"root\"},\"options\":{\"leaf\":{\"body\":[{\"op\":\"swap\"},{\"value\":{\"param\":\"c\"},\"register\":\"x\",\"op\":\"add\"}],\"success\":{\"all\":[]},\"initiation\":{\"all\":[]},\"params\":[\"c\"]},\"child\":{\"body\":[{\"else\":[{\"value\":{\"const\":1},\"register\":\"y\",\"op\":\"scale\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"c\":{\"param\":\"b\"}},\"option\":\"leaf\",\"op\":\"call\"}],\"test\":{\"all\":[{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":4},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"b\"]},\"root\":{\"body\":[{\"value\":{\"param\":\"a\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"b\":{\"param\":\"a\"}},\"option\":\"child\",\"op\":\"call\"},{\"value\":{\"param\":\"a\"},\"register\":\"y\",\"op\":\"add\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"y\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":1},\"cmp\":\"ge\",\"left\":{\"param\":\"a\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"a\"]}},\"initial_state\":{\"y\":1,\"x\":2},\"version\":1,\"kind\":\"option_resume\"}","renderer":"reverse","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-202","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-A","semantic_task":{"checkpoint":null,"entry":{"args":{"a":{"const":3}},"option":"root"},"event_budget":48,"history":[],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"fresh","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":3,"phase":"completed","root_pending":false,"state":{"x":4,"y":11}},"error":null,"new_effects":5,"new_events":[{"bindings":{"a":3},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":5,"y":1},"value":3},{"bindings":{"b":3},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":8,"y":1},"value":3},{"bindings":{"c":3},"call_site":{"body_path":[0,"then"],"caller_instance":1,"index":1},"event":"enter","initiation_ok":true,"instance_id":2,"option":"leaf"},{"body_path":[],"event":"effect","index":0,"instance_id":2,"op":"swap","option":"leaf","state":{"x":1,"y":8}},{"body_path":[],"event":"effect","index":1,"instance_id":2,"op":"add","option":"leaf","register":"x","state":{"x":4,"y":8},"value":3},{"event":"return","instance_id":2,"option":"leaf","success_ok":true},{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":4,"y":11},"value":3},{"event":"return","instance_id":0,"option":"root","success_ok":true}],"next_event":null,"previous_effects":0,"status":"completed"}}
{"controlled_context":"I","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 forward","controlled_context":"I","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-191","arbitrary-193"],"renderer":"forward","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-195"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-193","arbitrary-197"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-197","arbitrary-199"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-191","arbitrary-201"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-203"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-205"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-207"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 I","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-203","arbitrary-204"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"a584b980bc5f1db7a05a03c8acc798a1f0fd51463f37d513cffba12650306118","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"kind\":\"option_resume\",\"version\":1,\"initial_state\":{\"x\":2,\"y\":1},\"options\":{\"root\":{\"params\":[\"a\"],\"initiation\":{\"all\":[{\"left\":{\"param\":\"a\"},\"cmp\":\"ge\",\"right\":{\"const\":1}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}},{\"left\":{\"reg\":\"y\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"body\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"a\"}},{\"op\":\"call\",\"option\":\"child\",\"args\":{\"b\":{\"param\":\"a\"}}},{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"a\"}}]},\"child\":{\"params\":[\"b\"],\"initiation\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":4}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}}]},\"body\":[{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"then\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"b\"}},{\"op\":\"call\",\"option\":\"leaf\",\"args\":{\"c\":{\"param\":\"b\"}}}],\"else\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":{\"const\":1}}]}]},\"leaf\":{\"params\":[\"c\"],\"initiation\":{\"all\":[]},\"success\":{\"all\":[]},\"body\":[{\"op\":\"swap\"},{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"c\"}}]}},\"entry\":{\"option\":\"root\",\"args\":{\"a\":{\"const\":0}}},\"mode\":\"fresh\",\"history\":[],\"checkpoint\":null,\"event_budget\":48}","renderer":"forward","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-203","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-I","semantic_task":{"checkpoint":null,"entry":{"args":{"a":{"const":0}},"option":"root"},"event_budget":48,"history":[],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"fresh","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":1,"phase":"initiation_failed","root_pending":false,"state":{"x":2,"y":1}},"error":null,"new_effects":0,"new_events":[{"bindings":{"a":0},"call_site":null,"event":"enter","initiation_ok":false,"instance_id":0,"option":"root"}],"next_event":null,"previous_effects":0,"status":"initiation_failed"}}
{"controlled_context":"I","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 reverse","controlled_context":"I","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-192","arbitrary-194"],"renderer":"reverse","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-196"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-194","arbitrary-198"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-198","arbitrary-200"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-192","arbitrary-202"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-204"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-206"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-208"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 I","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-203","arbitrary-204"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"69a9a5baa78263ac2ec43ef9ed20240d81aedc76de6b1931ddee27d47110e29c","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"event_budget\":48,\"checkpoint\":null,\"history\":[],\"mode\":\"fresh\",\"entry\":{\"args\":{\"a\":{\"const\":0}},\"option\":\"root\"},\"options\":{\"leaf\":{\"body\":[{\"op\":\"swap\"},{\"value\":{\"param\":\"c\"},\"register\":\"x\",\"op\":\"add\"}],\"success\":{\"all\":[]},\"initiation\":{\"all\":[]},\"params\":[\"c\"]},\"child\":{\"body\":[{\"else\":[{\"value\":{\"const\":1},\"register\":\"y\",\"op\":\"scale\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"c\":{\"param\":\"b\"}},\"option\":\"leaf\",\"op\":\"call\"}],\"test\":{\"all\":[{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":4},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"b\"]},\"root\":{\"body\":[{\"value\":{\"param\":\"a\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"b\":{\"param\":\"a\"}},\"option\":\"child\",\"op\":\"call\"},{\"value\":{\"param\":\"a\"},\"register\":\"y\",\"op\":\"add\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"y\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":1},\"cmp\":\"ge\",\"left\":{\"param\":\"a\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"a\"]}},\"initial_state\":{\"y\":1,\"x\":2},\"version\":1,\"kind\":\"option_resume\"}","renderer":"reverse","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-204","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-I","semantic_task":{"checkpoint":null,"entry":{"args":{"a":{"const":0}},"option":"root"},"event_budget":48,"history":[],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"fresh","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":1,"phase":"initiation_failed","root_pending":false,"state":{"x":2,"y":1}},"error":null,"new_effects":0,"new_events":[{"bindings":{"a":0},"call_site":null,"event":"enter","initiation_ok":false,"instance_id":0,"option":"root"}],"next_event":null,"previous_effects":0,"status":"initiation_failed"}}
{"controlled_context":"S","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 forward","controlled_context":"S","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-191","arbitrary-193"],"renderer":"forward","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-195"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-193","arbitrary-197"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-197","arbitrary-199"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-191","arbitrary-201"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-203"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-205"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-207"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 S","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-205","arbitrary-206"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"a68e2d7189d1ace0e9cea1789c2bcda4432670fa848e3fd735c142c4d926440e","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"kind\":\"option_resume\",\"version\":1,\"initial_state\":{\"x\":2,\"y\":1},\"options\":{\"root\":{\"params\":[\"a\"],\"initiation\":{\"all\":[{\"left\":{\"param\":\"a\"},\"cmp\":\"ge\",\"right\":{\"const\":1}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":100000}},{\"left\":{\"reg\":\"y\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"body\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"a\"}},{\"op\":\"call\",\"option\":\"child\",\"args\":{\"b\":{\"param\":\"a\"}}},{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"a\"}}]},\"child\":{\"params\":[\"b\"],\"initiation\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":4}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}}]},\"body\":[{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"then\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"b\"}},{\"op\":\"call\",\"option\":\"leaf\",\"args\":{\"c\":{\"param\":\"b\"}}}],\"else\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":{\"const\":1}}]}]},\"leaf\":{\"params\":[\"c\"],\"initiation\":{\"all\":[]},\"success\":{\"all\":[]},\"body\":[{\"op\":\"swap\"},{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"c\"}}]}},\"entry\":{\"option\":\"root\",\"args\":{\"a\":{\"reg\":\"x\"}}},\"mode\":\"fresh\",\"history\":[],\"checkpoint\":null,\"event_budget\":48}","renderer":"forward","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-205","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-S","semantic_task":{"checkpoint":null,"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"fresh","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":100000}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":3,"phase":"success_failed","root_pending":false,"state":{"x":3,"y":8}},"error":null,"new_effects":5,"new_events":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2},{"bindings":{"c":2},"call_site":{"body_path":[0,"then"],"caller_instance":1,"index":1},"event":"enter","initiation_ok":true,"instance_id":2,"option":"leaf"},{"body_path":[],"event":"effect","index":0,"instance_id":2,"op":"swap","option":"leaf","state":{"x":1,"y":6}},{"body_path":[],"event":"effect","index":1,"instance_id":2,"op":"add","option":"leaf","register":"x","state":{"x":3,"y":6},"value":2},{"event":"return","instance_id":2,"option":"leaf","success_ok":true},{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":3,"y":8},"value":2},{"event":"return","instance_id":0,"option":"root","success_ok":false}],"next_event":null,"previous_effects":0,"status":"success_failed"}}
{"controlled_context":"S","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 reverse","controlled_context":"S","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-192","arbitrary-194"],"renderer":"reverse","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-196"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-194","arbitrary-198"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-198","arbitrary-200"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-192","arbitrary-202"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-204"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-206"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-208"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 S","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-205","arbitrary-206"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"da44ff170446b81afe2323549485465a2dc1b1d6a8a8d4f98d733274a38ac450","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"event_budget\":48,\"checkpoint\":null,\"history\":[],\"mode\":\"fresh\",\"entry\":{\"args\":{\"a\":{\"reg\":\"x\"}},\"option\":\"root\"},\"options\":{\"leaf\":{\"body\":[{\"op\":\"swap\"},{\"value\":{\"param\":\"c\"},\"register\":\"x\",\"op\":\"add\"}],\"success\":{\"all\":[]},\"initiation\":{\"all\":[]},\"params\":[\"c\"]},\"child\":{\"body\":[{\"else\":[{\"value\":{\"const\":1},\"register\":\"y\",\"op\":\"scale\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"c\":{\"param\":\"b\"}},\"option\":\"leaf\",\"op\":\"call\"}],\"test\":{\"all\":[{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":4},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"b\"]},\"root\":{\"body\":[{\"value\":{\"param\":\"a\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"b\":{\"param\":\"a\"}},\"option\":\"child\",\"op\":\"call\"},{\"value\":{\"param\":\"a\"},\"register\":\"y\",\"op\":\"add\"}],\"success\":{\"all\":[{\"right\":{\"const\":100000},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"y\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":1},\"cmp\":\"ge\",\"left\":{\"param\":\"a\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"a\"]}},\"initial_state\":{\"y\":1,\"x\":2},\"version\":1,\"kind\":\"option_resume\"}","renderer":"reverse","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-206","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-S","semantic_task":{"checkpoint":null,"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"fresh","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":100000}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":3,"phase":"success_failed","root_pending":false,"state":{"x":3,"y":8}},"error":null,"new_effects":5,"new_events":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2},{"bindings":{"c":2},"call_site":{"body_path":[0,"then"],"caller_instance":1,"index":1},"event":"enter","initiation_ok":true,"instance_id":2,"option":"leaf"},{"body_path":[],"event":"effect","index":0,"instance_id":2,"op":"swap","option":"leaf","state":{"x":1,"y":6}},{"body_path":[],"event":"effect","index":1,"instance_id":2,"op":"add","option":"leaf","register":"x","state":{"x":3,"y":6},"value":2},{"event":"return","instance_id":2,"option":"leaf","success_ok":true},{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":3,"y":8},"value":2},{"event":"return","instance_id":0,"option":"root","success_ok":false}],"next_event":null,"previous_effects":0,"status":"success_failed"}}
{"controlled_context":"X","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 forward","controlled_context":"X","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-191","arbitrary-193"],"renderer":"forward","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-195"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-193","arbitrary-197"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-197","arbitrary-199"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-191","arbitrary-201"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-203"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-191","arbitrary-205"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-193","arbitrary-207"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 X","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-207","arbitrary-208"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"a6101acbdea15bd2beeee4264835b3783aecc014448637cb4c74e97723ca9fa7","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"kind\":\"option_resume\",\"version\":1,\"initial_state\":{\"x\":2,\"y\":1},\"options\":{\"root\":{\"params\":[\"a\"],\"initiation\":{\"all\":[{\"left\":{\"param\":\"a\"},\"cmp\":\"ge\",\"right\":{\"const\":1}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}},{\"left\":{\"reg\":\"y\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"body\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"a\"}},{\"op\":\"call\",\"option\":\"child\",\"args\":{\"b\":{\"param\":\"a\"}}},{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"a\"}}]},\"child\":{\"params\":[\"b\"],\"initiation\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":4}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}}]},\"body\":[{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"then\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"b\"}},{\"op\":\"call\",\"option\":\"leaf\",\"args\":{\"c\":{\"param\":\"b\"}}}],\"else\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":{\"const\":1}}]}]},\"leaf\":{\"params\":[\"c\"],\"initiation\":{\"all\":[]},\"success\":{\"all\":[]},\"body\":[{\"op\":\"swap\"},{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"c\"}}]}},\"entry\":{\"option\":\"root\",\"args\":{\"a\":{\"reg\":\"x\"}}},\"mode\":\"resume\",\"history\":[{\"event\":\"enter\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"call_site\":null,\"initiation_ok\":true},{\"event\":\"effect\",\"instance_id\":0,\"option\":\"root\",\"body_path\":[],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":4,\"y\":1}},{\"event\":\"enter\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"call_site\":{\"caller_instance\":0,\"body_path\":[],\"index\":1},\"initiation_ok\":true},{\"event\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[],\"index\":0,\"condition\":true},{\"event\":\"effect\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[0,\"then\"],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":6,\"y\":1}}],\"checkpoint\":{\"state\":{\"x\":6,\"y\":1},\"frames\":[{\"frame_kind\":\"option\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"body_path\":[],\"next_index\":2},{\"frame_kind\":\"option\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[],\"next_index\":1},{\"frame_kind\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":3},\"body_path\":[0,\"then\"],\"next_index\":1}],\"next_instance_id\":2,\"root_pending\":false,\"phase\":\"running\"},\"event_budget\":48}","renderer":"forward","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-207","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-X","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":3},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":1}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"resume","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":null,"error":"invalid_checkpoint","new_effects":0,"new_events":[],"next_event":null,"previous_effects":null,"status":"invalid"}}
{"controlled_context":"X","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-19 reverse","controlled_context":"X","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-192","arbitrary-194"],"renderer":"reverse","scope":"corpus_variant","source_family_index":19,"source_family_key":"hand-origin-19"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-196"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-194","arbitrary-198"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-198","arbitrary-200"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-192","arbitrary-202"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-204"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-192","arbitrary-206"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-19 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-194","arbitrary-208"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-19 X","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-207","arbitrary-208"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":19,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"4a2b3bb17ec34d78dd7a228cc1a9eca7eef87c2259d548b386b3446174708324","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"event_budget\":48,\"checkpoint\":{\"phase\":\"running\",\"root_pending\":false,\"next_instance_id\":2,\"frames\":[{\"next_index\":2,\"body_path\":[],\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[0,\"then\"],\"bindings\":{\"b\":3},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"branch\"}],\"state\":{\"y\":1,\"x\":6}},\"history\":[{\"initiation_ok\":true,\"call_site\":null,\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"event\":\"enter\"},{\"state\":{\"y\":1,\"x\":4},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[],\"option\":\"root\",\"instance_id\":0,\"event\":\"effect\"},{\"initiation_ok\":true,\"call_site\":{\"index\":1,\"body_path\":[],\"caller_instance\":0},\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"event\":\"enter\"},{\"condition\":true,\"index\":0,\"body_path\":[],\"option\":\"child\",\"instance_id\":1,\"event\":\"branch\"},{\"state\":{\"y\":1,\"x\":6},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[0,\"then\"],\"option\":\"child\",\"instance_id\":1,\"event\":\"effect\"}],\"mode\":\"resume\",\"entry\":{\"args\":{\"a\":{\"reg\":\"x\"}},\"option\":\"root\"},\"options\":{\"leaf\":{\"body\":[{\"op\":\"swap\"},{\"value\":{\"param\":\"c\"},\"register\":\"x\",\"op\":\"add\"}],\"success\":{\"all\":[]},\"initiation\":{\"all\":[]},\"params\":[\"c\"]},\"child\":{\"body\":[{\"else\":[{\"value\":{\"const\":1},\"register\":\"y\",\"op\":\"scale\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"c\":{\"param\":\"b\"}},\"option\":\"leaf\",\"op\":\"call\"}],\"test\":{\"all\":[{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":4},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"b\"]},\"root\":{\"body\":[{\"value\":{\"param\":\"a\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"b\":{\"param\":\"a\"}},\"option\":\"child\",\"op\":\"call\"},{\"value\":{\"param\":\"a\"},\"register\":\"y\",\"op\":\"add\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"y\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":1},\"cmp\":\"ge\",\"left\":{\"param\":\"a\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"a\"]}},\"initial_state\":{\"y\":1,\"x\":2},\"version\":1,\"kind\":\"option_resume\"}","renderer":"reverse","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-208","semantic_family_id":"hand-semantic-19","semantic_parent_id":"hand-parent-19-X","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":3},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":1}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"resume","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"args":{"c":{"param":"b"}},"op":"call","option":"leaf"}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"leaf":{"body":[{"op":"swap"},{"op":"add","register":"x","value":{"param":"c"}}],"initiation":{"all":[]},"params":["c"],"success":{"all":[]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":19,"source_family_key":"hand-origin-19","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"dev_challenge","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{