t":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2},{"body_path":[0,"then"],"condition":true,"event":"branch","index":1,"instance_id":1,"option":"child"},{"body_path":[0,"then",1,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"y","state":{"x":6,"y":3},"value":2},{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":6,"y":5},"value":2},{"event":"return","instance_id":0,"option":"root","success_ok":true}],"next_event":null,"previous_effects":0,"status":"completed"}}
{"controlled_context":"R","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-16 forward","controlled_context":"R","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-209","arbitrary-211"],"renderer":"forward","scope":"corpus_variant","source_family_index":16,"source_family_key":"hand-origin-16"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-211","arbitrary-213"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-211","arbitrary-215"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-215","arbitrary-217"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-209","arbitrary-219"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-209","arbitrary-221"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-209","arbitrary-223"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-211","arbitrary-225"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-16 R","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-211","arbitrary-212"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":16,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"6cbd3346d0dfcee0f07063cb4deca2733d972b3cdd51bb4c96c9baaf3f5db967","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"kind\":\"option_resume\",\"version\":1,\"initial_state\":{\"x\":2,\"y\":1},\"options\":{\"root\":{\"params\":[\"a\"],\"initiation\":{\"all\":[{\"left\":{\"param\":\"a\"},\"cmp\":\"ge\",\"right\":{\"const\":1}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}},{\"left\":{\"reg\":\"y\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"body\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"a\"}},{\"op\":\"call\",\"option\":\"child\",\"args\":{\"b\":{\"param\":\"a\"}}},{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"a\"}}]},\"child\":{\"params\":[\"b\"],\"initiation\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":4}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}}]},\"body\":[{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"then\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"b\"}},{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"param\":\"b\"}}]},\"then\":[{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"b\"}}],\"else\":[{\"op\":\"add\",\"register\":\"y\",\"value\":{\"const\":0}}]}],\"else\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":{\"const\":1}}]}]}},\"entry\":{\"option\":\"root\",\"args\":{\"a\":{\"reg\":\"x\"}}},\"mode\":\"resume\",\"history\":[{\"event\":\"enter\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"call_site\":null,\"initiation_ok\":true},{\"event\":\"effect\",\"instance_id\":0,\"option\":\"root\",\"body_path\":[],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":4,\"y\":1}},{\"event\":\"enter\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"call_site\":{\"caller_instance\":0,\"body_path\":[],\"index\":1},\"initiation_ok\":true},{\"event\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[],\"index\":0,\"condition\":true},{\"event\":\"effect\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[0,\"then\"],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":6,\"y\":1}}],\"checkpoint\":{\"state\":{\"x\":6,\"y\":1},\"frames\":[{\"frame_kind\":\"option\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"body_path\":[],\"next_index\":2},{\"frame_kind\":\"option\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[],\"next_index\":1},{\"frame_kind\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[0,\"then\"],\"next_index\":1}],\"next_instance_id\":2,\"root_pending\":false,\"phase\":\"running\"},\"event_budget\":48}","renderer":"forward","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-211","semantic_family_id":"hand-semantic-16","semantic_parent_id":"hand-parent-16-R","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":1}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"resume","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"else":[{"op":"add","register":"y","value":{"const":0}}],"op":"if","test":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"param":"b"}}]},"then":[{"op":"add","register":"y","value":{"param":"b"}}]}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":16,"source_family_key":"hand-origin-16","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":2,"phase":"completed","root_pending":false,"state":{"x":6,"y":5}},"error":null,"new_effects":2,"new_events":[{"body_path":[0,"then"],"condition":true,"event":"branch","index":1,"instance_id":1,"option":"child"},{"body_path":[0,"then",1,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"y","state":{"x":6,"y":3},"value":2},{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":6,"y":5},"value":2},{"event":"return","instance_id":0,"option":"root","success_ok":true}],"next_event":null,"previous_effects":2,"status":"completed"}}
{"controlled_context":"R","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-16 reverse","controlled_context":"R","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-210","arbitrary-212"],"renderer":"reverse","scope":"corpus_variant","source_family_index":16,"source_family_key":"hand-origin-16"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-212","arbitrary-214"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-212","arbitrary-216"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-216","arbitrary-218"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-210","arbitrary-220"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-210","arbitrary-222"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-210","arbitrary-224"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-212","arbitrary-226"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-16 R","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-211","arbitrary-212"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":16,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"0e5cc33e3a85f2f74b9e78b0448c3952062e0a1642bf7b42a33d2cd9ab8fedb1","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"event_budget\":48,\"checkpoint\":{\"phase\":\"running\",\"root_pending\":false,\"next_instance_id\":2,\"frames\":[{\"next_index\":2,\"body_path\":[],\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[0,\"then\"],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"branch\"}],\"state\":{\"y\":1,\"x\":6}},\"history\":[{\"initiation_ok\":true,\"call_site\":null,\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"event\":\"enter\"},{\"state\":{\"y\":1,\"x\":4},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[],\"option\":\"root\",\"instance_id\":0,\"event\":\"effect\"},{\"initiation_ok\":true,\"call_site\":{\"index\":1,\"body_path\":[],\"caller_instance\":0},\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"event\":\"enter\"},{\"condition\":true,\"index\":0,\"body_path\":[],\"option\":\"child\",\"instance_id\":1,\"event\":\"branch\"},{\"state\":{\"y\":1,\"x\":6},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[0,\"then\"],\"option\":\"child\",\"instance_id\":1,\"event\":\"effect\"}],\"mode\":\"resume\",\"entry\":{\"args\":{\"a\":{\"reg\":\"x\"}},\"option\":\"root\"},\"options\":{\"child\":{\"body\":[{\"else\":[{\"value\":{\"const\":1},\"register\":\"y\",\"op\":\"scale\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"x\",\"op\":\"add\"},{\"else\":[{\"value\":{\"const\":0},\"register\":\"y\",\"op\":\"add\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"y\",\"op\":\"add\"}],\"test\":{\"all\":[{\"right\":{\"param\":\"b\"},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"test\":{\"all\":[{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":4},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"b\"]},\"root\":{\"body\":[{\"value\":{\"param\":\"a\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"b\":{\"param\":\"a\"}},\"option\":\"child\",\"op\":\"call\"},{\"value\":{\"param\":\"a\"},\"register\":\"y\",\"op\":\"add\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"y\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":1},\"cmp\":\"ge\",\"left\":{\"param\":\"a\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"a\"]}},\"initial_state\":{\"y\":1,\"x\":2},\"version\":1,\"kind\":\"option_resume\"}","renderer":"reverse","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-212","semantic_family_id":"hand-semantic-16","semantic_parent_id":"hand-parent-16-R","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":1}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"resume","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"else":[{"op":"add","register":"y","value":{"const":0}}],"op":"if","test":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"param":"b"}}]},"then":[{"op":"add","register":"y","value":{"param":"b"}}]}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":16,"source_family_key":"hand-origin-16","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":2,"phase":"completed","root_pending":false,"state":{"x":6,"y":5}},"error":null,"new_effects":2,"new_events":[{"body_path":[0,"then"],"condition":true,"event":"branch","index":1,"instance_id":1,"option":"child"},{"body_path":[0,"then",1,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"y","state":{"x":6,"y":3},"value":2},{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":6,"y":5},"value":2},{"event":"return","instance_id":0,"option":"root","success_ok":true}],"next_event":null,"previous_effects":2,"status":"completed"}}
{"controlled_context":"T","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-16 forward","controlled_context":"T","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-209","arbitrary-211"],"renderer":"forward","scope":"corpus_variant","source_family_index":16,"source_family_key":"hand-origin-16"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-211","arbitrary-213"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-211","arbitrary-215"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-215","arbitrary-217"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-209","arbitrary-219"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-209","arbitrary-221"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-209","arbitrary-223"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-211","arbitrary-225"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-16 T","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-213","arbitrary-214"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":16,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"173fa96550acc083b333254ff3dac2f7c23c95040e12ad52e3cec0ea48c6bbbd","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"kind\":\"option_resume\",\"version\":1,\"initial_state\":{\"x\":2,\"y\":1},\"options\":{\"root\":{\"params\":[\"a\"],\"initiation\":{\"all\":[{\"left\":{\"param\":\"a\"},\"cmp\":\"ge\",\"right\":{\"const\":1}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}},{\"left\":{\"reg\":\"y\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"body\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"a\"}},{\"op\":\"call\",\"option\":\"child\",\"args\":{\"b\":{\"param\":\"a\"}}},{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"a\"}}]},\"child\":{\"params\":[\"b\"],\"initiation\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":4}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}}]},\"body\":[{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"then\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"b\"}},{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"param\":\"b\"}}]},\"then\":[{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"b\"}}],\"else\":[{\"op\":\"add\",\"register\":\"y\",\"value\":{\"const\":0}}]}],\"else\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":{\"const\":1}}]}]}},\"entry\":{\"option\":\"root\",\"args\":{\"a\":{\"reg\":\"x\"}}},\"mode\":\"restart\",\"history\":[{\"event\":\"enter\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"call_site\":null,\"initiation_ok\":true},{\"event\":\"effect\",\"instance_id\":0,\"option\":\"root\",\"body_path\":[],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":4,\"y\":1}},{\"event\":\"enter\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"call_site\":{\"caller_instance\":0,\"body_path\":[],\"index\":1},\"initiation_ok\":true},{\"event\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[],\"index\":0,\"condition\":true},{\"event\":\"effect\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[0,\"then\"],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":6,\"y\":1}}],\"checkpoint\":{\"state\":{\"x\":6,\"y\":1},\"frames\":[{\"frame_kind\":\"option\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"body_path\":[],\"next_index\":2},{\"frame_kind\":\"option\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[],\"next_index\":1},{\"frame_kind\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[0,\"then\"],\"next_index\":1}],\"next_instance_id\":2,\"root_pending\":false,\"phase\":\"running\"},\"event_budget\":48}","renderer":"forward","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-213","semantic_family_id":"hand-semantic-16","semantic_parent_id":"hand-parent-16-T","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":1}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"restart","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"else":[{"op":"add","register":"y","value":{"const":0}}],"op":"if","test":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"param":"b"}}]},"then":[{"op":"add","register":"y","value":{"param":"b"}}]}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":16,"source_family_key":"hand-origin-16","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[{"bindings":{"a":6},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"}],"next_instance_id":2,"phase":"initiation_failed","root_pending":false,"state":{"x":12,"y":1}},"error":null,"new_effects":1,"new_events":[{"bindings":{"a":6},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":12,"y":1},"value":6},{"bindings":{"b":6},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":false,"instance_id":1,"option":"child"}],"next_event":null,"previous_effects":2,"status":"initiation_failed"}}
{"controlled_context":"T","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-16 reverse","controlled_context":"T","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-210","arbitrary-212"],"renderer":"reverse","scope":"corpus_variant","source_family_index":16,"source_family_key":"hand-origin-16"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-212","arbitrary-214"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-212","arbitrary-216"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-216","arbitrary-218"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-210","arbitrary-220"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-210","arbitrary-222"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-210","arbitrary-224"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-212","arbitrary-226"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-16 T","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-213","arbitrary-214"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":16,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"9ce56746511b28c8e40cba6e132cdec0df94ed5c8a9196189a1f032594fd2305","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"event_budget\":48,\"checkpoint\":{\"phase\":\"running\",\"root_pending\":false,\"next_instance_id\":2,\"frames\":[{\"next_index\":2,\"body_path\":[],\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[0,\"then\"],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"branch\"}],\"state\":{\"y\":1,\"x\":6}},\"history\":[{\"initiation_ok\":true,\"call_site\":null,\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"event\":\"enter\"},{\"state\":{\"y\":1,\"x\":4},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[],\"option\":\"root\",\"instance_id\":0,\"event\":\"effect\"},{\"initiation_ok\":true,\"call_site\":{\"index\":1,\"body_path\":[],\"caller_instance\":0},\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"event\":\"enter\"},{\"condition\":true,\"index\":0,\"body_path\":[],\"option\":\"child\",\"instance_id\":1,\"event\":\"branch\"},{\"state\":{\"y\":1,\"x\":6},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[0,\"then\"],\"option\":\"child\",\"instance_id\":1,\"event\":\"effect\"}],\"mode\":\"restart\",\"entry\":{\"args\":{\"a\":{\"reg\":\"x\"}},\"option\":\"root\"},\"options\":{\"child\":{\"body\":[{\"else\":[{\"value\":{\"const\":1},\"register\":\"y\",\"op\":\"scale\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"x\",\"op\":\"add\"},{\"else\":[{\"value\":{\"const\":0},\"register\":\"y\",\"op\":\"add\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"y\",\"op\":\"add\"}],\"test\":{\"all\":[{\"right\":{\"param\":\"b\"},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"test\":{\"all\":[{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":4},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"b\"]},\"root\":{\"body\":[{\"value\":{\"param\":\"a\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"b\":{\"param\":\"a\"}},\"option\":\"child\",\"op\":\"call\"},{\"value\":{\"param\":\"a\"},\"register\":\"y\",\"op\":\"add\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"y\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":1},\"cmp\":\"ge\",\"left\":{\"param\":\"a\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"a\"]}},\"initial_state\":{\"y\":1,\"x\":2},\"version\":1,\"kind\":\"option_resume\"}","renderer":"reverse","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-214","semantic_family_id":"hand-semantic-16","semantic_parent_id":"hand-parent-16-T","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":1}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"restart","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"else":[{"op":"add","register":"y","value":{"const":0}}],"op":"if","test":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"param":"b"}}]},"then":[{"op":"add","register":"y","value":{"param":"b"}}]}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":16,"source_family_key":"hand-origin-16","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[{"bindings":{"a":6},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"}],"next_instance_id":2,"phase":"initiation_failed","root_pending":false,"state":{"x":12,"y":1}},"error":null,"new_effects":1,"new_events":[{"bindings":{"a":6},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":12,"y":1},"value":6},{"bindings":{"b":6},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":false,"instance_id":1,"option":"child"}],"next_event":null,"previous_effects":2,"status":"initiation_failed"}}
{"controlled_context":"P","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-16 forward","controlled_context":"P","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-209","arbitrary-211"],"renderer":"forward","scope":"corpus_variant","source_family_index":16,"source_family_key":"hand-origin-16"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-211","arbitrary-213"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-211","arbitrary-215"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-215","arbitrary-217"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-209","arbitrary-219"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-209","arbitrary-221"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-209","arbitrary-223"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-211","arbitrary-225"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-16 P","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-215","arbitrary-216"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":16,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"3eb2b3aa99058927f56ea3f965e7b76414d166b8ed5a38a77eeb1efebb4e5868","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"kind\":\"option_resume\",\"version\":1,\"initial_state\":{\"x\":2,\"y\":1},\"options\":{\"root\":{\"params\":[\"a\"],\"initiation\":{\"all\":[{\"left\":{\"param\":\"a\"},\"cmp\":\"ge\",\"right\":{\"const\":1}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}},{\"left\":{\"reg\":\"y\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"body\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"a\"}},{\"op\":\"call\",\"option\":\"child\",\"args\":{\"b\":{\"param\":\"a\"}}},{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"a\"}}]},\"child\":{\"params\":[\"b\"],\"initiation\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":4}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}}]},\"body\":[{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"then\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"b\"}},{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"param\":\"b\"}}]},\"then\":[{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"b\"}}],\"else\":[{\"op\":\"add\",\"register\":\"y\",\"value\":{\"const\":0}}]}],\"else\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":{\"const\":1}}]}]}},\"entry\":{\"option\":\"root\",\"args\":{\"a\":{\"reg\":\"x\"}}},\"mode\":\"resume\",\"history\":[{\"event\":\"enter\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"call_site\":null,\"initiation_ok\":true},{\"event\":\"effect\",\"instance_id\":0,\"option\":\"root\",\"body_path\":[],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":4,\"y\":1}},{\"event\":\"enter\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"call_site\":{\"caller_instance\":0,\"body_path\":[],\"index\":1},\"initiation_ok\":true},{\"event\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[],\"index\":0,\"condition\":true},{\"event\":\"effect\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[0,\"then\"],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":6,\"y\":1}}],\"checkpoint\":{\"state\":{\"x\":6,\"y\":1},\"frames\":[{\"frame_kind\":\"option\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"body_path\":[],\"next_index\":2},{\"frame_kind\":\"option\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[],\"next_index\":1},{\"frame_kind\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[0,\"then\"],\"next_index\":1}],\"next_instance_id\":2,\"root_pending\":false,\"phase\":\"running\"},\"event_budget\":2}","renderer":"forward","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-215","semantic_family_id":"hand-semantic-16","semantic_parent_id":"hand-parent-16-P","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":1}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":2,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"resume","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"else":[{"op":"add","register":"y","value":{"const":0}}],"op":"if","test":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"param":"b"}}]},"then":[{"op":"add","register":"y","value":{"param":"b"}}]}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":16,"source_family_key":"hand-origin-16","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":3}},"error":null,"new_effects":1,"new_events":[{"body_path":[0,"then"],"condition":true,"event":"branch","index":1,"instance_id":1,"option":"child"},{"body_path":[0,"then",1,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"y","state":{"x":6,"y":3},"value":2}],"next_event":{"event":"return","instance_id":1,"option":"child","success_ok":true},"previous_effects":2,"status":"paused"}}
{"controlled_context":"P","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-16 reverse","controlled_context":"P","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-210","arbitrary-212"],"renderer":"reverse","scope":"corpus_variant","source_family_index":16,"source_family_key":"hand-origin-16"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-212","arbitrary-214"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-212","arbitrary-216"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-216","arbitrary-218"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-210","arbitrary-220"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-210","arbitrary-222"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-210","arbitrary-224"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-212","arbitrary-226"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-16 P","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-215","arbitrary-216"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":16,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"7cabfaf74f8f00290c4ee436be62d611683c6ce2d5dc08d9dc401f9ac8436ccf","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"event_budget\":2,\"checkpoint\":{\"phase\":\"running\",\"root_pending\":false,\"next_instance_id\":2,\"frames\":[{\"next_index\":2,\"body_path\":[],\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[0,\"then\"],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"branch\"}],\"state\":{\"y\":1,\"x\":6}},\"history\":[{\"initiation_ok\":true,\"call_site\":null,\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"event\":\"enter\"},{\"state\":{\"y\":1,\"x\":4},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[],\"option\":\"root\",\"instance_id\":0,\"event\":\"effect\"},{\"initiation_ok\":true,\"call_site\":{\"index\":1,\"body_path\":[],\"caller_instance\":0},\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"event\":\"enter\"},{\"condition\":true,\"index\":0,\"body_path\":[],\"option\":\"child\",\"instance_id\":1,\"event\":\"branch\"},{\"state\":{\"y\":1,\"x\":6},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[0,\"then\"],\"option\":\"child\",\"instance_id\":1,\"event\":\"effect\"}],\"mode\":\"resume\",\"entry\":{\"args\":{\"a\":{\"reg\":\"x\"}},\"option\":\"root\"},\"options\":{\"child\":{\"body\":[{\"else\":[{\"value\":{\"const\":1},\"register\":\"y\",\"op\":\"scale\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"x\",\"op\":\"add\"},{\"else\":[{\"value\":{\"const\":0},\"register\":\"y\",\"op\":\"add\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"y\",\"op\":\"add\"}],\"test\":{\"all\":[{\"right\":{\"param\":\"b\"},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"test\":{\"all\":[{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":4},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"b\"]},\"root\":{\"body\":[{\"value\":{\"param\":\"a\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"b\":{\"param\":\"a\"}},\"option\":\"child\",\"op\":\"call\"},{\"value\":{\"param\":\"a\"},\"register\":\"y\",\"op\":\"add\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"y\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":1},\"cmp\":\"ge\",\"left\":{\"param\":\"a\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"a\"]}},\"initial_state\":{\"y\":1,\"x\":2},\"version\":1,\"kind\":\"option_resume\"}","renderer":"reverse","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-216","semantic_family_id":"hand-semantic-16","semantic_parent_id":"hand-parent-16-P","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"},{"bindings":{"b":2},"body_path":[0,"then"],"frame_kind":"branch","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":1}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":2,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"resume","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"else":[{"op":"add","register":"y","value":{"const":0}}],"op":"if","test":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"param":"b"}}]},"then":[{"op":"add","register":"y","value":{"param":"b"}}]}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":16,"source_family_key":"hand-origin-16","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":3}},"error":null,"new_effects":1,"new_events":[{"body_path":[0,"then"],"condition":true,"event":"branch","index":1,"instance_id":1,"option":"child"},{"body_path":[0,"then",1,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"y","state":{"x":6,"y":3},"value":2}],"next_event":{"event":"return","instance_id":1,"option":"child","success_ok":true},"previous_effects":2,"status":"paused"}}
{"controlled_context":"U","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-16 forward","controlled_context":"U","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-209","arbitrary-211"],"renderer":"forward","scope":"corpus_variant","source_family_index":16,"source_family_key":"hand-origin-16"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-211","arbitrary-213"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-211","arbitrary-215"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-215","arbitrary-217"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-209","arbitrary-219"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-209","arbitrary-221"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-209","arbitrary-223"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-211","arbitrary-225"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-16 U","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-217","arbitrary-218"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":16,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"b0d9602111f3aeee0a7a531f2ab050b9de3e7c397e537e72fc7fe1143c08fa2c","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"kind\":\"option_resume\",\"version\":1,\"initial_state\":{\"x\":2,\"y\":1},\"options\":{\"root\":{\"params\":[\"a\"],\"initiation\":{\"all\":[{\"left\":{\"param\":\"a\"},\"cmp\":\"ge\",\"right\":{\"const\":1}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}},{\"left\":{\"reg\":\"y\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"body\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"a\"}},{\"op\":\"call\",\"option\":\"child\",\"args\":{\"b\":{\"param\":\"a\"}}},{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"a\"}}]},\"child\":{\"params\":[\"b\"],\"initiation\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":4}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}}]},\"body\":[{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"then\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"b\"}},{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"param\":\"b\"}}]},\"then\":[{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"b\"}}],\"else\":[{\"op\":\"add\",\"register\":\"y\",\"value\":{\"const\":0}}]}],\"else\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":{\"const\":1}}]}]}},\"entry\":{\"option\":\"root\",\"args\":{\"a\":{\"reg\":\"x\"}}},\"mode\":\"resume\",\"history\":[{\"event\":\"enter\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"call_site\":null,\"initiation_ok\":true},{\"event\":\"effect\",\"instance_id\":0,\"option\":\"root\",\"body_path\":[],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":4,\"y\":1}},{\"event\":\"enter\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"call_site\":{\"caller_instance\":0,\"body_path\":[],\"index\":1},\"initiation_ok\":true},{\"event\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[],\"index\":0,\"condition\":true},{\"event\":\"effect\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[0,\"then\"],\"index\":0,\"op\":\"add\",\"register\":\"x\",\"value\":2,\"state\":{\"x\":6,\"y\":1}},{\"event\":\"branch\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[0,\"then\"],\"index\":1,\"condition\":true},{\"event\":\"effect\",\"instance_id\":1,\"option\":\"child\",\"body_path\":[0,\"then\",1,\"then\"],\"index\":0,\"op\":\"add\",\"register\":\"y\",\"value\":2,\"state\":{\"x\":6,\"y\":3}}],\"checkpoint\":{\"state\":{\"x\":6,\"y\":3},\"frames\":[{\"frame_kind\":\"option\",\"instance_id\":0,\"option\":\"root\",\"bindings\":{\"a\":2},\"body_path\":[],\"next_index\":2},{\"frame_kind\":\"option\",\"instance_id\":1,\"option\":\"child\",\"bindings\":{\"b\":2},\"body_path\":[],\"next_index\":1}],\"next_instance_id\":2,\"root_pending\":false,\"phase\":\"running\"},\"event_budget\":48}","renderer":"forward","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-217","semantic_family_id":"hand-semantic-16","semantic_parent_id":"hand-parent-16-U","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":3}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2},{"body_path":[0,"then"],"condition":true,"event":"branch","index":1,"instance_id":1,"option":"child"},{"body_path":[0,"then",1,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"y","state":{"x":6,"y":3},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"resume","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"else":[{"op":"add","register":"y","value":{"const":0}}],"op":"if","test":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"param":"b"}}]},"then":[{"op":"add","register":"y","value":{"param":"b"}}]}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":16,"source_family_key":"hand-origin-16","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":2,"phase":"completed","root_pending":false,"state":{"x":6,"y":5}},"error":null,"new_effects":1,"new_events":[{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":6,"y":5},"value":2},{"event":"return","instance_id":0,"option":"root","success_ok":true}],"next_event":null,"previous_effects":3,"status":"completed"}}
{"controlled_context":"U","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-16 reverse","controlled_context":"U","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-210","arbitrary-212"],"renderer":"reverse","scope":"corpus_variant","source_family_index":16,"source_family_key":"hand-origin-16"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-212","arbitrary-214"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-212","arbitrary-216"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-216","arbitrary-218"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-210","arbitrary-220"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-210","arbitrary-222"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-210","arbitrary-224"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-212","arbitrary-226"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-16 U","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-217","arbitrary-218"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":16,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"d4dde851aa37a2e17052a8ff6b7bf59f8673fede274271e86f7fb4083524062b","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"event_budget\":48,\"checkpoint\":{\"phase\":\"running\",\"root_pending\":false,\"next_instance_id\":2,\"frames\":[{\"next_index\":2,\"body_path\":[],\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"frame_kind\":\"option\"},{\"next_index\":1,\"body_path\":[],\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"frame_kind\":\"option\"}],\"state\":{\"y\":3,\"x\":6}},\"history\":[{\"initiation_ok\":true,\"call_site\":null,\"bindings\":{\"a\":2},\"option\":\"root\",\"instance_id\":0,\"event\":\"enter\"},{\"state\":{\"y\":1,\"x\":4},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[],\"option\":\"root\",\"instance_id\":0,\"event\":\"effect\"},{\"initiation_ok\":true,\"call_site\":{\"index\":1,\"body_path\":[],\"caller_instance\":0},\"bindings\":{\"b\":2},\"option\":\"child\",\"instance_id\":1,\"event\":\"enter\"},{\"condition\":true,\"index\":0,\"body_path\":[],\"option\":\"child\",\"instance_id\":1,\"event\":\"branch\"},{\"state\":{\"y\":1,\"x\":6},\"value\":2,\"register\":\"x\",\"op\":\"add\",\"index\":0,\"body_path\":[0,\"then\"],\"option\":\"child\",\"instance_id\":1,\"event\":\"effect\"},{\"condition\":true,\"index\":1,\"body_path\":[0,\"then\"],\"option\":\"child\",\"instance_id\":1,\"event\":\"branch\"},{\"state\":{\"y\":3,\"x\":6},\"value\":2,\"register\":\"y\",\"op\":\"add\",\"index\":0,\"body_path\":[0,\"then\",1,\"then\"],\"option\":\"child\",\"instance_id\":1,\"event\":\"effect\"}],\"mode\":\"resume\",\"entry\":{\"args\":{\"a\":{\"reg\":\"x\"}},\"option\":\"root\"},\"options\":{\"child\":{\"body\":[{\"else\":[{\"value\":{\"const\":1},\"register\":\"y\",\"op\":\"scale\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"x\",\"op\":\"add\"},{\"else\":[{\"value\":{\"const\":0},\"register\":\"y\",\"op\":\"add\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"y\",\"op\":\"add\"}],\"test\":{\"all\":[{\"right\":{\"param\":\"b\"},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"test\":{\"all\":[{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":4},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"b\"]},\"root\":{\"body\":[{\"value\":{\"param\":\"a\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"b\":{\"param\":\"a\"}},\"option\":\"child\",\"op\":\"call\"},{\"value\":{\"param\":\"a\"},\"register\":\"y\",\"op\":\"add\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"y\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":1},\"cmp\":\"ge\",\"left\":{\"param\":\"a\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"a\"]}},\"initial_state\":{\"y\":1,\"x\":2},\"version\":1,\"kind\":\"option_resume\"}","renderer":"reverse","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-218","semantic_family_id":"hand-semantic-16","semantic_parent_id":"hand-parent-16-U","semantic_task":{"checkpoint":{"frames":[{"bindings":{"a":2},"body_path":[],"frame_kind":"option","instance_id":0,"next_index":2,"option":"root"},{"bindings":{"b":2},"body_path":[],"frame_kind":"option","instance_id":1,"next_index":1,"option":"child"}],"next_instance_id":2,"phase":"running","root_pending":false,"state":{"x":6,"y":3}},"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":4,"y":1},"value":2},{"bindings":{"b":2},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":6,"y":1},"value":2},{"body_path":[0,"then"],"condition":true,"event":"branch","index":1,"instance_id":1,"option":"child"},{"body_path":[0,"then",1,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"y","state":{"x":6,"y":3},"value":2}],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"resume","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"else":[{"op":"add","register":"y","value":{"const":0}}],"op":"if","test":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"param":"b"}}]},"then":[{"op":"add","register":"y","value":{"param":"b"}}]}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":16,"source_family_key":"hand-origin-16","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":2,"phase":"completed","root_pending":false,"state":{"x":6,"y":5}},"error":null,"new_effects":1,"new_events":[{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":6,"y":5},"value":2},{"event":"return","instance_id":0,"option":"root","success_ok":true}],"next_event":null,"previous_effects":3,"status":"completed"}}
{"controlled_context":"A","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-16 forward","controlled_context":"A","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-209","arbitrary-211"],"renderer":"forward","scope":"corpus_variant","source_family_index":16,"source_family_key":"hand-origin-16"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-211","arbitrary-213"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-211","arbitrary-215"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-215","arbitrary-217"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-209","arbitrary-219"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-209","arbitrary-221"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-209","arbitrary-223"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-211","arbitrary-225"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-16 A","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-219","arbitrary-220"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":16,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"d063158b3092a2df6b2c7c6f13e001cefb0d81b845e81b2ffe8a86e08ead4748","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"kind\":\"option_resume\",\"version\":1,\"initial_state\":{\"x\":2,\"y\":1},\"options\":{\"root\":{\"params\":[\"a\"],\"initiation\":{\"all\":[{\"left\":{\"param\":\"a\"},\"cmp\":\"ge\",\"right\":{\"const\":1}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}},{\"left\":{\"reg\":\"y\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"body\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"a\"}},{\"op\":\"call\",\"option\":\"child\",\"args\":{\"b\":{\"param\":\"a\"}}},{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"a\"}}]},\"child\":{\"params\":[\"b\"],\"initiation\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":4}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}}]},\"body\":[{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"then\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"b\"}},{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"param\":\"b\"}}]},\"then\":[{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"b\"}}],\"else\":[{\"op\":\"add\",\"register\":\"y\",\"value\":{\"const\":0}}]}],\"else\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":{\"const\":1}}]}]}},\"entry\":{\"option\":\"root\",\"args\":{\"a\":{\"const\":3}}},\"mode\":\"fresh\",\"history\":[],\"checkpoint\":null,\"event_budget\":48}","renderer":"forward","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-219","semantic_family_id":"hand-semantic-16","semantic_parent_id":"hand-parent-16-A","semantic_task":{"checkpoint":null,"entry":{"args":{"a":{"const":3}},"option":"root"},"event_budget":48,"history":[],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"fresh","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"else":[{"op":"add","register":"y","value":{"const":0}}],"op":"if","test":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"param":"b"}}]},"then":[{"op":"add","register":"y","value":{"param":"b"}}]}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":16,"source_family_key":"hand-origin-16","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":2,"phase":"completed","root_pending":false,"state":{"x":8,"y":7}},"error":null,"new_effects":4,"new_events":[{"bindings":{"a":3},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":5,"y":1},"value":3},{"bindings":{"b":3},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":8,"y":1},"value":3},{"body_path":[0,"then"],"condition":true,"event":"branch","index":1,"instance_id":1,"option":"child"},{"body_path":[0,"then",1,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"y","state":{"x":8,"y":4},"value":3},{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":8,"y":7},"value":3},{"event":"return","instance_id":0,"option":"root","success_ok":true}],"next_event":null,"previous_effects":0,"status":"completed"}}
{"controlled_context":"A","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-16 reverse","controlled_context":"A","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-210","arbitrary-212"],"renderer":"reverse","scope":"corpus_variant","source_family_index":16,"source_family_key":"hand-origin-16"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-212","arbitrary-214"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-212","arbitrary-216"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-216","arbitrary-218"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-210","arbitrary-220"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-210","arbitrary-222"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-210","arbitrary-224"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-212","arbitrary-226"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-16 A","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-219","arbitrary-220"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":16,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"f430b42eec848c7ddfb6f0d4ace1444c727779ed00896fdf990b5c86a03af732","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"event_budget\":48,\"checkpoint\":null,\"history\":[],\"mode\":\"fresh\",\"entry\":{\"args\":{\"a\":{\"const\":3}},\"option\":\"root\"},\"options\":{\"child\":{\"body\":[{\"else\":[{\"value\":{\"const\":1},\"register\":\"y\",\"op\":\"scale\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"x\",\"op\":\"add\"},{\"else\":[{\"value\":{\"const\":0},\"register\":\"y\",\"op\":\"add\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"y\",\"op\":\"add\"}],\"test\":{\"all\":[{\"right\":{\"param\":\"b\"},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"test\":{\"all\":[{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":4},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"b\"]},\"root\":{\"body\":[{\"value\":{\"param\":\"a\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"b\":{\"param\":\"a\"}},\"option\":\"child\",\"op\":\"call\"},{\"value\":{\"param\":\"a\"},\"register\":\"y\",\"op\":\"add\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"y\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":1},\"cmp\":\"ge\",\"left\":{\"param\":\"a\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"a\"]}},\"initial_state\":{\"y\":1,\"x\":2},\"version\":1,\"kind\":\"option_resume\"}","renderer":"reverse","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-220","semantic_family_id":"hand-semantic-16","semantic_parent_id":"hand-parent-16-A","semantic_task":{"checkpoint":null,"entry":{"args":{"a":{"const":3}},"option":"root"},"event_budget":48,"history":[],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"fresh","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"else":[{"op":"add","register":"y","value":{"const":0}}],"op":"if","test":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"param":"b"}}]},"then":[{"op":"add","register":"y","value":{"param":"b"}}]}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":16,"source_family_key":"hand-origin-16","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":2,"phase":"completed","root_pending":false,"state":{"x":8,"y":7}},"error":null,"new_effects":4,"new_events":[{"bindings":{"a":3},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body_path":[],"event":"effect","index":0,"instance_id":0,"op":"add","option":"root","register":"x","state":{"x":5,"y":1},"value":3},{"bindings":{"b":3},"call_site":{"body_path":[],"caller_instance":0,"index":1},"event":"enter","initiation_ok":true,"instance_id":1,"option":"child"},{"body_path":[],"condition":true,"event":"branch","index":0,"instance_id":1,"option":"child"},{"body_path":[0,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"x","state":{"x":8,"y":1},"value":3},{"body_path":[0,"then"],"condition":true,"event":"branch","index":1,"instance_id":1,"option":"child"},{"body_path":[0,"then",1,"then"],"event":"effect","index":0,"instance_id":1,"op":"add","option":"child","register":"y","state":{"x":8,"y":4},"value":3},{"event":"return","instance_id":1,"option":"child","success_ok":true},{"body_path":[],"event":"effect","index":2,"instance_id":0,"op":"add","option":"root","register":"y","state":{"x":8,"y":7},"value":3},{"event":"return","instance_id":0,"option":"root","success_ok":true}],"next_event":null,"previous_effects":0,"status":"completed"}}
{"controlled_context":"I","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-16 forward","controlled_context":"I","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-209","arbitrary-211"],"renderer":"forward","scope":"corpus_variant","source_family_index":16,"source_family_key":"hand-origin-16"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-211","arbitrary-213"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-211","arbitrary-215"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-215","arbitrary-217"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-209","arbitrary-219"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-209","arbitrary-221"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-209","arbitrary-223"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-211","arbitrary-225"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-16 I","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-221","arbitrary-222"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":16,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"9e7916ec38f2765bf3c0d41ff66561d3ae654e908bf0dc32b115b36d67f20968","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"kind\":\"option_resume\",\"version\":1,\"initial_state\":{\"x\":2,\"y\":1},\"options\":{\"root\":{\"params\":[\"a\"],\"initiation\":{\"all\":[{\"left\":{\"param\":\"a\"},\"cmp\":\"ge\",\"right\":{\"const\":1}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}},{\"left\":{\"reg\":\"y\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"body\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"a\"}},{\"op\":\"call\",\"option\":\"child\",\"args\":{\"b\":{\"param\":\"a\"}}},{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"a\"}}]},\"child\":{\"params\":[\"b\"],\"initiation\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":4}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}}]},\"body\":[{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"then\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"b\"}},{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"param\":\"b\"}}]},\"then\":[{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"b\"}}],\"else\":[{\"op\":\"add\",\"register\":\"y\",\"value\":{\"const\":0}}]}],\"else\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":{\"const\":1}}]}]}},\"entry\":{\"option\":\"root\",\"args\":{\"a\":{\"const\":0}}},\"mode\":\"fresh\",\"history\":[],\"checkpoint\":null,\"event_budget\":48}","renderer":"forward","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-221","semantic_family_id":"hand-semantic-16","semantic_parent_id":"hand-parent-16-I","semantic_task":{"checkpoint":null,"entry":{"args":{"a":{"const":0}},"option":"root"},"event_budget":48,"history":[],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"fresh","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"else":[{"op":"add","register":"y","value":{"const":0}}],"op":"if","test":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"param":"b"}}]},"then":[{"op":"add","register":"y","value":{"param":"b"}}]}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":16,"source_family_key":"hand-origin-16","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":1,"phase":"initiation_failed","root_pending":false,"state":{"x":2,"y":1}},"error":null,"new_effects":0,"new_events":[{"bindings":{"a":0},"call_site":null,"event":"enter","initiation_ok":false,"instance_id":0,"option":"root"}],"next_event":null,"previous_effects":0,"status":"initiation_failed"}}
{"controlled_context":"I","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-16 reverse","controlled_context":"I","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-210","arbitrary-212"],"renderer":"reverse","scope":"corpus_variant","source_family_index":16,"source_family_key":"hand-origin-16"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-212","arbitrary-214"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-212","arbitrary-216"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-216","arbitrary-218"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-210","arbitrary-220"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-210","arbitrary-222"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-210","arbitrary-224"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 reverse","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-212","arbitrary-226"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-16 I","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-221","arbitrary-222"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":16,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"1fcc608e927b3bf8fd61584bf2cd21050b7a52b9d69fe505b1b90a05a262639b","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"event_budget\":48,\"checkpoint\":null,\"history\":[],\"mode\":\"fresh\",\"entry\":{\"args\":{\"a\":{\"const\":0}},\"option\":\"root\"},\"options\":{\"child\":{\"body\":[{\"else\":[{\"value\":{\"const\":1},\"register\":\"y\",\"op\":\"scale\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"x\",\"op\":\"add\"},{\"else\":[{\"value\":{\"const\":0},\"register\":\"y\",\"op\":\"add\"}],\"then\":[{\"value\":{\"param\":\"b\"},\"register\":\"y\",\"op\":\"add\"}],\"test\":{\"all\":[{\"right\":{\"param\":\"b\"},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"test\":{\"all\":[{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"op\":\"if\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":4},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":6},\"cmp\":\"lt\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"b\"]},\"root\":{\"body\":[{\"value\":{\"param\":\"a\"},\"register\":\"x\",\"op\":\"add\"},{\"args\":{\"b\":{\"param\":\"a\"}},\"option\":\"child\",\"op\":\"call\"},{\"value\":{\"param\":\"a\"},\"register\":\"y\",\"op\":\"add\"}],\"success\":{\"all\":[{\"right\":{\"const\":0},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"y\"}}]},\"initiation\":{\"all\":[{\"right\":{\"const\":1},\"cmp\":\"ge\",\"left\":{\"param\":\"a\"}},{\"right\":{\"const\":-4096},\"cmp\":\"ge\",\"left\":{\"reg\":\"x\"}}]},\"params\":[\"a\"]}},\"initial_state\":{\"y\":1,\"x\":2},\"version\":1,\"kind\":\"option_resume\"}","renderer":"reverse","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-222","semantic_family_id":"hand-semantic-16","semantic_parent_id":"hand-parent-16-I","semantic_task":{"checkpoint":null,"entry":{"args":{"a":{"const":0}},"option":"root"},"event_budget":48,"history":[],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"fresh","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"else":[{"op":"add","register":"y","value":{"const":0}}],"op":"if","test":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"param":"b"}}]},"then":[{"op":"add","register":"y","value":{"param":"b"}}]}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":16,"source_family_key":"hand-origin-16","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":1,"phase":"initiation_failed","root_pending":false,"state":{"x":2,"y":1}},"error":null,"new_effects":0,"new_events":[{"bindings":{"a":0},"call_site":null,"event":"enter","initiation_ok":false,"instance_id":0,"option":"root"}],"next_event":null,"previous_effects":0,"status":"initiation_failed"}}
{"controlled_context":"S","difficulty":3,"family_control_claims":[{"control_id":" shared public evidence hand-origin-16 forward","controlled_context":"S","diagnostics":{"untrusted":"checked independently"},"evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"uninterrupted_resume_suffix","pair_sample_ids":["arbitrary-209","arbitrary-211"],"renderer":"forward","scope":"corpus_variant","source_family_index":16,"source_family_key":"hand-origin-16"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-211","arbitrary-213"],"property":"resume_restart_replay","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"budget_pause_after_effect","pair_sample_ids":["arbitrary-211","arbitrary-215"],"property":"budget_pause_after_effect","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"second_checkpoint_suffix","pair_sample_ids":["arbitrary-215","arbitrary-217"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-209","arbitrary-219"],"property":"positive_bound_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"initiation_argument_counterfactual","pair_sample_ids":["arbitrary-209","arbitrary-221"],"property":"initiation_argument_counterfactual","scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"success_contract_counterfactual","pair_sample_ids":["arbitrary-209","arbitrary-223"],"scope":"corpus_variant"},{"control_id":" shared public evidence hand-origin-16 forward","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","pair_sample_ids":["arbitrary-211","arbitrary-225"],"property":"active_checkpoint_tamper_rejection","scope":"corpus_variant"},{"control_id":"view hand-origin-16 S","evidence_manifest":"reviews/oracle/RSM-option-resumption-corpus-20261010T0956Z/hand-control-manifest.json","name":"object_field_order_invariance","pair_sample_ids":["arbitrary-223","arbitrary-224"],"property":"object_field_order_invariance","scope":"corpus_variant"}],"generation_seed":16,"generator_version":"hand-fixture-1","oracle_version":"own-task427","property_witnesses":{},"record_hash":"c14463ba3194b43d9fc1978af9df761770c31c040a185d88cae9e2be840e2913","rendered_input":"# RSM prospective option resumption contract v1\n\nFrozen prospective public design, 2026-10-10 UTC. Actual author: `/root/research_architect`. New task kind `option_resume`, integer version `1`. This does not amend legacy `kind=skills`, its release, checker or targets. No interpreter, sample, gold, scorer or release is produced here. This contract specifies a finite supplied procedure, not discovery of an option policy or planning among alternative implementations.\n\n## Typed input\n\nThe task has exactly `kind,version,initial_state,options,entry,mode,history,checkpoint,event_budget`. `kind` is `option_resume`; `version` is integer 1. Integers exclude booleans; no floats, coercion, overflow or implicit truncation. Objects are compared independently of field order; list order is significant. All option/parameter names are nonempty strings. All integer arithmetic is exact.\n\n- `initial_state` has exactly integer registers `x,y`.\n- `options` is a nonempty map from distinct names to objects with exactly `params,initiation,success,body`. `params` is an ordered list of distinct names. `body` is an instruction list. Every option's call graph, including calls in both conditional branches and unused options, is acyclic.\n- An expression has exactly one form: `{const:integer}`, `{reg:\"x\"|\"y\"}`, or `{param:existing_parameter_name}`. Registers read the current global state; parameters read the current option's immutable bindings. A predicate is exactly `{all:[atoms]}`; an atom is exactly `{left:expression,cmp:\"lt\"|\"eq\"|\"ge\",right:expression}`. Evaluate all atoms against the same state/bindings; empty `all` is true. Predicates have no effects.\n- Instructions have exactly these forms: `{op:\"add\",register:\"x\"|\"y\",value:expression}`, `{op:\"scale\",register:\"x\"|\"y\",value:expression}`, `{op:\"swap\"}`, `{op:\"call\",option:existing_option,args:{parameter:expression,...}}`, or `{op:\"if\",test:predicate,then:[instructions],else:[instructions]}`. `add` increments and `scale` multiplies the selected register; `swap` exchanges both registers simultaneously. Calls share global registers and return before the next caller instruction. Branches execute exactly one selected list.\n- `entry` is exactly `{option:existing_option,args:{parameter:expression,...}}`. Every call/entry `args` map has exactly the called option's parameter keys. Evaluate **all** arguments simultaneously in the caller's pre-call state/bindings, then copy those integers into the callee. No later register change can rebind an argument. Root entry expressions may use constants/registers but cannot use parameters. All parameter references anywhere in an option refer to that option's declared parameters, including expressions in nested branches and call arguments.\n- `mode` is exactly `fresh`, `resume` or `restart`. `history` is the ordered list of already committed semantic events from the original execution starting at `initial_state` and `entry`. `checkpoint` is null or the exact snapshot below. `event_budget` is a nonnegative integer: the maximum number of **new semantic events**, including entry, branch and return events, to execute. It is not a primitive-effect count.\n\nInitiation is checked once, on each new option entry after argument binding and before body execution. A false initiation causes `initiation_failed` and no callee body effects. A successful entry does **not** imply a successful option. Success is checked against the current state and retained bindings only at normal body exhaustion. A false success causes `success_failed`. It does not roll back effects. Success is not an early-stop predicate, and initiation is not rechecked while resuming an already entered frame. Any runtime failure halts the whole run; there is no hidden retry, rollback, exception handler or alternate policy.\n\n## Frames and event boundaries\n\nA snapshot has exactly `state,frames,next_instance_id,root_pending,phase`. State is the two-register map. `next_instance_id` is a nonnegative integer. `root_pending` is boolean. `phase` is `running`, `completed`, `initiation_failed` or `success_failed`. `frames` is the ordered stack, bottom first. Every frame has exactly `frame_kind,instance_id,option,bindings,body_path,next_index`:\n\n- `frame_kind` is `option` or `branch`; `instance_id` identifies its owning option invocation; `bindings` is the exact immutable parameter-to-integer map for that invocation.\n- An option frame has `body_path=[]` and indexes its option's body. A branch frame indexes a selected branch list in that same option. Its `body_path` alternates an integer instruction index and `then`/`else`, for example `[2,\"then\",0,\"else\"]`; the empty path selects the body. A path must actually resolve through `if` instructions to a list. `next_index` is the next unexecuted instruction in that list, in range 0..list length.\n- A caller or branch cursor advances **before** its call/selected-branch frame is pushed. Completed effects therefore cannot remain pending behind a child. Branch frames copy their owning invocation's bindings; they do not introduce new variables or invocation IDs.\n\nThe initial machine has `state=initial_state`, no frames, `next_instance_id=0`, `root_pending=true`, `phase=running`. Remove exhausted branch frames without generating an event, repeatedly, before every event and snapshot. Do not remove an exhausted option frame: its next event must test success and return. This normalization is part of the canonical checkpoint; accepting an unnormalized supplied stack is prohibited.\n\nEach event is one atomic transition. The following event objects have exactly the listed fields:\n\n| Event | Fields and transition |\n|---|---|\n| `enter` | `{event:\"enter\",instance_id,option,bindings,call_site,initiation_ok}`. Allocate and increment the invocation counter even if initiation fails. Root `call_site` is null; a nested site's exact shape is `{caller_instance,body_path,index}`. Bind arguments in the pre-call state. On true initiation push the new option frame with cursor 0; on false halt. Root entry clears root_pending. A nested call advances its caller cursor before this event's push/failure. |\n| `branch` | `{event:\"branch\",instance_id,option,body_path,index,condition}`. Evaluate the current `if` predicate once, advance its containing cursor and push only the chosen branch frame. Record the actual boolean; never reevaluate a suspended chosen branch. |\n| `effect` | `add`/`scale`: `{event:\"effect\",instance_id,option,body_path,index,op,register,value,state}`; `swap`: `{event:\"effect\",instance_id,option,body_path,index,op:\"swap\",state}`. `value` is the evaluated integer operand and `state` is the complete **after** state. Advance the cursor exactly once. The body locator is the instruction before advancement. |\n| `return` | `{event:\"return\",instance_id,option,success_ok}`. Check the exhausted option's success predicate, pop its frame on either outcome, then normalize completed branches. False success halts with any unfinished caller frames retained. True root return, leaving no frames, completes the run; a successful child returns to its already advanced caller. |\n\nEvent IDs/locators are derived from actual execution, not supplied naming patterns. Running with root_pending generates root enter next; otherwise use the top frame's current instruction or exhausted-option return. Every valid program is finite because the instruction tree and call DAG are finite. Two interruptions cannot move a completed instruction back into the pending stack.\n\n## History validation, modes and malformed policy\n\nValidate in this order; there is no best-effort repair:\n\n1. Validate the exact task envelope and program, expression types/references, call acyclicity, mode/version and budget. Missing envelope fields, unknown fields, bad integer types, missing option/parameter names or recursive calls produce `invalid_task`.\n2. Starting from the initial machine, independently generate the exact next event for each history position and compare the supplied event with it using typed object equality and ordered lists. A malformed/non-list history, incorrect event field/value/order, or event after terminal phase produces `invalid_history`. A history is a committed **prefix**, not an unordered bag or an instruction-count claim.\n3. For fresh mode require an empty history and null checkpoint. For resume/restart require a correctly typed checkpoint exactly equal to the normalized machine after that history, including every state value, frame, binding, cursor, invocation counter, root_pending and phase. Missing, malformed or unequal checkpoints, or forbidden fresh history/checkpoint combinations, produce `invalid_checkpoint`. Validation uses the original initial state/entry even for restart. This makes the history and checkpoint independently auditable instead of trusting a producer-supplied stack.\n\nAfter validation:\n\n- `fresh` continues the initial machine.\n- `resume` continues the exact checkpoint machine. It executes only pending work and retains previously bound arguments/selected branches. A terminal checkpoint resumes with no new event and its existing terminal phase.\n- `restart` deliberately starts a **new** machine from the checkpoint's current state, root entry and declared options, with frames empty, next_instance_id 0 and root_pending true. Root arguments/guards are evaluated again against that state. It does not pretend completed effects were undone. Invocation numbers restart inside this new run; history and new_events are separate logs. A valid failed/completed checkpoint may be restarted. Resume and restart are different visible requests, not an invisible corrective policy.\n\nExecute until a terminal phase or event_budget new events, whichever occurs first. A terminal transition at the last allowed event is terminal, not paused. With zero budget a running machine is paused before its next event. Failed initiation/success retains the state containing all prior effects; unfinished caller frames remain in the terminal snapshot and cannot be resumed past failure under this version.\n\n## Unique typed output\n\nReturn exactly `{status,error,checkpoint,new_events,previous_effects,new_effects,next_event}`. Status is `completed`, `paused`, `initiation_failed`, `success_failed` or `invalid`.\n\n- On invalid input return exactly status invalid, error the first validation-stage code above, checkpoint null, new_events empty, previous_effects null, new_effects 0 and next_event null. This policy intentionally includes visible malformed histories/checkpoints in the valid supervision domain.\n- Otherwise error is null. checkpoint is the exact normalized final snapshot. Its phase is running when output status is paused; otherwise phase equals the terminal status. new_events contains only actually executed continuation/new-run events, in order. previous_effects counts effect events in the validated history; new_effects counts effect events in new_events. For resume, history followed by new_events is a single valid original trace. For restart it is not: the two logs intentionally describe different runs.\n- At pause, next_event is the uniquely determined next full event computed from the snapshot **without committing it**. Otherwise next_event is null. Predicting its after-state does not advance the checkpoint, count or cursor.\n\nThe supplied policy and event timing are deterministic, so there is exactly one typed result. There is no optimization, unspecified action selection or legal-plan tie to break. JSON field-order variants of the same object are equivalent; all specified list orders remain significant. Do not select a convenient teacher trace among alternative policies: introducing policy choice or a set of legal plans requires a separate public contract accepting all legal ties.\n\n## Public matched-control meaning\n\nAll facts needed for execution, boundaries, arguments, guards, history, mode and budget are student-visible task fields. Context letters, difficulty, mechanism labels and expected outcomes must stay outside the prompt. The full contract is included before `Task JSON:\\n` and the exact task JSON; no expected status or target is encoded in metadata as an input hint.\n\n- Resume versus uninterrupted execution: use the same program/root request and a true committed prefix. Complete resumption must reproduce the uninterrupted terminal state/status and exact remaining event suffix. Prefix effects do not occur again.\n- Resume versus restart: hold program, validated history and checkpoint fixed; change only mode. For the initial pilot's replay control, root initiation passes on restart and an actually committed non-idempotent effect executes again, producing a measured difference in continuation trace and terminal state or status. New future work remains for resume. An immediately blocked restart or merely calling an operation non-idempotent is insufficient; initiation failure is a separate control.\n- Bound argument control: an argument evaluated from a register on entry remains fixed after the register changes; an actual later effect/guard/success depends on that saved value. A positive argument counterfactual changes one root argument while both runs initiate, and changes an actual outcome or trace. Do not credit unused formal parameters.\n- Guard controls: change one root argument for a matched initiation pass/fail case, with no callee effects on failure. Separately change one literal in the root success predicate so the same body/entry/history produces the same effects but opposite success at return; this is a success-contract control, not a rollback claim.\n- Multiple checkpoints: pausing at a second actual event prefix and resuming its independently validated snapshot must match the same complete suffix. Demonstrate retained nested callers/selected branch where actually present; do not infer a second interruption from a long trace alone.\n- Tampered checkpoint: change one actually consequential state, cursor or saved binding while retaining the original history. Exact validation must reject it before executing any new event. A correct-looking final state cannot rescue a false history/stack. Actual validity/status must be derived, not inferred from a context label.\n\nLater independent oracles must test every event boundary, zero/full budgets, failed entry/exit, empty branches/bodies, retained caller cursors, simultaneous binding, typed malformed cases and resume-prefix/suffix composition. These are prospective properties, not tests executed here.\n\nThis is bounded explicit interpreter execution. It does not establish learned hierarchy, discovered options, chosen termination policies, general recovery, student-state aggregation, sealed transfer or model efficacy. Public-design authorship and any later adjudication overlap, root guidance and common-model correlation must be disclosed in later receipts.\n\nTask JSON:\n{\"kind\":\"option_resume\",\"version\":1,\"initial_state\":{\"x\":2,\"y\":1},\"options\":{\"root\":{\"params\":[\"a\"],\"initiation\":{\"all\":[{\"left\":{\"param\":\"a\"},\"cmp\":\"ge\",\"right\":{\"const\":1}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":100000}},{\"left\":{\"reg\":\"y\"},\"cmp\":\"ge\",\"right\":{\"const\":-4096}}]},\"body\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"a\"}},{\"op\":\"call\",\"option\":\"child\",\"args\":{\"b\":{\"param\":\"a\"}}},{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"a\"}}]},\"child\":{\"params\":[\"b\"],\"initiation\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":4}},{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"success\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"const\":0}}]},\"body\":[{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"lt\",\"right\":{\"const\":6}}]},\"then\":[{\"op\":\"add\",\"register\":\"x\",\"value\":{\"param\":\"b\"}},{\"op\":\"if\",\"test\":{\"all\":[{\"left\":{\"reg\":\"x\"},\"cmp\":\"ge\",\"right\":{\"param\":\"b\"}}]},\"then\":[{\"op\":\"add\",\"register\":\"y\",\"value\":{\"param\":\"b\"}}],\"else\":[{\"op\":\"add\",\"register\":\"y\",\"value\":{\"const\":0}}]}],\"else\":[{\"op\":\"scale\",\"register\":\"y\",\"value\":{\"const\":1}}]}]}},\"entry\":{\"option\":\"root\",\"args\":{\"a\":{\"reg\":\"x\"}}},\"mode\":\"fresh\",\"history\":[],\"checkpoint\":null,\"event_budget\":48}","renderer":"forward","review_receipt_ids":[],"review_status":"PENDING","sample_id":"arbitrary-223","semantic_family_id":"hand-semantic-16","semantic_parent_id":"hand-parent-16-S","semantic_task":{"checkpoint":null,"entry":{"args":{"a":{"reg":"x"}},"option":"root"},"event_budget":48,"history":[],"initial_state":{"x":2,"y":1},"kind":"option_resume","mode":"fresh","options":{"child":{"body":[{"else":[{"op":"scale","register":"y","value":{"const":1}}],"op":"if","test":{"all":[{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"then":[{"op":"add","register":"x","value":{"param":"b"}},{"else":[{"op":"add","register":"y","value":{"const":0}}],"op":"if","test":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"param":"b"}}]},"then":[{"op":"add","register":"y","value":{"param":"b"}}]}]}],"initiation":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":4}},{"cmp":"lt","left":{"reg":"x"},"right":{"const":6}}]},"params":["b"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":0}}]}},"root":{"body":[{"op":"add","register":"x","value":{"param":"a"}},{"args":{"b":{"param":"a"}},"op":"call","option":"child"},{"op":"add","register":"y","value":{"param":"a"}}],"initiation":{"all":[{"cmp":"ge","left":{"param":"a"},"right":{"const":1}},{"cmp":"ge","left":{"reg":"x"},"right":{"const":-4096}}]},"params":["a"],"success":{"all":[{"cmp":"ge","left":{"reg":"x"},"right":{"const":100000}},{"cmp":"ge","left":{"reg":"y"},"right":{"const":-4096}}]}}},"version":1},"skill_tags":["finite_supplied_policy","hand_development_fixture"],"source_family_index":16,"source_family_key":"hand-origin-16","source_provenance":{"curriculum_difficulty_explanation":"Saved register-derived arguments remain in nested caller/selected-branch frames after guard reversal; validating committed history and the pending continuation requires these dependencies.","sealed_evaluation_used":false},"split":"train","structural_difficulty":3,"target_format":"json","track_id":"RSM-001","verified_target":{"checkpoint":{"frames":[],"next_instance_id":2,"phase":"success_failed","root_pending":false,"state":{"x":6,"y":5}},"error":null,"new_effects":4,"new_events":[{"bindings":{"a":2},"call_site":null,"event":"enter","initiation_ok":true,"instance_id":0,"option":"root"},{"body