{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rineya canonical v1",
  "type": "object",
  "required": [
    "sample_id",
    "semantic_parent_id",
    "semantic_family_id",
    "track_id",
    "skill_tags",
    "difficulty",
    "generator_version",
    "oracle_version",
    "generation_seed",
    "source_provenance",
    "semantic_task",
    "rendered_input",
    "verified_target",
    "target_format",
    "split",
    "review_status",
    "review_receipt_ids",
    "record_hash"
  ],
  "properties": {
    "sample_id": {
      "type": "string"
    },
    "semantic_parent_id": {
      "type": "string"
    },
    "semantic_family_id": {
      "type": "string"
    },
    "track_id": {
      "type": "string"
    },
    "skill_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "generator_version": {
      "type": "string"
    },
    "oracle_version": {
      "type": "string"
    },
    "generation_seed": {
      "type": "integer"
    },
    "source_provenance": {
      "type": "object"
    },
    "semantic_task": {
      "type": "object"
    },
    "rendered_input": {
      "type": "string"
    },
    "verified_target": {
      "type": "object"
    },
    "target_format": {
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "dev_challenge"
      ]
    },
    "review_status": {
      "enum": [
        "PENDING",
        "ACCEPTED",
        "REVISE",
        "REJECT",
        "QUARANTINE"
      ]
    },
    "review_receipt_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
