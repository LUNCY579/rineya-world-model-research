def main():
    import argparse
    sys.dont_write_bytecode=True
    parser=argparse.ArgumentParser(description='Factual comparison only; no quality votes or receipts')
    anchor_arguments(parser);args=parser.parse_args()
    before=anchored_closure(ROOT,OUT,args,'RSM_CANONICAL_FACTUAL_COMPARISON')
    config=json.loads((OUT/'RUN_CONFIG.json').read_text())
    sys.path[:0]=[str(PREP),str(CORRECTED),str(INPUT)]
    import frame_solver_r1 as frame
    import recursive_simulator_r1 as recursive
    import control_probes_r2 as controls
    import run_input_review_r1 as owninput
    after_imports=anchored_closure(ROOT,OUT,args,'RSM_CANONICAL_FACTUAL_COMPARISON')
    started=datetime.datetime.now(datetime.timezone.utc).isoformat();clock=time.monotonic()
    read=lambda path:[frame.strict_json(x) for x in (ROOT/path).read_text().splitlines()]
    rows=read(config['candidate_path']);parents=read(config['parent_path']);legacy=read(config['legacy_input_path'])
    manifest=frame.strict_json((ROOT/config['manifest_path']).read_text());schema=frame.strict_json((ROOT/'schemas/canonical/v1.schema.json').read_text())
    first={r['sample_id']:r for r in read(str((INPUT/'frame_predictions.jsonl').relative_to(ROOT)))}
    second={r['sample_id']:r for r in read(str((INPUT/'recursive_predictions.jsonl').relative_to(ROOT)))}
    view={r['sample_id']:r for r in read('reviews/input_only/RSM-option-resumption-pilot-v1.jsonl')}
    checks=[];failures=[];outputs={};members={};families=defaultdict(dict);perrow=defaultdict(list)
    def check(name,fn,sid=None):
        try:
            result=fn();assert_true(result is not False,name);okay=True;error=None
        except Exception as e:okay=False;error=type(e).__name__+': '+str(e);result=None
        item={'check':name,'passed':okay,'sample_id':sid}
        if not okay:item['factual_failure']=error;failures.append(item)
        checks.append(item)
        if sid:perrow[sid].append(item)
        return result
    check('216_actual_rows',lambda:len(rows)==216);check('108_actual_parents',lambda:len(parents)==108)
    assert_true(bind(ROOT/config['candidate_path'])['sha256']==config['candidate_sha256'],'frozen candidate SHA')
    for row in rows:
        sid=row['sample_id'];check('unique_id',lambda:sid not in members,sid);members[sid]=row
        check('public_canonical_schema',lambda:validate_schema(row,schema),sid)
        check('full_record_hash',lambda:record_hash(row)==row['record_hash'],sid)
        check('pending_unapproved',lambda:row['review_status']=='PENDING' and row['review_receipt_ids']==[],sid)
        check('exact_stripped_join',lambda:all(frame.typed_equal(row[k],view[sid][k]) for k in view[sid]),sid)
        check('first_frame_prediction_join',lambda:first[sid]['record_hash']==row['record_hash'] and first[sid]['typed_task_sha256']==semantic_hash(row['semantic_task']),sid)
        check('first_recursive_prediction_join',lambda:second[sid]['record_hash']==row['record_hash'] and second[sid]['typed_task_sha256']==semantic_hash(row['semantic_task']),sid)
        check('immutable_frame_target',lambda:frame.typed_equal(row['verified_target'],first[sid]['expected_output']),sid)
        check('immutable_recursive_target',lambda:frame.typed_equal(row['verified_target'],second[sid]['expected_output']),sid)
        fresh=frame.solve(row['semantic_task']);other=recursive.solve(row['semantic_task']);outputs[sid]=fresh
        check('fresh_own_solver_agreement',lambda:frame.typed_equal(fresh,other) and frame.typed_equal(fresh,first[sid]['expected_output']),sid)
        def bounds():
            t=row['semantic_task'];g=owninput.geometry(t,frame);events,snapshots=recursive.full_execution(t)
            assert_true(2<=g['options']<=4 and all(1<=n<=3 for n in g['parameters']) and g['declared_instructions']<=24 and g['conditional_depth']<=2,'declared cohort bounds')
            assert_true(all(type(n) is int and -6<=n<=6 for n in t['initial_state'].values()),'initial integer bounds')
            assert_true(len(events)<=48 and max(sum(fr['frame_kind']=='option' for fr in s['frames']) for s in snapshots)<=3,'actual complete event/option-depth bounds')
            assert_true(all(-4096<=v<=4096 for s in snapshots for v in s['state'].values()),'actual complete register bounds')
            if row['controlled_context'] in {'F','R','U','A'}:assert_true(t['event_budget']==48,'full context budget')
            return True
        check('actual_all_context_cohort_bounds',bounds,sid)
        check('typed_metadata_coordinates',lambda:type(row['source_family_index']) is int and type(row['source_family_key']) is str and row['controlled_context'] in controls.CONTEXTS and row['renderer'] in {'forward','reverse'},sid)
        key=(row['controlled_context'],row['renderer']);check('unique_family_coordinates',lambda:key not in families[row['semantic_family_id']],sid);families[row['semantic_family_id']][key]=row
        check('difficulty_strict_range',lambda:type(row['difficulty']) is int and type(row['structural_difficulty']) is int and 2<=row['difficulty']<=4 and row['difficulty']==row['structural_difficulty'],sid)
        check('difficulty_explanation_present',lambda:type(row['source_provenance'].get('curriculum_difficulty_explanation')) is str and bool(row['source_provenance']['curriculum_difficulty_explanation'].strip()),sid)
        check('target_format_structured',lambda:row['target_format']=='structured',sid)
        check('source_origin_disclosure',lambda:row['source_provenance'].get('origin')=='original_synthetic' and row['source_provenance'].get('common_model_prior_context') is True and row['source_provenance'].get('sealed_evaluation_used') is False,sid)
        check('skill_descriptors_typed',lambda:type(row['skill_tags']) is list and all(type(t) is str for t in row['skill_tags']),sid)
    parent_map={p['semantic_parent_id']:p for p in parents};check('unique_actual_parents',lambda:len(parent_map)==108)
    for row in rows:
        def parentcheck():
            p=parent_map[row['semantic_parent_id']]
            assert_true(all(frame.typed_equal(p[k],row[k]) for k in ['semantic_family_id','semantic_task','source_family_index','source_family_key','controlled_context','split','generator_version']),'actual parent lineage/task binding')
            assert_true(p['status']=='PENDING','parent status');return True
        check('semantic_parent_binding',parentcheck,row['sample_id'])
    source_bytes={}
    for path,h in manifest['source_bindings'].items():
        p=safe_file(path);b=p.read_bytes();assert_true(hashlib.sha256(b).hexdigest()==h,'opaque/public source binding '+path);source_bytes[path]=b
    check('manifest_public_header',lambda:controls.manifest_header(manifest,source_bytes,config['candidate_sha256'],'option-resumption-pilot-v1'))
    entries=manifest['control_pairs'];check('300_named_entries',lambda:len(entries)==300);keys=[];nonmember=0;claim_evidence=[]
    for row in rows:
        sid=row['sample_id'];check('nine_owner_claims',lambda:controls.owner_claims(row),sid)
        for claim in row['family_control_claims']:
            key=controls.claim_key(claim);keys.append(key);nonmember+=sid not in claim['pair_sample_ids']
            def resolve():
                assert_true(safe_file(claim['evidence_manifest'])==ROOT/config['manifest_path'],'actual manifest reference')
                return controls.resolve_claim(row,claim,entries,members,config['candidate_sha256'])
            e=check('actual_owner_lookup:'+key[1],resolve,sid)
            claim_evidence.append({'owner_sample_id':sid,'owner_record_hash':row['record_hash'],'lookup_key':[key[0],key[1],list(key[2])],'resolved':e is not None,'nonmember_owner':sid not in claim['pair_sample_ids']})
    check('1944_owner_claims',lambda:len(keys)==1944);check('1344_nonmember_owner_claims',lambda:nonmember==1344)
    named_keys=[]
    for e in entries:
        name=controls.identifier(e);pair=e['pair_sample_ids'];named_keys.append((e['control_id'],name,tuple(pair)))
        check('entry_pair_types:'+e['control_id']+':'+name,lambda:type(pair) is list and len(pair)==2 and all(type(v) is str for v in pair) and pair[0]!=pair[1])
    check('unique_named_lookup_keys',lambda:len(set(named_keys))==300)
    check('all_entries_used_by_actual_claims',lambda:set(named_keys)==set(keys))
    cfg=json.loads((ROOT/'research/curricula/RSM-OPTION-RESUMPTION-CONFIG-20261010.json').read_text());byindex={i:s for s,indices in cfg['source_family_indices_by_stratum'].items() for i in indices}
    structural={};family_evidence=[];witness_evidence=[]
    check('12_actual_families',lambda:len(families)==12)
    for fam,group in families.items():
        complete=set(group)==set(itertools.product(controls.CONTEXTS,{'forward','reverse'}));check('18_family_coordinates:'+fam,lambda:complete)
        if not complete:continue
        frow=group[('F','forward')];index=frow['source_family_index'];expected_split='train' if index%10<=7 else 'dev_challenge';structural[fam]=controls.program_signatures(frow['semantic_task'])
        for row in group.values():
            sid=row['sample_id'];check('same_family_lineage',lambda:row['source_family_key']==frow['source_family_key'] and row['source_family_index']==index and row['split']==expected_split,sid)
            check('source_stratum_assignment',lambda:row['source_provenance'].get('source_stratum')==byindex[index],sid)
            facts=check('actual_optional_witnesses',lambda:witness_facts(row,group,outputs,frame,recursive,controls,owninput),sid)
            witness_evidence.append({'sample_id':sid,'record_hash':row['record_hash'],'facts':facts})
        for style in ('forward','reverse'):
            tasks={c:group[(c,style)]['semantic_task'] for c in controls.CONTEXTS};out={c:outputs[group[(c,style)]['sample_id']] for c in controls.CONTEXTS}
            facts=check('actual_eight_semantic_controls:'+fam+':'+style,lambda:controls.check_controls(tasks,out))
            family_evidence.append({'family':fam,'renderer':style,'actual_relations':facts})
        for c in controls.CONTEXTS:
            a,b=group[(c,'forward')],group[(c,'reverse')];pa=frame.strict_json(a['rendered_input'].rsplit('Task JSON:\n',1)[1]);pb=frame.strict_json(b['rendered_input'].rsplit('Task JSON:\n',1)[1])
            check('actual_renderer_typed_pair',lambda:frame.typed_equal(pa,pb) and frame.typed_equal(pa,a['semantic_task']) and frame.typed_equal(pb,b['semantic_task']),a['sample_id'])
            check('actual_recursive_order_reversal',lambda:json.dumps(controls.reverse_objects(pa),separators=(',',':'))==json.dumps(pb,separators=(',',':')),a['sample_id'])
    legacy_sigs={r['sample_id']:controls.program_signatures(lift_legacy(r['semantic_task'])) for r in legacy};novelty={}
    for name in ('full','coarse_all','coarse_reachable'):
        newset={s[name] for s in structural.values()};oldset={s[name] for s in legacy_sigs.values()};collisions=newset&oldset
        novelty[name]={'new_unique_graphs':len(newset),'legacy_unique_graphs':len(oldset),'legacy_views':len(legacy),'legacy_lineages':len({r['semantic_family_id'] for r in legacy}),
                       'cross_collision_signatures':sorted(collisions),'new_signatures':{f:s[name] for f,s in structural.items()},'legacy_signatures':{i:s[name] for i,s in legacy_sigs.items()}}
        check('12distinct_no_legacy_collision:'+name,lambda:len(newset)==12 and not collisions)
    regression=[]
    def rejection(name,fn):
        try:fn();okay=False;error='unexpected acceptance'
        except Exception as e:okay=True;error=type(e).__name__+': '+str(e)
        regression.append({'check':name,'passed':okay,'actual_result':error})
    owner=rows[0];claim=copy.deepcopy(owner['family_control_claims'][0]);entry=next(e for e in entries if (e['control_id'],controls.identifier(e),tuple(e['pair_sample_ids']))==controls.claim_key(claim))
    for label,mutator in [('reverse_pair',lambda c:c['pair_sample_ids'].reverse()),('bool_index',lambda c:c.update(source_family_index=True)),('empty_control_id',lambda c:c.update(control_id='')),('forbidden_canonical_hashes',lambda c:c.update(pair_record_hashes=['0'*64]*2)),('missing_member',lambda c:c['pair_sample_ids'].__setitem__(0,'own-missing-member')),('wrong_context',lambda c:c.update(controlled_context='X'))]:
        c=copy.deepcopy(claim);mutator(c);rejection(label,lambda:controls.resolve_claim(owner,c,entries,members,config['candidate_sha256']))
    rejection('duplicate_complete_lookup_key',lambda:controls.resolve_claim(owner,claim,entries+[copy.deepcopy(entry)],members,config['candidate_sha256']))
    e2=copy.deepcopy(entries);selected=next(e for e in e2 if e['control_id']==entry['control_id'] and controls.identifier(e)==controls.identifier(entry));selected['candidate_sha256']='0'*64
    rejection('wrong_actual_candidate_SHA',lambda:controls.resolve_claim(owner,claim,e2,members,config['candidate_sha256']))
    e2=copy.deepcopy(entries);selected=next(e for e in e2 if e['control_id']==entry['control_id'] and controls.identifier(e)==controls.identifier(entry));selected['pair_record_hashes'].reverse()
    rejection('reversed_external_hashes',lambda:controls.resolve_claim(owner,claim,e2,members,config['candidate_sha256']))
    allowed_claim=copy.deepcopy(claim);allowed_claim['pair_sample_ids']=['','nonempty'];allowed_claim['control_id']=' '
    regression.append({'check':'empty_but_distinct_IDs_and_literal_whitespace_controlID','passed':controls.claim_key(allowed_claim)==(' ',controls.identifier(claim),('','nonempty'))})
    optional=copy.deepcopy(entries)
    for e in optional:e.pop('pair_record_hashes',None)
    regression.append({'check':'optional_external_hash_absence_valid','passed':controls.resolve_claim(owner,claim,optional,members,config['candidate_sha256']) is not None})
    bool_row=copy.deepcopy(owner);bool_row['difficulty']=True;rejection('canonical_bool_integer_type',lambda:validate_schema(bool_row,schema))
    altered=copy.deepcopy(owner);altered['verified_target']['status']='invalid';altered['record_hash']=record_hash(altered)
    rejection('rehashed_wrong_target_still_fails_first_prediction',lambda:assert_true(frame.typed_equal(altered['verified_target'],first[owner['sample_id']]['expected_output']),'wrong target'))
    checks.extend({'check':'own_regression:'+r['check'],'passed':r['passed'],'factual_evidence':r} for r in regression);failures.extend(r for r in regression if not r['passed'])
    facts=[]
    witnesses={e['sample_id']:e['facts'] for e in witness_evidence}
    for row in rows:
        sid=row['sample_id'];o=outputs[sid]
        facts.append({'sample_id':sid,'record_hash':row['record_hash'],'actual_author_execution':ACTOR,'stage':'CANONICAL_FACTUAL_FIRST',
          'quality_assessment':'UNASSESSED_PENDING_ACTUAL_AGENT_INSPECTION','checks':perrow[sid],
          'target_facts':{'frame_first_match':frame.typed_equal(row['verified_target'],first[sid]['expected_output']),'recursive_first_match':frame.typed_equal(row['verified_target'],second[sid]['expected_output']),
                          'stored_typed_output_sha256':semantic_hash(row['verified_target']),'immutable_first_expected_sha256':semantic_hash(first[sid]['expected_output'])},
          'declared_metadata_for_later_inspection':{'difficulty':row['difficulty'],'structural_difficulty':row['structural_difficulty'],'explanation':row['source_provenance'].get('curriculum_difficulty_explanation'),
              'skill_tags':row['skill_tags'],'source_provenance_assertions':row['source_provenance'],'controlled_context':row['controlled_context'],'renderer':row['renderer']},
          'actual_execution_for_later_difficulty_inspection':{'status':o['status'],'history_events':len(row['semantic_task']['history']),'new_events':len(o['new_events']),'new_effects':o['new_effects'],
              'first_new_event':o['new_events'][0] if o['new_events'] else None,'checkpoint_frames':o['checkpoint']['frames'] if o['checkpoint'] else None},
          'actual_witness_facts':witnesses.get(sid),'frozen_first_predictions_preserved':True})
    after=anchored_closure(ROOT,OUT,args,'RSM_CANONICAL_FACTUAL_COMPARISON')
    factual_first=write('FACTUAL_FIRST.jsonl',facts,True)
    evidence=write('FACTUAL_EVIDENCE.json',{'actor':ACTOR,'quality_assessment':'UNASSESSED_PENDING_ACTUAL_AGENT_INSPECTION','witnesses':witness_evidence,'family_controls':family_evidence,
        'claims':claim_evidence,'novelty':novelty,'regressions':regression,'all_factual_failures':failures,'prior_status_only_negative_evidence':bind(INPUT/'NUMERIC_SHORTCUT_EXECUTION.json'),
        'read_scope':'authorized canonical gold after frozen ownFIRST; private source bindings opaque only; no other qualityvotes'})
    execution=write('COMPARISON_EXECUTION.json',{'actor':ACTOR,'stage':'FACTUAL_COMPARISON_ONLY','quality_assessment':'UNASSESSED_PENDING_ACTUAL_AGENT_INSPECTION',
      'started_at_utc':started,'completed_at_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'elapsed_seconds':time.monotonic()-clock,
      'checks':checks,'failed_checks':failures,'passed':sum(c['passed'] for c in checks),'failed':sum(not c['passed'] for c in checks),
      'closure_before_helpers':before,'closure_after_helpers_before_targets':after_imports,'closure_after_comparison':after,
      'outputs':[factual_first,evidence],'candidate':bind(ROOT/config['candidate_path']),'no_quality_scores_decisions_or_designated_receipts':True})
    freeze=write('FACTUAL_FIRST_FREEZE.json',{'actor':ACTOR,'stage':'FACTUAL_FIRST_FROZEN_QUALITY_UNASSESSED','files':[factual_first,evidence,execution],
      'external_config_sha256':args.expected_config_sha256,'external_source_freeze_sha256':args.expected_source_freeze_sha256,
      'frame_first_binding':bind(INPUT/'frame_predictions.jsonl'),'recursive_first_binding':bind(INPUT/'recursive_predictions.jsonl'),
      'candidate':bind(ROOT/config['candidate_path']),'original_negative_evidence':bind(INPUT/'NUMERIC_SHORTCUT_EXECUTION.json')})
    print(canon({'factual_first':factual_first,'comparison_execution':execution,'factual_first_freeze':freeze,'quality_assessment':'UNASSESSED_PENDING_ACTUAL_AGENT_INSPECTION','data_vote_emitted':False}))

if __name__=='__main__':main()
