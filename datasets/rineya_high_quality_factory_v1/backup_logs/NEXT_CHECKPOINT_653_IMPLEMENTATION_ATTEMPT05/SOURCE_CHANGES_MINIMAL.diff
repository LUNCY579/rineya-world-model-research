+def validate_registry_policy(value):
+    expected={'schema':'next653-exact-current-role-registry-physical-path-policy-v1',
+              'logical_current':{'path':REGISTRY_LOGICAL,'size':19279,'sha256':REGISTRY_CURRENT_SHA},
+              'canonical_current':{'path':REGISTRY_CANONICAL,'size':19279,'sha256':REGISTRY_CURRENT_SHA},
+              'historical_parent653_canonical':{'path':REGISTRY_CANONICAL,'size':13913,'sha256':'ed0b314b07fa4bbaeffde8bc2233f713d139681e213a01e1781d69e9aeefe447'},
+              'historical_core507_logical':{'path':REGISTRY_LOGICAL,'size':16187,'sha256':'400789d3467ce6b33e7e134caa6645666a0bd58f586cbb2b2d8dff0bbce72a4f'},
+              'expected_parent':c.PARENT,'observed_registry_directory_entries':['ROLE_REGISTRY.json'],
+              'identity_rule':'Derive actual device/inode; both lookup spellings must identify the same file when the logical lookup exists. Only the canonical file may physically exist. Canonical-only case-sensitive restoration is allowed for this exact tuple.',
+              'grants_data_approval':False}
+    if not c.typed_equal(value,expected):raise ValueError('Only the exact bound registry logical/current/canonical/historical policy is allowed')
+    prior=c.fixed_json('prior')
+    inherited=[c.projection(r) for r in prior['files'] if r['path']==REGISTRY_CANONICAL]
+    if inherited!=[expected['historical_parent653_canonical']]:raise ValueError('Canonical registry path must equal its exact preserved parent653 tuple')
+    return value
+
+def registry_policy():
+    path=c.HERE/REGISTRY_POLICY_NAME
+    return validate_registry_policy(c.bound_json(c.file_binding(path)))
+
+def validate_registry_observation(row,observation,value):
+    validate_registry_policy(value)
+    if not c.typed_equal(row,value['logical_current']):raise ValueError('No generic case alias; only exact current lower registry tuple may project')
+    keys={'canonical_binding','logical_binding','canonical_identity','logical_identity','logical_lookup_present','observed_registry_directory_entries'}
+    if type(observation) is not dict or set(observation)!=keys:raise ValueError('Closed actual registry physical observation required')
+    if not c.typed_equal(observation['canonical_binding'],value['canonical_current']) or observation['observed_registry_directory_entries']!=value['observed_registry_directory_entries']:
+        raise ValueError('Exact canonical bytes and single physical uppercase registry name required')
+    def identity(v):
+        if type(v) is not dict or set(v)!={'device','inode'} or any(type(v[k]) is not int or v[k]<0 for k in v):raise ValueError('Derived typed file identity required')
+        return v
+    actual=identity(observation['canonical_identity'])
+    if type(observation['logical_lookup_present']) is not bool:raise ValueError('Logical lookup presence must be an actual boolean')
+    if observation['logical_lookup_present']:
+        if not c.typed_equal(observation['logical_binding'],row) or not c.typed_equal(identity(observation['logical_identity']),actual):
+            raise ValueError('Two lookup spellings must rehash exact same bytes and identify one actual file')
+    elif observation['logical_binding'] is not None or observation['logical_identity'] is not None:
+        raise ValueError('Canonical-only restoration cannot invent a lower physical file')
+    return observation
+
+def exact_registry_alias(row):
+    value=registry_policy()
+    if not c.typed_equal(row,value['logical_current']):raise ValueError('Wrong registry logical path/size/hash is not an admitted alias')
+    canonical=c.safe(c.FACTORY,REGISTRY_CANONICAL)
+    before=c.stat_key(canonical)
+    observed=sorted(p.name for p in canonical.parent.iterdir() if p.name in ('ROLE_REGISTRY.json','role_registry.json'))
+    c.validate_binding(value['canonical_current'])
