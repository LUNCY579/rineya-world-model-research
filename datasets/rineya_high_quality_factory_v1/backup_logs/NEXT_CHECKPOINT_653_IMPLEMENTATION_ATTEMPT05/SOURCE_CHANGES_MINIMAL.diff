+        if logical_before!=c.stat_key(logical):raise ValueError('Logical registry identity evolved during verification')
+    observation={'canonical_binding':value['canonical_current'],'logical_binding':logical_binding,
+                 'canonical_identity':{'device':current.st_dev,'inode':current.st_ino},'logical_identity':logical_identity,
+                 'logical_lookup_present':present,'observed_registry_directory_entries':observed}
+    validate_registry_observation(row,observation,value)
+    if before!=c.stat_key(canonical):raise ValueError('Canonical registry bytes/identity evolved during exact alias verification')
+    if observed!=sorted(p.name for p in canonical.parent.iterdir() if p.name in ('ROLE_REGISTRY.json','role_registry.json')):
+        raise ValueError('Physical registry directory spelling evolved during verification')
+    return {'schema':'next653-exact-registry-logical-physical-alias-witness-v1','policy':c.file_binding(c.HERE/REGISTRY_POLICY_NAME),
+            'logical_reference':row,'canonical_physical_binding':value['canonical_current'],
+            'historical_parent653_canonical':value['historical_parent653_canonical'],
+            'historical_core507_logical':value['historical_core507_logical'],'actual_physical_observation':observation,
+            'generic_case_normalization':False,'historical_logical_references_rewritten':False}
+
