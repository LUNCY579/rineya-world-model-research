  "actual_prompt_contract_leads": {
    "blocks": [
      {
        "characters": 1610,
        "sha256": "93e689c2bd2d87c8bb47948ac2f17bc4da2e00de3fe4158336ad643b311992d1",
        "text": "Executable task contract:\nBlocks contract: kind=blocks. on maps each distinct block name to a support block or TABLE. TABLE is reserved, supports must exist, and self-support, cycles, or more than one block directly on a block are malformed. TABLE may support several blocks. goal_on is a partial map using existing blocks or TABLE; self-support, cycles, and multiple blocks directly assigned to one block are contradictory and malformed. The initial state and goals here are well-formed. A block is clear when no block is directly on it. plan is an ordered list of {block,to} actions. A move is legal exactly when block exists and is clear, to is TABLE or an existing clear block distinct from block, and to differs from block's current support. A legal move changes only that block's support. At the first illegal move, include its {legal:false,after:unchanged_on_map} step, stop immediately, and ignore subsequent moves. An empty plan is valid. valid means every proposed move was legal. reaches_goal means the entire plan is valid and every goal_on entry equals the final on-map entry; unspecified supports need not change. shortest_plan is a fresh plan from the INITIAL on-map that satisfies every goal_on entry, minimizes the number of moves, and breaks ties by the lexicographic order of the complete sequence of (block,to) string pairs. It is [] when the initial state already satisfies the goal and null if unreachable. Return exactly a JSON object with steps:[{legal:boolean,after:on_map}], after:on_map, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\n"
      }
    ],
    "graph": [
      {
        "characters": 1512,
        "sha256": "59823e85add5423b4a959483d3f06fdfa4ccfa4b04b181bf0a817fa08c2243c2",
        "text": "Executable task contract:\nGraph contract: kind=graph. nodes contains distinct strings. edges contains [from,to,cost] triples with positive integer fuel costs and at most one edge per ordered pair. start and goal are nodes; fuel is a nonnegative integer. plan is an ordered list of destination node names. Every edge is directed. Start at {node:start,fuel:fuel}. An action is legal exactly when an edge from the current node to its destination exists and its cost is at most the remaining fuel. A legal move changes node to its destination and subtracts the edge cost. At the first illegal action, include that action's {legal:false,after:unchanged_state} step, stop immediately, and do not evaluate subsequent actions. An empty plan is valid. valid means every proposed action was legal. reaches_goal is true exactly when the whole plan is valid and its terminal node is goal, including an initially satisfied goal with an empty plan. shortest_plan is a fresh plan from the INITIAL state that reaches goal within initial fuel, minimizes the number of moves, and breaks ties by the lexicographic order of the entire destination-name sequence. It is [] for an initially satisfied goal and null if no feasible plan exists. Fuel cost is a feasibility constraint, not the optimization objective. Return exactly a JSON object with steps:[{legal:boolean,after:{node:string,fuel:integer}}], after:{node:string,fuel:integer}, valid:boolean, reaches_goal:boolean, shortest_plan:list_or_null. Include only evaluated steps.\n"
      }
    ]
  },
