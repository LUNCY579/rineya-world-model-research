"""Independent public REM witnesses, crossing checks, and instantiated probes.

Stored targets, producer/reference implementations, and verdicts are not inputs.
The unchanged semantic oracle validates and executes newly supplied task inputs.
"""

from collections import Counter, defaultdict
from copy import deepcopy
import json

from .extended_independent import solve
from .independent import OracleError


PER_RECORD = frozenset({"decisive_delayed_boundary", "version_over_recency", "equal_version_time_conflict",
    "equal_version_time_input_conflict", "authoritative_tombstone", "present_null_distinction",
    "future_event_filter_control", "cross_key_filter_control", "absence_control", "temporary_delayed_winner"})
FAMILY_CONTROLS = frozenset({"query_role_id_position_crossing", "key_role_crossing", "field_order_invariance",
    "lower_version_append_invariance", "other_key_edit_invariance", "future_event_edit_invariance",
    "version_priority_counterfactual", "active_input_tie_swap_counterfactual",
    "null_lifecycle_counterfactual", "query_key_counterfactual"})
UNRESOLVED_ALIASES = frozenset({"delayed_dependency", "decisive_asof_boundary", "version_first",
    "tombstone_vs_put_null", "same_time_index_tie", "wrong_key_suppression", "absent_key_control",
    "exact_query_role_crossing"})
KEY_GROUPS = ("delayed", "lifecycle", "index_tie", "absent")
ROLES = ("delayed_before", "delayed_at", "delayed_later", "lifecycle_before", "lifecycle_at",
         "put_null_at", "index_tie_at", "absent_key")
ROLE_ALIASES = {"tombstone_at": "lifecycle_at", "delayed_older_later": "delayed_later"}


def _json(value):
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def _typed(value):
    return "null" if value is None else {bool: "boolean", int: "integer", str: "string"}[type(value)]


def _answer(result):
    return {"status": result["status"], "value_type": _typed(result["value"]), "value": result["value"]}


def _event_answer(event):
    return {"status": "deleted" if event["op"] == "delete" else "present",
            "value_type": _typed(event["value"]), "value": event["value"]}


def _rank(event, index):
    return [event["version"], event["at"], index]


def analyze(task):
    """Derive every public per-record witness from one visible episodic task."""
    if type(task) is not dict or task.get("kind") != "episodic":
        raise OracleError("memory controls require kind=episodic")
    results = solve(task)["results"]
    events, queries = task["events"], task["queries"]
    properties = {name: [] for name in sorted(PER_RECORD)}
    signatures = defaultdict(list)
    for position, query in enumerate(queries):
        signatures[(query["key"], query["as_of"])].append(position)

    def qw(position):
        query, result = queries[position], results[position]
        witness = {"query_position": position, "query_id": query["query_id"],
                   "signature": {"key": query["key"], "as_of": query["as_of"]},
                   "answer": _answer(result), "chosen_event": result["chosen_event"],
                   "chosen_version": result["chosen_version"]}
        if result["chosen_event"] is not None:
            witness["winning_tuple"] = _rank(events[result["chosen_event"]], result["chosen_event"])
        return witness

    for position, (query, result) in enumerate(zip(queries, results)):
        same_key = [(index, item) for index, item in enumerate(events) if item["key"] == query["key"]]
        eligible = [(index, item) for index, item in same_key if item["at"] <= query["as_of"]]
        wi = result["chosen_event"]
        actual = _answer(result)
        if wi is None:
            properties["absence_control"].append({**qw(position),
                "absence_class": "future_only" if same_key else "missing_key",
                "same_key_event_indices": [index for index, _ in same_key]})
        else:
            winner = events[wi]
            ri, recent = max(eligible, key=lambda pair: (pair[1]["at"], pair[0]))
            if winner["version"] > recent["version"] and winner["at"] < recent["at"] and _json(actual) != _json(_event_answer(recent)):
                properties["version_over_recency"].append({**qw(position), "recency_event": ri,
                    "recency_tuple": _rank(recent, ri), "recency_answer": _event_answer(recent)})
            for index, other in eligible:
                if other["version"] == winner["version"] and other["at"] < winner["at"] and _json(_event_answer(other)) != _json(actual):
                    properties["equal_version_time_conflict"].append({**qw(position), "older_top_version_event": index,
                        "competitor_tuple": _rank(other, index), "competitor_answer": _event_answer(other)})
                if other["version"] == winner["version"] and other["at"] == winner["at"] and index < wi and _json(_event_answer(other)) != _json(actual):
                    properties["equal_version_time_input_conflict"].append({**qw(position), "conflicting_top_tuple_event": index,
                        "competitor_tuple": _rank(other, index), "competitor_answer": _event_answer(other)})
                if winner["op"] == "delete" and other["op"] == "put" and other["version"] < winner["version"]:
                    properties["authoritative_tombstone"].append({**qw(position), "lower_version_put": index,
                        "competitor_tuple": _rank(other, index), "competitor_answer": _event_answer(other)})
            boundary = winner["at"]
            if boundary >= 1 and query["as_of"] == boundary:
                for before in signatures.get((query["key"], boundary - 1), []):
                    if _json(_answer(results[before])) != _json(actual):
                        properties["decisive_delayed_boundary"].append({"T": boundary, "before": qw(before), "at": qw(position)})
            if winner["op"] == "put" and winner["value"] is None:
                for other_position, other_result in enumerate(results):
                    if other_result["status"] in ("absent", "deleted") and other_result["value"] is None:
                        properties["present_null_distinction"].append({"put_null": qw(position), "other_null": qw(other_position)})
        if same_key:
            fi, future = max(same_key, key=lambda pair: tuple(_rank(pair[1], pair[0])))
            if future["at"] > query["as_of"] and _json(_event_answer(future)) != _json(actual):
                properties["future_event_filter_control"].append({**qw(position), "uncut_winner": fi,
                    "uncut_tuple": _rank(future, fi), "uncut_answer": _event_answer(future)})
        all_eligible = [(index, item) for index, item in enumerate(events) if item["at"] <= query["as_of"]]
        if all_eligible:
            oi, other = max(all_eligible, key=lambda pair: tuple(_rank(pair[1], pair[0])))
            if other["key"] != query["key"] and _json(_event_answer(other)) != _json(actual):
                properties["cross_key_filter_control"].append({**qw(position), "all_keys_winner": oi,
                    "other_key": other["key"], "other_tuple": _rank(other, oi), "other_answer": _event_answer(other)})
    for first in properties["decisive_delayed_boundary"]:
        for second in properties["decisive_delayed_boundary"]:
            if second["T"] >= first["T"] + 2 and first["at"]["signature"]["key"] == second["at"]["signature"]["key"] and second["before"]["chosen_event"] == first["at"]["chosen_event"]:
                properties["temporary_delayed_winner"].append({"T": first["T"], "U": second["T"],
                    "before_T": first["before"], "at_T": first["at"], "before_U": second["before"], "at_U": second["at"]})
    return {"properties": properties, "derived_results": results,
            "absence_classes": dict(Counter(item["absence_class"] for item in properties["absence_control"]))}


def _metadata(row, name):
    provenance = row.get("source_provenance", {})
    direct = row.get(name)
    nested = provenance.get(name) if type(provenance) is dict else None
    if direct is not None and nested is not None and _json(direct) != _json(nested):
        raise OracleError("conflicting metadata field " + name)
    return direct if direct is not None else nested


def _tags(row):
    tags = row.get("skill_tags")
    if type(tags) is not list or not all(type(tag) is str for tag in tags):
        raise OracleError("skill_tags must be a list of strings")
    return {component for tag in tags for component in tag.split(":")}


def _claims(row):
    claims = _metadata(row, "family_control_claims")
    if claims is None:
        return []
    if type(claims) is not list:
        raise OracleError("family_control_claims must be a list")
    for claim in claims:
        if type(claim) is not dict or set(claim) != {"property", "scope"}:
            raise OracleError("family control claim must have exactly property and scope")
        if type(claim["property"]) is not str or claim["property"] not in FAMILY_CONTROLS:
            raise OracleError("undefined family control property")
        if type(claim["scope"]) is not str or claim["scope"] not in ("corpus_variant", "audit_probe"):
            raise OracleError("undefined family control scope")
    return claims


def _visible(row):
    prompt = row.get("rendered_input")
    if prompt is None:
        return None
    if type(prompt) is not str or "Task JSON:\n" not in prompt:
        raise OracleError("rendered_input lacks public Task JSON delimiter")
    prefix, raw = prompt.rsplit("Task JSON:\n", 1)
    try:
        parsed = json.loads(raw)
    except (json.JSONDecodeError, ValueError) as error:
        raise OracleError("rendered task JSON is malformed: " + str(error)) from error
    if _json(parsed) != _json(row.get("semantic_task")):
        raise OracleError("rendered task differs from semantic_task under typed JSON equality")
    return prefix, raw, parsed


def check(row):
    """Per-row property errors. Unknown legacy aliases block NEW control records."""
    if type(row) is not dict:
        return ["memory_control_row: expected an object"]
    try:
        tags = _tags(row)
        claims = _claims(row)
        analysis = analyze(row.get("semantic_task"))
        _visible(row)
        controlled = _metadata(row, "controlled_variant") is not None or _metadata(row, "query_role_assignments") is not None
    except (OracleError, TypeError, KeyError) as error:
        return ["memory_control_row: " + str(error)]
    errors = ["unresolved factual tag definition: " + tag for tag in sorted(tags & UNRESOLVED_ALIASES)] if controlled else []
    errors.extend("unwitnessed per-record property: " + name for name in sorted(tags & PER_RECORD)
                  if not analysis["properties"][name])
    errors.extend("family relationship tag requires an explicit scoped claim: " + name
                  for name in sorted(tags & FAMILY_CONTROLS) if not any(claim["property"] == name for claim in claims))
    return errors


def _identity(result, task):
    index = result["chosen_event"]
    return None if index is None else _json(task["events"][index])


def audit_probes(task):
    """Instantiate actual independent probes; add zero source families/records."""
    original = analyze(task)["derived_results"]
    probes = []

    def record(name, position, changed, fields, invariant, old_event=None, new_event=None):
        before, after = original[position], solve(changed)["results"][position]
        semantic_same = _json(_answer(before)) == _json(_answer(after))
        identity_same = _identity(before, task) == _identity(after, changed)
        probes.append({"property": name, "scope": "audit_probe", "query_position": position,
            "query_signature": {"key": task["queries"][position]["key"], "as_of": task["queries"][position]["as_of"]},
            "changed_fields": fields, "before": before, "after": after,
            "before_event": old_event, "after_event": new_event,
            "semantic_answer_same": semantic_same, "selected_event_identity_same": identity_same,
            "satisfied": semantic_same and identity_same if invariant else not semantic_same,
            "added_source_families": 0, "added_training_records": 0})

    for position, (query, result) in enumerate(zip(task["queries"], original)):
        wi = result["chosen_event"]
        eligible = [(index, item) for index, item in enumerate(task["events"])
                    if item["key"] == query["key"] and item["at"] <= query["as_of"]]
        if wi is not None:
            winner = task["events"][wi]
            if winner["version"] > 0:
                changed = deepcopy(task)
                added = {"key": query["key"], "version": winner["version"] - 1, "at": query["as_of"],
                         "op": "put", "value": "independent_lower_version_probe"}
                changed["events"].append(added)
                record("lower_version_append_invariance", position, changed, ["events.append"], True, winner, added)
            for index, other in eligible:
                if _json(_event_answer(other)) != _json(_answer(result)):
                    changed = deepcopy(task)
                    changed["events"][index]["version"] = max(item["version"] for _, item in eligible) + 1
                    record("version_priority_counterfactual", position, changed, ["events[" + str(index) + "].version"],
                           False, other, changed["events"][index])
                    break
            for index, other in eligible:
                if index != wi and other["version"] == winner["version"] and other["at"] == winner["at"] and _json(_event_answer(other)) != _json(_answer(result)):
                    changed = deepcopy(task)
                    changed["events"][index], changed["events"][wi] = changed["events"][wi], changed["events"][index]
                    record("active_input_tie_swap_counterfactual", position, changed, ["swap events " + str(index) + "," + str(wi)],
                           False, winner, changed["events"][wi])
                    break
            if winner["value"] is None:
                changed = deepcopy(task)
                changed["events"][wi]["op"] = "put" if winner["op"] == "delete" else "delete"
                record("null_lifecycle_counterfactual", position, changed, ["events[" + str(wi) + "].op"],
                       False, winner, changed["events"][wi])
        for index, item in enumerate(task["events"]):
            if item["key"] != query["key"]:
                changed = deepcopy(task)
                changed["events"][index].update(op="put", value="independent_other_key_probe")
                record("other_key_edit_invariance", position, changed, ["events[" + str(index) + "].op,value"],
                       True, item, changed["events"][index])
                break
        for index, item in enumerate(task["events"]):
            if item["at"] > query["as_of"]:
                changed = deepcopy(task)
                changed["events"][index].update(op="put", value="independent_future_event_probe")
                record("future_event_edit_invariance", position, changed, ["events[" + str(index) + "].op,value"],
                       True, item, changed["events"][index])
                break
        keys = sorted({item["key"] for item in task["events"]})
        missing = "independent_missing_key_probe"
        while missing in keys:
            missing += "_"
        for key in keys + [missing]:
            if key != query["key"]:
                changed = deepcopy(task)
                changed["queries"][position]["key"] = key
                if _json(_answer(solve(changed)["results"][position])) != _json(_answer(result)):
                    record("query_key_counterfactual", position, changed, ["queries[" + str(position) + "].key"], False)
                    break
    return probes


def _histogram(results):
    return {"status": dict(sorted(Counter(item["status"] for item in results).items())),
            "type": dict(sorted(Counter(_typed(item["value"]) for item in results).items())),
            "status_type": dict(sorted(Counter(item["status"] + "/" + _typed(item["value"]) for item in results).items())),
            "present_null": sum(item["status"] == "present" and item["value"] is None for item in results)}


def _order(value):
    if type(value) is dict:
        return [(key, _order(child)) for key, child in value.items()]
    if type(value) is list:
        return [_order(child) for child in value]
    return None


def _schedule(row, analysis):
    task = row["semantic_task"]
    assignments, keys = _metadata(row, "query_role_assignments"), _metadata(row, "key_role_assignments")
    if type(keys) is not dict or set(keys) != set(KEY_GROUPS) or not all(type(value) is str for value in keys.values()) or len(set(keys.values())) != 4:
        raise OracleError("key_role_assignments must biject four groups to four distinct strings")
    if type(assignments) is not list or len(assignments) != 8 or len(task["queries"]) != 8:
        raise OracleError("query_role_assignments and queries must each have eight entries")
    decoded, positions, roles = [], set(), set()
    inverse = {key: group for group, key in keys.items()}
    for item in assignments:
        if type(item) is not dict or set(item) != {"position", "query_id", "role"}:
            raise OracleError("query role assignment shape is malformed")
        position, declared_role = item["position"], item["role"]
        if type(declared_role) is not str:
            raise OracleError("declared query role must be a string")
        role = ROLE_ALIASES.get(declared_role, declared_role)
        if type(position) is not int or not 0 <= position < 8 or position in positions:
            raise OracleError("query positions must cover 0..7 exactly")
        if role in roles:
            raise OracleError("query roles must have eight distinct declared slot identities")
        positions.add(position); roles.add(role)
        query = task["queries"][position]
        if type(item["query_id"]) is not str or item["query_id"] != query["query_id"]:
            raise OracleError("declared query ID differs from visible query ID")
        if query["key"] not in inverse:
            raise OracleError("visible query key is absent from declared assignments")
        decoded.append({"position": position, "query_id": query["query_id"], "role": role, "declared_role": declared_role,
            "signature": [inverse[query["key"]], query["as_of"]], "actual_key": query["key"],
            "derived_result": analysis["derived_results"][position]})
    if len({_json(item["signature"]) for item in decoded}) != 8:
        raise OracleError("eight roles require eight distinct decoded signatures")
    rotation, key_rotation, renderer = (_metadata(row, name) for name in ("query_rotation", "key_rotation", "renderer"))
    if type(rotation) is not int or not 0 <= rotation < 8 or type(key_rotation) is not int or not 0 <= key_rotation < 4:
        raise OracleError("rotation indices must be integers in 0..7 and 0..3")
    if renderer not in ("forward", "reverse"):
        raise OracleError("renderer must be forward or reverse")
    family, history = _metadata(row, "source_family_key"), _metadata(row, "controlled_variant")
    if type(family) is not str or type(history) is not str:
        raise OracleError("source_family_key and controlled_variant must be strings")
    baseline = _metadata(row, "counterfactual_baseline")
    if baseline not in (None, "baseline"):
        raise OracleError("counterfactual_baseline must name the supplied baseline")
    return {"family": family, "history": history, "rotation": rotation, "key_rotation": key_rotation,
            "renderer": renderer, "keys": keys, "queries": sorted(decoded, key=lambda item: item["position"])}


def _decoded_events(task, keys):
    inverse = {key: group for group, key in keys.items()}
    return [{**event, "key": inverse.get(event["key"], "undeclared:" + event["key"])} for event in task["events"]]


def _variant_relations(bt, vt, baseline, variant):
    """Recognize actual matched input edits, including index-shifting invariants."""
    be, ve = _decoded_events(bt, baseline["keys"]), _decoded_events(vt, variant["keys"])
    bi, vi = ({key: group for group, key in member["keys"].items()} for member in (baseline, variant))
    bqueries = [{**query, "key": bi.get(query["key"], "undeclared:" + query["key"])} for query in bt["queries"]]
    vqueries = [{**query, "key": vi.get(query["key"], "undeclared:" + query["key"])} for query in vt["queries"]]
    bq = {item["role"]: item for item in baseline["queries"]}
    variant_positions = {item["position"]: item for item in variant["queries"]}
    vq = {role: variant_positions[item["position"]] for role, item in bq.items()}
    fixed_queries = _json(bqueries) == _json(vqueries)
    changed = [index for index, (old, new) in enumerate(zip(be, ve)) if _json(old) != _json(new)]
    relations = []

    def identity(result, events):
        return None if result["chosen_event"] is None else _json(events[result["chosen_event"]])

    def add(name, role, before, after, **evidence):
        same = _json(_answer(before)) == _json(_answer(after))
        identity_same = identity(before, be) == identity(after, ve)
        invariant = name.endswith("invariance")
        relations.append({"property": name, "role": role, "before": before, "after": after,
            "semantic_answer_changed": not same, "selected_event_identity_same": identity_same,
            "satisfied": same and identity_same if invariant else not same, **evidence})

    if fixed_queries:
        for role in bq:
            before, after = bq[role]["derived_result"], vq[role]["derived_result"]
            key, cutoff = bq[role]["signature"]
            semantic_changed = _json(_answer(before)) != _json(_answer(after))
            if len(ve) > len(be) and _json(ve[:len(be)]) == _json(be) and before["chosen_event"] is not None:
                winner = be[before["chosen_event"]]
                appended = ve[len(be):]
                if all(item["key"] == key and item["at"] <= cutoff and item["version"] < winner["version"] for item in appended):
                    add("lower_version_append_invariance", role, before, after, appended_event_indices=list(range(len(be), len(ve))),
                        selected_version_unchanged=before["chosen_version"] == after["chosen_version"],
                        selected_index_unchanged=before["chosen_event"] == after["chosen_event"])
            if _json(be) != _json(ve):
                if _json([item for item in be if item["key"] == key]) == _json([item for item in ve if item["key"] == key]):
                    add("other_key_edit_invariance", role, before, after, protected_key_group=key,
                        recomputed_event_index=after["chosen_event"])
                if _json([item for item in be if item["at"] <= cutoff]) == _json([item for item in ve if item["at"] <= cutoff]):
                    add("future_event_edit_invariance", role, before, after, protected_cutoff=cutoff,
                        recomputed_event_index=after["chosen_event"])
            if not semantic_changed or len(be) != len(ve):
                continue
            if len(changed) == 1:
                index = changed[0]
                old, new = be[index], ve[index]
                fields = sorted(field for field in old if _json(old[field]) != _json(new[field]))
                if fields == ["op"] and old["value"] is None and new["value"] is None and {old["op"], new["op"]} == {"put", "delete"} and before["chosen_event"] == index and after["chosen_event"] == index:
                    add("null_lifecycle_counterfactual", role, before, after, changed_event=index, changed_fields=fields,
                        old_tuple=_rank(old, index), new_tuple=_rank(new, index))
                eligible = [item for item in be if item["key"] == key and item["at"] <= cutoff]
                if fields == ["version"] and old["key"] == key and old["at"] <= cutoff and new["version"] > max((item["version"] for item in eligible), default=-1) and after["chosen_event"] == index and _json(_event_answer(old)) != _json(_answer(before)):
                    add("version_priority_counterfactual", role, before, after, changed_event=index, changed_fields=fields,
                        old_tuple=_rank(old, index), new_tuple=_rank(new, index),
                        prior_max_eligible_version=max(item["version"] for item in eligible))
            elif len(changed) == 2:
                left, right = changed
                if _json(be[left]) == _json(ve[right]) and _json(be[right]) == _json(ve[left]) and be[left]["version"] == be[right]["version"] and be[left]["at"] == be[right]["at"] and before["chosen_event"] in (left, right) and after["chosen_event"] in (left, right):
                    add("active_input_tie_swap_counterfactual", role, before, after, swapped_event_indices=changed,
                        old_top_tuple=_rank(be[before["chosen_event"]], before["chosen_event"]),
                        new_top_tuple=_rank(ve[after["chosen_event"]], after["chosen_event"]))
    elif _json(be) == _json(ve) and len(bqueries) == len(vqueries):
        changed_queries = [index for index, (old, new) in enumerate(zip(bqueries, vqueries)) if _json(old) != _json(new)]
        if len(changed_queries) == 1:
            position = changed_queries[0]
            old, new = bqueries[position], vqueries[position]
            if sorted(field for field in old if _json(old[field]) != _json(new[field])) == ["key"]:
                role = next(item["role"] for item in baseline["queries"] if item["position"] == position)
                before, after = bq[role]["derived_result"], vq[role]["derived_result"]
                if _json(_answer(before)) != _json(_answer(after)):
                    add("query_key_counterfactual", role, before, after, changed_query_position=position,
                        old_key_group=old["key"], new_key_group=new["key"])
    return changed, relations


def check_batch(rows):
    """Auditable top-level errors, input-derived witnesses, crossings and probes."""
    if type(rows) is not list:
        return {"errors": ["rows must be a list"], "rows": [], "properties": {}}
    errors, summaries, schedules, analyses = [], [], [], {}
    groups = defaultdict(list)
    for index, row in enumerate(rows):
        row_errors = check(row)
        identity = row.get("sample_id", "row_" + str(index)) if type(row) is dict else "row_" + str(index)
        errors.extend(str(identity) + ": " + error for error in row_errors)
        try:
            analysis = analyze(row["semantic_task"])
            analyses[index] = analysis
            schedule = _schedule(row, analysis)
            schedule["row_index"] = index
            schedules.append(schedule)
            groups[(schedule["family"], schedule["history"])].append(schedule)
            summaries.append({"sample_id": identity, "row_index": index, "errors": row_errors,
                "witnesses": analysis["properties"], "absence_classes": analysis["absence_classes"],
                "raw_unresolved_aliases": sorted(_tags(row) & UNRESOLVED_ALIASES)})
        except (OracleError, TypeError, KeyError) as error:
            errors.append(str(identity) + ": schedule/input: " + str(error))
    properties = {name: {"scope": "corpus_variant", "witnesses": []} for name in sorted(FAMILY_CONTROLS)}
    group_reports, probe_reports, total_base_queries = [], [], 0
    probe_counts = Counter()
    for (family, history), members in sorted(groups.items()):
        ge = []
        coordinates = [(item["rotation"], item["renderer"]) for item in members]
        expected = {(rotation, style) for rotation in range(8) for style in ("forward", "reverse")}
        if len(coordinates) != 16 or set(coordinates) != expected:
            ge.append("incomplete or duplicate eight-rotation/two-field-order schedule")
        ids = {query["query_id"] for member in members for query in member["queries"]}
        group_roles = sorted({query["role"] for member in members for query in member["queries"]})
        if len(ids) != 8:
            ge.append("exactly eight query IDs must be reused")
        role_signatures, id_results, position_results, key_results = (defaultdict(list) for _ in range(4))
        role_ids, role_positions, key_groups, roles_by_key = Counter(), Counter(), Counter(), Counter()
        decoded_histories, assignment_table = set(), []
        for member in members:
            task = rows[member["row_index"]]["semantic_task"]
            decoded_histories.add(_json(_decoded_events(task, member["keys"])))
            assignment_table.append({"query_rotation": member["rotation"], "key_rotation": member["key_rotation"],
                "field_order": member["renderer"], "key_role_assignments": member["keys"]})
            for group, key in member["keys"].items():
                key_groups[(member["renderer"], group, key)] += 1
            for query in member["queries"]:
                role_signatures[query["role"]].append(_json(query["signature"]))
                role_ids[(member["renderer"], query["role"], query["query_id"])] += 1
                role_positions[(member["renderer"], query["role"], query["position"])] += 1
                id_results[query["query_id"]].append(query["derived_result"])
                position_results[str(query["position"])].append(query["derived_result"])
                key_results[query["actual_key"]].append(query["derived_result"])
                roles_by_key[(member["renderer"], query["role"], query["actual_key"])] += 1
        if any(len(set(values)) != 1 for values in role_signatures.values()) or len(group_roles) != 8:
            ge.append("role claims do not retain one actual decoded query signature")
        if len(decoded_histories) != 1:
            ge.append("events are not consistently renamed history isomorphs")
        if any(role_ids[(style, role, identity)] != 1 for style in ("forward", "reverse") for role in group_roles for identity in ids):
            ge.append("role-by-ID crossing is not exactly once per field-order style")
        if any(role_positions[(style, role, position)] != 1 for style in ("forward", "reverse") for role in group_roles for position in range(8)):
            ge.append("role-by-position crossing is not exactly once per field-order style")
        by_id = {key: _histogram(value) for key, value in sorted(id_results.items())}
        by_position = {key: _histogram(value) for key, value in sorted(position_results.items())}
        by_key = {key: _histogram(value) for key, value in sorted(key_results.items())}
        if len({_json(value) for value in by_id.values()}) != 1 or len({_json(value) for value in by_position.values()}) != 1:
            ge.append("ID or position outcome histograms differ")
        if any(set(value["status"]) != {"present", "deleted", "absent"} for value in by_id.values()):
            ge.append("history lacks present/deleted/absent support in every reused ID")
        keys = {key for member in members for key in member["keys"].values()}
        if len(keys) != 4 or any(key_groups[(style, group, key)] != 2 for style in ("forward", "reverse") for group in KEY_GROUPS for key in keys):
            ge.append("key/group crossing is not exactly twice per history per field-order style")
        if any(roles_by_key[(style, role, key)] != 2 for style in ("forward", "reverse") for role in group_roles for key in keys):
            ge.append("actual role-by-key crossing is not exactly twice per field-order style")
        residual = len({_json(value) for value in by_key.values()}) != 1
        if residual:
            ge.append("measured per-key status/type histograms retain residual differences")
        group_reports.append({"family": family, "history": history,
            "assignment_table": sorted(assignment_table, key=lambda item: (item["query_rotation"], item["field_order"])),
            "role_by_id": [{"field_order": style, "role": role, "query_id": identity, "count": count} for (style, role, identity), count in sorted(role_ids.items())],
            "role_by_position": [{"field_order": style, "role": role, "position": position, "count": count} for (style, role, position), count in sorted(role_positions.items())],
            "key_by_group": [{"field_order": style, "group": group, "key": key, "count": count} for (style, group, key), count in sorted(key_groups.items())],
            "role_by_key": [{"field_order": style, "role": role, "key": key, "count": count} for (style, role, key), count in sorted(roles_by_key.items())],
            "declared_role_names": sorted({query["declared_role"] for member in members for query in member["queries"]}),
            "role_signatures": {role: sorted(set(values)) for role, values in sorted(role_signatures.items())},
            "outcomes_by_id": by_id, "outcomes_by_position": by_position, "outcomes_by_key": by_key,
            "residual_key_histogram_differences": residual, "errors": ge})
        errors.extend(family + "/" + history + ": " + error for error in ge)
        if not any("role" in error or "ID" in error or "position" in error or "schedule" in error or "signature" in error or "isomorph" in error for error in ge):
            properties["query_role_id_position_crossing"]["witnesses"].append({"family": family, "history": history})
        if not any("key" in error or "schedule" in error or "isomorph" in error for error in ge):
            properties["key_role_crossing"]["witnesses"].append({"family": family, "history": history})
        for rotation in range(8):
            pair = [member for member in members if member["rotation"] == rotation]
            if len(pair) != 2 or {member["renderer"] for member in pair} != {"forward", "reverse"}:
                continue
            left, right = pair
            try:
                lv, rv = _visible(rows[left["row_index"]]), _visible(rows[right["row_index"]])
                if lv is None or rv is None:
                    raise OracleError("field-order evidence requires rendered inputs")
                if _json(lv[2]) != _json(rv[2]) or lv[0] != rv[0]:
                    raise OracleError("field-order pair differs in typed task or prompt contract")
                if _order(lv[2]) == _order(rv[2]):
                    raise OracleError("declared field orders have identical actual object orders")
                properties["field_order_invariance"]["witnesses"].append({"family": family, "history": history,
                    "rotation": rotation, "row_indices": [left["row_index"], right["row_index"]],
                    "typed_input_equal": True, "typed_output_equal": _json(analyses[left["row_index"]]["derived_results"]) == _json(analyses[right["row_index"]]["derived_results"]),
                    "actual_object_order_differs": True})
            except (OracleError, TypeError, KeyError) as error:
                errors.append(family + "/" + history + ": " + str(error))
        total_base_queries += len({signature for values in role_signatures.values() for signature in values})
        base = min(members, key=lambda member: (member["rotation"], member["renderer"]))
        probes = audit_probes(rows[base["row_index"]]["semantic_task"])
        probe_reports.append({"family": family, "history": history, "base_row_index": base["row_index"], "probes": probes})
        for probe in probes:
            if probe["satisfied"]:
                probe_counts[probe["property"]] += 1
            else:
                errors.append(family + "/" + history + ": failed independent audit probe " + probe["property"])
    paired_variants = []
    coordinates = defaultdict(dict)
    for member in schedules:
        coordinates[(member["family"], member["rotation"], member["renderer"])][member["history"]] = member
    for coordinate, variants in sorted(coordinates.items()):
        baseline = variants.get("baseline")
        if baseline is None:
            if any(_metadata(rows[member["row_index"]], "counterfactual_baseline") == "baseline" for member in variants.values()):
                errors.append(coordinate[0] + ": declared counterfactual baseline is not supplied at rotation " + str(coordinate[1]) + "/" + coordinate[2])
            continue
        bt = rows[baseline["row_index"]]["semantic_task"]
        for name, variant in sorted(variants.items()):
            if name == "baseline":
                continue
            vt = rows[variant["row_index"]]["semantic_task"]
            changed, relations = _variant_relations(bt, vt, baseline, variant)
            for relation in relations:
                if not relation["satisfied"]:
                    errors.append(coordinate[0] + ": supplied variant relation failed " + relation["property"])
                else:
                    properties[relation["property"]]["witnesses"].append({"family": coordinate[0], "rotation": coordinate[1],
                        "renderer": coordinate[2], "variant": name, **relation})
            paired_variants.append({"family": coordinate[0], "rotation": coordinate[1], "renderer": coordinate[2],
                "variant": name, "baseline_row_index": baseline["row_index"], "variant_row_index": variant["row_index"],
                "actual_changed_event_indices": changed, "relations": relations,
                "recognized_relation_count": len(relations)})
    declarations = defaultdict(list)
    for member in schedules:
        try:
            for claim in _claims(rows[member["row_index"]]):
                declarations[(member["family"], claim["property"], claim["scope"])].append(member["row_index"])
        except OracleError:
            pass  # The exact malformed declaration was already retained in row errors.
    claim_checks = []
    for (family, name, scope), declaring_rows in sorted(declarations.items()):
        if scope == "corpus_variant":
            witnesses = [item for item in properties[name]["witnesses"] if item["family"] == family]
        else:
            witnesses = [{**item, "history": group["history"], "family": family} for group in probe_reports if group["family"] == family
                         for item in group["probes"] if item["property"] == name and item["satisfied"]]
        satisfied = bool(witnesses)
        claim_checks.append({"family": family, "property": name, "scope": scope,
            "declaring_row_indices": sorted(set(declaring_rows)), "matched_witness_count": len(witnesses),
            "satisfied": satisfied, "witnesses": witnesses})
        if not satisfied:
            errors.append(family + ": unwitnessed declared family control " + name + " at scope " + scope)
    family_splits = defaultdict(set)
    source_indices = defaultdict(set)
    family_role_sets = defaultdict(set)
    for member in schedules:
        row = rows[member["row_index"]]
        family_role_sets[member["family"]].add(tuple(sorted(item["role"] for item in member["queries"])))
        if "split" in row:
            family_splits[member["family"]].add(_json(row["split"]))
        source_index = _metadata(row, "source_family_index")
        if source_index is not None:
            if type(source_index) is not int or source_index < 0:
                errors.append(member["family"] + ": source_family_index must be a nonnegative integer")
            else:
                source_indices[source_index].add(member["family"])
    for family, splits in family_splits.items():
        if len(splits) > 1:
            errors.append(family + ": supplied variants cross source-family splits")
    for family, role_sets in family_role_sets.items():
        if len(role_sets) > 1:
            errors.append(family + ": declared eight-role identity sets differ across supplied histories or rotations")
    for index, families in source_indices.items():
        if len(families) > 1:
            errors.append("source_family_index " + str(index) + " is shared by distinct source-family keys")
    return {"errors": errors, "rows": summaries, "properties": properties, "family_crossings": group_reports,
        "family_control_claim_checks": claim_checks,
        "paired_variants": paired_variants, "audit_probes": probe_reports,
        "audit_probe_properties": {name: {"scope": "audit_probe", "witnesses": count, "added_source_families": 0, "added_training_records": 0} for name, count in sorted(probe_counts.items())},
        "counts": {"records": len(rows), "scheduled_records": len(schedules),
            "source_families": len({member["family"] for member in schedules}), "base_controlled_histories": len(groups),
            "base_history_query_observations": total_base_queries,
            "rotation_level_observations": sum(len(member["queries"]) for member in schedules if member["renderer"] == "forward"),
            "rendered_observations": sum(len(member["queries"]) for member in schedules)},
        "family_splits": {family: sorted(values) for family, values in sorted(family_splits.items())},
        "scope_note": "Corpus variants and actually instantiated audit probes are separate. Declared query role names denote family slots, whose actual signatures and answers are published; they do not certify per-row op/status claims. No verdict is issued."}
