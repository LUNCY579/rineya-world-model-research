"""Public RBM controls, independently executed from inputs; no target imports."""
from collections import Counter, defaultdict
from copy import deepcopy
import itertools
import json
import re


class BeliefControlError(ValueError):
    pass


PER_RECORD = frozenset('multiworld_unobserved_invariant conjunction_required_invariant useful_after_conjunctive_evidence multiworld_all_queries_redundant multiworld_entailed_null ambiguous_null_partition cross_fact_inconsistent_conjunction post_empty_absorption nonempty_repeated_observation typed_observation_separator typed_query_partition_separator skewed_possible_value_partition'.split())
FAMILY = frozenset('equal_support_usefulness_counterfactual observation_reorder_final_invariance nonempty_repetition_final_invariance cross_fact_contradiction_counterfactual post_empty_append_absorption typed_equals_counterfactual null_guarantee_contrast query_id_position_fact_crossing field_order_invariance world_order_invariance world_id_rename_equivariance'.split())
SCOPE_TAGS = frozenset(['finite_synthetic_proxy', 'finite_noiseless_filter', 'possible_value_partition'])
PROFILES = {12: 'cyclic_uniform', 13: 'acyclic_branching', 18: 'cyclic_weighted', 19: 'typed_path'}
QUERY_ROLES = ('invariant_query', 'variation_query', 'observed_control')
FACT_ROLES = frozenset(['observation_control', 'observation_auxiliary', 'invariant_query', 'variation_query', 'unoffered_feature'])


def _need(condition, message):
    if not condition:
        raise BeliefControlError(message)


def _json(value):
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(',', ':'))


def _atom(value):
    _need(type(value) in (bool, int, str, type(None)), 'scalar excludes floats and containers')
    return type(value).__name__, value


def _meta(row, name):
    nested = row.get('source_provenance', {})
    values = []
    if name in row:
        values.append(row[name])
    if type(nested) is dict and name in nested:
        values.append(nested[name])
    _need(not values or all(_json(item) == _json(values[0]) for item in values), 'conflicting metadata ' + name)
    return values[0] if values else None


def _controlled(row):
    if type(row) is not dict:
        return False
    tags = row.get('skill_tags', [])
    return any(_meta(row, key) is not None for key in ('controlled_context', 'fact_role_assignments', 'property_witnesses', 'family_control_claims')) or (type(tags) is list and any(type(tag) is str and tag in PER_RECORD for tag in tags))


def derive(task):
    """Typed world-position sets and direct partitions; independent of both solvers."""
    _need(type(task) is dict and set(task) == {'kind', 'worlds', 'observations', 'queries'} and task['kind'] == 'belief', 'expected exact belief task')
    worlds, observations, queries = task['worlds'], task['observations'], task['queries']
    _need(all(type(items) is list for items in (worlds, observations, queries)), 'task lists required')
    ids, keys = [], None
    for world in worlds:
        _need(type(world) is dict and set(world) == {'world_id', 'facts'}, 'malformed world')
        _need(type(world['world_id']) is str and world['world_id'] not in ids, 'distinct string world IDs required')
        _need(type(world['facts']) is dict and all(type(key) is str for key in world['facts']), 'fact map required')
        for value in world['facts'].values():
            _atom(value)
        if keys is None:
            keys = set(world['facts'])
        _need(set(world['facts']) == keys, 'world fact-key sets differ')
        ids.append(world['world_id'])
    keys = keys or set()
    supports = [set(range(len(worlds)))]
    for observation in observations:
        _need(type(observation) is dict and set(observation) == {'fact', 'equals'} and type(observation['fact']) is str and observation['fact'] in keys, 'malformed observation or unknown fact')
        value = _atom(observation['equals'])
        supports.append({index for index in supports[-1] if _atom(worlds[index]['facts'][observation['fact']]) == value})
    query_ids, rows = [], []
    for query in queries:
        _need(type(query) is dict and set(query) == {'query_id', 'fact'} and type(query['query_id']) is str and query['query_id'] not in query_ids and type(query['fact']) is str and query['fact'] in keys, 'malformed query or unknown fact/duplicate ID')
        query_ids.append(query['query_id'])
        rows.append(_partition(task, query, supports[-1]))
    target = {'surviving_worlds': sorted(ids[index] for index in supports[-1]), 'belief_sizes': [len(support) for support in supports[1:]], 'queries': rows}
    return {'target': target, 'supports': supports, 'support_ids': [sorted(ids[index] for index in support) for support in supports]}


def _partition(task, query, support):
    bins = {}
    for index in support:
        value = task['worlds'][index]['facts'][query['fact']]
        key = _atom(value)
        if key not in bins:
            bins[key] = {'value': value, 'count': 0}
        bins[key]['count'] += 1
    counts = sorted(bins.values(), key=lambda item: _json(item['value']))
    entailed = bool(support) and len(counts) == 1
    return {'query_id': query['query_id'], 'counts': counts, 'distinct_values': len(counts), 'entailed': entailed, 'guaranteed': counts[0]['value'] if entailed else None, 'can_reduce_uncertainty': len(counts) > 1}


def _alias(value):
    if type(value) is bool:
        return int(value)
    if type(value) is int and value in (0, 1):
        return bool(value)
    return None


def analyze(task):
    result = derive(task)
    worlds, obs, queries = task['worlds'], task['observations'], task['queries']
    supports, final, m = result['supports'], result['supports'][-1], len(obs)
    properties = {name: [] for name in sorted(PER_RECORD)}
    payloads = {_json(worlds[index]['facts']) for index in final}
    observed = {item['fact'] for item in obs}
    def add(name, qids=(), indices=(), prefixes=(), support=None, **detail):
        support = final if support is None else support
        properties[name].append({'query_ids': list(qids), 'observation_indices': sorted(set(indices)), 'prefix_indices': sorted(set(prefixes)), 'supporting_world_ids': sorted(worlds[index]['world_id'] for index in support), **detail})
    for query, answer in zip(queries, result['target']['queries']):
        qid, fact = query['query_id'], query['fact']
        bins = {_atom(item['value']): item['count'] for item in answer['counts']}
        if len(payloads) >= 2 and fact not in observed and answer['distinct_values'] == 1:
            add('multiworld_unobserved_invariant', [qid], prefixes=[m], partition=answer)
            for left, right in itertools.combinations(range(m), 2):
                if obs[left]['fact'] == obs[right]['fact']:
                    continue
                omitted = []
                for removed in (left, right):
                    altered = deepcopy(task); altered['observations'] = [item for index, item in enumerate(obs) if index != removed]
                    reduced = derive(altered)
                    omitted.append((removed, reduced))
                if all(_partition(task, query, value['supports'][-1])['distinct_values'] >= 2 for _, value in omitted):
                    related = final | set().union(*(value['supports'][-1] for _, value in omitted))
                    add('conjunction_required_invariant', [qid], [left, right], [m], related, omitted=[{'removed_observation': index, 'survivors': value['target']['surviving_worlds'], 'partition': _partition(task, query, value['supports'][-1])} for index, value in omitted], partition=answer)
        if final and answer['distinct_values'] > 1:
            reducing = [index for index in range(m) if 0 < len(supports[index + 1]) < len(supports[index])]
            for left, right in itertools.combinations(reducing, 2):
                if obs[left]['fact'] != obs[right]['fact']:
                    add('useful_after_conjunctive_evidence', [qid], [left, right], [left, left + 1, right, right + 1, m], partition=answer)
        if len(payloads) >= 2 and list(bins) == [('NoneType', None)]:
            add('multiworld_entailed_null', [qid], prefixes=[m], partition=answer)
        if ('NoneType', None) in bins and len(bins) > 1:
            add('ambiguous_null_partition', [qid], prefixes=[m], partition=answer)
        for boolean, integer in ((True, 1), (False, 0)):
            if ('bool', boolean) in bins and ('int', integer) in bins:
                add('typed_query_partition_separator', [qid], prefixes=[m], partition=answer, alias_pair=[boolean, integer])
        if len(bins) > 1 and len(set(bins.values())) > 1:
            add('skewed_possible_value_partition', [qid], prefixes=[m], partition=answer)
    queried = {item['fact'] for item in queries}
    if len(payloads) >= 2 and queries and all(item['distinct_values'] == 1 for item in result['target']['queries']):
        varying = [fact for fact in worlds[0]['facts'] if fact not in queried and len({_atom(worlds[index]['facts'][fact]) for index in final}) > 1]
        if varying:
            add('multiworld_all_queries_redundant', [query['query_id'] for query in queries], prefixes=[m], unqueried_varying_facts=varying)
    whole = supports[0]
    for left, right in itertools.combinations(range(m), 2):
        if obs[left]['fact'] == obs[right]['fact']:
            continue
        lone = [{index for index in whole if _atom(worlds[index]['facts'][obs[position]['fact']]) == _atom(obs[position]['equals'])} for position in (left, right)]
        if all(lone) and not (lone[0] & lone[1]) and not final:
            add('cross_fact_inconsistent_conjunction', indices=[left, right], prefixes=[0, m], support=lone[0] | lone[1], individually_supported_ids=[sorted(worlds[index]['world_id'] for index in subset) for subset in lone])
    empty_prefix = next((index for index, support in enumerate(supports) if not support), None)
    if empty_prefix is not None and empty_prefix < m:
        for later in range(empty_prefix, m):
            lone = {index for index in whole if _atom(worlds[index]['facts'][obs[later]['fact']]) == _atom(obs[later]['equals'])}
            if lone:
                add('post_empty_absorption', [query['query_id'] for query in queries], [later], [0, *range(empty_prefix, m + 1)], lone, first_empty_prefix=empty_prefix)
    for index, observation in enumerate(obs):
        for earlier in range(index):
            if _json(observation) == _json(obs[earlier]) and supports[index] and supports[index + 1] == supports[index]:
                add('nonempty_repeated_observation', indices=[earlier, index], prefixes=[index, index + 1], support=supports[index], unchanged_count=len(supports[index]))
        alias = _alias(observation['equals'])
        if alias is not None:
            exact = {world for world in supports[index] if _atom(worlds[world]['facts'][observation['fact']]) == _atom(observation['equals'])}
            excluded = {world for world in supports[index] if _atom(worlds[world]['facts'][observation['fact']]) == _atom(alias)}
            if exact and excluded and supports[index + 1] == exact:
                add('typed_observation_separator', indices=[index], prefixes=[index, index + 1], support=exact | excluded, alias_pair=[observation['equals'], alias], exact_ids=sorted(worlds[world]['world_id'] for world in exact), excluded_alias_ids=sorted(worlds[world]['world_id'] for world in excluded))
    return {**result, 'properties': properties}


def _claims(row):
    claims = _meta(row, 'family_control_claims')
    _need(type(claims) is list, 'family_control_claims list required')
    output, identifiers = [], {}
    for claim in claims:
        _need(type(claim) is dict, 'claim object required')
        names = set(claim) & {'name', 'property'}
        _need(len(names) == 1 and 'scope' in claim and not (set(claim) - {'name', 'property', 'scope', 'source_family_key', 'evidence_manifest', 'control_id', 'pair_sample_ids', 'probe_id'}), 'claim encoding fields invalid')
        name = claim[next(iter(names))]; scope = claim['scope']
        _need(type(name) is str and name in FAMILY and scope in ('corpus_variant', 'audit_probe'), 'undefined family property or scope')
        if 'source_family_key' in claim:
            _need(claim['source_family_key'] == _meta(row, 'source_family_key') and type(claim['source_family_key']) is str, 'claim source family mismatch')
        for key in ('evidence_manifest', 'control_id', 'probe_id'):
            if key in claim:
                _need(type(claim[key]) is str and bool(claim[key]), 'nonempty descriptive ' + key + ' required')
        if 'evidence_manifest' in claim:
            path = claim['evidence_manifest']
            _need(not path.startswith(('/', '\\')) and not re.match(r'^[A-Za-z]:', path) and '..' not in path.replace('\\', '/').split('/'), 'evidence_manifest must be relative provenance')
        if 'pair_sample_ids' in claim:
            pair = claim['pair_sample_ids']
            _need(scope == 'corpus_variant' and type(pair) is list and len(pair) == 2 and all(type(item) is str for item in pair) and pair[0] != pair[1], 'pair_sample_ids require two distinct corpus IDs')
        if 'probe_id' in claim:
            _need(scope == 'audit_probe', 'probe_id requires audit_probe scope')
        identifier = claim.get('control_id', name)
        _need(identifier not in identifiers or identifiers[identifier] == (name, scope), 'duplicate claim identifier has inconsistent property/scope')
        identifiers[identifier] = name, scope
        output.append({**claim, 'property': name, 'scope': scope})
    return output


def _visible(row):
    prompt = row.get('rendered_input')
    _need(type(prompt) is str and 'Task JSON:\n' in prompt, 'rendered Task JSON required')
    prefix, raw = prompt.rsplit('Task JSON:\n', 1)
    try:
        parsed = json.loads(raw)
    except ValueError as error:
        raise BeliefControlError('malformed rendered JSON') from error
    _need(_json(parsed) == _json(row['semantic_task']), 'typed rendered input mismatch')
    return prefix, raw


def _profile(task, roles):
    weights = Counter()
    vertices = set()
    for world in task['worlds']:
        left = ('left', _atom(world['facts'][roles['observation_control']]))
        right = ('right', _atom(world['facts'][roles['observation_auxiliary']]))
        vertices.update((left, right)); weights[left, right] += 1
    adjacency = {vertex: set() for vertex in vertices}
    for left, right in weights:
        adjacency[left].add(right); adjacency[right].add(left)
    components, seen = 0, set()
    for vertex in vertices:
        if vertex in seen:
            continue
        components += 1; pending = [vertex]
        while pending:
            item = pending.pop()
            if item in seen:
                continue
            seen.add(item); pending.extend(adjacency[item] - seen)
    degrees = sorted(len(neighbors) for neighbors in adjacency.values())
    cyclic = len(weights) > len(vertices) - components
    return {'vertices': len(vertices), 'edges': len(weights), 'components': components, 'cyclic': cyclic, 'degrees': degrees, 'weights': sorted(weights.values()), 'left_blocks': sum(vertex[0] == 'left' for vertex in vertices), 'right_blocks': sum(vertex[0] == 'right' for vertex in vertices)}


def _signature(task, roles):
    # Scalar/name independent, order invariant partition/incidence data. Profile
    # topology/weights independently separate the four required source families.
    columns = {}
    for role, fact in roles.items():
        blocks = defaultdict(set)
        for index, world in enumerate(task['worlds']):
            blocks[_atom(world['facts'][fact])].add(index)
        columns[role] = list(blocks.values())
    intersections = {}
    for left, right in itertools.combinations(sorted(columns), 2):
        intersections[left + '|' + right] = sorted(sorted(len(a & b) for b in columns[right]) for a in columns[left])
    return {'profile_graph': _profile(task, roles), 'partition_block_sizes': {role: sorted(map(len, blocks)) for role, blocks in sorted(columns.items())}, 'partition_intersections': intersections,
        'world_partition_profiles': sorted(sorted(sorted(len(block) for block in columns[role] if index in block) for role in sorted(columns)) for index in range(len(task['worlds'])))}


def _encoding(row, analysis):
    task = row['semantic_task']; context = _meta(row, 'controlled_context')
    _need(context in tuple('ABCDEF'), 'controlled_context must be A-F')
    family, index = _meta(row, 'source_family_key'), _meta(row, 'source_family_index')
    _need(type(family) is str and bool(family) and type(index) is int and index in PROFILES, 'public source-family key/index required')
    _need(_meta(row, 'structural_family_profile') == PROFILES[index], 'structural profile/index mapping mismatch')
    _need(row.get('split') == ('train' if index in (12, 13) else 'dev_challenge'), 'source index/split mapping mismatch')
    for key in ('sample_id', 'semantic_family_id', 'semantic_parent_id'):
        _need(type(row.get(key)) is str and bool(row[key]), 'nonempty lineage field ' + key + ' required')
    shifts = [_meta(row, key) for key in ('id_shift', 'position_shift', 'fact_name_shift')]
    _need(all(type(value) is int and 0 <= value < 3 for value in shifts), 'shifts must be integers 0..2')
    u, v, w = shifts
    _need(type(_meta(row, 'schedule_index')) is int and _meta(row, 'schedule_index') == 9 * u + 3 * v + w, 'schedule_index arithmetic mismatch')
    renderer = _meta(row, 'renderer'); _need(renderer in ('forward', 'reverse'), 'undefined renderer')
    pools = [_meta(row, name) for name in ('query_id_pool', 'queried_fact_name_pool')]
    _need(all(type(pool) is list and len(pool) == 3 and all(type(value) is str for value in pool) and len(set(pool)) == 3 for pool in pools), 'ordered distinct three-name pools required')
    roles = _meta(row, 'fact_role_assignments')
    _need(type(roles) is dict and FACT_ROLES <= set(roles) and all(role in FACT_ROLES or re.fullmatch(r'aux_extra_[0-9]+', role) for role in roles), 'fact role encoding invalid')
    _need(all(type(value) is str for value in roles.values()) and len(set(roles.values())) == len(roles), 'fact-role names must be distinct strings')
    _need(bool(task['worlds']) and set(roles.values()) == set(task['worlds'][0]['facts']), 'fact roles must equal visible key set')
    _need(all(roles[role] not in pools[1] for role in roles if role not in ('invariant_query', 'variation_query', 'observation_control')), 'auxiliary names overlap queried-name pool')
    _need(len({_json(world['facts']) for world in task['worlds']}) == len(task['worlds']), 'duplicate complete fact payloads do not certify distinct worlds')
    assignments = _meta(row, 'query_role_assignments')
    _need(type(assignments) is list and len(assignments) == 3 and len(task['queries']) == 3, 'exactly three query assignments required')
    declared = set()
    for item in assignments:
        _need(type(item) is dict and {'role', 'position', 'query_id'} <= set(item) and not set(item) - {'role', 'position', 'query_id', 'fact'}, 'query assignment fields invalid')
        role = item['role']; _need(role in QUERY_ROLES and role not in declared, 'query roles must occur once')
        declared.add(role); r = QUERY_ROLES.index(role); position = (r + v) % 3
        fact = pools[1][(r + w) % 3]; fact_role = 'observation_control' if role == 'observed_control' else role
        _need(type(item['position']) is int and item['position'] == position and item['query_id'] == pools[0][(r + u) % 3], 'query assignment shift mismatch')
        _need(task['queries'][position] == {'query_id': item['query_id'], 'fact': fact} and roles[fact_role] == fact and item.get('fact', fact) == fact, 'query/fact role names were not consistently reassigned')
    _need(len(task['observations']) == (3 if context in 'DF' else 2), 'context observation count mismatch')
    _need({item['fact'] for item in task['observations'][:2]} == {roles['observation_control'], roles['observation_auxiliary']}, 'context must constrain both declared observation roles')
    graph = _profile(task, roles)
    if index == 12:
        _need(graph['cyclic'] and len(set(graph['weights'])) == 1, 'cyclic_uniform graph witness absent')
    elif index == 13:
        _need(graph['components'] == 1 and not graph['cyclic'] and max(graph['degrees'], default=0) >= 3, 'acyclic_branching graph witness absent')
    elif index == 18:
        _need(graph['cyclic'] and len(set(graph['weights'])) > 1, 'cyclic_weighted graph witness absent')
    else:
        _need(graph['components'] == 1 and not graph['cyclic'] and graph['edges'] > 1 and max(graph['degrees'], default=0) <= 2, 'typed_path graph witness absent')
    _visible(row)
    return {'family': family, 'index': index, 'context': context, 'renderer': renderer, 'schedule': 9 * u + 3 * v + w, 'shifts': shifts, 'pools': pools, 'roles': roles, 'assignments': assignments, 'graph': graph}


def _locator(row, name, actual):
    locator = _meta(row, 'property_witnesses')[name]
    required = {'query_ids', 'observation_indices', 'prefix_indices'}
    _need(type(locator) is dict and required <= set(locator) and not set(locator) - required - {'supporting_world_ids', 'note'}, 'locator fields invalid: ' + name)
    task = row['semantic_task']; m = len(task['observations']); ids = {query['query_id'] for query in task['queries']}
    for key, allowed in [('query_ids', ids), ('observation_indices', set(range(m))), ('prefix_indices', set(range(m + 1)))]:
        values = locator[key]
        _need(type(values) is list and len({_json(value) for value in values}) == len(values), 'distinct locator list required: ' + key)
        _need(all(type(value) is (str if key == 'query_ids' else int) and value in allowed for value in values), 'invalid locator index/ID: ' + key)
    if 'note' in locator:
        _need(type(locator['note']) is str, 'locator note must be descriptive string')
    supported = []
    for proof in actual:
        if all(set(proof[key]) <= set(locator[key]) for key in required):
            if name == 'conjunction_required_invariant' and len(locator['observation_indices']) != 2:
                continue
            supported.append(proof)
    _need(bool(supported), 'locator does not identify required property witness: ' + name)
    if 'supporting_world_ids' in locator:
        supplied = locator['supporting_world_ids']
        _need(type(supplied) is list and all(type(item) is str for item in supplied) and supplied == sorted(set(supplied)), 'supporting_world_ids must be sorted distinct strings')
        _need(any(set(supplied) <= set(proof['supporting_world_ids']) for proof in supported), 'locator supporting worlds do not support the property')


def check(row):
    """Per-row input/metadata errors; legacy rows without control markers retain scope."""
    try:
        _need(type(row) is dict, 'row object required')
        analysis = analyze(row.get('semantic_task'))
        controlled = _controlled(row)
        if not controlled:
            return []
        _encoding(row, analysis)
        tags = row.get('skill_tags')
        _need(type(tags) is list and all(type(tag) is str for tag in tags) and len(set(tags)) == len(tags), 'distinct skill_tags strings required')
        _need(SCOPE_TAGS <= set(tags) and not set(tags) - SCOPE_TAGS - PER_RECORD, 'missing scope tags or undefined per-row tags')
        witnesses = _meta(row, 'property_witnesses')
        _need(type(witnesses) is dict and set(witnesses) == set(tags) & PER_RECORD, 'property_witnesses keys must equal property tags')
        for name in witnesses:
            _need(bool(analysis['properties'][name]), 'unwitnessed property tag: ' + name)
            _locator(row, name, analysis['properties'][name])
        _claims(row)
    except (BeliefControlError, KeyError, TypeError, ValueError) as error:
        return ['belief_control_row: ' + str(error)]
    return []


def _decode(row, encoding):
    mapping = {fact: role for role, fact in encoding['roles'].items()}
    task = row['semantic_task']
    return {'kind': 'belief', 'worlds': [{'world_id': world['world_id'], 'facts': {mapping[fact]: value for fact, value in world['facts'].items()}} for world in task['worlds']], 'observations': [{'fact': mapping[item['fact']], 'equals': item['equals']} for item in task['observations']], 'queries': [{'query_id': role, 'fact': 'observation_control' if role == 'observed_control' else role} for role in QUERY_ROLES]}


def _payloads(target):
    return [{key: value for key, value in item.items() if key != 'query_id'} for item in target['queries']]


def _relations(left, right):
    a, b = derive(left), derive(right); properties = []
    same = _json(left['worlds']) == _json(right['worlds']) and _json(left['queries']) == _json(right['queries'])
    if not same:
        return properties
    ao, bo = left['observations'], right['observations']
    changes = [index for index in range(min(len(ao), len(bo))) if _json(ao[index]) != _json(bo[index])]
    only_equals = len(ao) == len(bo) and len(changes) == 1 and ao[changes[0]]['fact'] == bo[changes[0]]['fact']
    if only_equals:
        index = changes[0]
        if len(a['supports'][-1]) == len(b['supports'][-1]) >= 2 and any(x['can_reduce_uncertainty'] != y['can_reduce_uncertainty'] for x, y in zip(a['target']['queries'], b['target']['queries'])):
            properties.append(('equal_support_usefulness_counterfactual', {'changed_observation': index, 'changed_field': 'equals'}))
        if a['supports'][-1] and analyze(right)['properties']['cross_fact_inconsistent_conjunction']:
            properties.append(('cross_fact_contradiction_counterfactual', {'changed_observation': index, 'changed_field': 'equals'}))
        alias = _alias(ao[index]['equals'])
        if alias is not None and _atom(alias) == _atom(bo[index]['equals']) and a['supports'][index + 1] and b['supports'][index + 1] and a['supports'][index + 1] != b['supports'][index + 1]:
            properties.append(('typed_equals_counterfactual', {'changed_observation': index, 'old_equals': ao[index]['equals'], 'new_equals': bo[index]['equals']}))
    if sorted(map(_json, ao)) == sorted(map(_json, bo)) and _json(ao) != _json(bo) and _json(a['target']['queries']) == _json(b['target']['queries']) and a['target']['surviving_worlds'] == b['target']['surviving_worlds'] and a['target']['belief_sizes'] != b['target']['belief_sizes']:
        properties.append(('observation_reorder_final_invariance', {}))
    if len(bo) == len(ao) + 1 and _json(bo[:-1]) == _json(ao):
        if a['supports'][-1] and any(_json(bo[-1]) == _json(item) for item in ao) and _json(a['target']['queries']) == _json(b['target']['queries']) and a['target']['surviving_worlds'] == b['target']['surviving_worlds']:
            properties.append(('nonempty_repetition_final_invariance', {}))
        individually = any(_atom(world['facts'][bo[-1]['fact']]) == _atom(bo[-1]['equals']) for world in left['worlds'])
        if not a['supports'][-1] and individually and not b['supports'][-1] and b['target']['belief_sizes'][-1] == 0:
            properties.append(('post_empty_append_absorption', {}))
    return [(name, {**detail, 'left': a['target'], 'right': b['target'], 'left_prefix_supports': a['support_ids'], 'right_prefix_supports': b['support_ids']}) for name, detail in properties]


def _probes(family, bases):
    output = []
    def add(name, identifier, tasks, detail):
        output.append({'family': family, 'property': name, 'scope': 'audit_probe', 'probe_id': identifier, 'tasks': tasks, **detail, 'added_corpus_records': 0, 'added_source_families': 0})
    for context, task in sorted(bases.items()):
        original = derive(task)
        permuted = deepcopy(task); permuted['worlds'].reverse(); altered = derive(permuted)
        _need(_json(original['target']) == _json(altered['target']), 'executed world-order probe failed')
        add('world_order_invariance', family + ':' + context + ':world_order', [task, permuted], {'targets': [original['target'], altered['target']], 'satisfied': True})
        renamed = deepcopy(task); mapping = {world['world_id']: 'renamed-' + str(len(task['worlds']) - index) for index, world in enumerate(task['worlds'])}
        for world in renamed['worlds']: world['world_id'] = mapping[world['world_id']]
        rt = derive(renamed)['target']; expected = {**original['target'], 'surviving_worlds': sorted(mapping[name] for name in original['target']['surviving_worlds'])}
        _need(_json(rt) == _json(expected), 'executed world-ID probe failed')
        add('world_id_rename_equivariance', family + ':' + context + ':world_id', [task, renamed], {'mapping': mapping, 'targets': [original['target'], rt], 'satisfied': True})
    if not bases:
        return output
    source = next(iter(bases.values()))
    for fact in sorted(source['worlds'][0]['facts']):
        atoms = {_atom(world['facts'][fact]) for world in source['worlds']}
        for boolean, integer in ((True, 1), (False, 0)):
            if ('bool', boolean) not in atoms or ('int', integer) not in atoms:
                continue
            pair = []
            for value in (boolean, integer):
                task = deepcopy(source); task['observations'] = [{'fact': fact, 'equals': value}]; pair.append(task)
            relation = [detail for name, detail in _relations(*pair) if name == 'typed_equals_counterfactual']
            _need(bool(relation), 'executed typed-equals probe failed')
            add('typed_equals_counterfactual', family + ':typed:' + fact + ':' + str(integer), pair, {'satisfied': True, 'relation': relation[0]})
        null_worlds = [world for world in source['worlds'] if world['facts'][fact] is None]
        if len(null_worlds) >= 2 and len(atoms) >= 2:
            cases = []
            absent = '__missing_probe__'
            while ('str', absent) in atoms: absent += '_'
            for observations in ([{'fact': fact, 'equals': None}], [], [{'fact': fact, 'equals': absent}]):
                task = deepcopy(source); task['queries'] = [{'query_id': 'null-probe', 'fact': fact}]; task['observations'] = observations; cases.append(task)
            derived = [analyze(task) for task in cases]
            valid = bool(derived[0]['properties']['multiworld_entailed_null']) and bool(derived[1]['properties']['ambiguous_null_partition']) and not derived[2]['target']['surviving_worlds']
            _need(valid, 'executed null contrast probe failed')
            add('null_guarantee_contrast', family + ':null:' + fact, cases, {'satisfied': True, 'targets': [item['target'] for item in derived]})
    return output


def _audit_answer(answer, analysis):
    category = 'empty' if not analysis['target']['surviving_worlds'] else 'entailed' if answer['entailed'] else 'ambiguous'
    return {'payload': {key: value for key, value in answer.items() if key != 'query_id'}, 'category': category, 'guaranteed_null_context': category if answer['guaranteed'] is None else 'nonnull', 'count_type_signature': [[type(item['value']).__name__, item['count']] for item in answer['counts']], 'final_survivors': analysis['target']['surviving_worlds'], 'prefix_survivors': analysis['support_ids'], 'prefix_counts': analysis['target']['belief_sizes']}


def check_batch(rows):
    """Complete supplied schedule and actual same-family scoped control proofs."""
    errors, summaries, groups, families = [], [], defaultdict(list), defaultdict(list)
    ids = {}; lineage = defaultdict(set)
    for index, row in enumerate(rows):
        label = row.get('sample_id', str(index)) if type(row) is dict else str(index)
        errors.extend(label + ': ' + message for message in check(row))
        try:
            _need(type(row) is dict, 'row object required')
            if not _controlled(row):
                continue
            actual = analyze(row['semantic_task']); encoding = _encoding(row, actual)
            decoded = _decode(row, encoding); member = {'row_index': index, 'sample_id': label, **encoding, 'analysis': actual, 'decoded': decoded}
            _need(label not in ids, 'duplicate sample_id'); ids[label] = member
            groups[(encoding['family'], encoding['context'], encoding['renderer'])].append(member); families[encoding['family']].append(member)
            for field in ('semantic_family_id', 'semantic_parent_id'):
                lineage[(field, row[field])].add(encoding['family'])
            summaries.append({'sample_id': label, 'family': encoding['family'], 'context': encoding['context'], 'supports': actual['support_ids'], 'derived_target': actual['target'], 'properties': actual['properties'], 'graph': encoding['graph']})
        except (BeliefControlError, KeyError, TypeError, ValueError) as error:
            errors.append(str(label) + ': belief_control_batch_row: ' + str(error))
    properties = {name: [] for name in sorted(FAMILY)}; crossings = []; pairings = {}; base_by_family = {}; signatures = {}
    for coordinate, members in sorted(groups.items()):
        family, context, renderer = coordinate; schedules = [member['schedule'] for member in members]
        if sorted(schedules) != list(range(27)):
            errors.append(family + '/' + context + '/' + renderer + ': exact 27 schedules missing/duplicated')
        baseline = members[0]['decoded']; pools = members[0]['pools']
        if any(_json(member['decoded']) != _json(baseline) or member['pools'] != pools for member in members):
            errors.append(family + '/' + context + ': decoded task or declared pools differ across views')
        role_counts = {role: {key: Counter() for key in ('id', 'position', 'name', 'id_position', 'id_name', 'position_name', 'triple')} for role in QUERY_ROLES}
        outcomes = {key: defaultdict(Counter) for key in ('id', 'position', 'name', 'id_position', 'id_name', 'position_name', 'triple')}
        for member in members:
            for assignment in member['assignments']:
                role = assignment['role']; pos = assignment['position']; query = rows[member['row_index']]['semantic_task']['queries'][pos]
                i, p, n = pools[0].index(query['query_id']), pos, pools[1].index(query['fact'])
                buckets = {'id': str(i), 'position': str(p), 'name': str(n), 'id_position': str((i, p)), 'id_name': str((i, n)), 'position_name': str((p, n)), 'triple': str((i, p, n))}
                audit = _json(_audit_answer(member['analysis']['target']['queries'][pos], member['analysis']))
                for key, bucket in buckets.items(): role_counts[role][key][bucket] += 1; outcomes[key][bucket][audit] += 1
        valid = True
        for role, counts in role_counts.items():
            for key, counter in counts.items():
                dimensions = 3 if key == 'triple' else 2 if '_' in key else 1
                if len(counter) != 3 ** dimensions or set(counter.values()) != {27 // (3 ** dimensions)}:
                    valid = False
        for key, histograms in outcomes.items():
            if len({_json(dict(histogram)) for histogram in histograms.values()}) != 1:
                valid = False
        if not valid:
            errors.append(family + '/' + context + '/' + renderer + ': actual query crossing/outcome histograms fail')
        crossing = {'family': family, 'context': context, 'renderer': renderer, 'sample_ids': [member['sample_id'] for member in members], 'role_counts': {role: {key: dict(value) for key, value in counters.items()} for role, counters in role_counts.items()}, 'actual_outcome_histograms': {key: {bucket: dict(counter) for bucket, counter in histograms.items()} for key, histograms in outcomes.items()}, 'satisfied': valid}
        crossings.append(crossing)
        if valid: properties['query_id_position_fact_crossing'].append(crossing)
        for member in members: pairings[(family, context, member['schedule'], renderer)] = member
    for family, members in sorted(families.items()):
        indices = {member['index'] for member in members}; contexts = {member['context'] for member in members}
        if len(indices) != 1 or contexts != set('ABCDEF') or len(members) != 324:
            errors.append(family + ': full one-index 6-context x27 x2 family required')
        if len({_json(member['pools']) for member in members}) != 1:
            errors.append(family + ': pools change across contexts')
        bases = {context: next(member for member in members if member['context'] == context)['decoded'] for context in sorted(contexts)}
        base_by_family[family] = bases
        if len({_json(task['worlds']) for task in bases.values()}) != 1:
            errors.append(family + ': decoded world table changes across contexts')
        first = members[0]; signatures[family] = _signature(rows[first['row_index']]['semantic_task'], first['roles'])
        for context, task in bases.items():
            actual = analyze(task); q = {item['query_id']: item for item in actual['target']['queries']}; props = actual['properties']
            if context == 'A':
                valid = len(actual['supports'][-1]) >= (3 if first['index'] == 18 else 2) and len(task['observations']) == 2 and task['observations'][0]['fact'] != task['observations'][1]['fact'] and all(0 < len(actual['supports'][j + 1]) < len(actual['supports'][j]) for j in range(2)) and any('invariant_query' in proof['query_ids'] for proof in props['conjunction_required_invariant']) and q['variation_query']['can_reduce_uncertainty']
                if not valid: errors.append(family + ': A decisive conjunction/invariant/useful requirements fail')
            if context == 'B' and not props['multiworld_all_queries_redundant']:
                errors.append(family + ': B lacks distinct surviving payloads with all offered queries redundant')
        pairs = [('A', 'B', 'equal_support_usefulness_counterfactual'), ('A', 'C', 'observation_reorder_final_invariance'), ('A', 'D', 'nonempty_repetition_final_invariance'), ('A', 'E', 'cross_fact_contradiction_counterfactual'), ('E', 'F', 'post_empty_append_absorption')]
        for left, right, name in pairs:
            if left not in bases or right not in bases or name not in {prop for prop, _ in _relations(bases[left], bases[right])}:
                errors.append(family + ': required supplied ' + name + ' fails')
        nulls = {name: [] for name in ('multiworld_entailed_null', 'ambiguous_null_partition', 'empty')}
        active_aliases = set()
        for member in members:
            for name in nulls:
                if name == 'empty':
                    if not member['analysis']['target']['surviving_worlds']: nulls[name].append(member['sample_id'])
                elif member['analysis']['properties'][name]: nulls[name].append(member['sample_id'])
            for name in ('typed_observation_separator', 'typed_query_partition_separator'):
                for proof in member['analysis']['properties'][name]:
                    active_aliases.add('true1' if any(type(value) is bool and value for value in proof['alias_pair']) else 'false0')
        if all(nulls.values()):
            properties['null_guarantee_contrast'].append({'family': family, 'sample_ids': [values[0] for values in nulls.values()], 'scope': 'corpus_variant', 'cases': {name: values[0] for name, values in nulls.items()}})
        if first['index'] in (12, 18) and not all(nulls.values()): errors.append(family + ': required supplied complete null contrast absent')
        if first['index'] == 18 and not any(member['analysis']['properties']['skewed_possible_value_partition'] for member in members): errors.append(family + ': weighted profile lacks a supplied unequal positive query-bin count witness')
        if first['index'] == 13 and 'false0' not in active_aliases: errors.append(family + ': active false/0 separator absent')
        if first['index'] == 19 and active_aliases != {'true1', 'false0'}: errors.append(family + ': active true/1 and false/0 separators required')
    index_families = defaultdict(set)
    for family, members in families.items():
        for member in members: index_families[member['index']].add(family)
    if set(index_families) != set(PROFILES) or any(len(value) != 1 for value in index_families.values()): errors.append('batch requires exactly one source family for each public index 12,13,18,19')
    if len({_json(value) for value in signatures.values()}) != len(signatures): errors.append('distinct source families share order/name/scalar-invariant structural signatures')
    for (field, value), owners in lineage.items():
        if len(owners) > 1: errors.append(field + ' ' + value + ': lineage crosses source families')
    for coordinate, left in sorted(pairings.items()):
        family, context, schedule, renderer = coordinate
        if renderer != 'forward': continue
        right = pairings.get((family, context, schedule, 'reverse'))
        if right is None: errors.append(family + ': missing paired field renderer'); continue
        lr, rr = rows[left['row_index']], rows[right['row_index']]
        lp, lraw = _visible(lr); rp, rraw = _visible(rr)
        same = _json(lr['semantic_task']) == _json(rr['semantic_task']) and lp == rp
        # Equality of parse with preserved insertion order exposes actual object
        # field reordering; whitespace alone never establishes the control.
        order_differs = json.dumps(json.loads(lraw), ensure_ascii=False) != json.dumps(json.loads(rraw), ensure_ascii=False)
        if not same or not order_differs: errors.append(family + ': field-order pair is not a pure actual object-order change')
        else: properties['field_order_invariance'].append({'family': family, 'sample_ids': [left['sample_id'], right['sample_id']], 'scope': 'corpus_variant', 'schedule': schedule, 'context': context})
    for family in families:
        for schedule in range(27):
            for renderer in ('forward', 'reverse'):
                names = {context: pairings.get((family, context, schedule, renderer)) for context in 'ABCDEF'}
                for left_context in 'ABCDEF':
                    for right_context in 'ABCDEF':
                        if left_context == right_context or names[left_context] is None or names[right_context] is None: continue
                        left, right = names[left_context], names[right_context]
                        for name, detail in _relations(left['decoded'], right['decoded']):
                            properties[name].append({'family': family, 'scope': 'corpus_variant', 'sample_ids': [left['sample_id'], right['sample_id']], **detail})
    probes = [probe for family, bases in sorted(base_by_family.items()) for probe in _probes(family, bases)]
    probe_properties = {name: [probe for probe in probes if probe['property'] == name] for name in FAMILY}
    claims, declarations = [], defaultdict(list); claim_identifiers = {}
    for family, members in families.items():
        for member in members:
            try:
                for claim in _claims(rows[member['row_index']]):
                    identifier = family, claim.get('control_id', claim['property'])
                    identity = claim['property'], claim['scope']
                    if identifier in claim_identifiers and claim_identifiers[identifier] != identity: errors.append(family + ': duplicate claim identifier has inconsistent scope/property')
                    claim_identifiers[identifier] = identity
                    declarations[(family, _json(claim))].append(member['sample_id'])
            except BeliefControlError:
                continue
    for (family, encoded), sources in sorted(declarations.items()):
        claim = json.loads(encoded); name, scope = claim['property'], claim['scope']
        witnesses = [item for item in (properties[name] if scope == 'corpus_variant' else probe_properties[name]) if item['family'] == family]
        if 'pair_sample_ids' in claim:
            pair = set(claim['pair_sample_ids'])
            if any(identifier not in ids or ids[identifier]['family'] != family for identifier in pair): errors.append(family + ': declared pair IDs do not belong to same actual family')
            witnesses = [item for item in witnesses if pair <= set(item.get('sample_ids', []))]
        if 'probe_id' in claim: witnesses = [item for item in witnesses if item['probe_id'] == claim['probe_id']]
        valid = bool(witnesses)
        claims.append({'family': family, 'claim': claim, 'declaring_sample_ids': sorted(set(sources)), 'matched_witness_count': len(witnesses), 'satisfied': valid})
        if not valid: errors.append(family + ': missing actual same-family scoped claim witness ' + name + '/' + scope)
    # All required supplied and audit scopes are measured separately. No optional
    # descriptive pointer is opened, and no stored target is consulted.
    unique_tasks = {_json(rows[member['row_index']]['semantic_task']) for members in families.values() for member in members}
    world_tables = {_json(sorted([world['facts'] for world in member['decoded']['worlds']], key=_json)) for members in families.values() for member in members}
    visible_tables = {_json(sorted([world for world in rows[member['row_index']]['semantic_task']['worlds']], key=_json)) for members in families.values() for member in members}
    visible_queries = {_json(query) for members in families.values() for member in members for query in rows[member['row_index']]['semantic_task']['queries']}
    base_queries = {_json([family, member['context'], query]) for family, members in families.items() for member in members for query in member['decoded']['queries']}
    renderings = {rows[member['row_index']]['rendered_input'] for members in families.values() for member in members}
    return {'errors': errors, 'counts': {'records': len(rows), 'controlled_records': sum(map(len, families.values())), 'source_families': len(families), 'base_contexts': len({(family, context) for family, context, _ in groups}), 'base_context_query_observations': len(base_queries), 'rotation_level_query_observations': 3 * sum(len(value) for key, value in groups.items() if key[2] == 'forward'), 'rendered_query_observations': 3 * sum(map(len, families.values())), 'distinct_parsed_tasks': len(unique_tasks), 'distinct_decoded_world_tables': len(world_tables), 'distinct_visible_world_tables': len(visible_tables), 'distinct_literal_query_signatures': len(visible_queries), 'distinct_renderings': len(renderings), 'executed_probes': len(probes), 'added_probe_corpus_records': 0, 'added_probe_source_families': 0}, 'rows': summaries, 'crossings': crossings, 'corpus_controls': properties, 'audit_probes': probes, 'claim_checks': claims, 'structural_signatures': signatures, 'source_index_mapping': {str(index): sorted(value) for index, value in index_families.items()}, 'prior_release_comparison': 'Not inferred from numeric IDs; prior input tables are not supplied to this input-only API.', 'approval_verdict': None}
