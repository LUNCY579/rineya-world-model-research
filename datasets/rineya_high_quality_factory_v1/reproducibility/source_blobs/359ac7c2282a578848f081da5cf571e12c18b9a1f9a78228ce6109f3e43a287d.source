"""Independent hand fixtures and corruption tests for the public RBM controls."""
from copy import deepcopy
import itertools
import json
from pathlib import Path
import sys
import unittest

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from oracles.belief_controls_independent import analyze, check, check_batch, derive, _relations, _probes, _signature


def raw_worlds(index):
    if index == 12:
        cells = [(0, 0, 3), (0, 1, 3), (1, 0, 3), (1, 1, 3), (1, 2, 3), (2, 0, 3)]
    elif index == 13:
        cells = [(0, 0, 3), (0, 1, 3), (1, 0, 3), (1, 2, 3), (2, 0, 3)]
    elif index == 18:
        cells = [(0, 0, 4), (0, 1, 4), (1, 0, 1), (1, 1, 2), (1, 2, 1), (2, 0, 1)]
    else:
        cells = [(0, 0, 3), (0, 1, 3), (1, 0, 2), (1, 2, 1)]
    worlds = []
    for left, right, multiplicity in cells:
        for member in range(multiplicity):
            control = (True if left == 0 else 1) if index == 19 else left
            invariant = None if (left, right) == (0, 0) else 'unknown'
            if (left, right) == (0, 0):
                values = [None, None, True, 1] if index == 18 else [None, False, 0] if index in (13, 19) else [None, True, 1]
                variation = values[member]
            else:
                variation = 'fixed'
            worlds.append({'world_id': 'w' + str(len(worlds)), 'facts': {'observation_control': control, 'observation_auxiliary': right, 'invariant_query': invariant, 'variation_query': variation, 'unoffered_feature': member}})
    return worlds


def base_task(index=12, context='A'):
    control = True if index == 19 else 0
    observations = [{'fact': 'observation_control', 'equals': control}, {'fact': 'observation_auxiliary', 'equals': 0}]
    if context == 'B': observations[1]['equals'] = 1
    if context == 'C': observations.reverse()
    if context == 'D': observations.append(deepcopy(observations[0]))
    if context in ('E', 'F'): observations[1]['equals'] = 2
    if context == 'F': observations.append({'fact': 'observation_auxiliary', 'equals': 0})
    return {'kind': 'belief', 'worlds': raw_worlds(index), 'observations': observations,
            'queries': [{'query_id': role, 'fact': 'observation_control' if role == 'observed_control' else role} for role in ('invariant_query', 'variation_query', 'observed_control')]}


def reverse_objects(value):
    if type(value) is dict:
        return {key: reverse_objects(item) for key, item in reversed(list(value.items()))}
    if type(value) is list:
        return [reverse_objects(item) for item in value]
    return value


def render(row):
    payload = reverse_objects(row['semantic_task']) if row['renderer'] == 'reverse' else row['semantic_task']
    row['rendered_input'] = 'Public finite belief contract.\nTask JSON:\n' + json.dumps(payload, ensure_ascii=False)


def row(index=12, context='A', shifts=(0, 0, 0), renderer='forward'):
    u, v, w = shifts; source = base_task(index, context); roles = list(source['worlds'][0]['facts'])
    qroles = ('invariant_query', 'variation_query', 'observed_control'); names = ['f0', 'f1', 'f2']; qids = ['q0', 'q1', 'q2']
    mapping = {'observation_auxiliary': 'aux', 'unoffered_feature': 'feature'}
    for r, role in enumerate(qroles): mapping['observation_control' if role == 'observed_control' else role] = names[(r + w) % 3]
    task = deepcopy(source)
    for world in task['worlds']: world['facts'] = {mapping[fact]: value for fact, value in world['facts'].items()}
    for observation in task['observations']: observation['fact'] = mapping[observation['fact']]
    task['queries'] = [None] * 3; assignments = []
    for r, role in enumerate(qroles):
        position = (r + v) % 3; fact = names[(r + w) % 3]; qid = qids[(r + u) % 3]
        task['queries'][position] = {'query_id': qid, 'fact': fact}
        assignments.append({'role': role, 'position': position, 'query_id': qid, 'fact': fact})
    corpus = ['equal_support_usefulness_counterfactual', 'observation_reorder_final_invariance', 'nonempty_repetition_final_invariance', 'cross_fact_contradiction_counterfactual', 'post_empty_append_absorption', 'null_guarantee_contrast', 'query_id_position_fact_crossing', 'field_order_invariance']
    audits = ['world_order_invariance', 'world_id_rename_equivariance', 'typed_equals_counterfactual']
    result = {'sample_id': f'fixture-{index}-{context}-{u}{v}{w}-{renderer}', 'semantic_family_id': f'sf-{index}', 'semantic_parent_id': f'parent-{index}', 'source_family_key': f'family-{index}', 'source_family_index': index, 'controlled_context': context,
              'structural_family_profile': {12:'cyclic_uniform', 13:'acyclic_branching', 18:'cyclic_weighted', 19:'typed_path'}[index], 'split': 'train' if index in (12, 13) else 'dev_challenge', 'id_shift':u, 'position_shift':v, 'fact_name_shift':w, 'schedule_index':9*u+3*v+w, 'renderer':renderer, 'query_id_pool':qids, 'queried_fact_name_pool':names, 'fact_role_assignments':mapping, 'query_role_assignments':assignments,
              'skill_tags':['finite_synthetic_proxy','finite_noiseless_filter','possible_value_partition'], 'property_witnesses':{}, 'family_control_claims':[{'name':name,'scope':'corpus_variant'} for name in corpus] + [{'name':name,'scope':'audit_probe'} for name in audits], 'semantic_task':task}
    render(result); return result


def full_batch():
    return [row(index, context, shifts, style) for index in (12, 13, 18, 19) for context in 'ABCDEF' for shifts in itertools.product(range(3), repeat=3) for style in ('forward', 'reverse')]


def attach(item, name, queries=(), observations=(), prefixes=(), **extra):
    item['skill_tags'].append(name)
    item['property_witnesses'][name] = {'query_ids':list(queries), 'observation_indices':list(observations), 'prefix_indices':list(prefixes), **extra}
    return item


class BeliefInputProperties(unittest.TestCase):
    def test_hand_supports_and_conjunction_omissions(self):
        a = analyze(base_task())
        self.assertEqual(a['target']['belief_sizes'], [6, 3])
        self.assertEqual(a['target']['surviving_worlds'], ['w0','w1','w2'])
        self.assertEqual(a['target']['queries'][0]['counts'], [{'value':None,'count':3}])
        self.assertEqual([json.dumps(item['value']) for item in a['target']['queries'][1]['counts']], ['1','null','true'])
        self.assertEqual(len(a['properties']['conjunction_required_invariant']), 1)
        proof = a['properties']['conjunction_required_invariant'][0]
        self.assertEqual([len(item['survivors']) for item in proof['omitted']], [9,6])
        self.assertTrue(all(item['partition']['distinct_values'] == 2 for item in proof['omitted']))

    def test_all_six_contexts_have_hand_calculated_traces(self):
        expected = {'A':[6,3], 'B':[6,3], 'C':[9,3], 'D':[6,3,3], 'E':[6,0], 'F':[6,0,0]}
        for context, sizes in expected.items():
            self.assertEqual(derive(base_task(context=context))['target']['belief_sizes'], sizes)
        b = analyze(base_task(context='B'))
        self.assertTrue(b['properties']['multiworld_all_queries_redundant'])
        self.assertTrue(all(item['entailed'] for item in b['target']['queries']))
        self.assertEqual(b['target']['queries'][0]['guaranteed'], 'unknown')

    def test_true_one_false_zero_and_null_partition_flags(self):
        for index, alias in [(12,[True,1]),(13,[False,0]),(19,[False,0])]:
            actual = analyze(base_task(index))
            self.assertTrue(actual['properties']['typed_query_partition_separator'])
            self.assertTrue(actual['properties']['multiworld_entailed_null'])
            self.assertTrue(actual['properties']['ambiguous_null_partition'])
            self.assertEqual(actual['properties']['typed_query_partition_separator'][0]['alias_pair'], alias)
        self.assertTrue(analyze(base_task(19))['properties']['typed_observation_separator'])
        self.assertTrue(analyze(base_task(18))['properties']['skewed_possible_value_partition'])

    def test_public_locator_accepts_required_omission_indices(self):
        item = attach(row(), 'conjunction_required_invariant', ['q0'], [0,1], [2], supporting_world_ids=['w0','w1','w2'])
        self.assertEqual(check(item), [])
        item['property_witnesses']['conjunction_required_invariant']['observation_indices'] = [0]
        self.assertTrue(any('locator' in error for error in check(item)))

    def test_locators_reject_wrong_query_prefix_alias_and_foreign_world(self):
        original = attach(row(), 'multiworld_entailed_null', ['q0'], [], [2])
        self.assertEqual(check(original), [])
        for field, bad in [('query_ids',['q1']),('prefix_indices',[True]),('prefix_indices',[0]),('supporting_world_ids',['w5']),('observation_indices',[3])]:
            altered=deepcopy(original); altered['property_witnesses']['multiworld_entailed_null'][field]=bad
            self.assertTrue(check(altered), (field,bad))

    def test_false_tags_missing_locators_and_rich_answer_annotations_fail(self):
        item=attach(row(context='E'),'multiworld_entailed_null',['q0'],[],[2])
        self.assertTrue(any('unwitnessed' in error for error in check(item)))
        item=row(); item['skill_tags'].append('multiworld_entailed_null')
        self.assertTrue(check(item))

    def test_absorption_and_repetition_locators_require_actual_prefixes(self):
        item=attach(row(context='F'),'post_empty_absorption',['q0','q1','q2'],[2],[0,2,3])
        self.assertEqual(check(item),[])
        item['property_witnesses']['post_empty_absorption']['prefix_indices']=[2,3]
        self.assertTrue(check(item))
        item=attach(row(context='D'),'nonempty_repeated_observation',[],[0,2],[2,3])
        self.assertEqual(check(item),[])
        item['property_witnesses']['nonempty_repeated_observation']['prefix_indices']=[3]
        self.assertTrue(check(item))

    def test_same_fact_dispute_and_empty_repeat_do_not_certify_stronger_tags(self):
        task=base_task(context='E'); task['observations'][1]={'fact':'observation_control','equals':1}
        self.assertFalse(analyze(task)['properties']['cross_fact_inconsistent_conjunction'])
        task=base_task(context='F'); task['observations'][2]=deepcopy(task['observations'][0])
        self.assertFalse(analyze(task)['properties']['nonempty_repeated_observation'])
        item=attach(row(),'multiworld_entailed_null',['q0'],[],[2]); item['property_witnesses']['multiworld_entailed_null']['counts']=[{'value':None,'count':3}]
        self.assertTrue(check(item))

    def test_required_metadata_and_type_sensitive_rendering_fail_closed(self):
        for field in ['controlled_context','fact_role_assignments','family_control_claims','property_witnesses','semantic_parent_id']:
            item=row(); del item[field]; self.assertTrue(check(item),field)
        item=row(19); altered=deepcopy(item['semantic_task']); altered['observations'][0]['equals']=1
        item['rendered_input']='Task JSON:\n'+json.dumps(altered)
        self.assertTrue(any('typed rendered' in error for error in check(item)))

    def test_schedule_metadata_cannot_replace_actual_consistent_name_changes(self):
        for field,bad in [('id_shift',True),('schedule_index',26),('source_family_index',14),('split','train'),('structural_family_profile','cyclic_uniform')]:
            item=row(19); item[field]=bad; self.assertTrue(check(item),(field,bad))
        item=row(); item['semantic_task']['queries'][0]['fact']='f1'; render(item)
        self.assertTrue(check(item))
        item=row(); item['semantic_task']['observations'][1]['fact']='feature'; render(item)
        self.assertTrue(any('observation roles' in error for error in check(item)))

    def test_duplicate_payloads_and_wrong_structural_profiles_fail(self):
        item=row(); item['semantic_task']['worlds'][1]['facts']=deepcopy(item['semantic_task']['worlds'][0]['facts']); render(item)
        self.assertTrue(any('duplicate complete' in error for error in check(item)))
        item=row(13); item['source_family_index']=19; item['structural_family_profile']='typed_path'; item['split']='dev_challenge'
        self.assertTrue(any('typed_path graph' in error for error in check(item)))

    def test_descriptive_claims_reject_conflicts_and_do_not_open_pointers(self):
        item=row(); item['family_control_claims']=[{'property':'world_order_invariance','scope':'audit_probe','source_family_key':'family-12','evidence_manifest':'nonexistent/unread.json','control_id':'descriptive'}]
        self.assertEqual(check(item),[])
        for extra in [{'name':'field_order_invariance'},{'source_family_key':'foreign'},{'scope':'imagined'},{'evidence_manifest':'/private.json'},{'approved':True},{'probe_id':'x','scope':'corpus_variant'}]:
            bad=deepcopy(item); bad['family_control_claims'][0].update(extra); self.assertTrue(check(bad),extra)

    def test_scalar_name_order_metamorphic_signature_and_input_identity(self):
        task=base_task(); original=deepcopy(task); rolemap={role:role for role in task['worlds'][0]['facts']}
        signature=_signature(task,rolemap)
        renamed=deepcopy(task); mapping={role:'new-'+role for role in rolemap}
        for world in renamed['worlds']: world['facts']={mapping[fact]: ('replacement' if value=='unknown' else value) for fact,value in reversed(list(world['facts'].items()))}
        renamed['worlds'].reverse()
        self.assertEqual(_signature(renamed,mapping),signature)
        derive(task); self.assertEqual(task,original)

    def test_real_scoped_probes_execute_typed_and_null_contrasts(self):
        probes=_probes('family',{context:base_task(context=context) for context in 'ABCDEF'})
        self.assertEqual(len([item for item in probes if item['property']=='world_order_invariance']),6)
        self.assertEqual(len([item for item in probes if item['property']=='world_id_rename_equivariance']),6)
        self.assertTrue(any(item['property']=='typed_equals_counterfactual' for item in probes))
        contrasts=[item for item in probes if item['property']=='null_guarantee_contrast']
        self.assertTrue(contrasts)
        for item in contrasts:
            answers=[target['queries'][0] for target in item['targets']]
            self.assertEqual([answer['entailed'] for answer in answers],[True,False,False])
            self.assertTrue(all(answer['guaranteed'] is None for answer in answers))
        self.assertTrue(all(item['added_corpus_records']==0 and item['added_source_families']==0 for item in probes))

    def test_semantic_edits_require_decisive_supported_counterfactuals(self):
        a,b=base_task(),base_task(context='B')
        self.assertIn('equal_support_usefulness_counterfactual',[name for name,_ in _relations(a,b)])
        unchanged=deepcopy(a); unchanged['observations'][1]['equals']=0
        self.assertEqual(_relations(a,unchanged),[])
        unsupported=deepcopy(a); unsupported['observations'][1]['equals']=999
        self.assertNotIn('cross_fact_contradiction_counterfactual',[name for name,_ in _relations(a,unsupported)])
        e,f=base_task(context='E'),base_task(context='F')
        self.assertIn('post_empty_append_absorption',[name for name,_ in _relations(e,f)])


class BeliefBatchProperties(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.rows=full_batch(); cls.report=check_batch(cls.rows)

    def test_complete_four_family_schedule_and_actual_histograms(self):
        self.assertEqual(self.report['errors'],[])
        counts=self.report['counts']
        self.assertEqual([counts[key] for key in ['records','source_families','base_contexts','base_context_query_observations','rotation_level_query_observations','rendered_query_observations']],[1296,4,24,72,1944,3888])
        self.assertEqual(counts['distinct_decoded_world_tables'],4)
        self.assertEqual(len(self.report['crossings']),48)
        self.assertTrue(all(item['satisfied'] for item in self.report['crossings']))
        self.assertTrue(all(item['satisfied'] for item in self.report['claim_checks']))
        for crossing in self.report['crossings']:
            for role,counts in crossing['role_counts'].items():
                self.assertEqual(set(counts['triple'].values()),{1})
                self.assertEqual(len(counts['triple']),27)
                self.assertEqual(set(counts['id_position'].values()),{3})
                self.assertEqual(set(counts['id'].values()),{9})

    def test_partial_nine_plane_schedule_cannot_pass_complete_triple_claim(self):
        incomplete=[item for item in self.rows if item['fact_name_shift']==(item['id_shift']+item['position_shift'])%3]
        report=check_batch(incomplete)
        self.assertTrue(any('exact 27 schedules' in error for error in report['errors']))
        self.assertTrue(any('crossing/outcome' in error for error in report['errors']))

    def test_pair_and_probe_ids_need_actual_same_family_relation(self):
        rows=deepcopy(self.rows)
        rows[0]['family_control_claims']=[{'name':'equal_support_usefulness_counterfactual','scope':'corpus_variant','pair_sample_ids':[rows[0]['sample_id'],next(item['sample_id'] for item in rows if item['source_family_index']==13)]},
                                         {'name':'world_order_invariance','scope':'audit_probe','probe_id':'invented-unexecuted-probe'}]
        report=check_batch(rows)
        self.assertTrue(any('pair IDs' in error for error in report['errors']))
        self.assertTrue(any('missing actual same-family scoped' in error for error in report['errors']))

    def test_wrong_list_order_renderer_and_lineage_cannot_be_credited(self):
        rows=deepcopy(self.rows)
        rows[1]['semantic_task']['observations'].reverse(); render(rows[1])
        rows[-1]['semantic_parent_id']=rows[0]['semantic_parent_id']
        report=check_batch(rows)
        self.assertTrue(any('decoded task' in error for error in report['errors']))
        self.assertTrue(any('pure actual object-order' in error for error in report['errors']))
        self.assertTrue(any('lineage crosses' in error for error in report['errors']))

    def test_batch_input_permutation_and_poisoned_targets_do_not_change_witnesses(self):
        item=deepcopy(self.rows[0]); item['verified_target']={'bogus':True}; item['review_verdict']='APPROVED'
        self.assertEqual(check(item),check(self.rows[0]))
        self.assertEqual(derive(item['semantic_task']),derive(self.rows[0]['semantic_task']))
        self.assertIsNone(self.report['approval_verdict'])
        reversed_report=check_batch(list(reversed(self.rows)))
        self.assertEqual(reversed_report['errors'],[])
        self.assertEqual(reversed_report['counts'],self.report['counts'])
        self.assertEqual(reversed_report['structural_signatures'],self.report['structural_signatures'])
        self.assertEqual({name:len(value) for name,value in reversed_report['corpus_controls'].items()}, {name:len(value) for name,value in self.report['corpus_controls'].items()})

    def test_weighted_incidence_does_not_substitute_for_skewed_query_bins(self):
        rows=deepcopy(self.rows)
        for item in rows:
            if item['source_family_index']!=18: continue
            roles=item['fact_role_assignments']
            selected=[world for world in item['semantic_task']['worlds'] if world['facts'][roles['observation_control']]==0 and world['facts'][roles['observation_auxiliary']]==0]
            for position,world in enumerate(selected): world['facts'][roles['variation_query']]=None if position%2==0 else True
            render(item)
        report=check_batch(rows)
        self.assertTrue(any('unequal positive query-bin' in error for error in report['errors']))

    def test_malformed_rows_are_errors_and_legacy_scope_is_retained(self):
        self.assertTrue(check_batch([None])['errors'])
        legacy={'semantic_task':{'kind':'belief','worlds':[],'observations':[],'queries':[]},'skill_tags':['finite_synthetic_proxy']}
        self.assertEqual(check(legacy),[])


if __name__=='__main__':
    unittest.main()
