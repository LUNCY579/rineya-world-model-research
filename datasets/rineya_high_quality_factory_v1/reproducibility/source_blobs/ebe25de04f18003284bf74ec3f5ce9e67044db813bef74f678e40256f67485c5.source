"""Build research specifications only. This program neither creates nor approves samples."""
from pathlib import Path
import hashlib, json
from datetime import datetime, timezone

ROOT = Path(__file__).resolve().parents[2]
FACTORY = ROOT / 'High-Quality_Dataset'
BUNDLE = 'rineya_complementary_research_2026-10-09'
REPO = 'rineya-world-model-research'

source_specs = [
 ('LOCAL_README', f'{REPO}/README.md', 'repository scope and contribution boundary', 'full text'),
 ('BWM_REPORT', f'{REPO}/bwm/README.md', 'frozen hybrid planning result and exploratory size/shortcut findings', 'full text'),
 ('RCWM_REPORT', f'{REPO}/rcwm/experiments/RCWM-T1/REPORT.md', 'PREREG-1/2/3 and failed localization promotion', 'sections 1-4, 6-7'),
 ('RCWM_DECISIONS', f'{REPO}/rcwm/experiments/RCWM-T1/DECISIONS.md', 'authoritative chronology, surface audit and filler/retention corrections', 'targeted D-28, R-L1, D-33 to D-37, R16'),
 ('JOINT_ROADMAP', f'{REPO}/bwm/docs/research/JOINT_ROADMAP_2026-10-08.md', 'reuse, planning/skill hypotheses and negative baselines', 'full text'),
 ('BWM_PREREG', f'{REPO}/bwm/docs/PREREG_PLANBENCH.md', 'planning protocol; no benchmark examples were opened', 'protocol text'),
 ('RCWM_PREREG2', f'{REPO}/rcwm/experiments/RCWM-T1/PREREG_2.md', 'registered in-distribution scope and endpoints', 'protocol excerpts'),
 ('RCWM_PREREG3', f'{REPO}/rcwm/experiments/RCWM-T1/PREREG_3.md', 'registered rule/trigger distinctions and ambiguity exclusions', 'sections 1-2.4 protocol only'),
 ('T2B_PREREQ', f'{REPO}/rcwm/experiments/RCWM-T1/docs/t2b/prereq/DESIGN.md', 'precondition representation, shortcut quotas, input surfaces', 'sections 0-5 design only'),
 ('T2B_REGISTER', f'{REPO}/rcwm/experiments/RCWM-T1/docs/t2b/register/DESIGN.md', 'boundary arithmetic and fixed filler guidance', 'sections 0-3 design only'),
 ('BUNDLE_README', f'{BUNDLE}/README.md', 'planning-only status and read-only provenance', 'full text'),
 ('BUNDLE_REPORT', f'{BUNDLE}/01_report/Rineya_Complementary_Research_Report.md', 'evidence taxonomy, dependencies, claims and literature limitations', 'sections 1-3 and 6-12'),
 ('TRACKS', f'{BUNDLE}/04_experiments/tracks.json', 'ten planned mechanisms and controls', 'all ten track specifications'),
 ('REGISTRY', f'{BUNDLE}/04_experiments/experiment_registry.json', '35 proposed experiment entries', 'all entry IDs, purposes, dependencies, endpoints; common controls'),
 ('PREDICTIONS', f'{BUNDLE}/04_experiments/predictions.json', '13 unmeasured predictions and falsifiers', 'all entries'),
 ('PROTOCOL', f'{BUNDLE}/04_experiments/COMMON_PROTOCOL.md', 'parent custody, OOD axes, budgets, statistical and retention boundaries', 'full text'),
 ('CONTRACTS', f'{BUNDLE}/04_experiments/DATA_CONTRACTS.md', 'semantic lineage and privileged-label separation', 'full text'),
 ('REUSE', f'{BUNDLE}/05_execution/REUSE_AND_BRANCH_POLICY.md', 'verified and unverified overlap candidates', 'full text'),
 ('TRANSFER', f'{BUNDLE}/05_execution/INTEGRATION_AND_TRANSFER.md', 'A/B/C/D assistance tiers and teacher eligibility', 'full text'),
 ('RESOURCES', f'{BUNDLE}/03_resources/resources.json', '36 primary-resource annotations; links only, no license clearance', 'all titles, use cases, limitations and catalog status'),
 ('READING_ORDER', f'{BUNDLE}/03_resources/READING_ORDER.md', 'mechanism extraction questions and order', 'full text'),
 ('SOURCE_AUDIT', f'{BUNDLE}/03_resources/SOURCE_AUDIT.md', 'resource verification and rights limitations', 'full text'),
 ('EVIDENCE_LEDGER', f'{BUNDLE}/07_evidence/evidence_ledger.json', 'nine scoped record-evidence entries', 'all entries'),
 ('REPOSITORY_SOURCES', f'{BUNDLE}/07_evidence/repository_sources.json', 'pinned commit/blob references and verification scope', 'all entries'),
]
for tid in ['RCM-001','RGM-001','RVM-001','RSM-001','RMM-001','REM-001','RBM-001','RJP-001','RDP-001','ROM-001']:
 source_specs.append((f'CARD_{tid}', f'{BUNDLE}/02_research_tracks/{tid}.md', 'proposed research card, no native experiment', 'full text'))
sources=[]
for sid, rel, purpose, scope in source_specs:
 data=(ROOT/rel).read_bytes()
 sources.append(dict(source_id=sid,path=rel,sha256=hashlib.sha256(data).hexdigest(),bytes=len(data),purpose=purpose,read_scope=scope))
source_map={x['source_id']:x for x in sources}

evidence = [
 dict(id='F01',status='record-confirmed frozen hybrid result',finding='BWM world-model plus beam solved 73/110; corresponding proposer without world model solved 5/110.',scope='PlanBench Blocksworld-hard, 6-15 blocks, trained on <=6 blocks, one training seed.',limitations=['Assisted system result; does not prove unaided standalone internalization.','No new reproduction, matched-compute superiority or frontier-model superiority established by this factory.'],sources=['BWM_REPORT','BUNDLE_REPORT','EVIDENCE_LEDGER']),
 dict(id='F02',status='record-confirmed in-distribution result',finding='RCWM PREREG-2 ledger decision regret 0.544 to 0.056; four-step exact state 0.029 to 0.698.',scope='150 fresh ledger parents; fixed unmerged T2 seed-0 adapter; same generator and marginals; chain_one horizon four.',limitations=['Fresh payloads are not an OOD rule-mastery claim.','Prerequisite copy shortcut persisted; register was not fixed.','Registered forgetting guard is limited and does not show general retained competence.'],sources=['RCWM_REPORT','RCWM_PREREG2','EVIDENCE_LEDGER']),
 dict(id='F03',status='record-confirmed failure boundary',finding='RCWM PREREG-3 returned TRIGGER: unseen no-op status strata achieved 0.01-0.18 versus trained void 0.99-1.00.',scope='Ledger in one frame; three T2 seeds; 1,500 one-step audit rows and 80 four-step chains described in the report.',limitations=['Not every possible status or causal rule was tested.','Rule-text inversion was explicitly excluded from this confirmation; it is proposed new data here, not an established PREREG-3 test result.','Arithmetic, renamed word accounts and key order also showed restricted generalization.'],sources=['RCWM_REPORT','RCWM_PREREG3','EVIDENCE_LEDGER']),
 dict(id='F04',status='record-confirmed failed promotion screen',finding='L8-15 failed C2 prerequisite acquisition: 96/128 to 88/128; verdict DO NOT PROMOTE.',scope='PREREG-L1 promotion screen; localization had reduced some activation drift.',limitations=['Reduced drift does not prove preservation of exact numeric output, acquisition or deployability.','The earlier localization mechanism finding is exploratory and cannot override the failed screen.'],sources=['RCWM_REPORT','RCWM_DECISIONS','EVIDENCE_LEDGER']),
 dict(id='F05',status='exploratory surface audit',finding='BWM surface audit: canonical accuracy 1.000; reversed JSON keys 0.458; unseen block names 0.992 and shuffled fact lists 1.000.',scope='120 generated keys at 5 and 10 blocks, reported in joint R16.',limitations=['A separate diagnostic; does not invalidate the canonical frozen 73/110 result.','Size, name and serialization invariance are distinct axes.'],sources=['RCWM_DECISIONS','BUNDLE_REPORT','EVIDENCE_LEDGER']),
 dict(id='F06',status='documented design defect and correction',finding='Per-row trace-matched filler length leaked wrap/branch labels; D-36 amendment 4b fixes filler length per public family/domain and action kind.',scope='T2b and BWM trace-control kits; preserve literal cmp/calc/after target ordering.',limitations=['This is a control-design correction, not a demonstrated new dataset learning benefit.','For this factory, choose any new filler policy from TRAIN only; do not copy a test-derived maximum.'],sources=['RCWM_DECISIONS','T2B_REGISTER','T2B_PREREQ','PROTOCOL']),
 dict(id='F07',status='frozen design; no efficacy claim',finding='D-36 retention no-go on corrected category loss, category net below -11, or pooled net below -4%, under both graders.',scope='Existing registered retention workflow; old -5/75 category rule is diagnostic.',limitations=['This factory does not open or recreate the protected retention instrument.','No detected loss is not proof of a <=2 percentage point noninferiority bound.'],sources=['RCWM_DECISIONS','PROTOCOL','EVIDENCE_LEDGER']),
 dict(id='F08',status='implementation-only, indirectly documented',finding='IDR role-specific routing infrastructure is documented as CPU-tested; native Rineya efficacy remains unqualified.',scope='Bundle repository-source entry R05, not a local ChatBubble code audit.',limitations=['RHF/triadic memory/CSS/RHD/recurrence are overlap candidates only; local executability is not established.'],sources=['REUSE','REPOSITORY_SOURCES','EVIDENCE_LEDGER']),
]

# These are curriculum proposals, not gold examples or observed data coverage.
design = {
'RCM-001': dict(objectives=['Execute the supplied predicate rather than lexical priors.','Separate applicability, exact computation and unchanged fields.','Follow different meanings assigned to the same status/operator.'], mechanisms=['literal_status_mapping','rule_inversion','threshold_boundary','compound_precondition','same_answer_different_predicate','applicable_identity_vs_inapplicable_noop','multi_step_dependency'], oracle='Independent AST predicate interpreter plus separately implemented arithmetic/state executor; integer arithmetic, complete state comparison and untouched-field invariants.', rubric=['Does an explicit rule uniquely define exact string matching, case handling and precedence?','Can the reviewer recompute applicability without seeing the generator expectation?','Do counterfactual twins change only the declared intervention and retain a shared family key?','Is applicable identity distinguished from inapplicable no-op and illegal action?','Are equality, negative numbers and unfamiliar vocabulary included without answer hints?'], levels=['One literal applicability rule and one state update.','Same rule with novel names, numbers and input order; structural difficulty remains one step.','Two predicates or strict/equality threshold exceptions evaluated jointly.','Two to eight events where later applicability or arithmetic depends on an earlier result.','Compose a new rule selection, precondition and arithmetic procedure from separately taught primitives.','Matched token-trigger, false-copy and rule-reversal traps with no prompt/target leakage.','Development challenge holds out predicate trees, magnitude ranges and renderer combinations.'], axes=['predicate_depth','condition_count','horizon','arithmetic_magnitude','rule_mapping_count'], expansion='Balance apply/no-op at parent strata, cover exact threshold at -1/0/+1, and add composed predicates before increasing paraphrases.', deferred='Hidden-causal discovery and arbitrary natural-language rule parsing require additional semantics and validation.'),
'RGM-001': dict(objectives=['Represent typed relations independent of entity names or serialization.','Check legal actions and exact state deltas.','Construct and repair goal-reaching plans under explicit dynamics.'], mechanisms=['typed_graph_delta','precondition_legality','constraint_invariant','goal_path','invalid_plan_first_error','minimal_plan_repair','resource_dependency'], oracle='Independent relation-set simulator plus graph invariants and bounded BFS/Dijkstra where optimality is claimed; replay every action and assert final goals.', rubric=['Is the graph initially valid and are relation arities/types explicit?','Does each action satisfy preconditions at its actual position in the trajectory?','Are untouched relations preserved and mutual exclusions respected?','Is feasibility checked separately from shortest-path optimality?','Do entity renamings give isomorphic states and plans, including distractor objects?'], levels=['One edge/object relation update.','Entity-permuted isomorphic state and shuffled fact/key order.','Multiple relational preconditions or resource constraints.','A genuine multi-action path with dependent intermediate states.','Combine resource transfer, dependency release and relational movement.','A plausible plan with a subtle precondition violation plus a bounded verified repair.','Held-out graph motifs/object-count range crossed with a held-out renderer.'], axes=['object_count','edge_count','dependency_depth','branching_factor','shortest_goal_distance','resource_count'], expansion='Increase graph motifs and optimal goal distance after exact transition coverage; size alone does not ensure structural diversity.', deferred='Large logistics/constraint search and minimum repairs need bounded exact solvers; record timeout as unknown, never unsolvable.'),
'RVM-001': dict(objectives=['Label transition validity, goal progress and utility separately.','Locate the first objectively invalid step.','Rank candidate plans using explicit goal and cost assumptions.'], mechanisms=['transition_validity','first_error_location','goal_progress','minimal_repair','cost_preference','goal_weight_change','near_miss_arithmetic'], oracle='Independently recompute candidate trajectories and exact objective values; derive a partial order or tie when candidates cannot be uniquely ranked.', rubric=['Does every validity label follow exact dynamics?','Are progress and usefulness defined by visible goal/cost, rather than verbosity?','Are chosen/rejected directions correct and ties retained explicitly?','Can error-producer identity, answer length or explanation style predict preference?','Is the first invalid step separated from downstream consequences?'], levels=['One correct/incorrect state update.','Matched correct and incorrect candidates with equal format/length.','Validity and progress disagree under a conditional goal.','Identify first error in a two-to-eight-step trajectory.','Rank plans across multiple verified constraints and explicit costs.','A fluent/short/verbose near miss with matched correctness controls.','Held-out corruption producers, goal functions and mechanism combinations.'], axes=['trajectory_length','candidate_count','error_position','constraint_count','goal_terms'], expansion='Add ties, valid-but-unhelpful and invalid-but-apparently-progressing cases before expanding preference exports.', deferred='A generic value model or successor-feature guarantee cannot be inferred from local objective labels; fixed-dynamics assumptions must be stated.'),
'RSM-001': dict(objectives=['Execute procedures with initiation, arguments and termination.','Compose subgoals in different orders and under conditions.','Recover after interruption without replaying completed effects.'], mechanisms=['option_contract','argument_binding','conditional_subgoal','AB_BA_composition','interruption_resume','procedure_reuse','termination_check'], oracle='Procedure interpreter plus primitive state simulator; verify initiation and termination, replay trace and final behavior; exact shortest path only where affordable.', rubric=['Are option boundaries functional and explicit rather than arbitrary text chunks?','Does more than one primitive mechanism affect the answer?','Do argument bindings and stop conditions remain correct after interruption?','Are unseen compositions held out at mechanism-template level?','Are multiple legal implementations accepted under the same behavioral criteria?'], levels=['Single primitive procedure.','Same procedure with new arguments and renamed resources.','Conditional initiation or termination requiring multiple predicates.','Dependent subgoals executed in a sequence.','Novel AB/BA/conditional composition from separately taught procedures.','Interruption, redundant action and stale-subgoal traps.','Longer horizons and unseen composition DAGs in development challenges.'], axes=['primitive_count','subgoal_count','composition_depth','horizon','interruptions'], expansion='Add next-action, full-plan and recovery targets with shared lineage; count each underlying procedure family separately.', deferred='No student-state aggregation is performed without authorized model execution; simulated off-path states are synthetic curriculum only.'),
'RMM-001': dict(objectives=['Select an operation-appropriate competent skill from explicit qualifications.','Abstain when no supplied skill supports the rule.','Track old and new skill requirements without role mixing.'], mechanisms=['operation_specific_selection','competence_mask','abstention','skill_sequence_replay','few_shot_rule_induction','role_separation'], oracle='Finite competence registry and explicit routing/cost constraints; rule induction accepted only when support uniquely identifies query behavior.', rubric=['Are competence statements visible evidence rather than claimed empirical model performance?','Does routing match the requested operation, not just domain tokens?','Can no expert solve the task, and is abstention the correct answer then?','Is claimed few-shot rule induction identifiable from support examples?','Are retention records synthetic task obligations rather than measured model retention?'], levels=['Select one visibly qualified skill for one operation.','Rename skill IDs and reorder registry entries.','Combine competence, cost and applicability constraints.','Route a sequence while preserving prior obligations.','Compose predictor/proposer/critic procedures with distinct roles.','Conflicting qualifications, attractive incompetent expert and unsupported-rule traps.','Held-out qualification patterns, task mixtures and rule families.'], axes=['expert_count','operation_count','constraint_count','sequence_length','support_examples'], expansion='Provide synthetic routing and support/query episodes first; defer learning-curve or retention claims to separate model studies.', deferred='True forgetting, learned router drift and adaptation efficacy cannot be measured by dataset construction.'),
'REM-001': dict(objectives=['Retrieve decisive evidence with event time and provenance.','Apply correction/supersession without stale-fact errors.','Ignore irrelevant memory and abstain on unresolved conflict.'], mechanisms=['relevant_retrieval','timestamp_update','supersession','source_authority','unresolved_conflict','delayed_dependency','procedure_memory'], oracle='Timestamped event ledger with explicit authority/supersession policy; independent query resolver outputs evidence IDs and answer/unknown.', rubric=['Does the correct answer require retrieval rather than being repeated in the query?','Are event time and statement time distinguished?','Is source authority or supersession policy explicit for conflicts?','Are supporting facts available before the query, with no future evidence?','Can the reader identify evidence and uncertainty without memorizing names?'], levels=['Retrieve one visible historical fact.','Rename entities and paraphrase queries with equal evidence.','Resolve one explicit update or authority-conditioned conflict.','Combine separated records and delayed dependencies.','Retrieve a stored procedure and execute it using current corrected facts.','Stale summaries, recent distractors and unsupported confidence traps.','Held-out update patterns, longer histories and changed procedure combinations.'], axes=['history_length','relevant_record_count','distractor_count','update_depth','time_gap'], expansion='Increase genuine corrections and unresolved conflicts; vary chronology independently of answer labels and keep provenance in evidence targets.', deferred='Storage compression, learned write policies and dense fact consolidation are model/system hypotheses, not demonstrated memory gains.'),
'RBM-001': dict(objectives=['Update a belief set from permitted observations.','Distinguish known, unknown and conflicting information.','Choose inspection/abstention when it has explicit expected utility.'], mechanisms=['partial_observation','set_belief_update','bayesian_update','information_action','contradictory_evidence','observation_delay'], oracle='Enumerate finite hidden states using exact rational probabilities where stated; independent observation-consistency filter and explicit observation-cost model.', rubric=['Is latent truth excluded from the student-visible lane?','Are likelihood/prior assumptions stated when a numeric posterior is required?','Does ambiguity remain when observations are insufficient?','Are inspection value and cost defined, including tie/abstain behavior?','Are contradictory signals governed by a noise/authority rule?'], levels=['Identify one unknown field from an incomplete observation.','Equivalent observation encodings and renamed hidden states.','Update multiple constraints or one explicit noisy observation.','Accumulate evidence over several observation/action steps.','Combine memory retrieval, belief update and information gathering.','Confident shared-shortcut and misleading-observation traps.','Held-out noise/delay regimes and hidden-state structures.'], axes=['hidden_state_count','observation_count','belief_support_size','history_length','inspection_cost'], expansion='Begin finite deterministic belief sets; add rational Bayes only after enumeration parity, then utility of inspect versus answer.', deferred='Calibration and learned introspective confidence require model predictions; oracle beliefs are a privileged ceiling.'),
'RJP-001': dict(objectives=['Identify decision-relevant invariant features without erasing exact bits.','Predict masked structured features under declared transitions.','Distinguish valid and near-miss candidate states.'], mechanisms=['lossless_abstraction','masked_feature_prediction','object_mask','invariance_pair','energy_candidate_labels','decision_critical_bit'], oracle='Exact structured feature projection, decoder round-trip checks and transition verifier; define abstraction equivalence relative to declared goal/action set.', rubric=['Is the abstraction sufficient for the stated decisions?','Are exact equality, parity and arithmetic boundary bits preserved?','Do positive pairs differ only in declared nuisance features?','Are negative candidates invalid by independent execution?','Are embeddings/energy/probability claims excluded from synthetic symbolic labels?'], levels=['Recover one masked feature from explicit rules.','Recognize equivalent states under nuisance renaming.','Condition feature prediction on multiple predicates.','Track projected features through dependent transitions.','Combine relational and arithmetic invariants without information loss.','Smooth-looking abstraction drops one decisive bit.','Held-out feature dependencies, object counts and rule combinations.'], axes=['feature_count','mask_count','dependency_depth','horizon','equivalence_class_size'], expansion='Produce structured contrastive and round-trip tasks; prioritize exact-bit negatives over large quantities of easy equivalences.', deferred='Synthetic feature tasks are not trained JEPA/latent dynamics; latent efficiency and anti-collapse require later model experiments.'),
'RDP-001': dict(objectives=['Identify and repair bounded candidate errors.','Preserve valid candidate prefixes and avoid introducing new violations.','Distinguish semantic solution diversity from surface variation.'], mechanisms=['first_fault_repair','bounded_edit','prefix_preservation','iterative_revision','multi_candidate_selection','repair_tie'], oracle='Replay candidate against independent simulator; bounded edit enumeration/BFS defines repair feasibility and minimality only within declared cost/bound.', rubric=['Does the original candidate actually contain the alleged defect?','Is each corrected plan executable and goal-reaching?','Is minimality proved within a visible edit metric/bound?','Are alternative equally good repairs accepted?','Does an extra revision create a regression or only reword the same plan?'], levels=['Repair one corrupted arithmetic/transition step.','Repair renamed equivalent candidates.','Repair a failed precondition with explicit constraints.','Repair the earliest failure and dependent suffix of a plan.','Repair plans composed of several reusable procedures.','Tempting local fix that breaks later constraints.','Held-out fault combinations, horizons and graph motifs.'], axes=['edit_distance','fault_count','suffix_dependency_depth','candidate_count','plan_length'], expansion='Add shared-start-candidate repair comparisons, ties and unrepairable-within-bound labels before masked revision tasks.', deferred='A verified revision dataset is not a diffusion model; denoising speed, diversity and learning benefit remain unmeasured.'),
'ROM-001': dict(objectives=['Maintain separate agent observations, beliefs and goals.','Predict actions from agent-accessible information.','Track explicit promises/relationship state while separating style from factual behavior.'], mechanisms=['false_belief','observation_access','belief_correction','promise_state','goal_conflict','cooperation'], oracle='Finite fictional event/observation simulator and explicit decision policies; use set-valued targets for underdetermined human-like behavior.', rubric=['Are world truth and each agent belief stored separately?','Does the action require only information this agent observed or retrieved?','Are inferred intentions uniquely determined by an explicit policy or allowed as a set?','Are promises/corrections temporally consistent?','Are style, instruction compliance and factual consistency evaluated separately?'], levels=['One agent knows or misses one event.','Identity renaming and equivalent observation wording.','Policy conditions depend on belief and promise/goal state.','Several events with delayed corrections and action consequences.','Cooperation among agents with different observations and goals.','Omniscient-information leakage and flattering but false style traps.','Held-out event combinations, partner policies and identities.'], axes=['agent_count','event_count','belief_depth','goal_count','observation_asymmetry'], expansion='Start original fictional agents and exact structured actions; add language realization after belief decisions pass independent review.', deferred='General human social understanding and subjective style quality are not exact-oracle claims; ambiguous behavior must be quarantined or set-valued.'),
}

tracks=json.loads((ROOT/BUNDLE/'04_experiments/tracks.json').read_text())
registry=json.loads((ROOT/BUNDLE/'04_experiments/experiment_registry.json').read_text())
predictions=json.loads((ROOT/BUNDLE/'04_experiments/predictions.json').read_text())
resources=json.loads((ROOT/BUNDLE/'03_resources/resources.json').read_text())
order=['RCM-001','RGM-001','RVM-001','RSM-001','REM-001','RMM-001','RBM-001','RJP-001','RDP-001','ROM-001']
track_map={t['id']:t for t in tracks}
levels=[dict(level=i+1,name=n,definition=d) for i,(n,d) in enumerate([
 ('Basic competence','One unambiguous semantic mechanism.'),
 ('Controlled generalization','Surface/numerical variants without increased dependency structure.'),
 ('Conditional reasoning','Multiple conditions, preconditions or exceptions.'),
 ('Multi-step reasoning','Later operations depend on earlier results; independent repetitions do not qualify.'),
 ('Compositional transfer','At least two independently defined mechanisms interact; novel compositions are held out by template.'),
 ('Adversarial robustness','Explicit shortcut/near-miss challenge axis, recorded alongside base structural level.'),
 ('OOD development challenge','Partition-relative unseen range, motif, rule or combined shift; recorded alongside base structural level.')])]
blueprint_tracks=[]
for tid in order:
 t=track_map[tid]; d=design[tid]
 pilot=30 if tid in ['RCM-001','RGM-001','RVM-001'] else 12
 exp=200 if tid in ['RCM-001','RGM-001','RVM-001'] else None
 bt=dict(track_id=tid,name=t['name'],bundle_priority=t['priority'],factory_sequence_priority='P0-A' if tid=='RCM-001' else 'P0-B' if tid=='RGM-001' else 'P0-C' if tid=='RVM-001' else t['priority'],specification_status='proposed; generation and independent approval owned by other roles',learning_objectives=d['objectives'],semantic_mechanisms=d['mechanisms'],oracle_contract=d['oracle'],specialized_rubric=d['rubric'],difficulty_levels=[dict(level=i+1,task_structure=x) for i,x in enumerate(d['levels'])],complexity_dimensions=d['axes'],coverage_goals=dict(initial_independent_parent_target=pilot,accepted_parent_expansion_target=exp,expansion_range=[150,250] if exp else None,minimum_mechanisms=len(d['mechanisms']),minimum_parents_per_mechanism=3,maximum_surface_variants_per_parent_initial=4,level_distribution_policy='Report observed level counts; do not force unavailable levels or relabel one-step samples as composition.',proposed_expansion_level_mix={'1':0.10,'2':0.15,'3':0.25,'4':0.30,'5':0.20},challenge_axis_policy='Within every supported base level, target >=25% changed-rule/near-miss/shortcut controls where applicable; hold OOD challenges outside TRAIN.'),expansion_recommendation=d['expansion'],limits=d['deferred'],bundle_reuse=t['reuse'],required_future_model_controls=t['controls'],future_metrics=t['metrics'],experiments=[dict(id=e['id'],name=e['name'],dependency=e['dependencies'],endpoint=e['primary_endpoint_draft'],status='planned in bundle; not executed by dataset architect') for e in registry if e['track']==tid],resource_ids=t['resources'],source_ids=[f'CARD_{tid}','TRACKS','REGISTRY','PREDICTIONS','RESOURCES','PROTOCOL','CONTRACTS','REUSE'],data_benefit_status='hypothesis; no model training or effectiveness evaluation performed')
 blueprint_tracks.append(bt)

gaps=[
 dict(id='G01',priority='P0',gap='Rule semantics versus familiar token triggers',evidence=['F03'],tracks=['RCM-001','RVM-001'],recommendation='Use opposite supplied mappings, nonce labels and paired counterfactual rules; hold out whole predicate compositions.',verification='Exact applicability/state labels and stripped-rule token probes; same status must support both outcomes under different rules.'),
 dict(id='G02',priority='P0',gap='Serialization and structural generalization are distinct',evidence=['F01','F05'],tracks=['RGM-001','RCM-001'],recommendation='Add input field/list permutations, names and held-out graph motifs; cross size with surface shifts.',verification='Isomorphism/metamorphic replay, renderer read-back and parent-level held-out grids.'),
 dict(id='G03',priority='P0',gap='Copy/no-op heuristics can mask failed conditional execution',evidence=['F02','F03'],tracks=['RCM-001','RGM-001','RVM-001'],recommendation='Separate applicable change, applicable identity, inapplicable no-op and illegal precondition failures.',verification='Report false-copy/false-apply separately; compare copy and ignore-condition floors per mechanism.'),
 dict(id='G04',priority='P0',gap='Boundary arithmetic and exact output fidelity',evidence=['F03','F04'],tracks=['RCM-001','RVM-001','RJP-001'],recommendation='Cover threshold equality and near-miss numerical errors; include carry/modulo/delete semantics only when independently implemented.',verification='Independent integer arithmetic and invariants; inspect first-error position and untouched fields.'),
 dict(id='G05',priority='P0',gap='Hybrid planning success does not establish unaided reusable procedures',evidence=['F01'],tracks=['RSM-001','RGM-001'],recommendation='Create next-action/full-plan demonstrations on fresh worlds and held-out AB/BA/conditional compositions.',verification='Exact replay and behavior criteria; future A/B/C/D plus matched SFT controls required for internalization claim.'),
 dict(id='G06',priority='P1',gap='Acquisition and retention can trade off despite smaller drift',evidence=['F04','F07'],tracks=['RMM-001','RSM-001'],recommendation='Provide replay/skill obligations and operation-specific competence masks; preserve source retention custody.',verification='Dataset coverage only now; later model acquisition/retention matrix with prospective powered margins.'),
 dict(id='G07',priority='P0',gap='Trace controls can encode outcomes through filler length',evidence=['F06'],tracks=['RCM-001','RVM-001'],recommendation='Keep target cmp/calc/after stable; freeze filler by TRAIN/public family/action kind and keep student metadata free of gold.',verification='Identical filler within public strata; majority-baseline/MI probe; input read-back and no label fields.'),
 dict(id='G08',priority='P1',gap='Memory retrieval, correction and belief evidence lack demonstrated dataset coverage',evidence=[],tracks=['REM-001','RBM-001'],recommendation='Generate timestamped corrections, unresolved conflicts, delayed observations and exact finite belief sets.',verification='Independent provenance/query resolver and observation-consistency enumeration.'),
 dict(id='G09',priority='P2',gap='Latent, revision and social tasks need sharply scoped exact semantics',evidence=[],tracks=['RJP-001','RDP-001','ROM-001'],recommendation='Use lossless abstractions, bounded edit repair and explicit fictional observation/policy semantics.',verification='Round-trip exactness, minimum-edit certificates and agent-specific information custody; no unsupported architecture benefit claims.'),
 dict(id='G10',priority='all',gap='Dataset quality is separate from learning effectiveness and broad intelligence',evidence=['F01','F02','F08'],tracks=order,recommendation='Report semantic-parent coverage and actual review receipts; do not convert synthetic tests or proposed gains into native efficacy.',verification='Release quality gates now; separate authorized training and independent sealed evaluation in the future.'),
]

now=datetime.now(timezone.utc).isoformat()
blueprint=dict(schema_version='1.0.0',created_at_utc=now,role='independent Dataset Research Architect',actor='/root/research_architect',scientific_status='research specifications, no sample generation or approval',workspace_relative_reference_root='..',evidence_hash_policy='sha256 of local source bytes; hashes certify identity, not correctness; bundle pinned commit is historical metadata, not a claim that current checkout matches it',historical_bundle_commit='a223884d55ff47baf3890c7d4a82054d07223215',sources=sources,findings=evidence,common_difficulty_levels=levels,complexity_policy='Keep structural level and robustness/OOD axes separate. Renaming, input order, unfamiliar tokens or prompt length alone never justify Levels 3-5.',split_policy=dict(assign_before_rendering=True,group_keys=['semantic_parent_id','semantic_family_id','counterfactual_group_id','template_family'],partitions=['TRAIN','DEV','DEVELOPMENT_CHALLENGE'],sealed_test_policy='No sealed test created or inspected by dataset-producing roles; separate custody required.',challenge_axes=['surface','numeric','semantic_rule','structural_motif','temporal_horizon','goal','domain','combined_shift'],known_benchmark_policy='Frozen Rineya evaluations and existing PlanBench-hard instruments stay historical, never training/development input.'),common_rubric=['Input completeness and clarity','Unambiguous requested behavior or explicit valid-answer set','Independent executable target agreement','Semantic coherence and initial-state validity','Intended competency genuinely required','No gold or outcome encoded in student metadata','Family-level lineage and partition integrity','Rights/provenance documented','No unresolved correctness or adversarial defect'],acceptance_policy='Architect does not accept samples. Release acceptance requires actual independent oracle, blind expert, adversarial and adjudication receipts; incomplete or ambiguous labels stay provisional/quarantined.',assistance_claim_policy='Data quality is not learning efficacy. Later A/B/C/D arms and matched SFT distinguish assistance from internalization; no training is authorized or executed by this role.',tracks=blueprint_tracks,gaps=gaps,resource_policy='Local catalog annotations only; no external papers were opened or verified anew and no code/data/weights imported. Links do not clear licenses.',expansion_policy='P0 30-parent pilots first, then 150-250 accepted parents each only after exact validation and independent review. Other tracks begin small verifiable pilots; expand by missing mechanism, not count.',production_metrics_required=['candidate_parents','accepted_parents','renderings_per_parent','review_disagreements','oracle_failures','quarantine_count','mechanism_counts','base_level_counts','challenge_axis_counts','split_lineage','exact_and_structural_duplicates','label_balance','shortcut_probe_results','generation_cost','remote_backup_status'])

FACTORY.mkdir(exist_ok=True)
for d in ['research/evidence_inventory','research/curricula','research/research_gap_analysis']:(FACTORY/d).mkdir(parents=True,exist_ok=True)
(FACTORY/'DATASET_BLUEPRINT.json').write_text(json.dumps(blueprint,indent=2,ensure_ascii=False)+'\n')
(FACTORY/'research/evidence_inventory/source_inventory.json').write_text(json.dumps(dict(schema_version='1.0.0',source_root='workspace',sources=sources,findings=evidence),indent=2)+'\n')
(FACTORY/'research/evidence_inventory/SHA256SUMS.sources.txt').write_text(''.join(x['sha256']+'  '+x['path']+'\n' for x in sources))

lines=['# Dataset curriculum v1','', 'Status: proposed dataset specification. This architect generated no examples and approved no samples. Counts are targets; actual coverage belongs in the production reports. No training or new efficacy experiment was run.','', 'The first sequence is RCM-001, RGM-001 and RVM-001. RSM is next on the bundle P0 path; memory, routing and beliefs can begin small exact pilots after shared review works. Latent, revision and social tracks remain bounded by verification.','', '## Research evidence and its limits','']
for e in evidence:
 lines += [f"- **{e['id']} — {e['status']}.** {e['finding']} {e['scope']} {' '.join(e['limitations'])} Sources: "+', '.join(e['sources'])+'.']
lines += ['', 'Full exact relative source paths and byte hashes are in `research/evidence_inventory/source_inventory.json` and the source table below. Findings are record-confirmed where specified, not independently reproduced by this factory.','', '## Difficulty and coverage discipline','']
for l in levels:lines += [f"- **Level {l['level']} — {l['name']}:** {l['definition']}"]
lines += ['', 'Store structural complexity (conditions, dependencies, graph size, horizon and composition depth) separately from adversarial and partition-relative OOD tags. A one-step renamed task remains Level 2; a conjunction may be Level 3; calling an ordinary task “hard” does not make it compositional. Levels 6 and 7 also record the underlying Level 1-5 structure. Longer prompts alone are never a difficulty measure.','', 'Start with approximately 30 independent parents per P0-A/B/C track, at least three parents per supported mechanism and at most four initial renderings per parent. For a 150-250-parent expansion, a proposed Level 1-5 mix is 10/15/25/30/20%, but unsupported levels must remain zero and documented gaps. Counterfactual twins, trajectory variants and paraphrases share family custody; their renderings do not inflate independent concept counts.','', 'Target both sides of applicability and changes at parent strata. Where possible include at least 25% declared counterfactual, near-miss or shortcut controls. A proposed quota is not a claim of achieved balance. Challenge partitions must hold out actual mechanisms/templates or combined shifts, not merely random seeds. No dataset producer creates or opens a final sealed test.','', '## Common review gate','']
for x in blueprint['common_rubric']:lines += ['- '+x+'.']
lines += ['', 'The formal oracle, blind expert, adversarial reviewer and adjudicator must execute separately. A correct deterministic generator cannot approve itself. Multiple valid answers require an explicit equivalence/set-based validator; unresolved uncertainty is quarantined.','']
for bt in blueprint_tracks:
 tid=bt['track_id'];d=design[tid]
 card=[f"## {tid} — {bt['name']}",'',f"Bundle priority {bt['bundle_priority']}; factory priority {bt['factory_sequence_priority']}. Proposed initial target: {bt['coverage_goals']['initial_independent_parent_target']} parents.",'','Learning objectives: '+ ' '.join(d['objectives']),'','Semantic mechanisms: '+', '.join(d['mechanisms'])+'.','','Oracle: '+d['oracle'],'','Specialized rubric:','']
 card += ['- '+x for x in d['rubric']]
 card += ['', 'Curriculum:','']
 card += [f"- Level {i+1}: {x}" for i,x in enumerate(d['levels'])]
 card += ['', 'Measure complexity with: '+', '.join(d['axes'])+'.','', 'Expand by: '+d['expansion'],'','Scope limitation: '+d['deferred'],'','Reuse: '+bt['bundle_reuse'],'', 'Linked proposed experiments: '+', '.join(e['id'] for e in bt['experiments'])+'. Resource anchors: '+', '.join(bt['resource_ids'])+'.', '', f"Sources: CARD_{tid}, TRACKS, REGISTRY, PREDICTIONS, RESOURCES, PROTOCOL, CONTRACTS, REUSE. Benefits remain hypotheses.", '']
 lines += card
 (FACTORY/f'research/curricula/{tid}.md').write_text('\n'.join(card).replace('## ', '# ',1)+'\n')
lines += ['## Source identity table','', '| Source | Workspace-relative path | SHA-256 |','|---|---|---|']
lines += [f"| {x['source_id']} | `{x['path']}` | `{x['sha256']}` |" for x in sources]
(FACTORY/'CURRICULUM.md').write_text('\n'.join(lines)+'\n')

gap_lines=['# Research gaps v1','', 'These are evidence-grounded dataset-design gaps and proposals. They do not assert that any new data has improved Rineya. This architect did not inspect protected datasets, sealed instruments, model artifacts or raw generations.','']
for g in gaps:
 gap_lines += [f"## {g['id']} — {g['gap']}",'',f"Priority {g['priority']}; tracks: {', '.join(g['tracks'])}.",'',f"Evidence: {', '.join(g['evidence']) or 'Proposed track need; no confirmed local efficacy evidence'}.",'',g['recommendation'],'','Verification: '+g['verification'],'']
gap_lines += ['## Expansion decisions','', 'Expand the three initial tracks toward 150-250 accepted independent parents only after the entire pipeline passes actual review. Add missing semantic mechanisms before more surface variants. Prefer multi-step dependency and compositional templates after one-step conditional labels are reliable. Maintain worst-stratum, label and difficulty coverage alongside total volume.','', 'RSM should add true procedure composition and recovery. REM/RBM require independent time/conflict/observation semantics. RMM may produce exact routing episodes, but dataset creation cannot establish retention. RJP/RDP/ROM should begin with lossless abstractions, bounded repair and explicit fictional policies; broader architecture/social claims remain unmeasured.','', 'The 35 registry experiments and 13 bundle predictions are planned, unmeasured source records. GPU caps and model advancement thresholds in them are future study designs; this CPU dataset role executes none of those studies. Source claims and exact SHA-256 references are in `DATASET_BLUEPRINT.json` and `research/evidence_inventory/source_inventory.json`.','', '## Existing-work overlap','', 'RCWM T2b and joint cmp/calc/after kits, BWM planner/search-distillation interfaces and surface-audit controls are directly documented local reuse points. Preserve the registered T2 unmerged FP32 artifact and all frozen benchmark histories. IDR is implementation-only in the bundle; RHF/triadic memory/CSS/RHD/recurrence are candidates requiring an exact branch/interface audit before reuse. No existing protected dataset bytes are reused by this specification.','']
(FACTORY/'RESEARCH_GAPS.md').write_text('\n'.join(gap_lines)+'\n')
(FACTORY/'research/research_gap_analysis/gaps.json').write_text(json.dumps(gaps,indent=2)+'\n')

execution=dict(schema_version='1.0.0',actor='/root/research_architect',parent='/root',role='Dataset Research Architect',execution_type='actual independently spawned subagent',completed_at_utc=now,independence_scope='Independent curriculum/evidence specification; not a sample generator, reviewer or adjudicator.',actions=['Read explicitly supplied directive and allowed local report/protocol/reference files.','Checked ancestor AGENTS.md locations and nested AGENTS.md names in the two references and factory; none were found.','Read all ten track cards, registry/prediction/resource catalog and common protocols.','Read repository reports and selected decision/design/preregistration text.','Recorded exact relative paths and SHA-256 of permitted sources.','Wrote research specifications, curricula and evidence inventory only.'],not_performed=['sample generation','sample acceptance','model loading/training','sealed or historical test data opening','raw generation or model artifact reading','reference-directory mutation','external paper verification','remote branch audit'],read_scope_warning='Some large report/protocol reads were output-truncated; claims rely on separately read relevant sections and full ten track cards/catalog digests, not a claim of reading all 740 report lines.',outputs=['CURRICULUM.md','RESEARCH_GAPS.md','DATASET_BLUEPRINT.json','research/evidence_inventory/source_inventory.json','research/evidence_inventory/SHA256SUMS.sources.txt','research/curricula/*.md','research/research_gap_analysis/gaps.json'],references_read_only=True)
(FACTORY/'research/ARCHITECT_EXECUTION.json').write_text(json.dumps(execution,indent=2)+'\n')
print(json.dumps({'tracks':len(blueprint_tracks),'sources':len(sources),'findings':len(evidence),'gaps':len(gaps),'artifact_status':'specifications only; no samples generated or approved'},indent=2))
