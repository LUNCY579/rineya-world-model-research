"""New public-only V2 hand fixtures; author /root/formal_oracle.
No producer/candidate/gold/private review reads. Shares own frozen V1 fixtures.
"""
from copy import deepcopy
from itertools import product
import json
import unittest
from unittest.mock import patch
from oracles import rgm_planning_controls_v2_independent as oracle
from oracles import rgm_planning_controls_independent as v1
import oracle_rgm_planning_controls_test as old

COUNTS={'hand_families':0,'guard_transition_cases':0,'mutant_transition_cases':0,
        'clearance_mutations':0,'metadata_mutations':0,'small_world_goal_pairs':0,'typed_malformed_cases':0}


def _manifest(families):
    return {'version':oracle.VERSION,'track_id':'RGM-001','batch_name':oracle.BATCH,
        'semantics_sha256':oracle.SPECIFICATIONS['schemas/SEMANTICS.md'],'revision_of_batch':'planning-gap-v1',
        'parent_input_view_sha256':oracle.PARENT_SHA256,
        'public_specification_bindings':[{'path':p,'sha256':s} for p,s in sorted(oracle.SPECIFICATIONS.items())],
        'families':families}


def family(index):
    stratum='ABCD'[(index-180)//12]; tasks=old.family_tasks(stratum)
    size=oracle.A_SIZES[index-180] if stratum=='A' else 5+(index-192)%3 if stratum=='B' else 5+index%2
    if stratum=='A' and index%2==0:
        tasks[0]=old.graph([['a','b',1],['b','g',1],['a','c',1],['c','d',1],['d','g',1]],2)
        tasks[1]=deepcopy(tasks[0]); tasks[1]['fuel']=1
        tasks[2]=deepcopy(tasks[0]); tasks[2]['plan']=['b']
        tasks[3]=deepcopy(tasks[0]); tasks[3]['plan']=['b','a']
    for task in tasks:
        if task['kind']=='graph': task['nodes'] += ['unused'+str(i) for i in range(size-5)]
        elif size==6: task['on']['f']='TABLE'
    if stratum=='C':
        swap=1 if index in oracle.DESTINATION_INDICES else 2
        tasks[1]=deepcopy(tasks[0]); tasks[1]['plan'][swap],tasks[1]['plan'][swap+1]=tasks[1]['plan'][swap+1],tasks[1]['plan'][swap]
        k=1+(index-204)%3; tasks[3]['plan']=deepcopy(tasks[0]['plan'][:k])
        tasks.append(deepcopy(tasks[3])); tasks[4]['plan'].append(old.action('a','TABLE'))
    contexts=[]; rows=[]; split='dev_challenge' if index%10 in (8,9) else 'train'; key='toy-family-'+str(index)
    for number,task in enumerate(tasks):
        context_id=stratum+str(number); ids=['toy-'+str(index)+'-'+context_id+'-'+str(i) for i in range(2)]
        props=[]; evidence={}
        if context_id=='C0':
            props=[oracle.CLEARANCE_PROPERTY]
            evidence[oracle.CLEARANCE_PROPERTY]={'action_index':2,'precondition':'source_not_clear','enabling_action_index':0,'obstructing_block':'a'}
        elif context_id=='C1':
            props=['legal_prefix_then_first_failure']
            evidence[props[0]]={'first_error_index':1 if index in oracle.DESTINATION_INDICES else 3}
        elif context_id=='C4':
            k=1+(index-204)%3; props=['legal_prefix_then_first_failure',oracle.NEW_PROPERTY]
            evidence[props[0]]={'first_error_index':k}
            evidence[oracle.NEW_PROPERTY]={'action_index':k,'block':'a','current_support':'TABLE'}
        contexts.append({'context_id':context_id,'sample_ids':ids,'row_properties':props,
            'row_witnesses':[{'sample_id':sid,'property':p,'scope':'row','evidence':deepcopy(evidence[p])} for sid in ids for p in props]})
        for i,sid in enumerate(ids):
            rendered=deepcopy(task) if i==0 else dict(reversed(list(deepcopy(task).items())))
            if i and task['kind']=='graph': rendered['nodes'].reverse(); rendered['edges'].reverse()
            rows.append({'sample_id':sid,'semantic_parent_id':'parent-'+str(index)+'-'+context_id,
                'semantic_family_id':'lineage-'+str(index),'track_id':'RGM-001','generator_version':oracle.GENERATOR,
                'split':split,'source_provenance':{'source_family_key':key,'source_family_index':index},
                'semantic_task':deepcopy(task),'skill_tags':list(props),
                'rendered_input':'Public block/graph contract. Task JSON:\n'+json.dumps(rendered),
                'verified_target':{'intentionally_unread':True}})
    definitions={'A':[('fuel_only_counterfactual',0,1,['fuel'])],
        'B':[('directed_edge_deletion_counterfactual',0,1,['edges']),('same_world_valid_goal_detour',0,3,['plan'])],
        'C':[('adjacent_action_order_counterfactual',0,1,['plan']),('same_world_valid_goal_detour',0,2,['plan']),
             ('isolated_noop_append_counterfactual',3,4,['plan'])],
        'D':[('partial_goal_extension_counterfactual',0,1,['goal_on']),('same_world_valid_goal_detour',2,3,['plan'])]}
    controls=[]
    for name,a,b,fields in definitions[stratum]:
        for style in range(2):
            control={'control_id':'same-evidence-id','name':name,'scope':'corpus_variant','provenance':'supplied_tasks',
                'sample_ids':[contexts[a]['sample_ids'][style],contexts[b]['sample_ids'][style]],'changed_task_fields':fields}
            if name=='adjacent_action_order_counterfactual':
                failure=1 if index in oracle.DESTINATION_INDICES else 3
                guards={k:True for k in oracle.GUARDS}; guards['destination_clear_or_table' if failure==1 else 'source_clear']=False
                control['evidence']={'swap_index':1 if failure==1 else 2,'first_failure_index':failure,
                    'first_failure_reason':'destination_not_clear' if failure==1 else 'source_not_clear','guard_truth':guards}
            elif name=='isolated_noop_append_counterfactual':
                control['evidence']={'prefix_length':1+(index-204)%3,'block':'a','current_support':'TABLE'}
            controls.append(control)
    return rows,_manifest([{'source_family_key':key,'source_index':index,'primary_stratum':stratum,'split':split,
        'base_sample_id':contexts[0]['sample_ids'][0],'contexts':contexts,'controls':controls}])


def step_formula(on,action,ignored=None):
    """Third representation: direct factual predicates plus dictionary update."""
    b,d=action['block'],action['to']; above={x for x in on.values() if x!='TABLE'}
    tests=[b in on,b not in above,d=='TABLE' or d in on,b!=d,d=='TABLE' or d not in above,b in on and on[b]!=d]
    remove={'source_clear_ignored':1,'destination_clear_ignored':4,'no_op_allowed':5}.get(ignored)
    legal=all(v for i,v in enumerate(tests) if i!=remove)
    result=deepcopy(on)
    if legal: result[b]=d
    return legal,result


class PlanningV2Tests(unittest.TestCase):
    def test_hand_source_and_destination_selectivity(self):
        for index,code,failure in [(204,'source_not_clear',3),(210,'destination_not_clear',1)]:
            rows,manifest=family(index); tasks=[rows[2*i]['semantic_task'] for i in range(5)]
            controls=manifest['families'][0]['controls']
            control=next(x for x in controls if x['name']=='adjacent_action_order_counterfactual')
            result,mutants=oracle._c1_control(control,tasks[0],tasks[1],[x['sample_id'] for x in rows])
            self.assertEqual(result['first_error_reason'],code); self.assertEqual(result['first_error'],failure)
            self.assertEqual(sum(not x for x in result['guard_truth'][failure].values()),1)
            selected='source_clear_ignored' if code=='source_not_clear' else 'destination_clear_ignored'
            self.assertTrue(mutants[selected]['output_differs']); self.assertTrue(mutants[selected]['mutant_transition_executed_at_first_failure'])
            self.assertEqual(mutants[selected]['first_differing_step'],failure)
            for task in tasks: self.assertEqual(oracle.solve(task),v1.solve(task))
            COUNTS['hand_families']+=1

    def test_isolated_table_noop_all_allocated_k(self):
        for index in (204,205,209):
            rows,manifest=family(index); tasks=[rows[2*i]['semantic_task'] for i in range(5)]
            control=next(x for x in manifest['families'][0]['controls'] if x['name']=='isolated_noop_append_counterfactual')
            result,mutants=oracle._c4_control(control,[tasks[0],tasks[3],tasks[4]],index)
            self.assertEqual(result['first_error'],1+(index-204)%3)
            self.assertTrue(result['properties'][oracle.NEW_PROPERTY])
            self.assertTrue(mutants['no_op_allowed']['mutant_valid'])
            self.assertTrue(mutants['no_op_allowed']['output_differs'])
            self.assertFalse(mutants['source_clear_ignored']['output_differs'])
            self.assertFalse(mutants['destination_clear_ignored']['output_differs'])
            self.assertEqual(result['target']['after'],oracle.solve(tasks[3])['after'])
            self.assertTrue(result['target']['steps'][-1]['after']==result['target']['steps'][-2]['after'])

    def test_canonical_witness_initial_precedence(self):
        rows,_=family(204); task=rows[0]['semantic_task']; result=oracle.analyze(task)
        witness={'action_index':2,'precondition':'source_not_clear','enabling_action_index':0,'obstructing_block':'a'}
        oracle._witness(witness,oracle.CLEARANCE_PROPERTY,task,result)
        # Both b and c start blocked. Source precedence is mandatory.
        wrong=dict(witness,precondition='destination_not_clear',enabling_action_index=1,obstructing_block='d')
        with self.assertRaises(oracle.OracleError): oracle._witness(wrong,oracle.CLEARANCE_PROPERTY,task,result)
        self.assertIn({'action_index':3,'precondition':'destination_not_clear','enabling_action_index':0,'obstructing_block':'a'},result['clearance'])

    def test_clearance_types_missing_fields_codes_and_wrong_actions(self):
        rows,_=family(204); task=rows[0]['semantic_task']; result=oracle.analyze(task)
        good={'action_index':2,'precondition':'source_not_clear','enabling_action_index':0,'obstructing_block':'a'}
        mutations=[]
        for key in good:
            bad=deepcopy(good); bad.pop(key); mutations.append(bad)
        for code in ('source','destination','blocked_source','blocked_destination',0,True,None,[],{}):
            mutations.append(dict(good,precondition=code))
        for key,value in [('action_index',True),('action_index',0),('action_index',4),('enabling_action_index',False),
                          ('enabling_action_index',1),('enabling_action_index',2),('obstructing_block','d'),('obstructing_block','missing')]:
            mutations.append(dict(good,**{key:value}))
        for bad in mutations:
            with self.assertRaises(oracle.OracleError): oracle._witness(bad,oracle.CLEARANCE_PROPERTY,task,result)
            COUNTS['clearance_mutations']+=1

    def test_clearance_must_remain_clear_after_enabling(self):
        task={'kind':'blocks','on':{'a':'b','b':'TABLE','c':'TABLE','d':'TABLE','e':'TABLE'},'goal_on':{},
              'plan':[old.action('a','TABLE'),old.action('a','b'),old.action('a','TABLE'),old.action('b','c')]}
        rr=oracle.analyze(task)
        valid={'action_index':3,'precondition':'source_not_clear','enabling_action_index':2,'obstructing_block':'a'}
        oracle._witness(valid,oracle.CLEARANCE_PROPERTY,task,rr)
        self.assertNotIn(dict(valid,enabling_action_index=0),rr['clearance'])
        with self.assertRaises(oracle.OracleError): oracle._witness(dict(valid,enabling_action_index=0),oracle.CLEARANCE_PROPERTY,task,rr)

    def test_illegal_prefix_cannot_supply_clearance_witness(self):
        rows,_=family(204); task=deepcopy(rows[0]['semantic_task']); task['plan'].insert(0,old.action('b','c'))
        rr=oracle.analyze(task); self.assertEqual(rr['clearance'],[])
        self.assertEqual(len(rr['target']['steps']),1)
        self.assertFalse(rr['properties'][oracle.CLEARANCE_PROPERTY])

    def test_compound_invalid_guard_vector_rejected(self):
        rows,manifest=family(204); task=deepcopy(rows[2]['semantic_task'])
        task['plan']=[old.action('b','b')]
        rr=oracle.analyze(task); guards=rr['guard_truth'][0]
        self.assertGreater(sum(not x for x in guards.values()),1)
        self.assertFalse(guards['source_clear']); self.assertFalse(guards['source_destination_distinct'])
        task={'kind':'blocks','on':{'a':'b','b':'TABLE','c':'TABLE','d':'TABLE','e':'TABLE'},'goal_on':{},'plan':[old.action('a','b')]}
        rr=oracle.analyze(task)
        self.assertEqual({k for k,v in rr['guard_truth'][0].items() if not v},{'destination_clear_or_table','changed_support'})
        self.assertFalse(rr['properties'][oracle.NEW_PROPERTY])
        # A C1 evidence vector cannot conceal a co-failure by a false boolean.
        rows,manifest=family(210); control=next(x for x in manifest['families'][0]['controls'] if x['name']=='adjacent_action_order_counterfactual')
        first=rows[0]['semantic_task']; second=deepcopy(rows[2]['semantic_task'])
        second['plan'][1]['to']='b'
        with self.assertRaises(oracle.OracleError): oracle._c1_control(control,first,second,[x['sample_id'] for x in rows])

    def test_mutants_have_no_compensating_post_transition_validator(self):
        task={'kind':'blocks','on':{'a':'b','b':'TABLE','c':'d','d':'TABLE','e':'TABLE'},'goal_on':{},'plan':[old.action('a','d')]}
        strict=oracle.replay(task); wrong=oracle.replay(task,'destination_clear_ignored')
        self.assertFalse(strict['valid']); self.assertTrue(wrong['valid'])
        self.assertEqual(wrong['after']['a'],wrong['after']['c'])
        # The deliberately invalid two-child state is retained, not repaired.
        task['plan'].append(old.action('c','TABLE'))
        self.assertTrue(oracle.replay(task,'destination_clear_ignored')['valid'])
        source={'kind':'blocks','on':{'a':'b','b':'TABLE','c':'TABLE','d':'TABLE','e':'TABLE'},'goal_on':{},'plan':[old.action('b','c')]}
        self.assertTrue(oracle.replay(source,'source_clear_ignored')['valid'])
        self.assertEqual(oracle.replay(source,'source_clear_ignored')['after']['b'],'c')

    def test_false_mutant_claim_and_restore_guard_closure_fail(self):
        rows,manifest=family(204); first,second=rows[0]['semantic_task'],rows[2]['semantic_task']
        control=deepcopy(next(x for x in manifest['families'][0]['controls'] if x['name']=='adjacent_action_order_counterfactual'))
        control['evidence']['mutant_trace_differs']=False
        with self.assertRaises(oracle.OracleError): oracle._c1_control(control,first,second,[x['sample_id'] for x in rows])
        control['evidence'].pop('mutant_trace_differs')
        actual=oracle.replay
        def closed(task,mutant='strict'): return actual(task,'strict')
        with patch.object(oracle,'replay',side_effect=closed):
            with self.assertRaises(oracle.OracleError): oracle._c1_control(control,first,second,[x['sample_id'] for x in rows])

    def test_guard_values_are_exact_bool_and_indices_exclude_bool(self):
        rows,manifest=family(210); first,second=rows[0]['semantic_task'],rows[2]['semantic_task']
        good=next(x for x in manifest['families'][0]['controls'] if x['name']=='adjacent_action_order_counterfactual')
        changes=[('swap_index',True),('first_failure_index',True),('first_failure_reason','destination'),('guard_truth',dict(good['evidence']['guard_truth'],source_exists=1))]
        for key,value in changes:
            bad=deepcopy(good); bad['evidence'][key]=value
            with self.assertRaises(oracle.OracleError): oracle._c1_control(bad,first,second,[x['sample_id'] for x in rows])
            COUNTS['typed_malformed_cases']+=1

    def test_exhaustive_guard_transitions_and_each_mutant(self):
        worlds=list(old.valid_worlds(['a','b','c']))
        for on in worlds:
            for b in ['a','b','c','missing']:
                for d in ['TABLE','a','b','c','missing']:
                    task={'kind':'blocks','on':on,'goal_on':{},'plan':[old.action(b,d)]}
                    legal,expected=step_formula(on,task['plan'][0])
                    strict=oracle.replay(task)
                    self.assertEqual(strict['valid'],legal); self.assertEqual(strict['after'],expected)
                    self.assertEqual(None if not legal else expected,old.stack_step(on,task['plan'][0]))
                    COUNTS['guard_transition_cases']+=1
                    for name in oracle.MUTANTS:
                        legal,expected=step_formula(on,task['plan'][0],name)
                        wrong=oracle.replay(task,name)
                        self.assertEqual(wrong['valid'],legal); self.assertEqual(wrong['after'],expected)
                        COUNTS['mutant_transition_cases']+=1
            for goal in worlds:
                task={'kind':'blocks','on':on,'goal_on':goal,'plan':[]}
                self.assertEqual(oracle.solve(task)['shortest_plan'],old.exhaustive_stack_path(on,goal))
                COUNTS['small_world_goal_pairs']+=1

    def test_noop_compound_invalid_and_wrong_prefix_not_control(self):
        rows,manifest=family(204); tasks=[rows[2*i]['semantic_task'] for i in range(5)]
        good=next(x for x in manifest['families'][0]['controls'] if x['name']=='isolated_noop_append_counterfactual')
        for changed in ('prefix','block','support','compound'):
            control=deepcopy(good); local=deepcopy(tasks)
            if changed=='prefix': control['evidence']['prefix_length']=2
            elif changed=='block': control['evidence']['block']='missing'
            elif changed=='support': control['evidence']['current_support']='b'
            else: local[4]['plan'][-1]=old.action('d','c')
            with self.assertRaises(oracle.OracleError): oracle._c4_control(control,[local[0],local[3],local[4]],204)
            COUNTS['metadata_mutations']+=1
        evidence={'action_index':1,'block':'a','current_support':'TABLE'}
        oracle._witness(evidence,oracle.NEW_PROPERTY,tasks[4],oracle.analyze(tasks[4]))
        with self.assertRaises(oracle.OracleError): oracle._witness(dict(evidence,action_index=True),oracle.NEW_PROPERTY,tasks[4],oracle.analyze(tasks[4]))

    def test_manifest_dispatch_and_exact_hashes_before_values(self):
        rows,manifest=family(204)
        malformed=[]
        for key,value in [('version',1),('version',True),('version','rgm-planning-controls-1.0.0'),
                          ('batch_name','planning-gap-v1'),('parent_input_view_sha256','0'*64),('revision_of_batch','other')]:
            x=deepcopy(manifest); x[key]=value; malformed.append(x)
        for mode in ('missing','hash','duplicate','unknown'):
            x=deepcopy(manifest)
            if mode=='missing': x['public_specification_bindings'].pop()
            elif mode=='hash': x['public_specification_bindings'][0]['sha256']='F'*64
            elif mode=='duplicate': x['public_specification_bindings'].append(x['public_specification_bindings'][0])
            else: x['public_specification_bindings'][0]['path']='unpublished'
            malformed.append(x)
        for x in malformed:
            result=oracle.check_batch(rows,x,[],[])
            self.assertTrue(result['errors']); self.assertEqual(result['counts']['complete_v2_families'],0)
            self.assertNotIn('families',result)
            COUNTS['metadata_mutations']+=1

    def test_manifest_positive_families_immutable_source_ignored_gold(self):
        for index in (180,181,192,204,209,210,216):
            rows,manifest=family(index); snapshot=json.dumps([rows,manifest],sort_keys=True)
            result=oracle.check_batch(rows,manifest,[],[])
            self.assertEqual(result['counts']['complete_v2_families'],1,result['errors'])
            self.assertFalse(any(x.startswith('toy-family-') for x in result['errors']),result['errors'])
            self.assertEqual(json.dumps([rows,manifest],sort_keys=True),snapshot)
            self.assertEqual(sum(result['conditional_histograms'].values()),len(rows))
            for row in rows: row['verified_target']={'false':999}
            self.assertEqual(oracle.check_batch(rows,manifest,[],[]),result)
            COUNTS['hand_families']+=1

    def test_missing_rows_contexts_controls_or_witness_fail_closed(self):
        rows,manifest=family(204); cases=[]
        x=deepcopy(manifest); x['families'][0]['contexts'].pop(); cases.append(x)
        x=deepcopy(manifest); x['families'][0]['contexts'][4]['sample_ids'].pop(); cases.append(x)
        x=deepcopy(manifest); x['families'][0]['contexts'][4]['row_witnesses'].pop(); cases.append(x)
        x=deepcopy(manifest); x['families'][0]['contexts'][4]['row_properties'].remove(oracle.NEW_PROPERTY); cases.append(x)
        x=deepcopy(manifest); x['families'][0]['controls']=[c for c in x['families'][0]['controls'] if c['name']!='isolated_noop_append_counterfactual']; cases.append(x)
        x=deepcopy(manifest); x['families'][0]['controls'][0]['sample_ids'][1]='foreign'; cases.append(x)
        x=deepcopy(manifest); x['families'][0]['controls'][0]['scope']='audit_probe'; cases.append(x)
        x=deepcopy(manifest); x['families'][0]['contexts'][0]['row_witnesses'][0]['evidence']['precondition']='source'; cases.append(x)
        for x in cases:
            result=oracle.check_batch(rows,x,[],[])
            self.assertTrue(any(y.startswith('toy-family-') for y in result['errors']),result['errors'])
            COUNTS['metadata_mutations']+=1
        self.assertTrue(oracle.check_batch(rows[:-1],manifest,[],[])['errors'])
        self.assertTrue(oracle.check_batch(rows,manifest,[])['errors'])
        self.assertTrue(any('reused from parent' in x for x in oracle.check_batch(rows,manifest,[],rows)['errors']))

    def test_wrong_typed_world_and_generator(self):
        rows,manifest=family(180)
        for key,value in [('fuel',True),('nodes',None),('edges',[['a','b',True]]),('plan',[True])]:
            bad=deepcopy(rows); bad[0]['semantic_task'][key]=value
            self.assertTrue(oracle.check_batch(bad,manifest,[],[])['errors'])
            COUNTS['typed_malformed_cases']+=1
        bad=deepcopy(rows); bad[0]['generator_version']='rgm-planning-gap-1.0.0'
        self.assertTrue(oracle.check(bad[0]))
        rows,manifest=family(204); rows[-1]['source_provenance']['source_family_index']=True
        self.assertTrue(any('source index mismatch' in x for x in oracle.check_batch(rows,manifest,[],[])['errors']))

    def test_search_incompletion_is_unknown_not_infeasible(self):
        task=old.graph(); old_result=v1.analyze(task); old_result['search']['complete']=False
        with patch.object(v1,'analyze',return_value=old_result):
            with self.assertRaisesRegex(oracle.OracleError,'UNKNOWN'): oracle.analyze(task)

    def test_name_permutation_and_illegal_suffix_absorption(self):
        rows,_=family(204); task=rows[2]['semantic_task']; strict=oracle.solve(task)
        altered=deepcopy(task); altered['plan']=task['plan'][:4]+[old.action('missing','TABLE')]
        self.assertEqual(oracle.solve(altered),strict)
        rename={b:'x'+str(i) for i,b in enumerate(reversed(sorted(task['on'])))}; rename['TABLE']='TABLE'
        renamed={'kind':'blocks','on':{rename[b]:rename[d] for b,d in task['on'].items()},
            'goal_on':{rename[b]:rename[d] for b,d in task['goal_on'].items()},
            'plan':[old.action(rename[x['block']],rename[x['to']]) for x in task['plan']]}
        rr=oracle.analyze(renamed)
        self.assertEqual(rr['search']['minimum_moves'],oracle.analyze(task)['search']['minimum_moves'])
        self.assertEqual(rr['first_error'],3)
        self.assertEqual(rr['properties'],oracle.analyze(task)['properties'])

if __name__=='__main__': unittest.main()
