"""Pre-generation public-v2 handmade fixtures, independent of candidate files."""
from copy import deepcopy
import importlib.util
import itertools
import json
from pathlib import Path
import sys
import unittest

sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
from oracles import belief_controls_v2_independent as v2
from oracles import belief_controls_independent as v1
spec=importlib.util.spec_from_file_location('frozen_own_v1_fixtures',Path(__file__).with_name('oracle_belief_controls_test.py'))
old=importlib.util.module_from_spec(spec);spec.loader.exec_module(old)


def fixture(index=12,context='A',shifts=(0,0,0),renderer='forward'):
    item=old.row(index,{'G':'E','H':'F'}.get(context,context),shifts,renderer)
    u,v,w=shifts; item['sample_id']=f'v2fixture-{index}-{context}-{u}{v}{w}-{renderer}'
    item['controlled_context']=context;item['generator_version']='rbm-belief-gap-2.0.0'
    roles=item['fact_role_assignments'];aux=roles['observation_auxiliary'];control=roles['observation_control']
    first={'fact':aux,'equals':2 if context in 'EFGH' else 1 if context=='B' else 0}
    second={'fact':control,'equals':1 if context in 'GH' else True if index==19 else 0}
    obs=[first,second]
    if context=='C':obs.reverse()
    if context in 'DFH':obs.append(deepcopy(first))
    item['semantic_task']['observations']=obs
    item['family_control_claims']=[c for c in item['family_control_claims'] if c['name']!='null_guarantee_contrast' or index in (12,18)]
    for left,right,length in [('E','G',2),('F','H',3)]:
        for name in sorted(v2.NEW_FAMILY):
            item['family_control_claims'].append({'name':name,'scope':'corpus_variant','pair_sample_ids':[f'v2fixture-{index}-{c}-{u}{v}{w}-{renderer}' for c in (left,right)],'evidence_manifest':f'own-fixture/{index}/{left}-{right}-length{length}.json'})
    old.render(item);return item


def batch():
    return [fixture(index,context,shifts,style) for index in (12,13,18,19) for context in v2.CONTEXTS for shifts in itertools.product(range(3),repeat=3) for style in ('forward','reverse')]


def tiny(length=2,singleton=False):
    worlds=[{'world_id':'a','facts':{'x':True,'y':'g','q':None,'r':True,'z':0}}, {'world_id':'b','facts':{'x':True,'y':'g','q':None,'r':1,'z':1}}, {'world_id':'c','facts':{'x':1,'y':'b','q':0,'r':'unknown','z':2}}, {'world_id':'d','facts':{'x':1,'y':'g','q':1,'r':'unknown','z':3}}]
    if singleton:worlds.pop(1)
    left={'kind':'belief','worlds':worlds,'observations':[{'fact':'x','equals':True},{'fact':'y','equals':'b'}],'queries':[{'query_id':f'query-{f}','fact':f} for f in ('q','r','x')]}
    right=deepcopy(left);right['observations'][1]['equals']='g'
    if length==3:
        for task in (left,right):task['observations'].append(deepcopy(task['observations'][0]))
    return left,right


class MatchedControls(unittest.TestCase):
    def test_hand_derived_pair_and_query_types(self):
        a,b=tiny();proof=v2.matched_pair(a,b)
        self.assertEqual(proof['left_prefix_supports'],[['a','b','c','d'],['a','b'],[]])
        self.assertEqual(proof['right_prefix_supports'],[['a','b','c','d'],['a','b'],['a','b']])
        self.assertEqual(v1._json(proof['right']['queries'][1]['counts']),v1._json([{'value':1,'count':1},{'value':True,'count':1}]))
        self.assertTrue(proof['right']['queries'][0]['entailed']);self.assertIsNone(proof['right']['queries'][0]['guaranteed'])
    def test_singleton_and_nonstrict_second_filter_valid(self):
        for singleton in (True,False):
            for length in (2,3):self.assertTrue(v2.matched_pair(*tiny(length,singleton))['satisfied'])
    def test_typed_second_edit_not_native_python_equality(self):
        a={'kind':'belief','worlds':[{'world_id':'a','facts':{'x':0,'y':True}},{'world_id':'b','facts':{'x':1,'y':1}}],'observations':[{'fact':'x','equals':0},{'fact':'y','equals':1}],'queries':[{'query_id':'q','fact':'y'}]}
        b=deepcopy(a);b['observations'][1]['equals']=True
        self.assertEqual(v2.matched_pair(a,b)['typed_old_equals'],['int',1])
        self.assertEqual(v2.matched_pair(a,b)['typed_new_equals'],['bool',True])
    def test_reject_pair_corruptions(self):
        mutations=[lambda b:b['observations'][0].update(equals=1),lambda b:b['observations'][1].update(fact='r'),lambda b:b['worlds'][0]['facts'].update(z=9),lambda b:b['queries'].reverse(),lambda b:b['observations'].append(deepcopy(b['observations'][0]))]
        for mutate in mutations:
            a,b=tiny();mutate(b)
            with self.assertRaises(v2.BeliefControlError):v2.matched_pair(a,b)
    def test_require_individually_supported_empty_constraints(self):
        a,b=tiny();a['observations'][1]['equals']='absent'
        with self.assertRaises(v2.BeliefControlError):v2.matched_pair(a,b)
    def test_require_repeat_first_typed_exactly(self):
        a,b=tiny(3);a['observations'][2]['equals']=1
        with self.assertRaises(v2.BeliefControlError):v2.matched_pair(a,b)
    def test_false_zero_string_null_distinctions(self):
        vals=[False,0,'0',None,'unknown'];worlds=[{'world_id':str(i),'facts':{'x':value}} for i,value in enumerate(vals)]
        for i,value in enumerate(vals):
            task={'kind':'belief','worlds':worlds,'observations':[{'fact':'x','equals':value}],'queries':[{'query_id':'q','fact':'x'}]}
            self.assertEqual(v1.derive(task)['target']['surviving_worlds'],[str(i)])
    def test_exhaustive_supported_cells(self):
        checked=0
        for mask in range(1,1<<4):
            cells=[(x,y) for x,y in itertools.product(range(2),repeat=2) if mask & (1<<(2*x+y))]
            worlds=[{'world_id':str(i),'facts':{'x':x,'y':y}} for i,(x,y) in enumerate(cells)]
            for x,y,g in itertools.product(range(2),repeat=3):
                if any(a==x for a,b in cells) and any(b==y for a,b in cells) and (x,y) not in cells and (x,g) in cells:
                    left={'kind':'belief','worlds':worlds,'observations':[{'fact':'x','equals':x},{'fact':'y','equals':y}],'queries':[{'query_id':'q','fact':'x'}]}
                    right=deepcopy(left);right['observations'][1]['equals']=g
                    self.assertTrue(v2.matched_pair(left,right)['satisfied']);checked+=1
        self.assertEqual(checked,12)


class RowMetadata(unittest.TestCase):
    def test_all_contexts_and_styles(self):
        for index in (12,13,18,19):
            for context in v2.CONTEXTS:
                for style in ('forward','reverse'):self.assertEqual(v2.check(fixture(index,context,(2,1,2),style)),[])
    def test_new_controls_cannot_be_row_tags(self):
        item=fixture(context='G');item['skill_tags'].append(next(iter(v2.NEW_FAMILY)))
        self.assertTrue(v2.check(item))
    def test_closed_claim_corruptions(self):
        for change in ({'property':'world_order_invariance'},{'scope':'pointer_only'},{'source_family_key':'wrong'},{'unknown_field':True}):
            item=fixture();item['family_control_claims'][-1].update(change);self.assertTrue(v2.check(item))
    def test_new_corpus_requires_pair_and_evidence(self):
        for key in ('pair_sample_ids','evidence_manifest'):
            item=fixture();del item['family_control_claims'][-1][key];self.assertTrue(v2.check(item))
    def test_boolean_shift_and_float_scalar_fail(self):
        for field in ('id_shift','schedule_index'):
            item=fixture();item[field]=False;self.assertTrue(v2.check(item))
        item=fixture();item['semantic_task']['observations'][0]['equals']=0.0;old.render(item);self.assertTrue(v2.check(item))
    def test_missing_context_and_typed_render_mismatch_fail(self):
        item=fixture();del item['controlled_context'];self.assertTrue(v2.check(item))
        item=fixture(19);item['rendered_input']=item['rendered_input'].replace('true','1');self.assertTrue(v2.check(item))


class FullSchedule(unittest.TestCase):
    @classmethod
    def setUpClass(cls):cls.inputs=batch();cls.report=v2.check_batch(cls.inputs)
    def test_handmade_complete_batch_counts(self):
        self.assertEqual(self.report['errors'],[])
        expected={'records':1728,'source_families':4,'base_contexts':32,'base_context_query_observations':96,'rotation_level_query_observations':2592,'rendered_query_observations':5184,'crossing_histograms':64,'distinct_decoded_world_tables':4}
        for key,value in expected.items():self.assertEqual(self.report['counts'][key],value)
    def test_exact_supplied_length_controls_and_full_crossings(self):
        for name in v2.NEW_FAMILY:
            proofs=self.report['corpus_controls'][name];self.assertEqual(len(proofs),432)
            for family in ('family-12','family-13','family-18','family-19'):
                for length in (2,3):self.assertEqual(sum(p['family']==family and p['observation_length']==length for p in proofs),54)
        self.assertTrue(all(p['satisfied'] for p in self.report['crossings']))
    def test_input_histograms_and_frozen_rule_measurements(self):
        for detail in self.report['shortcut_diagnostics'].values():
            self.assertGreater(detail['mixed_coarse_first_prefix_buckets'],0)
            self.assertEqual(set(detail['outcomes']),{'empty','nonempty'})
            self.assertGreater(detail['baselines']['v1_original_scalar_marker_empty']['errors'],0)
            self.assertEqual(detail['baselines']['frozen_v1_empty_core']['covered_records'],0)
            self.assertEqual(detail['baselines']['joint_input_lookup_lookup']['accuracy'],1)
    def test_family_claims_have_executed_witnesses(self):self.assertTrue(all(c['satisfied'] for c in self.report['claim_checks']))
    def test_missing_g_rotation_or_h_renderer_fails(self):
        subset=[r for r in self.inputs if r['sample_id']!='v2fixture-12-G-012-forward'];report=v2.check_batch(subset)
        self.assertTrue(any('27 schedules' in e for e in report['errors']))
        self.assertTrue(any('missing matched E/G' in e for e in report['errors']))
    def test_corpus_pointer_to_wrong_length_pair_fails(self):
        inputs=deepcopy(self.inputs);claim=inputs[0]['family_control_claims'][-1];claim['pair_sample_ids']=['v2fixture-12-A-000-forward','v2fixture-12-B-000-forward']
        report=v2.check_batch(inputs);self.assertTrue(any('missing actual scoped claim witness' in e for e in report['errors']))
    def test_arbitrary_new_probe_id_is_actually_executed(self):
        inputs=deepcopy(self.inputs);inputs[0]['family_control_claims'].append({'name':'same_prefix_empty_nonempty_counterfactual','scope':'audit_probe','control_id':'new-own-probe','probe_id':'arbitrary-real-execution'})
        report=v2.check_batch(inputs);self.assertEqual(report['errors'],[])
        p=next(p for p in report['audit_probes'] if p['probe_id']=='arbitrary-real-execution');self.assertTrue(p['executed_under_declared_id']);self.assertEqual(p['relation']['observation_length'],2)
        self.assertEqual(v1._json(p['executed_targets']),v1._json([v1.derive(t)['target'] for t in p['tasks']]))


if __name__=='__main__':unittest.main()
